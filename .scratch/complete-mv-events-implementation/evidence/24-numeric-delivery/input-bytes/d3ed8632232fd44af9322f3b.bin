'use strict';
const fs=require('node:fs/promises'),path=require('node:path'),assert=require('node:assert/strict'),crypto=require('node:crypto');
const {strictJson}=require('./map24-json.cjs'),isolation=require('./mv33-physical-isolation-v1.cjs');
const base=__dirname,sha=b=>crypto.createHash('sha256').update(b).digest('hex'),load=async p=>JSON.parse(await fs.readFile(p,'utf8'));
async function exists(file){try{await fs.lstat(file);return true;}catch(e){if(e.code==='ENOENT')return false;throw e;}}
function get(value,parts){for(const part of parts)value=value[part];return value;}
async function run(args){assert.ok(['prepare','native'].includes(args.mode));assert.ok(args.index);const startedAt=new Date().toISOString(),productPointer=await load(path.join(base,'product-freeze-v1-pointer.json'));assert.equal(sha(await fs.readFile(productPointer.manifest)),productPointer.sha256);const product=await load(productPointer.manifest);
for(const entry of product.entries){assert.equal(sha(await fs.readFile(entry.original)),entry.sha256,'Current frozen input '+entry.path);assert.equal(sha(await fs.readFile(entry.frozen)),entry.sha256,'Independent frozen input '+entry.path);const stat=await fs.lstat(entry.frozen,{bigint:true});assert.ok(stat.isFile()&&!stat.isSymbolicLink());assert.equal(stat.nlink,1n);}
const inputPointer=await load(path.join(base,'map24-physical-inputs-v2-pointer.json'));assert.equal(sha(await fs.readFile(inputPointer.manifest)),inputPointer.sha256);const inputs=await load(inputPointer.manifest);for(const tool of [inputs.script,inputs.adapter,...inputs.supportTools])assert.equal(sha(await fs.readFile(tool.path)),tool.sha256,'Bound tool '+tool.path);
const fullCurrent=await isolation.distinctTrees({reference:inputs.reference,seed:inputs.seedRoot});assert.deepEqual(fullCurrent.trees,inputs.fullAfter.trees,'Full protected inputs remain exact');assert.equal(fullCurrent.trees.reference.files.length,1100);assert.equal(fullCurrent.trees.seed.files.length,1100);
const index=await load(args.index);assert.equal(index.results.length,2);const pairs=[];
for(const item of index.results){const reportPath=path.join(item.root,args.mode==='prepare'?'preparation-result.json':'pair-result.json'),reportBytes=await fs.readFile(reportPath),report=JSON.parse(reportBytes),bound=inputs.bound.find(b=>b.definition.id===item.case);assert.ok(bound);assert.equal(sha(await fs.readFile(bound.file)),bound.sha256);const bundle=await load(bound.file);assert.equal(report.inputBinding.independentFixture.path,bound.file);assert.equal(report.inputBinding.independentFixture.sha256,bound.sha256);
assert.equal(report.checkStateUnchanged,true);assert.equal(report.completeGeneratedCarrierComparison.passed,true);assert.deepEqual(report.completeGeneratedCarrierComparison.files,['CommonEvents.json','Map001.json','System.json','Troops.json']);assert.equal(report.completeCarrierComparison.passed,true);assert.equal(report.completeCarrierComparison.files.length,15);assert.equal(report.sourceEdits.length,1);
const steps=['public init','public Clone','public Decompile','formal owned source edits','public Check','public Compile','public Diff','public Push'];for(const name of steps)assert.equal(report.lifecycle.find(step=>step.name===name)?.ok,true,name);
for(const [key,group]of [['source','src'],['dist','dist']])assert.deepEqual([...report.build[key].entries].sort((a,b)=>a.path.localeCompare(b.path)),[...product.groups[group].entries].sort((a,b)=>a.path.localeCompare(b.path)),item.case+'/'+key);
const dataNow=await isolation.distinctTrees({reference:path.join(inputs.reference,'data'),seed:path.join(inputs.seedRoot,'data'),literal:path.join(report.sides.literal.project,'data'),compiled:path.join(report.sides.compiled.project,'data')});const dataBaseline=report.isolationCheckpoints[0];assert.ok(report.isolationCheckpoints.length>=27);assert.ok(report.fullProtectedCheckpoints.length>=6);
let literalFrozen=false;for(const point of report.isolationCheckpoints){assert.equal(point.passed,true);assert.deepEqual(point.trees.reference,dataBaseline.trees.reference);assert.deepEqual(point.trees.seed,dataBaseline.trees.seed);if(point.label==='freeze literal independent complete input')literalFrozen=true;if(literalFrozen)assert.deepEqual(point.trees.literal,dataNow.trees.literal);for(const tree of Object.values(point.trees))for(const entry of tree.entries){assert.notEqual(entry.ino,'0');if(entry.kind==='file')assert.equal(entry.nlink,'1');}}
assert.deepEqual(dataNow.trees,report.isolationCheckpoints.at(-1).trees,'Latest actual complete data matches final captured identities and bytes');for(const point of report.fullProtectedCheckpoints){assert.equal(point.passed,true);assert.deepEqual(point.trees,inputs.fullAfter.trees);}
const numerical=[];for(const side of ['literal','compiled']){const value=report.sides[side],disk={};for(const name of report.completeCarrierComparison.files)disk[name]=JSON.parse(await fs.readFile(path.join(value.project,'data',name),'utf8'));assert.deepEqual(disk,bundle.fixture.carriers,'Complete15 current '+side+' carriers');for(const name of ['Map001.json','CommonEvents.json','System.json','Troops.json'])assert.deepEqual(report.generated.values[name],bundle.fixture.carriers[name]);
if(args.mode==='prepare'){assert.equal(report.prepared,true);assert.equal(report.passed,false);assert.match(report.nativeExecution,/not-executed/);assert.equal(value.native,undefined);for(const name of ['runtime-result.json','runtime-process-identity.json','native-launch.json','stdout.txt','stderr.txt','NativeProfile'])assert.equal(await exists(path.join(value.project,name)),false,'Prepare cannot launch native '+name);}
else {assert.equal(report.passed,true);assert.equal(report.runtimeComparison,true);assert.equal(value.passed,true);assert.equal(Object.keys(value.validation).length,15);for(const flag of Object.values(value.validation))assert.equal(flag,true);const runtime=value.native['runtime-result.json'].value;assert.equal(runtime.passed,true);assert.equal(runtime.error,null);assert.equal(runtime.engine,'1.6.1');assert.equal(runtime.versions.nw,'0.29.0');assert.equal(runtime.versions.node,'9.7.1');assert.match(runtime.versions.chromium||runtime.versions.chrome,/^65\./);assert.deepEqual(runtime.loaded,bundle.fixture.loadedCarriers);assert.equal(Object.keys(runtime.loaded).length,4);for(const location of bundle.numericSavedValueLocations)assert.ok(Object.is(get(runtime.loaded,location.path.split('/')),-0),'Runtime exact -0 '+side+' '+location.path);}
for(const location of bundle.numericSavedValueLocations){assert.ok(Object.is(get(bundle.fixture.carriers,location.path.split('/')),-0));assert.ok(Object.is(get(disk,location.path.split('/')),-0));assert.ok(Object.is(get(report.generated.values,location.path.split('/')),-0));numerical.push({side,path:location.path,expected:'-0',diskNegativeZero:true,generatedNegativeZero:true,runtimeNegativeZero:args.mode==='native'?true:'not-executed'});}}
pairs.push({case:item.case,report:{path:reportPath,sha256:sha(reportBytes)},lifecycle:steps,sourceFingerprint:report.build.source.sha256,distFingerprint:report.build.dist.sha256,generatedCarriers:report.completeGeneratedCarrierComparison.files,diskCarrierCount:15,physicalDataCheckpoints:report.isolationCheckpoints.length,fullProtectedCheckpoints:report.fullProtectedCheckpoints.length,numericSavedValueChecks:numerical,native:args.mode==='native'?'four native sides in total; complete loaded4 and strict15 flags per side':'not-executed',passed:args.mode==='native'?true:false,prepared:args.mode==='prepare'?true:undefined,verified:true});}
const result={purpose:'Map24 independent read-only actual physical/input/source/build validation; prepare is explicitly not game acceptance',mode:args.mode,startedAt,completedAt:new Date().toISOString(),productFreeze:productPointer,inputFreeze:inputPointer,index:{path:args.index,sha256:sha(await fs.readFile(args.index))},tools:[inputs.script,inputs.adapter,...inputs.supportTools],fullProtected:{referenceFiles:fullCurrent.trees.reference.files.length,seedFiles:fullCurrent.trees.seed.files.length,referenceFingerprint:fullCurrent.trees.reference.sha256,seedFingerprint:fullCurrent.trees.seed.sha256},pairs,passed:true};const out=path.join(base,'map24-'+args.mode+'-audit-v1-'+crypto.randomUUID()+'.json');await fs.writeFile(out,strictJson(result)+'\n',{flag:'wx'});console.log(JSON.stringify({output:out,sha256:sha(await fs.readFile(out)),pairs:pairs.length,passed:true}));}
if(require.main===module){const args=Object.fromEntries(process.argv.slice(2).map(text=>{const i=text.indexOf('=');assert.ok(i>2);return[text.slice(2,i),text.slice(i+1)];}));run(args).catch(e=>{console.error(e.stack||e);process.exitCode=1;});}module.exports={run};
