//#region src/domain/declarations.d.ts
type DslOwnedDeclaration = MapEventDefinition | CommonEventDefinition | TroopEventDefinition | SwitchDefinition | VariableDefinition;
type EventDefinition = MapEventDefinition | CommonEventDefinition | TroopEventDefinition;
type TroopEventDefinition = {
  kind: "troopEvent";
  troopId: number;
  pages: readonly [BattleEventPage, ...BattleEventPage[]];
};
type BattleEventPage = {
  conditions?: BattlePageConditions;
  span?: "battle" | "turn" | "moment";
  commands: readonly DslCommand[];
};
type BattlePageConditions = {
  turnEnd?: boolean;
  turn?: {
    enabled: boolean;
    a: number;
    b: number;
  };
  enemy?: {
    enabled: boolean;
    index: number;
    hpAtMost: number;
  };
  actor?: {
    enabled: boolean;
    ref: ReferenceValue<"actor">;
    hpAtMost: number;
  };
  switch?: {
    enabled: boolean;
    ref: ReferenceValue<"switch">;
  };
};
type SwitchDefinition = {
  kind: "switchDefinition";
  id: number;
  name: string;
};
type VariableDefinition = {
  kind: "variableDefinition";
  id: number;
  name: string;
};
type MapEventDefinition = {
  kind: "mapEvent";
  mapId: number;
  id: number;
  name: string;
  x: number;
  y: number;
  note?: string;
  pages: readonly [EventPage, ...EventPage[]];
};
type CommonEventInput = {
  id: number;
  name: string;
  commands: readonly DslCommand[];
} & ({
  trigger: "none";
  switch?: ReferenceValue<"switch">;
} | {
  trigger: "autorun" | "parallel";
  switch: ReferenceValue<"switch">;
});
type CommonEventDefinition = CommonEventInput & {
  kind: "commonEvent";
};
type CommonEventTrigger = "none" | "autorun" | "parallel";
type MapPageTrigger = "action" | "playerTouch" | "eventTouch" | "autorun" | "parallel";
type EventPage = {
  conditions: PageConditions;
  trigger: MapPageTrigger;
  commands: readonly DslCommand[];
  movement?: AutonomousMovement;
  image?: PageImage;
  priority?: "below" | "same" | "above";
  options?: PageOptions;
};
type PageImage = {
  character?: ImageAssetReference | null;
  characterIndex?: number;
  tileId?: number;
  direction?: "down" | "left" | "right" | "up";
  pattern?: number;
};
type PageOptions = {
  walkAnimation?: boolean;
  stepAnimation?: boolean;
  directionFix?: boolean;
  through?: boolean;
};
type AutonomousMovement = {
  type?: "fixed" | "random" | "approach" | "custom";
  speed?: number;
  frequency?: number;
  route?: MovementRoute;
};
type PageConditions = {
  actor?: {
    enabled: boolean;
    ref: ReferenceValue<"actor">;
  };
  item?: {
    enabled: boolean;
    ref: ReferenceValue<"item">;
  };
  selfSwitch?: {
    enabled: boolean;
    value: "A" | "B" | "C" | "D";
  };
  switch1?: {
    enabled: boolean;
    ref: ReferenceValue<"switch">;
  };
  switch2?: {
    enabled: boolean;
    ref: ReferenceValue<"switch">;
  };
  variable?: {
    enabled: boolean;
    ref: ReferenceValue<"variable">;
    atLeast: number;
  };
};
declare function isDslOwnedDeclaration(value: unknown): value is DslOwnedDeclaration;
//#endregion
//#region src/validation/declarations.d.ts
declare function collectDslOwnedDeclarations(moduleExports: Record<string, unknown>): DslOwnedDeclaration[];
//#endregion
