{"version":3,"file":"authoring-D0b1TW44.mjs","names":[],"sources":["C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/domain/declarations.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/project-data/json-values.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/command-errors.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/movement/validation.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/variables/validation.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/map/native-validation.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/native-parameters.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/command-structure.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/dsl-command-inputs.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/common-events.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/declarations.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/domain/references.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/authoring/declarations.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/message/authoring.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/authoring/shared.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/authoring/references.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/flow/validation.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/flow/authoring.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/variables/authoring.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/movement/authoring.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/screen/authoring.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/audio/authoring.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/map/validation.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/map/authoring.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/battle/authoring.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/actor/authoring.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/enemy/authoring.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/system/authoring.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/authoring/index.ts"],"sourcesContent":["import type { DslCommand, MovementRoute } from \"./command.js\";\nimport type { ImageAssetReference, ReferenceValue } from \"./references.js\";\n\nexport type DslOwnedDeclaration =\n  | MapEventDefinition\n  | CommonEventDefinition\n  | TroopEventDefinition\n  | SwitchDefinition\n  | VariableDefinition;\n\nexport type EventDefinition = MapEventDefinition | CommonEventDefinition | TroopEventDefinition;\n\nexport type TroopEventDefinition = {\n  kind: \"troopEvent\";\n  troopId: number;\n  pages: readonly [BattleEventPage, ...BattleEventPage[]];\n};\n\nexport type BattleEventPage = {\n  conditions?: BattlePageConditions;\n  span?: \"battle\" | \"turn\" | \"moment\";\n  commands: readonly DslCommand[];\n};\n\nexport type BattlePageConditions = {\n  turnEnd?: boolean;\n  turn?: { enabled: boolean; a: number; b: number };\n  enemy?: { enabled: boolean; index: number; hpAtMost: number };\n  actor?: { enabled: boolean; ref: ReferenceValue<\"actor\">; hpAtMost: number };\n  switch?: { enabled: boolean; ref: ReferenceValue<\"switch\"> };\n};\n\nexport type SwitchDefinition = {\n  kind: \"switchDefinition\";\n  id: number;\n  name: string;\n};\n\nexport type VariableDefinition = {\n  kind: \"variableDefinition\";\n  id: number;\n  name: string;\n};\n\nexport type MapEventDefinition = {\n  kind: \"mapEvent\";\n  mapId: number;\n  id: number;\n  name: string;\n  x: number;\n  y: number;\n  note?: string;\n  pages: readonly [EventPage, ...EventPage[]];\n};\n\nexport type CommonEventInput = {\n  id: number;\n  name: string;\n  commands: readonly DslCommand[];\n} & (\n  | { trigger: \"none\"; switch?: ReferenceValue<\"switch\"> }\n  | { trigger: \"autorun\" | \"parallel\"; switch: ReferenceValue<\"switch\"> }\n);\n\nexport type CommonEventDefinition = CommonEventInput & { kind: \"commonEvent\" };\n\nexport type CommonEventTrigger = \"none\" | \"autorun\" | \"parallel\";\n\nexport type MapPageTrigger = \"action\" | \"playerTouch\" | \"eventTouch\" | \"autorun\" | \"parallel\";\n\nexport type EventPage = {\n  conditions: PageConditions;\n  trigger: MapPageTrigger;\n  commands: readonly DslCommand[];\n  movement?: AutonomousMovement;\n  image?: PageImage;\n  priority?: \"below\" | \"same\" | \"above\";\n  options?: PageOptions;\n};\n\nexport type PageImage = {\n  character?: ImageAssetReference | null;\n  characterIndex?: number;\n  tileId?: number;\n  direction?: \"down\" | \"left\" | \"right\" | \"up\";\n  pattern?: number;\n};\n\nexport type PageOptions = {\n  walkAnimation?: boolean;\n  stepAnimation?: boolean;\n  directionFix?: boolean;\n  through?: boolean;\n};\n\nexport type AutonomousMovement = {\n  type?: \"fixed\" | \"random\" | \"approach\" | \"custom\";\n  speed?: number;\n  frequency?: number;\n  route?: MovementRoute;\n};\n\nexport type PageConditions = {\n  actor?: { enabled: boolean; ref: ReferenceValue<\"actor\"> };\n  item?: { enabled: boolean; ref: ReferenceValue<\"item\"> };\n  selfSwitch?: { enabled: boolean; value: \"A\" | \"B\" | \"C\" | \"D\" };\n  switch1?: { enabled: boolean; ref: ReferenceValue<\"switch\"> };\n  switch2?: { enabled: boolean; ref: ReferenceValue<\"switch\"> };\n  variable?: {\n    enabled: boolean;\n    ref: ReferenceValue<\"variable\">;\n    atLeast: number;\n  };\n};\n\nexport function isDslOwnedDeclaration(value: unknown): value is DslOwnedDeclaration {\n  return (\n    !!value &&\n    typeof value === \"object\" &&\n    \"kind\" in value &&\n    ((value as { kind?: string }).kind === \"mapEvent\" ||\n      (value as { kind?: string }).kind === \"commonEvent\" ||\n      (value as { kind?: string }).kind === \"troopEvent\" ||\n      (value as { kind?: string }).kind === \"switchDefinition\" ||\n      (value as { kind?: string }).kind === \"variableDefinition\")\n  );\n}\n","export class StrictJsonError extends Error {\n  constructor(\n    readonly path: string,\n    readonly actual: string,\n  ) {\n    super(`Expected strict representable JSON; received ${actual} at ${path}.`);\n  }\n}\n\nexport function describeValue(value: unknown): string {\n  try {\n    return renderJsonValue(value);\n  } catch (error) {\n    return error instanceof StrictJsonError ? error.actual : String(value);\n  }\n}\n\nexport function assertStrictJson(\n  value: unknown,\n  path = \"value\",\n  ancestors = new Set<object>(),\n): void {\n  if (value === null || typeof value === \"string\" || typeof value === \"boolean\") return;\n  if (typeof value === \"number\" && Number.isFinite(value)) return;\n  if (typeof value !== \"object\" || value === null)\n    throw new StrictJsonError(path, typeof value === \"number\" ? String(value) : typeof value);\n  if (ancestors.has(value)) throw new StrictJsonError(path, \"circular reference\");\n  if (\n    Array.isArray(value)\n      ? Object.getPrototypeOf(value) !== Array.prototype\n      : ![Object.prototype, null].includes(Object.getPrototypeOf(value))\n  )\n    throw new StrictJsonError(path, \"non-JSON object prototype\");\n  ancestors.add(value);\n  const descriptors = Object.getOwnPropertyDescriptors(value);\n  const keys = Reflect.ownKeys(value);\n  if (Array.isArray(value)) {\n    if (\n      keys.some(\n        (key) =>\n          key !== \"length\" &&\n          (typeof key !== \"string\" || !/^(0|[1-9]\\d*)$/.test(key) || Number(key) >= value.length),\n      )\n    )\n      throw new StrictJsonError(path, \"array with extra properties\");\n    for (let index = 0; index < value.length; index++) {\n      const descriptor = descriptors[String(index)];\n      if (!descriptor || !(\"value\" in descriptor) || !descriptor.enumerable)\n        throw new StrictJsonError(\n          `${path}[${index}]`,\n          descriptor ? \"non-JSON property\" : \"missing array slot\",\n        );\n      assertStrictJson(descriptor.value, `${path}[${index}]`, ancestors);\n    }\n  } else\n    for (const key of keys) {\n      if (typeof key !== \"string\") throw new StrictJsonError(path, \"symbol property\");\n      const childPath = /^[A-Za-z_$][\\w$]*$/.test(key)\n        ? `${path}.${key}`\n        : `${path}[${JSON.stringify(key)}]`;\n      const descriptor = descriptors[key]!;\n      if (!(\"value\" in descriptor) || !descriptor.enumerable)\n        throw new StrictJsonError(childPath, \"non-JSON property\");\n      assertStrictJson(descriptor.value, childPath, ancestors);\n    }\n  ancestors.delete(value);\n}\n\n// JSON permits the -0 token; JSON.stringify silently changes its parsed numeric value.\nexport function renderJsonValue(value: unknown, options: { typeScript?: boolean } = {}): string {\n  assertStrictJson(value);\n  return render(value, options.typeScript ?? false);\n}\n\nfunction render(value: unknown, typeScript: boolean): string {\n  if (Object.is(value, -0)) return \"-0\";\n  if (Array.isArray(value)) return `[${value.map((entry) => render(entry, typeScript)).join(\",\")}]`;\n  if (typeof value === \"object\" && value !== null)\n    return `{${Object.entries(value)\n      .map(\n        ([key, entry]) =>\n          `${typeScript && key === \"__proto__\" ? '[\"__proto__\"]' : JSON.stringify(key)}:${render(entry, typeScript)}`,\n      )\n      .join(\",\")}}`;\n  return JSON.stringify(value);\n}\n","import type { ValidationIssue } from \"./types.js\";\n\nexport class CommandStructureError extends Error {\n  constructor(\n    readonly code: string,\n    readonly detail: string,\n    readonly location: Pick<\n      ValidationIssue,\n      \"nativePath\" | \"dslPath\" | \"expected\" | \"actual\" | \"relatedLocations\"\n    > = {},\n    readonly identity?: string,\n    readonly stage?: \"compile\" | \"decompile\",\n  ) {\n    super(\n      `${stage ? `${stage} error ` : \"\"}${identity ? `${identity}: ` : \"\"}${code}: ${detail}${location.nativePath ? ` at ${location.nativePath}` : \"\"}${location.dslPath ? ` (${location.dslPath})` : \"\"}${location.expected !== undefined ? `; expected ${location.expected}; actual ${location.actual}` : \"\"}${location.relatedLocations?.map((related) => `; related ${related.nativePath ?? related.dslPath} = ${related.value}`).join(\"\") ?? \"\"}`,\n    );\n  }\n\n  issue(identity: string, stage: \"compile\" | \"decompile\"): ValidationIssue {\n    return {\n      level: \"error\",\n      code: this.code,\n      stage,\n      identity,\n      ...this.location,\n      message: `${stage} error ${identity}: ${this.message}`,\n    };\n  }\n}\n","import { isDeepStrictEqual } from \"node:util\";\nimport type { MovementRoute, SetMovementRouteDslCommand } from \"../../domain/types.js\";\nimport type { RawEventCommand } from \"../../compiler/types.js\";\nimport type { NativeMovementRecord, NativeMovementRoute } from \"./types.js\";\nimport type { ReferenceResolver, ValidationIssue } from \"../../validation/types.js\";\nimport { CommandStructureError } from \"../../validation/command-errors.js\";\nimport { describeValue, renderJsonValue } from \"../../project-data/json-values.js\";\n\ntype Location = Pick<\n  ValidationIssue,\n  \"nativePath\" | \"dslPath\" | \"expected\" | \"actual\" | \"relatedLocations\"\n>;\n\nfunction fail(message: string, location: Location, code = \"MV-MOVEMENT-SHAPE\"): never {\n  throw new CommandStructureError(code, message, location);\n}\n\nfunction record(value: unknown, location: Location): Record<string, unknown> {\n  if (\n    typeof value !== \"object\" ||\n    value === null ||\n    Array.isArray(value) ||\n    ![Object.prototype, null].includes(Object.getPrototypeOf(value))\n  )\n    fail(\"Expected a Movement Route object.\", location);\n  return value as Record<string, unknown>;\n}\n\nfunction keys(value: Record<string, unknown>, allowed: readonly string[], location: Location) {\n  if (\n    Reflect.ownKeys(value).some((key) => {\n      const descriptor = Object.getOwnPropertyDescriptor(value, key)!;\n      return (\n        typeof key !== \"string\" ||\n        !allowed.includes(key) ||\n        !(\"value\" in descriptor) ||\n        !descriptor.enumerable\n      );\n    })\n  )\n    fail(\"Unknown Movement Route field.\", location);\n}\n\nfunction array(value: unknown, location: Location): unknown[] {\n  if (!Array.isArray(value) || Object.getPrototypeOf(value) !== Array.prototype)\n    fail(\"Expected a dense ordinary array.\", location);\n  for (const key of Reflect.ownKeys(value))\n    if (key !== \"length\") {\n      const descriptor = Object.getOwnPropertyDescriptor(value, key)!;\n      if (\n        typeof key !== \"string\" ||\n        !/^(0|[1-9]\\d*)$/u.test(key) ||\n        Number(key) >= value.length ||\n        !(\"value\" in descriptor) ||\n        !descriptor.enumerable\n      )\n        fail(\"Movement Route arrays require only ordinary data slots.\", location);\n    }\n  if (Object.keys(value).length !== value.length || value.some((item) => item === undefined))\n    fail(\"Movement Route arrays cannot contain undefined, sparse slots or extra keys.\", location);\n  for (let index = 0; index < value.length; index += 1)\n    if (!Object.hasOwn(value, index))\n      fail(\"Movement Route arrays cannot contain sparse slots.\", location);\n  return value;\n}\n\nconst parameterCounts = new Map([\n  [14, 2],\n  [15, 1],\n  [27, 1],\n  [28, 1],\n  [29, 1],\n  [30, 1],\n  [41, 2],\n  [42, 1],\n  [43, 1],\n  [44, 1],\n  [45, 1],\n]);\n\nfunction at(location: Location, suffix: string): Location {\n  return {\n    ...(location.nativePath === undefined ? {} : { nativePath: location.nativePath + suffix }),\n    ...(location.dslPath === undefined ? {} : { dslPath: location.dslPath + suffix }),\n  };\n}\n\nfunction integer(value: unknown, minimum: number, maximum: number, location: Location): void {\n  if (!Number.isInteger(value) || (value as number) < minimum || (value as number) > maximum)\n    fail(\n      \"Movement parameter is outside its accepted integer domain.\",\n      {\n        ...location,\n        expected: `integer ${minimum}..${maximum}`,\n        actual: describeValue(value),\n      },\n      \"MV-MOVEMENT-PARAMETER\",\n    );\n}\n\nfunction asset(\n  value: unknown,\n  category: \"image\" | \"audio\",\n  folder: string,\n  location: Location,\n): void {\n  if (value === null) return;\n  const input = record(value, location);\n  keys(input, [\"kind\", \"category\", \"folder\", \"name\"], location);\n  if (\n    input.kind !== \"asset\" ||\n    input.category !== category ||\n    input.folder !== folder ||\n    typeof input.name !== \"string\" ||\n    input.name.length === 0\n  )\n    fail(`Movement asset requires a nonempty ${category}/${folder} reference or null.`, location);\n}\n\nexport function assertNativeMovementRecord(\n  value: unknown,\n  location: Location,\n  terminal = false,\n): asserts value is NativeMovementRecord {\n  const item = record(value, location);\n  keys(item, terminal ? [\"code\", \"parameters\"] : [\"code\", \"parameters\", \"indent\"], location);\n  if (terminal) {\n    if (\n      item.code !== 0 ||\n      Object.is(item.code, -0) ||\n      (Object.hasOwn(item, \"parameters\") && array(item.parameters, location).length !== 0)\n    )\n      fail(\n        \"The sole final M0 must omit parameters or contain an empty array, and must omit indent.\",\n        location,\n      );\n    return;\n  }\n  if (!Number.isInteger(item.code) || (item.code as number) < 1 || (item.code as number) > 45)\n    fail(\n      \"Unknown movement code; raw movement instructions are not supported.\",\n      location,\n      \"MV-MOVEMENT-CODE\",\n    );\n  if (\n    Object.hasOwn(item, \"indent\") &&\n    item.indent !== null &&\n    (item.indent !== 0 || Object.is(item.indent, -0))\n  )\n    fail(\"A nonterminal movement indent must be absent, null or numeric zero.\", location);\n  const count = parameterCounts.get(item.code as number);\n  if (count === undefined) {\n    if (Object.hasOwn(item, \"parameters\"))\n      fail(\"A parameterless movement instruction must omit parameters.\", location);\n    return;\n  }\n  const parameters = array(item.parameters, location);\n  if (parameters.length !== count)\n    fail(`Movement code ${item.code} requires exactly ${count} parameters.`, location);\n  if (item.code === 44) {\n    const audio = record(parameters[0], location);\n    keys(audio, [\"name\", \"volume\", \"pitch\", \"pan\"], location);\n    if (\n      typeof audio.name !== \"string\" ||\n      ![audio.volume, audio.pitch, audio.pan].every(\n        (value) => typeof value === \"number\" && Number.isFinite(value),\n      )\n    )\n      fail(\"Movement SE requires its complete saved audio object.\", location);\n  } else if (item.code === 45) {\n    if (typeof parameters[0] !== \"string\")\n      fail(\"Movement Script requires one complete string.\", location);\n  } else if (item.code === 41) {\n    if (\n      typeof parameters[0] !== \"string\" ||\n      typeof parameters[1] !== \"number\" ||\n      !Number.isFinite(parameters[1])\n    )\n      fail(\"Movement image requires its name and index.\", location);\n  } else if (!parameters.every((value) => typeof value === \"number\" && Number.isFinite(value))) {\n    fail(\"Movement numeric parameter slots require finite numbers.\", location);\n  }\n  if (item.code === 14) {\n    integer(parameters[0], -99, 99, at(location, \".parameters[0]\"));\n    integer(parameters[1], -99, 99, at(location, \".parameters[1]\"));\n  }\n  if (item.code === 15) integer(parameters[0], 1, 999, at(location, \".parameters[0]\"));\n  if (item.code === 27 || item.code === 28)\n    integer(parameters[0], 1, Number.MAX_SAFE_INTEGER, at(location, \".parameters[0]\"));\n  if (item.code === 29) integer(parameters[0], 1, 6, at(location, \".parameters[0]\"));\n  if (item.code === 30) integer(parameters[0], 1, 5, at(location, \".parameters[0]\"));\n  if (item.code === 41) integer(parameters[1], 0, 7, at(location, \".parameters[1]\"));\n  if (item.code === 42) integer(parameters[0], 0, 255, at(location, \".parameters[0]\"));\n  if (item.code === 43) {\n    integer(parameters[0], 0, 3, at(location, \".parameters[0]\"));\n    if (Object.is(parameters[0], -0))\n      fail(\n        \"Movement blend mode requires a code with an exact symbolic representation.\",\n        {\n          ...at(location, \".parameters[0]\"),\n          expected: \"0, 1, 2 or 3 excluding negative zero\",\n          actual: \"-0\",\n        },\n        \"MV-MOVEMENT-PARAMETER\",\n      );\n  }\n  if (item.code === 44) {\n    const audio = parameters[0] as Record<string, unknown>;\n    integer(audio.volume, 0, 100, at(location, \".parameters[0].volume\"));\n    integer(audio.pitch, 50, 150, at(location, \".parameters[0].pitch\"));\n    integer(audio.pan, -100, 100, at(location, \".parameters[0].pan\"));\n  }\n}\n\nexport function assertNativeMovementRoute(\n  value: unknown,\n  path: string,\n): asserts value is NativeMovementRoute {\n  const location = { nativePath: path };\n  const route = record(value, location);\n  keys(route, [\"list\", \"repeat\", \"skippable\", \"wait\"], location);\n  for (const key of [\"repeat\", \"skippable\", \"wait\"])\n    if (typeof route[key] !== \"boolean\")\n      fail(`Movement Route ${key} must be an explicit boolean.`, { nativePath: `${path}.${key}` });\n  const list = array(route.list, { nativePath: `${path}.list` });\n  if (list.length === 0)\n    fail(\"Movement Route requires a sole final M0.\", { nativePath: `${path}.list` });\n  for (let index = 0; index < list.length; index += 1)\n    assertNativeMovementRecord(\n      list[index],\n      { nativePath: `${path}.list[${index}]` },\n      index === list.length - 1,\n    );\n}\n\nexport function assertNativeMovementCommands(commands: readonly RawEventCommand[]): void {\n  for (let index = 0; index < commands.length; index += 1) {\n    const command = commands[index]!;\n    if (command.code === 505)\n      fail(\"Orphan Movement Route mirror.\", { nativePath: `list[${index}]` }, \"MV-MOVEMENT-MIRROR\");\n    if (command.code !== 205) continue;\n    const path = `list[${index}].parameters`;\n    array(command.parameters, { nativePath: path });\n    if (\n      command.parameters.length !== 2 ||\n      !Number.isSafeInteger(command.parameters[0]) ||\n      Object.is(command.parameters[0], -0) ||\n      (command.parameters[0] as number) < -1\n    )\n      fail(\"Set Movement Route requires one Character Runtime Selector and one route.\", {\n        nativePath: path,\n      });\n    const route = command.parameters[1];\n    assertNativeMovementRoute(route, `${path}[1]`);\n    const nonterminals = route.list.slice(0, -1);\n    for (let offset = 0; offset < nonterminals.length; offset += 1) {\n      const mirrorIndex = index + offset + 1;\n      const mirror = commands[mirrorIndex];\n      if (\n        mirror?.code !== 505 ||\n        mirror.indent !== command.indent ||\n        mirror.parameters.length !== 1 ||\n        !isDeepStrictEqual(mirror.parameters[0], nonterminals[offset])\n      )\n        fail(\n          \"Every nonterminal movement record requires one ordered, same-indent 505 containing the complete identical object.\",\n          {\n            nativePath: `list[${mirrorIndex}]`,\n            expected: renderJsonValue({\n              code: 505,\n              indent: command.indent,\n              parameters: [nonterminals[offset]],\n            }),\n            actual: mirror ? describeValue(mirror) : \"missing\",\n            relatedLocations: [\n              {\n                nativePath: `list[${index}].parameters[1].list[${offset}]`,\n                value: renderJsonValue(nonterminals[offset]),\n              },\n            ],\n          },\n          \"MV-MOVEMENT-MIRROR\",\n        );\n      array(mirror!.parameters, { nativePath: `list[${mirrorIndex}].parameters` });\n    }\n    index += nonterminals.length;\n  }\n}\n\nexport function assertNativeMovementCommandParameters(\n  code: number,\n  parameters: unknown,\n  location: Location,\n): void {\n  const slots = array(parameters, location);\n  if (slots.length !== (code === 205 ? 2 : 1))\n    fail(\n      \"Set Movement Route requires two parameter slots; its mirror requires exactly one.\",\n      location,\n    );\n  if (code === 505) assertNativeMovementRecord(slots[0], location);\n}\n\nconst instructionFields: Record<string, readonly string[]> = {\n  moveDown: [],\n  moveLeft: [],\n  moveRight: [],\n  moveUp: [],\n  moveLowerLeft: [],\n  moveLowerRight: [],\n  moveUpperLeft: [],\n  moveUpperRight: [],\n  moveRandom: [],\n  moveTowardPlayer: [],\n  moveAwayFromPlayer: [],\n  moveForward: [],\n  moveBackward: [],\n  jump: [\"x\", \"y\"],\n  wait: [\"frames\"],\n  turnDown: [],\n  turnLeft: [],\n  turnRight: [],\n  turnUp: [],\n  turn90Right: [],\n  turn90Left: [],\n  turn180: [],\n  turn90RightOrLeft: [],\n  turnRandom: [],\n  turnTowardPlayer: [],\n  turnAwayFromPlayer: [],\n  switchOn: [\"switch\"],\n  switchOff: [\"switch\"],\n  changeSpeed: [\"speed\"],\n  changeFrequency: [\"frequency\"],\n  walkAnimation: [\"enabled\"],\n  stepAnimation: [\"enabled\"],\n  directionFix: [\"enabled\"],\n  through: [\"enabled\"],\n  transparent: [\"enabled\"],\n  changeImage: [\"character\", \"characterIndex\"],\n  changeOpacity: [\"opacity\"],\n  changeBlendMode: [\"blendMode\"],\n  playSe: [\"audio\"],\n  script: [\"script\"],\n};\n\nexport function assertMovementRoute(value: unknown, path: string): asserts value is MovementRoute {\n  const route = record(value, { dslPath: path });\n  keys(route, [\"commands\", \"repeat\", \"skippable\", \"wait\", \"terminator\"], { dslPath: path });\n  for (const key of [\"repeat\", \"skippable\", \"wait\"])\n    if (route[key] !== undefined && typeof route[key] !== \"boolean\")\n      fail(`${key} must be a boolean.`, { dslPath: `${path}.${key}` });\n  if (route.terminator !== undefined) {\n    const terminal = record(route.terminator, { dslPath: `${path}.terminator` });\n    keys(terminal, [\"parameters\"], { dslPath: `${path}.terminator` });\n    if (\n      terminal.parameters !== undefined &&\n      terminal.parameters !== \"absent\" &&\n      terminal.parameters !== \"empty\"\n    )\n      fail(\"M0 parameters must be absent or empty.\", { dslPath: `${path}.terminator.parameters` });\n  }\n  const commands = array(route.commands, { dslPath: `${path}.commands` });\n  for (const [index, value] of commands.entries()) {\n    const location = { dslPath: `${path}.commands[${index}]` };\n    const command = record(value, location);\n    const fields =\n      typeof command.kind === \"string\" && Object.hasOwn(instructionFields, command.kind)\n        ? instructionFields[command.kind]\n        : undefined;\n    if (fields === undefined)\n      fail(\"Unknown movement instruction; M0 and raw are not authored commands.\", location);\n    keys(command, [\"kind\", \"savedShape\", ...fields], location);\n    if (fields.some((field) => command[field] === undefined))\n      fail(\"Movement instruction is missing a required field.\", location);\n    const domains: Record<string, readonly (readonly [string, number, number])[]> = {\n      jump: [\n        [\"x\", -99, 99],\n        [\"y\", -99, 99],\n      ],\n      wait: [[\"frames\", 1, 999]],\n      changeSpeed: [[\"speed\", 1, 6]],\n      changeFrequency: [[\"frequency\", 1, 5]],\n      changeImage: [[\"characterIndex\", 0, 7]],\n      changeOpacity: [[\"opacity\", 0, 255]],\n    };\n    for (const [field, minimum, maximum] of domains[command.kind as string] ?? [])\n      integer(command[field], minimum, maximum, at(location, `.${field}`));\n    if (\n      command.kind === \"changeBlendMode\" &&\n      ![\"normal\", \"additive\", \"multiply\", \"screen\"].includes(command.blendMode as string)\n    )\n      fail(\n        \"Movement blend mode requires an explicit symbol.\",\n        {\n          ...at(location, \".blendMode\"),\n          expected: \"normal/additive/multiply/screen\",\n          actual: describeValue(command.blendMode),\n        },\n        \"MV-MOVEMENT-PARAMETER\",\n      );\n    if (\n      [\"walkAnimation\", \"stepAnimation\", \"directionFix\", \"through\", \"transparent\"].includes(\n        command.kind as string,\n      ) &&\n      typeof command.enabled !== \"boolean\"\n    )\n      fail(\"Movement state flags require an explicit boolean.\", at(location, \".enabled\"));\n    if (command.kind === \"changeImage\")\n      asset(command.character, \"image\", \"characters\", at(location, \".character\"));\n    if (command.kind === \"switchOn\" || command.kind === \"switchOff\") {\n      const referenceLocation = at(location, \".switch\");\n      const reference = record(command.switch, referenceLocation);\n      const byId = Object.hasOwn(reference, \"id\");\n      keys(reference, byId ? [\"kind\", \"id\"] : [\"kind\", \"name\"], referenceLocation);\n      if (\n        reference.kind !== \"switch\" ||\n        (byId\n          ? typeof reference.id !== \"number\"\n          : typeof reference.name !== \"string\" || reference.name.length === 0)\n      )\n        fail(\n          \"Movement switch requires exactly one switch ID or name reference.\",\n          referenceLocation,\n        );\n    }\n    if (command.kind === \"playSe\") {\n      const audioLocation = at(location, \".audio\");\n      const audio = record(command.audio, audioLocation);\n      keys(audio, [\"asset\", \"volume\", \"pitch\", \"pan\"], audioLocation);\n      if (\n        [\"asset\", \"volume\", \"pitch\", \"pan\"].some(\n          (field) => !Object.hasOwn(audio, field) || audio[field] === undefined,\n        )\n      )\n        fail(\"Movement SE requires asset, volume, pitch and pan.\", audioLocation);\n      asset(audio.asset, \"audio\", \"se\", at(audioLocation, \".asset\"));\n      integer(audio.volume, 0, 100, at(audioLocation, \".volume\"));\n      integer(audio.pitch, 50, 150, at(audioLocation, \".pitch\"));\n      integer(audio.pan, -100, 100, at(audioLocation, \".pan\"));\n    }\n    if (command.kind === \"script\") {\n      const scriptLocation = at(location, \".script\");\n      const script = record(command.script, scriptLocation);\n      keys(script, [\"kind\", \"code\"], scriptLocation);\n      if (script.kind !== \"scriptInput\" || typeof script.code !== \"string\")\n        fail(\"Movement Script requires Script Input with its complete string.\", scriptLocation);\n    }\n    if (command.savedShape !== undefined) {\n      const shape = record(command.savedShape, location);\n      keys(shape, [\"indent\"], location);\n      if (\n        shape.indent !== undefined &&\n        ![\"absent\", \"null\", \"zero\"].includes(shape.indent as string)\n      )\n        fail(\"savedShape.indent must be absent, null or zero symbols.\", {\n          dslPath: `${location.dslPath}.savedShape.indent`,\n        });\n    }\n  }\n}\n\nexport function assertSetMovementRoute(node: SetMovementRouteDslCommand, path: string): void {\n  keys(node as unknown as Record<string, unknown>, [\"kind\", \"target\", \"route\"], { dslPath: path });\n  assertMovementRoute(node.route, `${path}.route`);\n}\n\nexport function validateNativeMovementRouteInputs(\n  value: unknown,\n  resolver: ReferenceResolver,\n  options: { scriptEnabled: boolean; identity?: string; dslPath?: string; nativePath: string },\n  issues: ValidationIssue[],\n): void {\n  assertNativeMovementRoute(value, options.nativePath);\n  for (const [index, command] of value.list.entries()) {\n    const nativePath = `${options.nativePath}.list[${index}]`;\n    const issue = (code: string, message: string) =>\n      issues.push({\n        level: \"error\",\n        code,\n        stage: \"compile\",\n        ...(options.identity === undefined ? {} : { identity: options.identity }),\n        ...(options.dslPath === undefined ? {} : { dslPath: options.dslPath }),\n        nativePath,\n        message,\n        expected: command.code === 45 ? \"scriptEnabled: true\" : \"existing switch ID\",\n        actual:\n          command.code === 45 ? \"scriptEnabled: false\" : describeValue(command.parameters?.[0]),\n      });\n    if (command.code === 45 && !options.scriptEnabled)\n      issue(\"MV-MOVEMENT-SCRIPT\", \"Movement Route Script requires explicit config enablement.\");\n    if (command.code === 27 || command.code === 28) {\n      try {\n        resolver.resolveReference({ kind: \"switch\", id: command.parameters![0] as number });\n      } catch (error) {\n        issue(\"MV-MOVEMENT-REFERENCE\", error instanceof Error ? error.message : String(error));\n      }\n    }\n  }\n}\n","import type { ReferenceResolver } from \"../../validation/types.js\";\n\nexport function assertNativeSwitchCommand(\n  code: number,\n  parameters: readonly unknown[],\n  resolver?: ReferenceResolver,\n): void {\n  if (code !== 121 && code !== 123) return;\n  const label = `MV-E${code}`;\n  if (!Array.isArray(parameters) || parameters.length !== (code === 121 ? 3 : 2)) {\n    throw new Error(\n      `${label}-PARAMETERS parameters: expected exactly ${code === 121 ? 3 : 2} saved slots; received ${JSON.stringify(parameters)}.`,\n    );\n  }\n  const operation = parameters[code === 121 ? 2 : 1];\n  if (operation !== 0 && operation !== 1) {\n    throw new Error(\n      `${label}-VALUE parameters[${code === 121 ? 2 : 1}]: expected native ON 0 or OFF 1; received ${JSON.stringify(operation)}.`,\n    );\n  }\n  if (code === 123) {\n    if (![\"A\", \"B\", \"C\", \"D\"].includes(parameters[0] as string)) {\n      throw new Error(\n        `${label}-LETTER parameters[0]: expected A, B, C or D; received ${JSON.stringify(parameters[0])}.`,\n      );\n    }\n    return;\n  }\n  const [from, to] = parameters;\n  if (\n    !Number.isSafeInteger(from) ||\n    (from as number) <= 0 ||\n    !Number.isSafeInteger(to) ||\n    (to as number) <= 0\n  ) {\n    throw new Error(\n      `${label}-TARGET parameters[0..1]: expected positive integer switch IDs; received ${JSON.stringify(parameters.slice(0, 2))}.`,\n    );\n  }\n  if ((from as number) > (to as number)) {\n    throw new Error(\n      `${label}-RANGE parameters[0..1]: range start ${from} exceeds end ${to}; ranges are not reordered.`,\n    );\n  }\n  if (resolver !== undefined) {\n    for (const [index, id] of [from, to].entries()) {\n      try {\n        resolver.resolveReference({ kind: \"switch\", id: id as number });\n      } catch (error) {\n        throw new Error(\n          `${label}-REFERENCE parameters[${index}]: ${error instanceof Error ? error.message : String(error)}`,\n        );\n      }\n    }\n  }\n}\n","import { CommandStructureError } from \"../../validation/command-errors.js\";\nimport { renderJsonValue } from \"../../project-data/json-values.js\";\n\nexport function assertNativeMapAppearanceParameters(\n  code: number,\n  parameters: readonly unknown[],\n  path: string,\n): void {\n  if (code < 281 || code > 284) return;\n  const fail = (suffix: string, expected: string, actual: unknown): never => {\n    throw new CommandStructureError(\n      `MV-E${code}-PARAMETERS`,\n      \"Invalid saved map appearance parameter.\",\n      {\n        nativePath: `${path}.parameters${suffix}`,\n        expected,\n        actual: renderJsonValue(actual),\n      },\n    );\n  };\n  const length = code === 283 ? 2 : code === 284 ? 5 : 1;\n  if (parameters.length !== length) fail(\"\", `exactly ${length} saved slots`, parameters);\n  const slot = (index: number, valid: boolean, expected: string) => {\n    if (!valid) fail(`[${index}]`, expected, parameters[index]);\n  };\n  if (code === 281)\n    slot(\n      0,\n      (parameters[0] === 0 || parameters[0] === 1) && !Object.is(parameters[0], -0),\n      \"native enabled 0 or disabled 1\",\n    );\n  if (code === 282)\n    slot(\n      0,\n      Number.isSafeInteger(parameters[0]) && (parameters[0] as number) > 0,\n      \"positive actual tileset ID; no None\",\n    );\n  if (code === 283)\n    for (const index of [0, 1])\n      slot(\n        index,\n        typeof parameters[index] === \"string\",\n        \"image filename string or empty string None\",\n      );\n  if (code === 284) {\n    slot(0, typeof parameters[0] === \"string\", \"parallax filename string or empty string None\");\n    for (const index of [1, 2]) slot(index, typeof parameters[index] === \"boolean\", \"boolean\");\n    for (const index of [3, 4])\n      slot(\n        index,\n        Number.isSafeInteger(parameters[index]) &&\n          (parameters[index] as number) >= -32 &&\n          (parameters[index] as number) <= 32,\n        \"integer -32..32\",\n      );\n  }\n}\n","import { CommandStructureError } from \"./command-errors.js\";\nimport { renderJsonValue } from \"../project-data/json-values.js\";\nimport { assertNativeSwitchCommand } from \"../commands/variables/validation.js\";\nimport { assertNativeMapAppearanceParameters } from \"../commands/map/native-validation.js\";\n\n// Shared saved-slot envelopes. Family validators retain ownership of semantic ranges,\n// references and mode-specific saved values; this table is not full family acceptance.\nconst signatures: Record<number, string> = {\n  0: \"\",\n  101: \"snnn\",\n  102: \"annnn\",\n  103: \"nn\",\n  104: \"nn\",\n  105: \"nb\",\n  108: \"s\",\n  111: \"\",\n  112: \"\",\n  113: \"\",\n  115: \"\",\n  117: \"n\",\n  118: \"s\",\n  119: \"s\",\n  121: \"nnn\",\n  122: \"\",\n  123: \"sn\",\n  124: \"\",\n  125: \"nnn\",\n  126: \"nnnn\",\n  127: \"nnnnb\",\n  128: \"nnnnb\",\n  129: \"nnb\",\n  132: \"o\",\n  133: \"o\",\n  134: \"n\",\n  135: \"n\",\n  136: \"n\",\n  137: \"n\",\n  138: \"a\",\n  139: \"o\",\n  140: \"no\",\n  201: \"nnnnnn\",\n  202: \"nnnnn\",\n  203: \"nnnnn\",\n  204: \"nnn\",\n  205: \"no\",\n  206: \"\",\n  211: \"n\",\n  212: \"nnb\",\n  213: \"nnb\",\n  214: \"\",\n  216: \"n\",\n  217: \"\",\n  221: \"\",\n  222: \"\",\n  223: \"anb\",\n  224: \"anb\",\n  225: \"nnnb\",\n  230: \"n\",\n  231: \"nsnnnnnnnn\",\n  232: \"nnnnnnnnnnnb\",\n  233: \"nn\",\n  234: \"nanb\",\n  235: \"n\",\n  236: \"snnb\",\n  241: \"o\",\n  242: \"n\",\n  243: \"\",\n  244: \"\",\n  245: \"o\",\n  246: \"n\",\n  249: \"o\",\n  250: \"o\",\n  251: \"\",\n  261: \"s\",\n  281: \"n\",\n  282: \"n\",\n  283: \"ss\",\n  284: \"sbbnn\",\n  285: \"nnnnn\",\n  301: \"nnbb\",\n  302: \"nnnnb\",\n  303: \"nn\",\n  311: \"nnnnnb\",\n  312: \"nnnnn\",\n  313: \"nnnn\",\n  314: \"nn\",\n  315: \"nnnnnb\",\n  316: \"nnnnnb\",\n  317: \"nnnnnn\",\n  318: \"nnnn\",\n  319: \"nnn\",\n  320: \"ns\",\n  321: \"nnb\",\n  322: \"nsnsns\",\n  323: \"nsn\",\n  324: \"ns\",\n  325: \"ns\",\n  326: \"nnnnn\",\n  331: \"nnnnb\",\n  332: \"nnnn\",\n  333: \"nnn\",\n  334: \"n\",\n  335: \"n\",\n  336: \"nn\",\n  337: \"nnb\",\n  339: \"nnnn\",\n  340: \"\",\n  342: \"nnnn\",\n  351: \"\",\n  352: \"\",\n  353: \"\",\n  354: \"\",\n  355: \"s\",\n  356: \"s\",\n  401: \"s\",\n  402: \"ns\",\n  403: \"\",\n  404: \"\",\n  405: \"s\",\n  408: \"s\",\n  411: \"\",\n  412: \"\",\n  413: \"\",\n  505: \"o\",\n  601: \"\",\n  602: \"\",\n  603: \"\",\n  604: \"\",\n  605: \"nnnn\",\n  655: \"s\",\n};\n\nexport function isKnownCommandCode(code: number): boolean {\n  return Object.hasOwn(signatures, code);\n}\n\nexport function assertNativeCommandParameters(\n  code: number,\n  parameters: readonly unknown[],\n  path: string,\n): void {\n  if (!isKnownCommandCode(code)) return;\n  assertNativeMapAppearanceParameters(code, parameters, path);\n  try {\n    assertNativeSwitchCommand(code, parameters);\n  } catch (error) {\n    const detail = error instanceof Error ? error.message : String(error);\n    throw new CommandStructureError(\n      /^MV-[\\w-]+/u.exec(detail)?.[0] ?? \"MV-COMMAND-PARAMETERS\",\n      detail,\n      {\n        nativePath: `${path}.${/parameters(?:\\[[\\d.]+\\])?/u.exec(detail)?.[0] ?? \"parameters\"}`,\n        expected: `valid E${code} switch parameters`,\n        actual: renderJsonValue(parameters),\n      },\n    );\n  }\n  let signature = signatures[code]!;\n  if (code === 111) {\n    const mode = parameters[0];\n    signature =\n      typeof mode === \"number\"\n        ? ((\n            {\n              0: \"nnn\",\n              1: \"nnnnn\",\n              2: \"nsn\",\n              3: \"nnn\",\n              4: parameters[2] === 0 ? \"nnn\" : \"nnnx\",\n              5: parameters[2] === 0 ? \"nnn\" : \"nnnn\",\n              6: \"nnn\",\n              7: \"nnn\",\n              8: \"nn\",\n              9: \"nnb\",\n              10: \"nnb\",\n              11: \"ns\",\n              12: \"ns\",\n              13: \"nn\",\n            } as Record<number, string>\n          )[mode] ?? \"?\")\n        : \"?\";\n  }\n  if (code === 122)\n    signature =\n      ({ 0: \"nnnnn\", 1: \"nnnnn\", 2: \"nnnnnn\", 3: \"nnnnnnn\", 4: \"nnnns\" } as Record<number, string>)[\n        parameters[3] as number\n      ] ?? \"?\";\n  if (code === 124) signature = parameters[0] === 1 && parameters.length === 1 ? \"n\" : \"nn\";\n  const matches = (value: unknown, kind: string) =>\n    kind === \"x\" ||\n    (kind === \"n\"\n      ? typeof value === \"number\"\n      : kind === \"s\"\n        ? typeof value === \"string\"\n        : kind === \"b\"\n          ? typeof value === \"boolean\"\n          : kind === \"a\"\n            ? Array.isArray(value)\n            : kind === \"o\"\n              ? typeof value === \"object\" && value !== null && !Array.isArray(value)\n              : false);\n  if (\n    parameters.length !== signature.length ||\n    ![...signature].every((kind, index) => matches(parameters[index], kind))\n  )\n    throw new CommandStructureError(\n      \"MV-COMMAND-PARAMETERS\",\n      \"Known command parameters do not match their native contract.\",\n      {\n        nativePath: `${path}.parameters`,\n        expected: `E${code} saved slots ${signature || \"[]\"}`,\n        actual: renderJsonValue(parameters),\n      },\n    );\n  const slot = (index: number, valid: boolean, expected: string): void => {\n    if (!valid)\n      throw new CommandStructureError(\"MV-COMMAND-PARAMETERS\", \"Invalid known saved parameter.\", {\n        nativePath: `${path}.parameters[${index}]`,\n        expected,\n        actual: renderJsonValue(parameters[index]),\n      });\n  };\n  const oneOf = (index: number, values: readonly unknown[]) =>\n    slot(\n      index,\n      values.includes(parameters[index]) && !Object.is(parameters[index], -0),\n      `one of ${renderJsonValue(values)}`,\n    );\n  const integer = (index: number, minimum: number, maximum = Number.MAX_SAFE_INTEGER) =>\n    slot(\n      index,\n      Number.isSafeInteger(parameters[index]) &&\n        !Object.is(parameters[index], -0) &&\n        (parameters[index] as number) >= minimum &&\n        (parameters[index] as number) <= maximum,\n      `integer ${minimum}..${maximum}, excluding negative zero`,\n    );\n  if (code === 101 || code === 322) integer(code === 101 ? 1 : 4, 0);\n  if (code === 101) {\n    oneOf(2, [0, 1, 2]);\n    oneOf(3, [0, 1, 2]);\n  }\n  if (code === 102) {\n    slot(\n      0,\n      (parameters[0] as unknown[]).every((value) => typeof value === \"string\") &&\n        (parameters[0] as unknown[]).length > 0,\n      \"nonempty string choices\",\n    );\n    oneOf(3, [0, 1, 2]);\n    oneOf(4, [0, 1, 2]);\n  }\n  if (code === 111) {\n    const mode = parameters[0];\n    if (mode === 0 || mode === 2 || mode === 3) oneOf(2, [0, 1]);\n    if (mode === 1) {\n      oneOf(2, [0, 1]);\n      oneOf(4, [0, 1, 2, 3, 4, 5]);\n    }\n    if (mode === 2) oneOf(1, [\"A\", \"B\", \"C\", \"D\"]);\n    if (mode === 4) {\n      oneOf(2, [0, 1, 2, 3, 4, 5, 6]);\n      if (parameters[2] === 1) slot(3, typeof parameters[3] === \"string\", \"actor name string\");\n    }\n    if (mode === 5) oneOf(2, [0, 1]);\n    if (mode === 6) oneOf(2, [2, 4, 6, 8]);\n    if (mode === 7) oneOf(2, [0, 1, 2]);\n    if (mode === 13) oneOf(1, [0, 1, 2]);\n  }\n  if (code === 122) {\n    oneOf(2, [0, 1, 2, 3, 4, 5]);\n    if (parameters[3] === 3) oneOf(4, [0, 1, 2, 3, 4, 5, 6, 7]);\n  }\n  if (code === 124) oneOf(0, [0, 1]);\n  if (code === 402) integer(0, 0);\n  if (code === 232) oneOf(1, [0]);\n  if (code === 302 || code === 605) {\n    oneOf(0, [0, 1, 2]);\n    oneOf(2, [0, 1]);\n    if (parameters[2] === 0) oneOf(3, [0]);\n  }\n  if (code === 201) {\n    oneOf(0, [0, 1]);\n    if (parameters[0] === 0) {\n      integer(2, 0);\n      integer(3, 0);\n    }\n    oneOf(4, [0, 2, 4, 6, 8]);\n    oneOf(5, [0, 1, 2]);\n  }\n  if (code === 202) {\n    oneOf(0, [0, 1, 2]);\n    oneOf(1, [0, 1]);\n    if (parameters[1] === 0) {\n      integer(3, 0);\n      integer(4, 0);\n    }\n  }\n  if (code === 203) {\n    oneOf(1, [0, 1, 2]);\n    if (parameters[1] === 0) {\n      integer(2, 0);\n      integer(3, 0);\n    }\n    oneOf(4, [0, 2, 4, 6, 8]);\n  }\n  if ([132, 133, 139, 140, 241, 245, 249, 250].includes(code)) {\n    const index = code === 140 ? 1 : 0;\n    const audio = parameters[index] as Record<string, unknown>;\n    slot(\n      index,\n      Object.keys(audio).length === 4 &&\n        [\"name\", \"volume\", \"pitch\", \"pan\"].every((key) => Object.hasOwn(audio, key)) &&\n        typeof audio.name === \"string\" &&\n        [audio.volume, audio.pitch, audio.pan].every((value) => typeof value === \"number\"),\n      \"complete audio object with name, volume, pitch and pan only\",\n    );\n  }\n  for (const [event, index] of [\n    [138, 0],\n    [223, 0],\n    [224, 0],\n    [234, 1],\n  ] as const)\n    if (code === event)\n      slot(\n        index,\n        (parameters[index] as unknown[]).length === 4 &&\n          (parameters[index] as unknown[]).every((value) => typeof value === \"number\"),\n        \"exactly four numeric saved color/tone components\",\n      );\n}\n","import type { RawEventCommand } from \"../compiler/types.js\";\nimport { assertNativeMovementCommands } from \"../commands/movement/validation.js\";\nimport { CommandStructureError } from \"./command-errors.js\";\nimport { assertStrictJson, describeValue, StrictJsonError } from \"../project-data/json-values.js\";\nimport { assertNativeCommandParameters } from \"./native-parameters.js\";\nimport { renderJsonValue } from \"../project-data/json-values.js\";\nexport { CommandStructureError } from \"./command-errors.js\";\n\nexport function assertNativeCommandEnvelope(\n  value: unknown,\n  index: number,\n): asserts value is RawEventCommand {\n  const fail = (\n    message: string,\n    field?: string,\n    expected = \"native command with exactly code, indent and parameters\",\n  ): never => {\n    throw new CommandStructureError(\"MV-COMMAND-ENVELOPE\", message, {\n      nativePath: `list[${index}]${field ? `.${field}` : \"\"}`,\n      expected,\n      actual:\n        field && typeof value === \"object\" && value !== null\n          ? Object.hasOwn(value, field)\n            ? describeValue(Object.getOwnPropertyDescriptor(value, field)?.value)\n            : \"missing\"\n          : describeValue(value),\n    });\n  };\n  if (typeof value !== \"object\" || value === null || Array.isArray(value))\n    fail(\"Expected a native command object.\");\n  const command = value as Record<string, unknown>;\n  for (const key of [\"code\", \"indent\", \"parameters\"]) {\n    const descriptor = Object.getOwnPropertyDescriptor(command, key);\n    if (!descriptor || (\"value\" in descriptor && descriptor.value === undefined))\n      fail(\n        \"A required command field is missing or undefined.\",\n        key,\n        \"present native field with a defined value\",\n      );\n  }\n  try {\n    assertStrictJson(command, `list[${index}]`);\n  } catch (error) {\n    if (error instanceof StrictJsonError)\n      throw new CommandStructureError(\"MV-STRICT-JSON\", error.message, {\n        nativePath: error.path,\n        expected: \"strict representable JSON\",\n        actual: error.actual,\n      });\n    throw error;\n  }\n  if (Object.keys(command).some((key) => ![\"code\", \"indent\", \"parameters\"].includes(key)))\n    fail(\"Unknown command field.\");\n  for (const key of [\"code\", \"indent\"]) {\n    if (\n      !Object.hasOwn(command, key) ||\n      !Number.isSafeInteger(command[key]) ||\n      (command[key] as number) < 0 ||\n      Object.is(command[key], -0)\n    )\n      fail(\n        `${key} must be a nonnegative safe integer.`,\n        key,\n        \"nonnegative safe integer, excluding negative zero\",\n      );\n  }\n  if (!Object.hasOwn(command, \"parameters\") || !Array.isArray(command.parameters))\n    fail(\n      \"parameters must be an array and cannot be missing.\",\n      \"parameters\",\n      \"dense parameter array\",\n    );\n  try {\n    assertStrictJson(command.parameters, `list[${index}].parameters`);\n  } catch (error) {\n    if (error instanceof StrictJsonError)\n      throw new CommandStructureError(\"MV-STRICT-JSON\", error.message, {\n        nativePath: error.path,\n        expected: \"strict representable JSON\",\n        actual: error.actual,\n      });\n    throw error;\n  }\n  if (command.code !== 505)\n    assertNativeCommandParameters(\n      command.code as number,\n      command.parameters as unknown[],\n      `list[${index}]`,\n    );\n}\n\nexport function inspectCommandListStructure(\n  commands: readonly RawEventCommand[],\n  options: { requireTerminator?: boolean; baseIndent?: number } = {},\n): { breaksOutsideLoops: number[] } {\n  const fail = (index: number, message: string, code = \"MV-COMMAND-STRUCTURE\"): never => {\n    throw new CommandStructureError(code, message, {\n      nativePath: `list[${index}]`,\n      expected: message,\n      actual: index < commands.length ? describeValue(commands[index]) : \"missing\",\n    });\n  };\n  if (!Array.isArray(commands) || Object.getPrototypeOf(commands) !== Array.prototype)\n    throw new CommandStructureError(\n      \"MV-COMMAND-ENVELOPE\",\n      \"A native list must be a dense command array.\",\n      { nativePath: \"list\", expected: \"dense command array\", actual: describeValue(commands) },\n    );\n  for (const key of Reflect.ownKeys(commands))\n    if (\n      key !== \"length\" &&\n      (typeof key !== \"string\" || !/^(0|[1-9]\\d*)$/.test(key) || Number(key) >= commands.length)\n    )\n      fail(0, \"A native list cannot have extra array properties.\", \"MV-COMMAND-ENVELOPE\");\n  for (let index = 0; index < commands.length; index += 1) {\n    assertNativeCommandEnvelope(commands[index], index);\n    if (\n      [0, 112, 113, 115, 413].includes(commands[index]!.code) &&\n      commands[index]!.parameters.length !== 0\n    ) {\n      fail(\n        index,\n        \"This known structural/flow command requires exactly zero parameters.\",\n        \"MV-COMMAND-PARAMETERS\",\n      );\n    }\n  }\n  assertNativeMovementCommands(commands);\n  const breaksOutsideLoops: number[] = [];\n  const continuationParents = new Map([\n    [401, [101, 401]],\n    [405, [105, 405]],\n    [408, [108, 408]],\n    [655, [355, 655]],\n    [505, [205, 505]],\n    [605, [302, 605]],\n  ]);\n  const branchCodes = [411, 412, 413, 402, 403, 404, 601, 602, 603, 604];\n  type Boundary = { indent: number; codes: readonly number[] };\n  const isBoundary = (index: number, boundary: Boundary | undefined): boolean =>\n    boundary !== undefined &&\n    commands[index]?.indent === boundary.indent &&\n    boundary.codes.includes(commands[index]!.code);\n  const sequence = (\n    start: number,\n    indent: number,\n    boundary: Boundary | undefined,\n    loopDepth: number,\n  ): { index: number; marker: boolean; content: boolean } => {\n    let index = start;\n    let content = false;\n    while (index < commands.length && !isBoundary(index, boundary)) {\n      const command = commands[index]!;\n      if (command.indent !== indent)\n        fail(index, `Expected indentation ${indent}, found ${command.indent}.`);\n      if (command.code === 0) {\n        if (\n          boundary === undefined ? index !== commands.length - 1 : !isBoundary(index + 1, boundary)\n        ) {\n          fail(\n            index,\n            \"A Body End Marker must be the sole trailing marker of its own body; the event terminator must be last.\",\n          );\n        }\n        return { index: index + 1, marker: true, content };\n      }\n      if (branchCodes.includes(command.code)) fail(index, \"Orphan branch or closing record.\");\n      const allowedPredecessors = continuationParents.get(command.code);\n      if (\n        allowedPredecessors &&\n        (commands[index - 1]?.indent !== indent ||\n          !allowedPredecessors.includes(commands[index - 1]!.code))\n      ) {\n        fail(index, \"Orphan continuation record.\");\n      }\n      if (command.code === 113 && loopDepth === 0) breaksOutsideLoops.push(index);\n      content = true;\n      if (command.code === 112) {\n        const parentIndent = command.indent;\n        const body = sequence(\n          index + 1,\n          parentIndent + 1,\n          { indent: parentIndent, codes: [413] },\n          loopDepth + 1,\n        );\n        if (!isBoundary(body.index, { indent: parentIndent, codes: [413] }))\n          fail(body.index, \"Loop has no matching 413.\");\n        if (!body.content && !body.marker)\n          fail(body.index, \"Empty Loop requires a Body End Marker.\", \"MV-CHILD-BODY\");\n        index = body.index + 1;\n        continue;\n      }\n      if (command.code === 111) {\n        const thenBody = sequence(index + 1, indent + 1, { indent, codes: [411, 412] }, loopDepth);\n        if (!thenBody.content && !thenBody.marker)\n          fail(\n            thenBody.index,\n            \"An empty Conditional body requires a Body End Marker.\",\n            \"MV-CHILD-BODY\",\n          );\n        let end = thenBody.index;\n        if (commands[end]?.code === 411 && commands[end]?.indent === indent) {\n          const elseBody = sequence(end + 1, indent + 1, { indent, codes: [412] }, loopDepth);\n          if (!elseBody.content && !elseBody.marker)\n            fail(elseBody.index, \"An empty Else body requires a Body End Marker.\", \"MV-CHILD-BODY\");\n          end = elseBody.index;\n        }\n        if (!isBoundary(end, { indent, codes: [412] }))\n          fail(end, \"Conditional has no matching412.\");\n        index = end + 1;\n        continue;\n      }\n      const choices = command.code === 102;\n      const battle =\n        command.code === 301 &&\n        commands[index + 1]?.indent === indent &&\n        [601, 602, 603, 604].includes(commands[index + 1]!.code);\n      if (choices || battle) {\n        const branches = choices ? [402, 403] : [601, 602, 603];\n        const close = choices ? 404 : 604;\n        let end = index + 1;\n        let choiceIndex = 0;\n        let cancelSeen = false;\n        const seen = new Set<number>();\n        while (isBoundary(end, { indent, codes: branches })) {\n          const branch = commands[end]!;\n          if (seen.has(branch.code) && branch.code !== 402)\n            fail(end, \"Duplicate parent-owned branch.\");\n          seen.add(branch.code);\n          if (choices && branch.code === 402) {\n            const texts = command.parameters[0] as unknown[];\n            const expected = [choiceIndex, texts[choiceIndex]];\n            if (\n              cancelSeen ||\n              choiceIndex >= texts.length ||\n              branch.parameters[0] !== choiceIndex ||\n              branch.parameters[1] !== texts[choiceIndex]\n            )\n              throw new CommandStructureError(\n                \"MV-CHOICE-MIRROR\",\n                \"Choice branches must mirror every parent choice exactly once in saved order.\",\n                {\n                  nativePath: `list[${end}].parameters`,\n                  expected:\n                    choiceIndex < texts.length\n                      ? renderJsonValue(expected)\n                      : \"no additional choice branch\",\n                  actual: renderJsonValue(branch.parameters),\n                  relatedLocations: [\n                    {\n                      nativePath: `list[${index}].parameters[0][${choiceIndex}]`,\n                      value:\n                        choiceIndex < texts.length\n                          ? renderJsonValue(texts[choiceIndex])\n                          : \"missing\",\n                    },\n                  ],\n                },\n              );\n            choiceIndex += 1;\n          }\n          if (choices && branch.code === 403) cancelSeen = true;\n          const body = sequence(\n            end + 1,\n            indent + 1,\n            { indent, codes: [...branches, close] },\n            loopDepth,\n          );\n          if (!body.content && !body.marker)\n            fail(body.index, \"An empty branch requires a Body End Marker.\", \"MV-CHILD-BODY\");\n          end = body.index;\n        }\n        if (choices && choiceIndex !== (command.parameters[0] as unknown[]).length)\n          throw new CommandStructureError(\n            \"MV-CHOICE-MIRROR\",\n            \"A saved choice has no matching 402 branch.\",\n            {\n              nativePath: `list[${end}]`,\n              expected: `402 branch for choice ${choiceIndex}`,\n              actual: commands[end] ? renderJsonValue(commands[end]) : \"missing\",\n              relatedLocations: [\n                {\n                  nativePath: `list[${index}].parameters[0][${choiceIndex}]`,\n                  value: renderJsonValue((command.parameters[0] as unknown[])[choiceIndex]),\n                },\n              ],\n            },\n          );\n        if (!isBoundary(end, { indent, codes: [close] }))\n          fail(end, `Parent has no matching${close}.`);\n        index = end + 1;\n        continue;\n      }\n      index += 1;\n    }\n    return { index, marker: false, content };\n  };\n  const result = sequence(0, options.baseIndent ?? 0, undefined, 0);\n  if (options.requireTerminator && !result.marker)\n    fail(\n      commands.length,\n      \"Event command list requires its final code0/indent0/parameters[] terminator.\",\n    );\n  return { breaksOutsideLoops };\n}\n","import type { DslCommand } from \"../domain/types.js\";\nimport { describeValue } from \"../project-data/json-values.js\";\nimport { CommandStructureError } from \"./command-errors.js\";\nimport { assertNativeCommandEnvelope } from \"./command-structure.js\";\n\nexport function assertDslObject(\n  value: unknown,\n  allowed: readonly string[] | undefined,\n  path: string,\n): asserts value is Record<string, unknown> {\n  const fail = (actual: string): never => {\n    throw new CommandStructureError(\n      \"MV-DSL-SHAPE\",\n      \"Expected a plain authored command with only supported own data fields.\",\n      { dslPath: path, expected: allowed?.join(\", \") ?? \"plain command object\", actual },\n    );\n  };\n  if (\n    typeof value !== \"object\" ||\n    value === null ||\n    Array.isArray(value) ||\n    ![Object.prototype, null].includes(Object.getPrototypeOf(value))\n  )\n    fail(describeValue(value));\n  for (const key of Reflect.ownKeys(value as object)) {\n    const descriptor = Object.getOwnPropertyDescriptor(value, key)!;\n    if (\n      typeof key !== \"string\" ||\n      (allowed && !allowed.includes(key)) ||\n      !(\"value\" in descriptor) ||\n      !descriptor.enumerable\n    )\n      fail(`unsupported field ${String(key)}`);\n  }\n}\n\nexport function assertRawDslInput(\n  value: unknown,\n  path: string,\n  indent = 0,\n  withKind = false,\n  checkParameters = true,\n): void {\n  assertDslObject(\n    value,\n    withKind ? [\"kind\", \"code\", \"indent\", \"parameters\"] : [\"code\", \"indent\", \"parameters\"],\n    path,\n  );\n  if (!checkParameters) return;\n  try {\n    assertNativeCommandEnvelope(\n      {\n        code: value.code,\n        indent: value.indent === undefined ? indent : value.indent,\n        parameters: value.parameters,\n      },\n      0,\n    );\n  } catch (error) {\n    if (error instanceof CommandStructureError) {\n      const { nativePath: _nativePath, ...location } = error.location;\n      throw new CommandStructureError(error.code, error.detail, {\n        ...location,\n        dslPath:\n          path +\n          (typeof value.code === \"number\" && value.code >= 281 && value.code <= 284\n            ? (error.location.nativePath?.replace(/^list\\[\\d+\\]/u, \"\") ?? \"\")\n            : \"\"),\n      });\n    }\n    throw error;\n  }\n}\n\nexport function assertDslCommandList(\n  value: unknown,\n  path: string,\n  validateRaw = true,\n): asserts value is readonly DslCommand[] {\n  const fail = (at: string, actual: string): never => {\n    throw new CommandStructureError(\n      \"MV-DSL-SHAPE\",\n      \"Commands must be a dense array of authored command objects.\",\n      { dslPath: at, expected: \"dense command array\", actual },\n    );\n  };\n  if (!Array.isArray(value) || Object.getPrototypeOf(value) !== Array.prototype)\n    fail(path, describeValue(value));\n  const values = value as unknown[];\n  for (const key of Reflect.ownKeys(values))\n    if (\n      key !== \"length\" &&\n      (typeof key !== \"string\" || !/^(0|[1-9]\\d*)$/.test(key) || Number(key) >= values.length)\n    )\n      fail(path, `extra array field ${String(key)}`);\n  for (let index = 0; index < values.length; index++) {\n    const at = `${path}[${index}]`;\n    const descriptor = Object.getOwnPropertyDescriptor(values, String(index));\n    if (!descriptor || !(\"value\" in descriptor) || !descriptor.enumerable)\n      fail(at, \"missing or non-data command slot\");\n    const node = descriptor!.value;\n    assertDslObject(node, undefined, at);\n    if (!Object.hasOwn(node, \"kind\") || typeof node.kind !== \"string\")\n      fail(at, \"missing command kind\");\n    if (node.kind === \"rawDslCommand\") assertRawDslInput(node, at, 0, true, validateRaw);\n  }\n}\n","import type { CommonEventDefinition } from \"../domain/types.js\";\nimport { describeValue } from \"../project-data/json-values.js\";\nimport { CommandStructureError } from \"./command-errors.js\";\nimport { assertDslCommandList, assertDslObject } from \"./dsl-command-inputs.js\";\n\nexport function assertCommonEventInput(\n  value: unknown,\n  withKind = false,\n): asserts value is CommonEventDefinition {\n  const path = \"commonEvent\";\n  const fail = (field: string, expected: string, actual: unknown): never => {\n    const id =\n      typeof value === \"object\" && value !== null\n        ? Object.getOwnPropertyDescriptor(value, \"id\")\n        : undefined;\n    throw new CommandStructureError(\n      \"MV-COMMON-EVENT\",\n      \"Invalid Common Event definition.\",\n      { dslPath: field, expected, actual: describeValue(actual) },\n      id !== undefined && \"value\" in id && Number.isSafeInteger(id.value)\n        ? `commonEvent:${id.value}`\n        : \"commonEvent\",\n      \"compile\",\n    );\n  };\n  try {\n    assertDslObject(\n      value,\n      [\"id\", \"name\", \"trigger\", \"switch\", \"commands\", ...(withKind ? [\"kind\"] : [])],\n      path,\n    );\n  } catch (error) {\n    fail(\n      path,\n      \"Common Event with only supported own data fields\",\n      error instanceof Error ? error.message : error,\n    );\n  }\n  const input = value as Record<string, unknown>;\n  if (!Number.isSafeInteger(input.id) || (input.id as number) <= 0)\n    fail(`${path}.id`, \"positive safe integer\", input.id);\n  if (typeof input.name !== \"string\") fail(`${path}.name`, \"string\", input.name);\n  if (![\"none\", \"autorun\", \"parallel\"].includes(input.trigger as string))\n    fail(`${path}.trigger`, \"none | autorun | parallel\", input.trigger);\n  if (input.switch === undefined) {\n    if (input.trigger !== \"none\") fail(`${path}.switch`, \"explicit Switch reference\", input.switch);\n  } else {\n    try {\n      assertDslObject(input.switch, [\"kind\", \"id\", \"name\"], `${path}.switch`);\n    } catch (error) {\n      fail(`${path}.switch`, \"Switch reference\", error instanceof Error ? error.message : error);\n    }\n    const ref = input.switch as Record<string, unknown>;\n    if (\n      ref.kind !== \"switch\" ||\n      Object.hasOwn(ref, \"id\") === Object.hasOwn(ref, \"name\") ||\n      (Object.hasOwn(ref, \"id\")\n        ? !Number.isSafeInteger(ref.id) || (ref.id as number) <= 0\n        : typeof ref.name !== \"string\")\n    )\n      fail(\n        `${path}.switch`,\n        \"Switch reference with exactly one positive id or string name\",\n        input.switch,\n      );\n  }\n  try {\n    assertDslCommandList(input.commands, `${path}.commands`, false);\n  } catch (error) {\n    fail(\n      `${path}.commands`,\n      \"dense authored command array\",\n      error instanceof Error ? error.message : error,\n    );\n  }\n}\n","import { isDslOwnedDeclaration, type DslOwnedDeclaration } from \"../domain/declarations.js\";\nimport { assertCommonEventInput } from \"./common-events.js\";\n\nexport function collectDslOwnedDeclarations(\n  moduleExports: Record<string, unknown>,\n): DslOwnedDeclaration[] {\n  const definitions: DslOwnedDeclaration[] = [];\n  for (const [name, value] of Object.entries(moduleExports)) {\n    if (name === \"default\") {\n      throw new Error(\"Default export is not allowed for DSL-owned declarations.\");\n    }\n    if (isDslOwnedDeclaration(value)) {\n      if (value.kind === \"commonEvent\") assertCommonEventInput(value, true);\n      definitions.push(value);\n    }\n  }\n  return definitions;\n}\n","export type ReferenceKind =\n  | \"actor\"\n  | \"animation\"\n  | \"armor\"\n  | \"class\"\n  | \"commonEvent\"\n  | \"enemy\"\n  | \"item\"\n  | \"map\"\n  | \"skill\"\n  | \"state\"\n  | \"switch\"\n  | \"tileset\"\n  | \"troop\"\n  | \"variable\"\n  | \"weapon\";\n\nexport const referenceKinds = [\n  \"actor\",\n  \"animation\",\n  \"armor\",\n  \"class\",\n  \"commonEvent\",\n  \"enemy\",\n  \"item\",\n  \"map\",\n  \"skill\",\n  \"state\",\n  \"switch\",\n  \"tileset\",\n  \"troop\",\n  \"variable\",\n  \"weapon\",\n] as const satisfies readonly ReferenceKind[];\n\nexport const audioAssetFolders = [\"bgm\", \"bgs\", \"me\", \"se\"] as const;\n\nexport const imageAssetFolders = [\n  \"animations\",\n  \"battlebacks1\",\n  \"battlebacks2\",\n  \"characters\",\n  \"enemies\",\n  \"faces\",\n  \"parallaxes\",\n  \"pictures\",\n  \"sv_actors\",\n  \"sv_enemies\",\n  \"system\",\n  \"tilesets\",\n  \"titles1\",\n  \"titles2\",\n] as const;\n\nexport type ReferenceValue<TKind extends ReferenceKind> =\n  | {\n      id: number;\n      kind: TKind;\n    }\n  | {\n      kind: TKind;\n      name: string;\n    };\n\nexport type AudioAssetFolder = (typeof audioAssetFolders)[number];\n\nexport type ImageAssetFolder = (typeof imageAssetFolders)[number];\n\nexport type AudioAssetReference = {\n  kind: \"asset\";\n  category: \"audio\";\n  folder: AudioAssetFolder;\n  name: string;\n};\n\nexport type ImageAssetReference = {\n  kind: \"asset\";\n  category: \"image\";\n  folder: ImageAssetFolder;\n  name: string;\n};\n\nexport type MovieAssetReference = {\n  kind: \"asset\";\n  category: \"movie\";\n  folder: \"movies\";\n  name: string;\n};\n\nexport type AssetReference = AudioAssetReference | ImageAssetReference | MovieAssetReference;\n\nexport type RuntimeSelector<TScope extends string = string, TTarget extends string = string> = {\n  kind: \"runtimeSelector\";\n  scope: TScope;\n  target: TTarget;\n};\n\nexport type ScriptInput = {\n  kind: \"scriptInput\";\n  code: string;\n};\n\nexport type ReferenceRange<TKind extends ReferenceKind> = {\n  kind: \"referenceRange\";\n  from: ReferenceValue<TKind>;\n  to: ReferenceValue<TKind>;\n};\n\nexport type NumericRange = {\n  kind: \"numericRange\";\n  from: number;\n  to: number;\n};\n\nexport type ConstantOperand = {\n  kind: \"constant\";\n  value: number;\n};\n\nexport type VariableOperand = {\n  kind: \"variable\";\n  variable: ReferenceValue<\"variable\">;\n};\n\nexport type RandomOperand = {\n  kind: \"random\";\n  from: number;\n  to: number;\n};\n\nexport type ScriptOperand = {\n  kind: \"script\";\n  script: ScriptInput;\n};\n\nexport type ControlVariablesGameDataOperand =\n  | {\n      kind: \"gameData\";\n      source: \"item\";\n      item: ReferenceValue<\"item\">;\n    }\n  | {\n      kind: \"gameData\";\n      source: \"weapon\";\n      weapon: ReferenceValue<\"weapon\">;\n    }\n  | {\n      kind: \"gameData\";\n      source: \"armor\";\n      armor: ReferenceValue<\"armor\">;\n    }\n  | {\n      kind: \"gameData\";\n      source: \"actor\";\n      actor: ReferenceValue<\"actor\">;\n      value:\n        | \"level\"\n        | \"exp\"\n        | \"hp\"\n        | \"mp\"\n        | \"mhp\"\n        | \"mmp\"\n        | \"atk\"\n        | \"def\"\n        | \"mat\"\n        | \"mdf\"\n        | \"agi\"\n        | \"luk\";\n    }\n  | {\n      kind: \"gameData\";\n      source: \"enemy\";\n      enemyIndex: number;\n      value: \"hp\" | \"mp\" | \"mhp\" | \"mmp\" | \"atk\" | \"def\" | \"mat\" | \"mdf\" | \"agi\" | \"luk\";\n    }\n  | {\n      kind: \"gameData\";\n      source: \"character\";\n      characterId: number;\n      value: \"mapX\" | \"mapY\" | \"direction\" | \"screenX\" | \"screenY\";\n    }\n  | {\n      kind: \"gameData\";\n      source: \"party\";\n      memberIndex: number;\n    }\n  | {\n      kind: \"gameData\";\n      source: \"other\";\n      value:\n        | \"mapId\"\n        | \"partyMembers\"\n        | \"gold\"\n        | \"steps\"\n        | \"playTime\"\n        | \"timer\"\n        | \"saveCount\"\n        | \"battleCount\"\n        | \"winCount\"\n        | \"escapeCount\";\n    };\n\nexport type CommandOperand =\n  | ConstantOperand\n  | VariableOperand\n  | RandomOperand\n  | ControlVariablesGameDataOperand\n  | ScriptOperand;\n\nexport type OperateValueOperand = number | ReferenceValue<\"variable\">;\n\nexport type OperateValueInput = {\n  operation: \"increase\" | \"decrease\";\n  operand: OperateValueOperand;\n};\n\nexport type ActorCommandTarget =\n  | (RuntimeSelector<\"actor\", \"entireParty\"> & {\n      actorId?: never;\n      variable?: never;\n    })\n  | (RuntimeSelector<\"actor\", \"actor\"> & {\n      actorId: number;\n      variable?: never;\n    })\n  | (RuntimeSelector<\"actor\", \"actorFromVariable\"> & {\n      actorId?: never;\n      variable: ReferenceValue<\"variable\">;\n    });\n\nexport type EnemyCommandTarget =\n  | (RuntimeSelector<\"enemy\", \"all\"> & {\n      index?: never;\n    })\n  | (RuntimeSelector<\"enemy\", \"enemy\"> & {\n      index: number;\n    });\n\nexport type BattlerCommandTarget =\n  | (RuntimeSelector<\"battler\", \"enemy\"> & {\n      index: number;\n      actorId?: never;\n    })\n  | (RuntimeSelector<\"battler\", \"actor\"> & {\n      actorId: number;\n      index?: never;\n    });\n\nexport type ActorParameter = \"mhp\" | \"mmp\" | \"atk\" | \"def\" | \"mat\" | \"mdf\" | \"agi\" | \"luk\";\n\nexport type DirectPosition = {\n  kind: \"direct\";\n  x: number;\n  y: number;\n};\n\nexport type VariablePosition = {\n  kind: \"variables\";\n  x: ReferenceValue<\"variable\">;\n  y: ReferenceValue<\"variable\">;\n};\n\nexport type CommandPosition = DirectPosition | VariablePosition;\n\nexport type VehicleTarget = \"boat\" | \"ship\" | \"airship\";\n\nexport type Direction = 2 | 4 | 6 | 8;\n\nexport type CharacterRuntimeSelector =\n  | (RuntimeSelector<\"character\", \"player\"> & {\n      id?: never;\n    })\n  | (RuntimeSelector<\"character\", \"currentEvent\"> & {\n      id?: never;\n    })\n  | (RuntimeSelector<\"character\", \"event\"> & {\n      id: number;\n    });\n\nexport type DirectMapDestination = {\n  kind: \"direct\";\n  map: ReferenceValue<\"map\">;\n  x: number;\n  y: number;\n};\n\nexport type VariableMapDestination = {\n  kind: \"variables\";\n  map: ReferenceValue<\"variable\">;\n  x: ReferenceValue<\"variable\">;\n  y: ReferenceValue<\"variable\">;\n};\n\nexport type MapDestination = DirectMapDestination | VariableMapDestination;\n\nexport type DirectEventLocationDestination = {\n  kind: \"direct\";\n  x: number;\n  y: number;\n};\n\nexport type VariableEventLocationDestination = {\n  kind: \"variables\";\n  x: ReferenceValue<\"variable\">;\n  y: ReferenceValue<\"variable\">;\n};\n\nexport type ExchangeEventLocationDestination = {\n  kind: \"exchange\";\n  character: CharacterRuntimeSelector;\n};\n\nexport type EventLocationDestination =\n  | DirectEventLocationDestination\n  | VariableEventLocationDestination\n  | ExchangeEventLocationDestination;\n\nexport type ToneInput =\n  | readonly [red: number, green: number, blue: number, gray: number]\n  | {\n      red: number;\n      green: number;\n      blue: number;\n      gray: number;\n    };\n\nexport type ColorInput =\n  | readonly [red: number, green: number, blue: number, alpha: number]\n  | {\n      red: number;\n      green: number;\n      blue: number;\n      alpha: number;\n    };\n\nexport type AudioPayload = {\n  asset: AudioAssetReference;\n  volume?: number;\n  pitch?: number;\n  pan?: number;\n};\n\nexport type LocationInfoType =\n  | \"terrainTag\"\n  | \"eventId\"\n  | \"tileIdLayer1\"\n  | \"tileIdLayer2\"\n  | \"tileIdLayer3\"\n  | \"tileIdLayer4\"\n  | \"regionId\";\n\nexport type ConditionalVariableOperator = \"eq\" | \"ge\" | \"le\" | \"gt\" | \"lt\" | \"ne\";\n\nexport type ConditionalBranchCondition =\n  | {\n      kind: \"switch\";\n      switch: ReferenceValue<\"switch\">;\n      value: boolean;\n    }\n  | {\n      kind: \"variable\";\n      variable: ReferenceValue<\"variable\">;\n      operator: ConditionalVariableOperator;\n      value: number | ReferenceValue<\"variable\">;\n    }\n  | {\n      kind: \"selfSwitch\";\n      selfSwitch: \"A\" | \"B\" | \"C\" | \"D\";\n      value: boolean;\n    }\n  | {\n      kind: \"timer\";\n      seconds: number;\n      operator: \"ge\" | \"le\";\n    }\n  | {\n      kind: \"actor\";\n      actor: ReferenceValue<\"actor\">;\n      check:\n        | { kind: \"inParty\" }\n        | { kind: \"name\"; name: string }\n        | { kind: \"class\"; class: ReferenceValue<\"class\"> }\n        | { kind: \"skill\"; skill: ReferenceValue<\"skill\"> }\n        | { kind: \"weapon\"; weapon: ReferenceValue<\"weapon\"> }\n        | { kind: \"armor\"; armor: ReferenceValue<\"armor\"> }\n        | { kind: \"state\"; state: ReferenceValue<\"state\"> };\n    }\n  | {\n      kind: \"enemy\";\n      enemyIndex: number;\n      check: { kind: \"appeared\" } | { kind: \"state\"; state: ReferenceValue<\"state\"> };\n    }\n  | {\n      kind: \"character\";\n      characterId: number;\n      direction: 2 | 4 | 6 | 8;\n    }\n  | {\n      kind: \"gold\";\n      amount: number;\n      operator: \"ge\" | \"le\" | \"lt\";\n    }\n  | {\n      kind: \"item\";\n      item: ReferenceValue<\"item\">;\n    }\n  | {\n      kind: \"weapon\";\n      weapon: ReferenceValue<\"weapon\">;\n      includeEquipment?: boolean;\n    }\n  | {\n      kind: \"armor\";\n      armor: ReferenceValue<\"armor\">;\n      includeEquipment?: boolean;\n    }\n  | {\n      kind: \"button\";\n      button: \"ok\" | \"cancel\" | \"shift\" | \"down\" | \"left\" | \"right\" | \"up\" | \"pageup\" | \"pagedown\";\n    }\n  | {\n      kind: \"script\";\n      script: ScriptInput;\n    }\n  | {\n      kind: \"vehicle\";\n      vehicle: \"boat\" | \"ship\" | \"airship\";\n    };\n\nexport function isProjectDataReference(value: unknown): value is ReferenceValue<ReferenceKind> {\n  if (!value || typeof value !== \"object\" || !(\"kind\" in value)) {\n    return false;\n  }\n\n  const candidate = value as { kind?: unknown; id?: unknown; name?: unknown };\n  return (\n    typeof candidate.kind === \"string\" &&\n    isReferenceKind(candidate.kind) &&\n    ((typeof candidate.id === \"number\" && !(\"name\" in candidate)) ||\n      (typeof candidate.name === \"string\" && !(\"id\" in candidate)))\n  );\n}\n\nexport function isAssetReference(value: unknown): value is AssetReference {\n  if (!value || typeof value !== \"object\" || !(\"kind\" in value)) {\n    return false;\n  }\n\n  const candidate = value as {\n    kind?: unknown;\n    category?: unknown;\n    folder?: unknown;\n    name?: unknown;\n  };\n\n  if (candidate.kind !== \"asset\" || typeof candidate.name !== \"string\") {\n    return false;\n  }\n\n  if (candidate.category === \"audio\") {\n    return isIncluded(audioAssetFolders, candidate.folder);\n  }\n  if (candidate.category === \"image\") {\n    return isIncluded(imageAssetFolders, candidate.folder);\n  }\n  if (candidate.category === \"movie\") {\n    return candidate.folder === \"movies\";\n  }\n\n  return false;\n}\n\nexport function isRuntimeSelector(value: unknown): value is RuntimeSelector {\n  if (!value || typeof value !== \"object\" || !(\"kind\" in value)) {\n    return false;\n  }\n\n  const candidate = value as { kind?: unknown; scope?: unknown; target?: unknown };\n  return (\n    candidate.kind === \"runtimeSelector\" &&\n    typeof candidate.scope === \"string\" &&\n    candidate.scope.length > 0 &&\n    typeof candidate.target === \"string\" &&\n    candidate.target.length > 0\n  );\n}\n\nexport function isScriptInput(value: unknown): value is ScriptInput {\n  if (!value || typeof value !== \"object\" || !(\"kind\" in value)) {\n    return false;\n  }\n\n  const candidate = value as { kind?: unknown; code?: unknown };\n  return candidate.kind === \"scriptInput\" && typeof candidate.code === \"string\";\n}\n\nexport function createReference<TKind extends ReferenceKind>(\n  kind: TKind,\n  value: { id: number } | { name: string },\n): ReferenceValue<TKind> {\n  if (\"id\" in value) {\n    return { id: value.id, kind };\n  }\n\n  return { kind, name: value.name };\n}\n\nexport function isReferenceKind(value: string): value is ReferenceKind {\n  return (referenceKinds as readonly string[]).includes(value);\n}\n\nfunction isIncluded<TValue extends string>(\n  allowedValues: readonly TValue[],\n  value: unknown,\n): value is TValue {\n  return typeof value === \"string\" && (allowedValues as readonly string[]).includes(value);\n}\n","import type {\n  CommonEventDefinition,\n  BattleEventPage,\n  TroopEventDefinition,\n  DslCommand,\n  EventPage,\n  AutonomousMovement,\n  MapEventDefinition,\n  MapPageTrigger,\n  PageConditions,\n  PageImage,\n  PageOptions,\n  SwitchDefinition,\n  VariableDefinition,\n} from \"../domain/types.js\";\nimport type { CommonEventInput } from \"../domain/declarations.js\";\nimport { assertCommonEventInput } from \"../validation/common-events.js\";\n\nexport function troopEvent(input: Omit<TroopEventDefinition, \"kind\">): TroopEventDefinition {\n  return { ...input, kind: \"troopEvent\" };\n}\n\nexport function battlePage(input: BattleEventPage): BattleEventPage {\n  return { ...input };\n}\n\nexport function mapEvent(input: {\n  mapId: number;\n  id: number;\n  name: string;\n  x: number;\n  y: number;\n  note?: string;\n  pages: readonly [EventPage, ...EventPage[]];\n}): MapEventDefinition {\n  return {\n    ...input,\n    kind: \"mapEvent\",\n    mapId: input.mapId,\n    id: input.id,\n    name: input.name,\n    x: input.x,\n    y: input.y,\n    note: input.note === undefined ? \"\" : input.note,\n    pages: input.pages,\n  };\n}\n\nexport function commonEvent(input: CommonEventInput): CommonEventDefinition {\n  assertCommonEventInput(input);\n  return { ...input, kind: \"commonEvent\" };\n}\n\nexport function switchDefinition(input: { id: number; name: string }): SwitchDefinition {\n  return {\n    kind: \"switchDefinition\",\n    id: input.id,\n    name: input.name,\n  };\n}\n\nexport function variableDefinition(input: { id: number; name: string }): VariableDefinition {\n  return {\n    kind: \"variableDefinition\",\n    id: input.id,\n    name: input.name,\n  };\n}\n\nexport function page(input: {\n  conditions?: PageConditions;\n  trigger?: MapPageTrigger;\n  commands: readonly DslCommand[];\n  movement?: AutonomousMovement;\n  image?: PageImage;\n  priority?: NonNullable<EventPage[\"priority\"]>;\n  options?: PageOptions;\n}): EventPage {\n  return {\n    ...input,\n    conditions: input.conditions === undefined ? {} : input.conditions,\n    trigger: input.trigger === undefined ? \"action\" : input.trigger,\n    commands: input.commands,\n    ...(input.movement === undefined ? {} : { movement: input.movement }),\n    ...(input.image === undefined ? {} : { image: input.image }),\n    ...(input.priority === undefined ? {} : { priority: input.priority }),\n    ...(input.options === undefined ? {} : { options: input.options }),\n  };\n}\n","import type {\n  DslCommand,\n  ImageAssetReference,\n  InputNumberDslCommand,\n  ReferenceValue,\n  SelectItemDslCommand,\n  ShowChoicesDslCommand,\n  ShowScrollingTextDslCommand,\n  ShowTextDslCommand,\n} from \"../../domain/types.js\";\n\nexport function showText(input: {\n  lines: readonly [string, ...string[]];\n  face?: {\n    image: ImageAssetReference;\n    index?: number;\n  };\n  background?: 0 | 1 | 2;\n  positionType?: 0 | 1 | 2;\n}): ShowTextDslCommand {\n  const node: ShowTextDslCommand = {\n    kind: \"showText\",\n    lines: input.lines,\n  };\n\n  if (input.face !== undefined) {\n    node.face = input.face;\n  }\n  if (input.background !== undefined) {\n    node.background = input.background;\n  }\n  if (input.positionType !== undefined) {\n    node.positionType = input.positionType;\n  }\n\n  return node;\n}\n\nexport function inputNumber(input: {\n  variable: ReferenceValue<\"variable\">;\n  digits: number;\n}): InputNumberDslCommand {\n  return {\n    kind: \"inputNumber\",\n    variable: input.variable,\n    digits: input.digits,\n  };\n}\n\nexport function selectItem(input: {\n  variable: ReferenceValue<\"variable\">;\n  itemType?: 1 | 2 | 3 | 4;\n}): SelectItemDslCommand {\n  const node: SelectItemDslCommand = {\n    kind: \"selectItem\",\n    variable: input.variable,\n  };\n\n  if (input.itemType !== undefined) {\n    node.itemType = input.itemType;\n  }\n\n  return node;\n}\n\nexport function showScrollingText(input: {\n  lines: readonly [string, ...string[]];\n  speed?: number;\n  noFastForward?: boolean;\n}): ShowScrollingTextDslCommand {\n  const node: ShowScrollingTextDslCommand = {\n    kind: \"showScrollingText\",\n    lines: input.lines,\n  };\n\n  if (input.speed !== undefined) {\n    node.speed = input.speed;\n  }\n  if (input.noFastForward !== undefined) {\n    node.noFastForward = input.noFastForward;\n  }\n\n  return node;\n}\n\nexport function showChoices(input: {\n  choices: readonly [string, ...string[]];\n  branches: readonly [readonly DslCommand[], ...(readonly DslCommand[][])];\n  cancelType?: number;\n  defaultType?: number;\n  positionType?: 0 | 1 | 2;\n  background?: 0 | 1 | 2;\n  cancelBranch?: readonly DslCommand[];\n}): ShowChoicesDslCommand {\n  const node: ShowChoicesDslCommand = {\n    kind: \"showChoices\",\n    choices: input.choices,\n    branches: input.branches,\n  };\n\n  if (input.cancelType !== undefined) {\n    node.cancelType = input.cancelType;\n  }\n  if (input.defaultType !== undefined) {\n    node.defaultType = input.defaultType;\n  }\n  if (input.positionType !== undefined) {\n    node.positionType = input.positionType;\n  }\n  if (input.background !== undefined) {\n    node.background = input.background;\n  }\n  if (input.cancelBranch !== undefined) {\n    node.cancelBranch = input.cancelBranch;\n  }\n\n  return node;\n}\n","import type { PictureDisplayInput } from \"../domain/types.js\";\n\nexport function assignPictureDisplayInput<TNode extends PictureDisplayInput>(\n  node: TNode,\n  input: PictureDisplayInput,\n): void {\n  if (input.scaleX !== undefined) {\n    node.scaleX = input.scaleX;\n  }\n  if (input.scaleY !== undefined) {\n    node.scaleY = input.scaleY;\n  }\n  if (input.opacity !== undefined) {\n    node.opacity = input.opacity;\n  }\n  if (input.blendMode !== undefined) {\n    node.blendMode = input.blendMode;\n  }\n}\n\nexport function assertIncluded<TValue extends string>(\n  allowedValues: readonly TValue[],\n  value: TValue,\n  fieldName: string,\n): void {\n  if (!(allowedValues as readonly string[]).includes(value)) {\n    throw new Error(`Invalid ${fieldName}: ${String(value)}.`);\n  }\n}\n\nexport function assertNonEmptyString(value: string, fieldName: string): void {\n  if (typeof value !== \"string\" || value.length === 0) {\n    throw new Error(`${fieldName} must be a non-empty string.`);\n  }\n}\n","import type {\n  AudioAssetFolder,\n  AudioAssetReference,\n  ImageAssetFolder,\n  ImageAssetReference,\n  MovieAssetReference,\n  RawDslCommand,\n  ReferenceValue,\n  ScriptInput,\n} from \"../domain/types.js\";\nimport { audioAssetFolders, createReference, imageAssetFolders } from \"../domain/references.js\";\nimport { assertIncluded, assertNonEmptyString } from \"./shared.js\";\nimport { assertRawDslInput } from \"../validation/dsl-command-inputs.js\";\n\nexport function rawDslCommand(input: {\n  code: number;\n  indent?: number;\n  parameters: readonly unknown[];\n}): RawDslCommand {\n  assertRawDslInput(input, \"rawDslCommand\", 0, false, false);\n  const node: RawDslCommand = {\n    kind: \"rawDslCommand\",\n    code: input.code,\n    parameters: input.parameters,\n  };\n\n  if (input.indent !== undefined) {\n    node.indent = input.indent;\n  }\n\n  return node;\n}\n\nexport function audioAsset(input: { folder: AudioAssetFolder; name: string }): AudioAssetReference {\n  assertIncluded(audioAssetFolders, input.folder, \"audio asset folder\");\n  assertNonEmptyString(input.name, \"Audio asset name\");\n\n  return {\n    kind: \"asset\",\n    category: \"audio\",\n    folder: input.folder,\n    name: input.name,\n  };\n}\n\nexport function imageAsset(input: { folder: ImageAssetFolder; name: string }): ImageAssetReference {\n  assertIncluded(imageAssetFolders, input.folder, \"image asset folder\");\n  assertNonEmptyString(input.name, \"Image asset name\");\n\n  return {\n    kind: \"asset\",\n    category: \"image\",\n    folder: input.folder,\n    name: input.name,\n  };\n}\n\nexport function movieAsset(input: { name: string }): MovieAssetReference {\n  assertNonEmptyString(input.name, \"Movie asset name\");\n\n  return {\n    kind: \"asset\",\n    category: \"movie\",\n    folder: \"movies\",\n    name: input.name,\n  };\n}\n\nexport function scriptInput(input: { code: string }): ScriptInput {\n  if (typeof input.code !== \"string\") throw new Error(\"Script input code must be a string.\");\n\n  return {\n    kind: \"scriptInput\",\n    code: input.code,\n  };\n}\n\nexport function actorRef(value: { id: number } | { name: string }): ReferenceValue<\"actor\"> {\n  return createReference(\"actor\", value);\n}\n\nexport function animationRef(\n  value: { id: number } | { name: string },\n): ReferenceValue<\"animation\"> {\n  return createReference(\"animation\", value);\n}\n\nexport function armorRef(value: { id: number } | { name: string }): ReferenceValue<\"armor\"> {\n  return createReference(\"armor\", value);\n}\n\nexport function classRef(value: { id: number } | { name: string }): ReferenceValue<\"class\"> {\n  return createReference(\"class\", value);\n}\n\nexport function commonEventRef(\n  value: { id: number } | { name: string },\n): ReferenceValue<\"commonEvent\"> {\n  return createReference(\"commonEvent\", value);\n}\n\nexport function enemyRef(value: { id: number } | { name: string }): ReferenceValue<\"enemy\"> {\n  return createReference(\"enemy\", value);\n}\n\nexport function itemRef(value: { id: number } | { name: string }): ReferenceValue<\"item\"> {\n  return createReference(\"item\", value);\n}\n\nexport function mapRef(value: { id: number } | { name: string }): ReferenceValue<\"map\"> {\n  return createReference(\"map\", value);\n}\n\nexport function skillRef(value: { id: number } | { name: string }): ReferenceValue<\"skill\"> {\n  return createReference(\"skill\", value);\n}\n\nexport function stateRef(value: { id: number } | { name: string }): ReferenceValue<\"state\"> {\n  return createReference(\"state\", value);\n}\n\nexport function switchRef(value: { id: number } | { name: string }): ReferenceValue<\"switch\"> {\n  return createReference(\"switch\", value);\n}\n\nexport function tilesetRef(value: { id: number } | { name: string }): ReferenceValue<\"tileset\"> {\n  return createReference(\"tileset\", value);\n}\n\nexport function troopRef(value: { id: number } | { name: string }): ReferenceValue<\"troop\"> {\n  return createReference(\"troop\", value);\n}\n\nexport function variableRef(value: { id: number } | { name: string }): ReferenceValue<\"variable\"> {\n  return createReference(\"variable\", value);\n}\n\nexport function weaponRef(value: { id: number } | { name: string }): ReferenceValue<\"weapon\"> {\n  return createReference(\"weapon\", value);\n}\n","import type {\n  BreakLoopDslCommand,\n  CommonEventDslCommand,\n  ExitEventProcessingDslCommand,\n  LoopDslCommand,\n} from \"../../domain/types.js\";\nimport { CommandStructureError } from \"../../validation/command-structure.js\";\nimport { assertDslObject } from \"../../validation/dsl-command-inputs.js\";\nimport { describeValue } from \"../../project-data/json-values.js\";\nimport type { ReferenceResolver } from \"../../validation/types.js\";\n\nexport function resolveCommonEventCall(\n  node: CommonEventDslCommand,\n  resolver: ReferenceResolver,\n  path: string,\n): number {\n  assertCommonEventCall(node, path);\n  try {\n    return resolver.resolveReference(node.commonEvent);\n  } catch (error) {\n    throw new CommandStructureError(\n      \"MV-E117-REFERENCE\",\n      error instanceof Error ? error.message : String(error),\n      {\n        dslPath: `${path}.commonEvent`,\n        expected: \"uniquely resolved staged Common Event\",\n        actual: describeValue(node.commonEvent),\n      },\n    );\n  }\n}\n\nexport function assertCommonEventCall(\n  value: unknown,\n  path = \"callCommonEvent\",\n  withKind = true,\n): asserts value is CommonEventDslCommand {\n  const fail = (at: string, expected: string, actual: unknown): never => {\n    throw new CommandStructureError(\"MV-E117\", \"Invalid Common Event call.\", {\n      dslPath: at,\n      expected,\n      actual: describeValue(actual),\n    });\n  };\n  try {\n    assertDslObject(value, withKind ? [\"kind\", \"commonEvent\"] : [\"commonEvent\"], path);\n  } catch (error) {\n    fail(\n      path,\n      \"named object containing commonEvent\",\n      error instanceof Error ? error.message : error,\n    );\n  }\n  const ref = (value as Record<string, unknown>).commonEvent;\n  try {\n    assertDslObject(ref, [\"kind\", \"id\", \"name\"], `${path}.commonEvent`);\n  } catch (error) {\n    fail(\n      `${path}.commonEvent`,\n      \"Common Event reference\",\n      error instanceof Error ? error.message : error,\n    );\n  }\n  const input = ref as Record<string, unknown>;\n  if (\n    input.kind !== \"commonEvent\" ||\n    Object.hasOwn(input, \"id\") === Object.hasOwn(input, \"name\") ||\n    (Object.hasOwn(input, \"id\")\n      ? !Number.isSafeInteger(input.id) || (input.id as number) <= 0\n      : typeof input.name !== \"string\")\n  )\n    fail(\n      `${path}.commonEvent`,\n      \"Common Event reference with exactly one positive id or string name\",\n      ref,\n    );\n}\n\nexport function assertParameterlessFlowCommand(\n  node: BreakLoopDslCommand | ExitEventProcessingDslCommand,\n  path: string,\n): void {\n  if (Object.keys(node).some((key) => key !== \"kind\"))\n    throw new CommandStructureError(\n      \"MV-COMMAND-PARAMETERS\",\n      `${node.kind} does not accept authored fields.`,\n      { dslPath: path },\n    );\n}\n\nexport function assertLoopCommand(node: LoopDslCommand, path: string): void {\n  const fail = (message: string, suffix = \".body\"): never => {\n    throw new CommandStructureError(\"MV-CHILD-BODY\", message, { dslPath: path + suffix });\n  };\n  if (Object.keys(node).some((key) => key !== \"kind\" && key !== \"body\")) {\n    fail(\"Loop has an unknown field.\", \"\");\n  }\n  const body = node.body;\n  if (typeof body !== \"object\" || body === null || Array.isArray(body)) {\n    fail(\"Loop requires a body object with commands.\");\n  }\n  if (Object.keys(body).some((key) => key !== \"commands\" && key !== \"endMarker\")) {\n    fail(\"Child Command Body has an unknown field.\");\n  }\n  if (!Array.isArray(body.commands)) {\n    fail(\"Child Command Body requires a commands array.\", \".body.commands\");\n  }\n  for (let index = 0; index < body.commands.length; index += 1) {\n    if (!Object.hasOwn(body.commands, index) || body.commands[index] === undefined) {\n      fail(\n        \"Child Command Body commands cannot contain undefined or sparse slots.\",\n        `.body.commands[${index}]`,\n      );\n    }\n    const command = body.commands[index];\n    if (\n      typeof command !== \"object\" ||\n      command === null ||\n      Array.isArray(command) ||\n      typeof command.kind !== \"string\"\n    ) {\n      fail(\"Expected a DSL Command object.\", `.body.commands[${index}]`);\n    }\n  }\n  if (body.endMarker !== undefined && body.endMarker !== \"present\" && body.endMarker !== \"absent\") {\n    fail(\"Body End Marker must be present or absent.\", \".body.endMarker\");\n  }\n  if (body.commands.length === 0 && body.endMarker === \"absent\") {\n    fail(\"An empty Child Command Body cannot omit its Body End Marker.\", \".body.endMarker\");\n  }\n}\n","import type {\n  BreakLoopDslCommand,\n  CommentDslCommand,\n  CommonEventDslCommand,\n  ConditionalBranchCondition,\n  ConditionalDslCommand,\n  DslCommand,\n  ExitEventProcessingDslCommand,\n  JumpToLabelDslCommand,\n  LabelDslCommand,\n  LoopDslCommand,\n  PluginDslCommand,\n  ReferenceValue,\n  ScriptDslCommand,\n  ScriptInput,\n} from \"../../domain/types.js\";\nimport { isScriptInput } from \"../../domain/references.js\";\nimport { scriptInput } from \"../../authoring/references.js\";\nimport { assertCommonEventCall } from \"./validation.js\";\n\nexport function conditional(input: {\n  condition: ConditionalBranchCondition;\n  then: readonly DslCommand[];\n  else?: readonly DslCommand[];\n}): ConditionalDslCommand {\n  const node: ConditionalDslCommand = {\n    kind: \"conditional\",\n    condition: input.condition,\n    then: input.then,\n  };\n\n  if (input.else !== undefined) {\n    node.else = input.else;\n  }\n\n  return node;\n}\n\nexport function loop(input: { body: LoopDslCommand[\"body\"] }): LoopDslCommand {\n  return { kind: \"loop\", body: input.body };\n}\n\nexport function breakLoop(): BreakLoopDslCommand {\n  return { kind: \"breakLoop\" };\n}\n\nexport function exitEventProcessing(): ExitEventProcessingDslCommand {\n  return { kind: \"exitEventProcessing\" };\n}\n\nexport function callCommonEvent(input: {\n  commonEvent: ReferenceValue<\"commonEvent\">;\n}): CommonEventDslCommand {\n  assertCommonEventCall(input, \"callCommonEvent\", false);\n  return { kind: \"commonEvent\", commonEvent: input.commonEvent };\n}\n\nexport function label(name: string): LabelDslCommand {\n  return { kind: \"label\", name };\n}\n\nexport function jumpToLabel(name: string): JumpToLabelDslCommand {\n  return { kind: \"jumpToLabel\", name };\n}\n\nexport function comment(lines: readonly [string, ...string[]]): CommentDslCommand {\n  return { kind: \"comment\", lines };\n}\n\nexport function script(input: { code: string } | ScriptInput): ScriptDslCommand {\n  return {\n    kind: \"script\",\n    script: isScriptInput(input) ? input : scriptInput(input),\n  };\n}\n\nexport function pluginCommand(input: {\n  command: string;\n  args?: readonly string[];\n}): PluginDslCommand {\n  const node: PluginDslCommand = {\n    kind: \"pluginCommand\",\n    command: input.command,\n  };\n\n  if (input.args !== undefined) {\n    node.args = input.args;\n  }\n\n  return node;\n}\n","import type {\n  ChangeArmorsDslCommand,\n  ChangeGoldDslCommand,\n  ChangeItemsDslCommand,\n  ChangePartyMemberDslCommand,\n  ChangeWeaponsDslCommand,\n  ControlSelfSwitchDslCommand,\n  ControlSwitchesDslCommand,\n  ControlTimerDslCommand,\n  ControlVariablesDslCommand,\n  ControlVariablesGameDataOperand,\n  Direction,\n  MapDestination,\n  OperateValueOperand,\n  RandomOperand,\n  ReferenceRange,\n  ReferenceValue,\n  ScriptOperand,\n  TransferPlayerDslCommand,\n} from \"../../domain/types.js\";\n\nexport function transferPlayer(input: {\n  destination: MapDestination;\n  direction?: Direction;\n  fadeType?: 0 | 1 | 2;\n}): TransferPlayerDslCommand {\n  const node: TransferPlayerDslCommand = {\n    kind: \"transferPlayer\",\n    destination: input.destination,\n  };\n\n  if (input.direction !== undefined) {\n    node.direction = input.direction;\n  }\n  if (input.fadeType !== undefined) {\n    node.fadeType = input.fadeType;\n  }\n\n  return node;\n}\n\nexport function controlSwitches(input: {\n  switch: ReferenceValue<\"switch\"> | ReferenceRange<\"switch\">;\n  value: boolean;\n}): ControlSwitchesDslCommand {\n  return {\n    kind: \"controlSwitches\",\n    switch: input.switch,\n    value: input.value,\n  };\n}\n\nexport function controlVariables(input: {\n  variable: ReferenceValue<\"variable\"> | ReferenceRange<\"variable\">;\n  operation: \"set\" | \"add\" | \"sub\" | \"mul\" | \"div\" | \"mod\";\n  value:\n    | number\n    | ReferenceValue<\"variable\">\n    | RandomOperand\n    | ControlVariablesGameDataOperand\n    | ScriptOperand;\n}): ControlVariablesDslCommand {\n  return {\n    kind: \"controlVariables\",\n    variable: input.variable,\n    operation: input.operation,\n    value: input.value,\n  };\n}\n\nexport function controlSelfSwitch(input: {\n  selfSwitch: \"A\" | \"B\" | \"C\" | \"D\";\n  value: boolean;\n}): ControlSelfSwitchDslCommand {\n  return {\n    kind: \"controlSelfSwitch\",\n    selfSwitch: input.selfSwitch,\n    value: input.value,\n  };\n}\n\nexport function controlTimer(\n  input: { action: \"start\"; seconds: number } | { action: \"stop\" },\n): ControlTimerDslCommand {\n  return input.action === \"start\"\n    ? {\n        kind: \"controlTimer\",\n        action: input.action,\n        seconds: input.seconds,\n      }\n    : {\n        kind: \"controlTimer\",\n        action: input.action,\n      };\n}\n\nexport function changeGold(input: {\n  operation: \"gain\" | \"lose\";\n  value: OperateValueOperand;\n}): ChangeGoldDslCommand {\n  return {\n    kind: \"changeGold\",\n    operation: input.operation,\n    value: input.value,\n  };\n}\n\nexport function changeItems(input: {\n  item: ReferenceValue<\"item\">;\n  operation: \"gain\" | \"lose\";\n  amount: OperateValueOperand;\n}): ChangeItemsDslCommand {\n  return {\n    kind: \"changeItems\",\n    item: input.item,\n    operation: input.operation,\n    amount: input.amount,\n  };\n}\n\nexport function changeWeapons(input: {\n  weapon: ReferenceValue<\"weapon\">;\n  operation: \"gain\" | \"lose\";\n  amount: OperateValueOperand;\n  includeEquipment?: boolean;\n}): ChangeWeaponsDslCommand {\n  const node: ChangeWeaponsDslCommand = {\n    kind: \"changeWeapons\",\n    weapon: input.weapon,\n    operation: input.operation,\n    amount: input.amount,\n  };\n\n  if (input.includeEquipment !== undefined) {\n    node.includeEquipment = input.includeEquipment;\n  }\n\n  return node;\n}\n\nexport function changeArmors(input: {\n  armor: ReferenceValue<\"armor\">;\n  operation: \"gain\" | \"lose\";\n  amount: OperateValueOperand;\n  includeEquipment?: boolean;\n}): ChangeArmorsDslCommand {\n  const node: ChangeArmorsDslCommand = {\n    kind: \"changeArmors\",\n    armor: input.armor,\n    operation: input.operation,\n    amount: input.amount,\n  };\n\n  if (input.includeEquipment !== undefined) {\n    node.includeEquipment = input.includeEquipment;\n  }\n\n  return node;\n}\n\nexport function changePartyMember(input: {\n  actor: ReferenceValue<\"actor\">;\n  operation: \"add\" | \"remove\";\n  initialize?: boolean;\n}): ChangePartyMemberDslCommand {\n  const node: ChangePartyMemberDslCommand = {\n    kind: \"changePartyMember\",\n    actor: input.actor,\n    operation: input.operation,\n  };\n\n  if (input.initialize !== undefined) {\n    node.initialize = input.initialize;\n  }\n\n  return node;\n}\n","import type {\n  AudioPayload,\n  BalloonIcon,\n  ChangeBattleBgmDslCommand,\n  ChangeDefeatMeDslCommand,\n  ChangeEncounterDisableDslCommand,\n  ChangeFormationAccessDslCommand,\n  ChangeMenuAccessDslCommand,\n  ChangePlayerFollowersDslCommand,\n  ChangeSaveAccessDslCommand,\n  ChangeTransparencyDslCommand,\n  ChangeVehicleBgmDslCommand,\n  ChangeVictoryMeDslCommand,\n  ChangeWindowColorDslCommand,\n  CharacterRuntimeSelector,\n  Direction,\n  EventLocationDestination,\n  GatherFollowersDslCommand,\n  GetOnOffVehicleDslCommand,\n  MapDestination,\n  ReferenceValue,\n  ScrollMapDslCommand,\n  SetEventLocationDslCommand,\n  SetMovementRouteDslCommand,\n  SetVehicleLocationDslCommand,\n  ShowAnimationDslCommand,\n  ShowBalloonIconDslCommand,\n  ToneInput,\n  VehicleTarget,\n} from \"../../domain/types.js\";\n\nexport function changeBattleBgm(input: { audio: AudioPayload }): ChangeBattleBgmDslCommand {\n  return {\n    kind: \"changeBattleBgm\",\n    audio: input.audio,\n  };\n}\n\nexport function changeVictoryMe(input: { audio: AudioPayload }): ChangeVictoryMeDslCommand {\n  return {\n    kind: \"changeVictoryMe\",\n    audio: input.audio,\n  };\n}\n\nexport function changeSaveAccess(input: { enabled: boolean }): ChangeSaveAccessDslCommand {\n  return {\n    kind: \"changeSaveAccess\",\n    enabled: input.enabled,\n  };\n}\n\nexport function changeMenuAccess(input: { enabled: boolean }): ChangeMenuAccessDslCommand {\n  return {\n    kind: \"changeMenuAccess\",\n    enabled: input.enabled,\n  };\n}\n\nexport function changeEncounterDisable(input: {\n  disabled: boolean;\n}): ChangeEncounterDisableDslCommand {\n  return {\n    kind: \"changeEncounterDisable\",\n    disabled: input.disabled,\n  };\n}\n\nexport function changeFormationAccess(input: {\n  enabled: boolean;\n}): ChangeFormationAccessDslCommand {\n  return {\n    kind: \"changeFormationAccess\",\n    enabled: input.enabled,\n  };\n}\n\nexport function changeWindowColor(input: { tone: ToneInput }): ChangeWindowColorDslCommand {\n  return {\n    kind: \"changeWindowColor\",\n    tone: input.tone,\n  };\n}\n\nexport function changeDefeatMe(input: { audio: AudioPayload }): ChangeDefeatMeDslCommand {\n  return {\n    kind: \"changeDefeatMe\",\n    audio: input.audio,\n  };\n}\n\nexport function changeVehicleBgm(input: {\n  vehicle: VehicleTarget;\n  audio: AudioPayload;\n}): ChangeVehicleBgmDslCommand {\n  return {\n    kind: \"changeVehicleBgm\",\n    vehicle: input.vehicle,\n    audio: input.audio,\n  };\n}\n\nexport function setVehicleLocation(input: {\n  vehicle: VehicleTarget;\n  destination: MapDestination;\n}): SetVehicleLocationDslCommand {\n  return {\n    kind: \"setVehicleLocation\",\n    vehicle: input.vehicle,\n    destination: input.destination,\n  };\n}\n\nexport function setEventLocation(input: {\n  character: CharacterRuntimeSelector;\n  destination: EventLocationDestination;\n  direction?: 0 | Direction;\n}): SetEventLocationDslCommand {\n  const node: SetEventLocationDslCommand = {\n    kind: \"setEventLocation\",\n    character: input.character,\n    destination: input.destination,\n  };\n\n  if (input.direction !== undefined) {\n    node.direction = input.direction;\n  }\n\n  return node;\n}\n\nexport function scrollMap(input: {\n  direction: Direction;\n  distance: number;\n  speed: number;\n}): ScrollMapDslCommand {\n  return {\n    kind: \"scrollMap\",\n    direction: input.direction,\n    distance: input.distance,\n    speed: input.speed,\n  };\n}\n\nexport function setMovementRoute(input: {\n  target: CharacterRuntimeSelector;\n  route: SetMovementRouteDslCommand[\"route\"];\n}): SetMovementRouteDslCommand {\n  const node: SetMovementRouteDslCommand = {\n    ...input,\n    kind: \"setMovementRoute\",\n    target: input.target,\n    route: input.route,\n  };\n\n  return node;\n}\n\nexport function getOnOffVehicle(): GetOnOffVehicleDslCommand {\n  return {\n    kind: \"getOnOffVehicle\",\n  };\n}\n\nexport function changeTransparency(input: { transparent: boolean }): ChangeTransparencyDslCommand {\n  return {\n    kind: \"changeTransparency\",\n    transparent: input.transparent,\n  };\n}\n\nexport function showAnimation(input: {\n  target: CharacterRuntimeSelector;\n  animation: ReferenceValue<\"animation\">;\n  wait?: boolean;\n}): ShowAnimationDslCommand {\n  const node: ShowAnimationDslCommand = {\n    kind: \"showAnimation\",\n    target: input.target,\n    animation: input.animation,\n  };\n\n  if (input.wait !== undefined) {\n    node.wait = input.wait;\n  }\n\n  return node;\n}\n\nexport function showBalloonIcon(input: {\n  target: CharacterRuntimeSelector;\n  balloon: BalloonIcon | number;\n  wait?: boolean;\n}): ShowBalloonIconDslCommand {\n  const node: ShowBalloonIconDslCommand = {\n    kind: \"showBalloonIcon\",\n    target: input.target,\n    balloon: input.balloon,\n  };\n\n  if (input.wait !== undefined) {\n    node.wait = input.wait;\n  }\n\n  return node;\n}\n\nexport function changePlayerFollowers(input: {\n  visible: boolean;\n}): ChangePlayerFollowersDslCommand {\n  return {\n    kind: \"changePlayerFollowers\",\n    visible: input.visible,\n  };\n}\n\nexport function gatherFollowers(): GatherFollowersDslCommand {\n  return {\n    kind: \"gatherFollowers\",\n  };\n}\n","import type {\n  ColorInput,\n  ErasePictureDslCommand,\n  FadeinScreenDslCommand,\n  FadeoutScreenDslCommand,\n  FlashScreenDslCommand,\n  ImageAssetReference,\n  MovePictureDslCommand,\n  PictureDisplayInput,\n  PicturePosition,\n  RotatePictureDslCommand,\n  SetWeatherEffectDslCommand,\n  ShakeScreenDslCommand,\n  ShowPictureDslCommand,\n  TintPictureDslCommand,\n  TintScreenDslCommand,\n  ToneInput,\n  WaitDslCommand,\n  WeatherEffectType,\n} from \"../../domain/types.js\";\nimport { assignPictureDisplayInput } from \"../../authoring/shared.js\";\n\nexport function fadeoutScreen(): FadeoutScreenDslCommand {\n  return {\n    kind: \"fadeoutScreen\",\n  };\n}\n\nexport function fadeinScreen(): FadeinScreenDslCommand {\n  return {\n    kind: \"fadeinScreen\",\n  };\n}\n\nexport function tintScreen(input: {\n  tone: ToneInput;\n  duration: number;\n  wait?: boolean;\n}): TintScreenDslCommand {\n  const node: TintScreenDslCommand = {\n    kind: \"tintScreen\",\n    tone: input.tone,\n    duration: input.duration,\n  };\n\n  if (input.wait !== undefined) {\n    node.wait = input.wait;\n  }\n\n  return node;\n}\n\nexport function flashScreen(input: {\n  color: ColorInput;\n  duration: number;\n  wait?: boolean;\n}): FlashScreenDslCommand {\n  const node: FlashScreenDslCommand = {\n    kind: \"flashScreen\",\n    color: input.color,\n    duration: input.duration,\n  };\n\n  if (input.wait !== undefined) {\n    node.wait = input.wait;\n  }\n\n  return node;\n}\n\nexport function shakeScreen(input: {\n  power: number;\n  speed: number;\n  duration: number;\n  wait?: boolean;\n}): ShakeScreenDslCommand {\n  const node: ShakeScreenDslCommand = {\n    kind: \"shakeScreen\",\n    power: input.power,\n    speed: input.speed,\n    duration: input.duration,\n  };\n\n  if (input.wait !== undefined) {\n    node.wait = input.wait;\n  }\n\n  return node;\n}\n\nexport function wait(frames: number): WaitDslCommand {\n  return { kind: \"wait\", frames };\n}\n\nexport function showPicture(\n  input: {\n    pictureId: number;\n    image: ImageAssetReference;\n    position: PicturePosition;\n  } & PictureDisplayInput,\n): ShowPictureDslCommand {\n  const node: ShowPictureDslCommand = {\n    kind: \"showPicture\",\n    pictureId: input.pictureId,\n    image: input.image,\n    position: input.position,\n  };\n\n  assignPictureDisplayInput(node, input);\n  return node;\n}\n\nexport function movePicture(\n  input: {\n    pictureId: number;\n    position: PicturePosition;\n    duration: number;\n    wait?: boolean;\n  } & PictureDisplayInput,\n): MovePictureDslCommand {\n  const node: MovePictureDslCommand = {\n    kind: \"movePicture\",\n    pictureId: input.pictureId,\n    position: input.position,\n    duration: input.duration,\n  };\n\n  assignPictureDisplayInput(node, input);\n  if (input.wait !== undefined) {\n    node.wait = input.wait;\n  }\n\n  return node;\n}\n\nexport function rotatePicture(input: {\n  pictureId: number;\n  speed: number;\n}): RotatePictureDslCommand {\n  return {\n    kind: \"rotatePicture\",\n    pictureId: input.pictureId,\n    speed: input.speed,\n  };\n}\n\nexport function tintPicture(input: {\n  pictureId: number;\n  tone: ToneInput;\n  duration: number;\n  wait?: boolean;\n}): TintPictureDslCommand {\n  const node: TintPictureDslCommand = {\n    kind: \"tintPicture\",\n    pictureId: input.pictureId,\n    tone: input.tone,\n    duration: input.duration,\n  };\n\n  if (input.wait !== undefined) {\n    node.wait = input.wait;\n  }\n\n  return node;\n}\n\nexport function erasePicture(input: { pictureId: number }): ErasePictureDslCommand {\n  return {\n    kind: \"erasePicture\",\n    pictureId: input.pictureId,\n  };\n}\n\nexport function setWeatherEffect(input: {\n  weather: WeatherEffectType;\n  power: number;\n  duration: number;\n  wait?: boolean;\n}): SetWeatherEffectDslCommand {\n  const node: SetWeatherEffectDslCommand = {\n    kind: \"setWeatherEffect\",\n    weather: input.weather,\n    power: input.power,\n    duration: input.duration,\n  };\n\n  if (input.wait !== undefined) {\n    node.wait = input.wait;\n  }\n\n  return node;\n}\n","import type {\n  AudioPayload,\n  FadeoutBgmDslCommand,\n  FadeoutBgsDslCommand,\n  MovieAssetReference,\n  PlayBgmDslCommand,\n  PlayBgsDslCommand,\n  PlayMeDslCommand,\n  PlayMovieDslCommand,\n  PlaySeDslCommand,\n  ResumeBgmDslCommand,\n  SaveBgmDslCommand,\n  StopSeDslCommand,\n} from \"../../domain/types.js\";\n\nexport function playBgm(input: { audio: AudioPayload }): PlayBgmDslCommand {\n  return {\n    kind: \"playBgm\",\n    audio: input.audio,\n  };\n}\n\nexport function fadeoutBgm(input: { duration: number }): FadeoutBgmDslCommand {\n  return {\n    kind: \"fadeoutBgm\",\n    duration: input.duration,\n  };\n}\n\nexport function saveBgm(): SaveBgmDslCommand {\n  return {\n    kind: \"saveBgm\",\n  };\n}\n\nexport function resumeBgm(): ResumeBgmDslCommand {\n  return {\n    kind: \"resumeBgm\",\n  };\n}\n\nexport function playBgs(input: { audio: AudioPayload }): PlayBgsDslCommand {\n  return {\n    kind: \"playBgs\",\n    audio: input.audio,\n  };\n}\n\nexport function fadeoutBgs(input: { duration: number }): FadeoutBgsDslCommand {\n  return {\n    kind: \"fadeoutBgs\",\n    duration: input.duration,\n  };\n}\n\nexport function playMe(input: { audio: AudioPayload }): PlayMeDslCommand {\n  return {\n    kind: \"playMe\",\n    audio: input.audio,\n  };\n}\n\nexport function playSe(input: { audio: AudioPayload }): PlaySeDslCommand {\n  return {\n    kind: \"playSe\",\n    audio: input.audio,\n  };\n}\n\nexport function stopSe(): StopSeDslCommand {\n  return {\n    kind: \"stopSe\",\n  };\n}\n\nexport function playMovie(input: { movie: MovieAssetReference }): PlayMovieDslCommand {\n  return {\n    kind: \"playMovie\",\n    movie: input.movie,\n  };\n}\n","import { assertDslObject } from \"../../validation/dsl-command-inputs.js\";\nimport { CommandStructureError } from \"../../validation/command-errors.js\";\nimport { describeValue } from \"../../project-data/json-values.js\";\nimport type { ReferenceResolver } from \"../../validation/types.js\";\nimport type { ReferenceValue } from \"../../domain/types.js\";\n\nexport function assertMapAppearanceInput(\n  kind: string,\n  input: unknown,\n  path: string,\n  withKind = false,\n  resolver?: ReferenceResolver,\n): void {\n  const fields: Record<string, readonly string[]> = {\n    changeMapNameDisplay: [\"enabled\"],\n    changeTileset: [\"tileset\"],\n    changeBattleBack: [\"battleback1\", \"battleback2\"],\n    changeParallax: [\"image\", \"loopX\", \"loopY\", \"sx\", \"sy\"],\n  };\n  if (!Object.hasOwn(fields, kind)) return;\n  assertDslObject(input, [...(withKind ? [\"kind\"] : []), ...fields[kind]!], path);\n  if (kind === \"changeParallax\") {\n    assertImageSlot(input.image, \"parallaxes\", `${path}.image`, 284);\n    for (const field of [\"loopX\", \"loopY\", \"sx\", \"sy\"]) {\n      const value = input[field];\n      const boolean = field === \"loopX\" || field === \"loopY\";\n      if (\n        boolean\n          ? typeof value !== \"boolean\"\n          : !Number.isSafeInteger(value) || (value as number) < -32 || (value as number) > 32\n      )\n        throw new CommandStructureError(\n          \"MV-E284-INPUT\",\n          \"Invalid independently saved parallax configuration.\",\n          {\n            dslPath: `${path}.${field}`,\n            expected: boolean ? \"boolean\" : \"integer -32..32\",\n            actual: describeValue(value),\n          },\n        );\n    }\n    return;\n  }\n  if (kind === \"changeBattleBack\") {\n    assertImageSlot(input.battleback1, \"battlebacks1\", `${path}.battleback1`, 283);\n    assertImageSlot(input.battleback2, \"battlebacks2\", `${path}.battleback2`, 283);\n    return;\n  }\n  if (kind === \"changeMapNameDisplay\") {\n    if (typeof input.enabled !== \"boolean\")\n      throw new CommandStructureError(\n        \"MV-E281-INPUT\",\n        \"Map name display requires an explicit boolean.\",\n        {\n          dslPath: `${path}.enabled`,\n          expected: \"boolean\",\n          actual: describeValue(input.enabled),\n        },\n      );\n    return;\n  }\n  const expected = \"tileset reference with one positive integer ID or nonempty name; no None\";\n  const fail = (): never => {\n    throw new CommandStructureError(\"MV-E282-INPUT\", \"Invalid tileset reference.\", {\n      dslPath: `${path}.tileset`,\n      expected,\n      actual: describeValue(input.tileset),\n    });\n  };\n  if (input.tileset === null || typeof input.tileset !== \"object\") fail();\n  const reference = input.tileset as Record<string, unknown>;\n  assertDslObject(reference, [\"kind\", \"id\", \"name\"], `${path}.tileset`);\n  if (\n    reference.kind !== \"tileset\" ||\n    Object.hasOwn(reference, \"id\") === Object.hasOwn(reference, \"name\")\n  )\n    fail();\n  if (\n    Object.hasOwn(reference, \"id\")\n      ? !Number.isSafeInteger(reference.id) || (reference.id as number) <= 0\n      : typeof reference.name !== \"string\" || reference.name.length === 0\n  )\n    fail();\n  if (resolver)\n    try {\n      resolver.resolveReference(reference as ReferenceValue<\"tileset\">);\n    } catch (error) {\n      throw new CommandStructureError(\n        \"MV-E282-REFERENCE\",\n        error instanceof Error ? error.message : String(error),\n        {\n          dslPath: `${path}.tileset`,\n          expected: \"existing tileset in the Project Data Snapshot\",\n          actual: describeValue(reference),\n        },\n      );\n    }\n}\n\nfunction assertImageSlot(value: unknown, folder: string, path: string, code: number): void {\n  if (value === null) return;\n  const fail = (): never => {\n    throw new CommandStructureError(\n      `MV-E${code}-INPUT`,\n      \"Expected an explicit image Asset Reference or None.\",\n      {\n        dslPath: path,\n        expected: `${folder} image Asset Reference with nonempty name, or null`,\n        actual: describeValue(value),\n      },\n    );\n  };\n  if (typeof value !== \"object\" || value === null || Array.isArray(value)) fail();\n  const asset = value as Record<string, unknown>;\n  assertDslObject(asset, [\"kind\", \"category\", \"folder\", \"name\"], path);\n  if (\n    asset.kind !== \"asset\" ||\n    asset.category !== \"image\" ||\n    asset.folder !== folder ||\n    typeof asset.name !== \"string\" ||\n    asset.name.length === 0\n  )\n    fail();\n}\n","import type {\n  ChangeBattleBackDslCommand,\n  ChangeMapNameDisplayDslCommand,\n  ChangeParallaxDslCommand,\n  ChangeTilesetDslCommand,\n  CommandPosition,\n  EraseEventDslCommand,\n  GetLocationInfoDslCommand,\n  ImageAssetReference,\n  LocationInfoType,\n  ReferenceValue,\n} from \"../../domain/types.js\";\nimport { assertMapAppearanceInput } from \"./validation.js\";\n\nexport function changeMapNameDisplay(input: { enabled: boolean }): ChangeMapNameDisplayDslCommand {\n  assertMapAppearanceInput(\"changeMapNameDisplay\", input, \"changeMapNameDisplay\");\n  return {\n    kind: \"changeMapNameDisplay\",\n    enabled: input.enabled,\n  };\n}\n\nexport function changeTileset(input: {\n  tileset: ReferenceValue<\"tileset\">;\n}): ChangeTilesetDslCommand {\n  assertMapAppearanceInput(\"changeTileset\", input, \"changeTileset\");\n  return {\n    kind: \"changeTileset\",\n    tileset: input.tileset,\n  };\n}\n\nexport function changeBattleBack(input: {\n  battleback1: ImageAssetReference | null;\n  battleback2: ImageAssetReference | null;\n}): ChangeBattleBackDslCommand {\n  assertMapAppearanceInput(\"changeBattleBack\", input, \"changeBattleBack\");\n  return {\n    kind: \"changeBattleBack\",\n    battleback1: input.battleback1,\n    battleback2: input.battleback2,\n  };\n}\n\nexport function changeParallax(input: {\n  image: ImageAssetReference | null;\n  loopX: boolean;\n  loopY: boolean;\n  sx: number;\n  sy: number;\n}): ChangeParallaxDslCommand {\n  assertMapAppearanceInput(\"changeParallax\", input, \"changeParallax\");\n  const node: ChangeParallaxDslCommand = {\n    kind: \"changeParallax\",\n    image: input.image,\n    loopX: input.loopX,\n    loopY: input.loopY,\n    sx: input.sx,\n    sy: input.sy,\n  };\n\n  return node;\n}\n\nexport function getLocationInfo(input: {\n  variable: ReferenceValue<\"variable\">;\n  info: LocationInfoType;\n  location: CommandPosition;\n}): GetLocationInfoDslCommand {\n  return {\n    kind: \"getLocationInfo\",\n    variable: input.variable,\n    info: input.info,\n    location: input.location,\n  };\n}\n\nexport function eraseEvent(): EraseEventDslCommand {\n  return { kind: \"eraseEvent\" };\n}\n","import type {\n  BattleProcessingDslCommand,\n  DslCommand,\n  NameInputProcessingDslCommand,\n  ReferenceValue,\n  ShopGoods,\n  ShopProcessingDslCommand,\n} from \"../../domain/types.js\";\n\nexport function battleProcessing(input: {\n  troop:\n    | ReferenceValue<\"troop\">\n    | {\n        kind: \"troop\";\n        variable: ReferenceValue<\"variable\">;\n      }\n    | {\n        kind: \"troop\";\n        useRandomEncounter: true;\n      };\n  canEscape?: boolean;\n  canLose?: boolean;\n  win?: readonly DslCommand[];\n  escape?: readonly DslCommand[];\n  lose?: readonly DslCommand[];\n}): BattleProcessingDslCommand {\n  const node: BattleProcessingDslCommand = {\n    kind: \"battleProcessing\",\n    troop: input.troop,\n  };\n\n  if (input.canEscape !== undefined) {\n    node.canEscape = input.canEscape;\n  }\n  if (input.canLose !== undefined) {\n    node.canLose = input.canLose;\n  }\n  if (input.win !== undefined) {\n    node.win = input.win;\n  }\n  if (input.escape !== undefined) {\n    node.escape = input.escape;\n  }\n  if (input.lose !== undefined) {\n    node.lose = input.lose;\n  }\n\n  return node;\n}\n\nexport function shopProcessing(input: {\n  goods: readonly [ShopGoods, ...ShopGoods[]];\n  allowSelling?: boolean;\n}): ShopProcessingDslCommand {\n  const node: ShopProcessingDslCommand = {\n    kind: \"shopProcessing\",\n    goods: input.goods,\n  };\n\n  if (input.allowSelling !== undefined) {\n    node.allowSelling = input.allowSelling;\n  }\n\n  return node;\n}\n\nexport function nameInputProcessing(input: {\n  actor: ReferenceValue<\"actor\">;\n  maxCharacters: number;\n}): NameInputProcessingDslCommand {\n  return {\n    kind: \"nameInputProcessing\",\n    actor: input.actor,\n    maxCharacters: input.maxCharacters,\n  };\n}\n","import type {\n  ActorCommandTarget,\n  ActorParameter,\n  ChangeActorImagesDslCommand,\n  ChangeClassDslCommand,\n  ChangeEquipmentDslCommand,\n  ChangeExpDslCommand,\n  ChangeHpDslCommand,\n  ChangeLevelDslCommand,\n  ChangeMpDslCommand,\n  ChangeNameDslCommand,\n  ChangeNicknameDslCommand,\n  ChangeParameterDslCommand,\n  ChangeProfileDslCommand,\n  ChangeSkillDslCommand,\n  ChangeStateDslCommand,\n  ChangeTpDslCommand,\n  ChangeVehicleImageDslCommand,\n  ImageAssetReference,\n  OperateValueOperand,\n  RecoverAllDslCommand,\n  ReferenceValue,\n  VehicleTarget,\n} from \"../../domain/types.js\";\n\nexport function changeHp(input: {\n  target: ActorCommandTarget;\n  operation: \"gain\" | \"lose\";\n  value: OperateValueOperand;\n  allowDeath?: boolean;\n}): ChangeHpDslCommand {\n  const node: ChangeHpDslCommand = {\n    kind: \"changeHp\",\n    target: input.target,\n    operation: input.operation,\n    value: input.value,\n  };\n\n  if (input.allowDeath !== undefined) {\n    node.allowDeath = input.allowDeath;\n  }\n\n  return node;\n}\n\nexport function changeMp(input: {\n  target: ActorCommandTarget;\n  operation: \"gain\" | \"lose\";\n  value: OperateValueOperand;\n}): ChangeMpDslCommand {\n  return {\n    kind: \"changeMp\",\n    target: input.target,\n    operation: input.operation,\n    value: input.value,\n  };\n}\n\nexport function changeState(input: {\n  target: ActorCommandTarget;\n  operation: \"add\" | \"remove\";\n  state: ReferenceValue<\"state\">;\n}): ChangeStateDslCommand {\n  return {\n    kind: \"changeState\",\n    target: input.target,\n    operation: input.operation,\n    state: input.state,\n  };\n}\n\nexport function recoverAll(input: { target: ActorCommandTarget }): RecoverAllDslCommand {\n  return {\n    kind: \"recoverAll\",\n    target: input.target,\n  };\n}\n\nexport function changeExp(input: {\n  target: ActorCommandTarget;\n  operation: \"gain\" | \"lose\";\n  value: OperateValueOperand;\n  showLevelUp?: boolean;\n}): ChangeExpDslCommand {\n  const node: ChangeExpDslCommand = {\n    kind: \"changeExp\",\n    target: input.target,\n    operation: input.operation,\n    value: input.value,\n  };\n\n  if (input.showLevelUp !== undefined) {\n    node.showLevelUp = input.showLevelUp;\n  }\n\n  return node;\n}\n\nexport function changeLevel(input: {\n  target: ActorCommandTarget;\n  operation: \"gain\" | \"lose\";\n  value: OperateValueOperand;\n  showLevelUp?: boolean;\n}): ChangeLevelDslCommand {\n  const node: ChangeLevelDslCommand = {\n    kind: \"changeLevel\",\n    target: input.target,\n    operation: input.operation,\n    value: input.value,\n  };\n\n  if (input.showLevelUp !== undefined) {\n    node.showLevelUp = input.showLevelUp;\n  }\n\n  return node;\n}\n\nexport function changeParameter(input: {\n  target: ActorCommandTarget;\n  parameter: ActorParameter;\n  operation: \"gain\" | \"lose\";\n  value: OperateValueOperand;\n}): ChangeParameterDslCommand {\n  return {\n    kind: \"changeParameter\",\n    target: input.target,\n    parameter: input.parameter,\n    operation: input.operation,\n    value: input.value,\n  };\n}\n\nexport function changeSkill(input: {\n  target: ActorCommandTarget;\n  operation: \"learn\" | \"forget\";\n  skill: ReferenceValue<\"skill\">;\n}): ChangeSkillDslCommand {\n  return {\n    kind: \"changeSkill\",\n    target: input.target,\n    operation: input.operation,\n    skill: input.skill,\n  };\n}\n\nexport function changeEquipment(input: {\n  actor: ReferenceValue<\"actor\">;\n  equipmentTypeId: number;\n  itemId: number | null;\n}): ChangeEquipmentDslCommand {\n  return {\n    kind: \"changeEquipment\",\n    actor: input.actor,\n    equipmentTypeId: input.equipmentTypeId,\n    itemId: input.itemId,\n  };\n}\n\nexport function changeName(input: {\n  actor: ReferenceValue<\"actor\">;\n  name: string;\n}): ChangeNameDslCommand {\n  return {\n    kind: \"changeName\",\n    actor: input.actor,\n    name: input.name,\n  };\n}\n\nexport function changeClass(input: {\n  actor: ReferenceValue<\"actor\">;\n  class: ReferenceValue<\"class\">;\n  keepExp?: boolean;\n}): ChangeClassDslCommand {\n  const node: ChangeClassDslCommand = {\n    kind: \"changeClass\",\n    actor: input.actor,\n    class: input.class,\n  };\n\n  if (input.keepExp !== undefined) {\n    node.keepExp = input.keepExp;\n  }\n\n  return node;\n}\n\nexport function changeActorImages(input: {\n  actor: ReferenceValue<\"actor\">;\n  character: { image: ImageAssetReference; index: number };\n  face: { image: ImageAssetReference; index: number };\n  battler: ImageAssetReference;\n}): ChangeActorImagesDslCommand {\n  return {\n    kind: \"changeActorImages\",\n    actor: input.actor,\n    character: input.character,\n    face: input.face,\n    battler: input.battler,\n  };\n}\n\nexport function changeVehicleImage(input: {\n  vehicle: VehicleTarget;\n  image: ImageAssetReference;\n  index: number;\n}): ChangeVehicleImageDslCommand {\n  return {\n    kind: \"changeVehicleImage\",\n    vehicle: input.vehicle,\n    image: input.image,\n    index: input.index,\n  };\n}\n\nexport function changeNickname(input: {\n  actor: ReferenceValue<\"actor\">;\n  nickname: string;\n}): ChangeNicknameDslCommand {\n  return {\n    kind: \"changeNickname\",\n    actor: input.actor,\n    nickname: input.nickname,\n  };\n}\n\nexport function changeProfile(input: {\n  actor: ReferenceValue<\"actor\">;\n  profile: string;\n}): ChangeProfileDslCommand {\n  return {\n    kind: \"changeProfile\",\n    actor: input.actor,\n    profile: input.profile,\n  };\n}\n\nexport function changeTp(input: {\n  target: ActorCommandTarget;\n  operation: \"gain\" | \"lose\";\n  value: OperateValueOperand;\n}): ChangeTpDslCommand {\n  return {\n    kind: \"changeTp\",\n    target: input.target,\n    operation: input.operation,\n    value: input.value,\n  };\n}\n","import type {\n  AbortBattleDslCommand,\n  BattlerCommandTarget,\n  ChangeEnemyHpDslCommand,\n  ChangeEnemyMpDslCommand,\n  ChangeEnemyStateDslCommand,\n  ChangeEnemyTpDslCommand,\n  EnemyAppearDslCommand,\n  EnemyCommandTarget,\n  EnemyRecoverAllDslCommand,\n  EnemyTransformDslCommand,\n  ForceActionDslCommand,\n  OperateValueOperand,\n  ReferenceValue,\n  ShowBattleAnimationDslCommand,\n} from \"../../domain/types.js\";\n\nexport function changeEnemyHp(input: {\n  target: EnemyCommandTarget;\n  operation: \"gain\" | \"lose\";\n  value: OperateValueOperand;\n  allowDeath?: boolean;\n}): ChangeEnemyHpDslCommand {\n  const node: ChangeEnemyHpDslCommand = {\n    kind: \"changeEnemyHp\",\n    target: input.target,\n    operation: input.operation,\n    value: input.value,\n  };\n\n  if (input.allowDeath !== undefined) {\n    node.allowDeath = input.allowDeath;\n  }\n\n  return node;\n}\n\nexport function changeEnemyMp(input: {\n  target: EnemyCommandTarget;\n  operation: \"gain\" | \"lose\";\n  value: OperateValueOperand;\n}): ChangeEnemyMpDslCommand {\n  return {\n    kind: \"changeEnemyMp\",\n    target: input.target,\n    operation: input.operation,\n    value: input.value,\n  };\n}\n\nexport function changeEnemyState(input: {\n  target: EnemyCommandTarget;\n  operation: \"add\" | \"remove\";\n  state: ReferenceValue<\"state\">;\n}): ChangeEnemyStateDslCommand {\n  return {\n    kind: \"changeEnemyState\",\n    target: input.target,\n    operation: input.operation,\n    state: input.state,\n  };\n}\n\nexport function enemyRecoverAll(input: { target: EnemyCommandTarget }): EnemyRecoverAllDslCommand {\n  return {\n    kind: \"enemyRecoverAll\",\n    target: input.target,\n  };\n}\n\nexport function enemyAppear(input: { target: EnemyCommandTarget }): EnemyAppearDslCommand {\n  return {\n    kind: \"enemyAppear\",\n    target: input.target,\n  };\n}\n\nexport function enemyTransform(input: {\n  target: EnemyCommandTarget;\n  enemy: ReferenceValue<\"enemy\">;\n}): EnemyTransformDslCommand {\n  return {\n    kind: \"enemyTransform\",\n    target: input.target,\n    enemy: input.enemy,\n  };\n}\n\nexport function showBattleAnimation(input: {\n  target: EnemyCommandTarget;\n  animation: ReferenceValue<\"animation\">;\n}): ShowBattleAnimationDslCommand {\n  return {\n    kind: \"showBattleAnimation\",\n    target: input.target,\n    animation: input.animation,\n  };\n}\n\nexport function forceAction(input: {\n  subject: BattlerCommandTarget;\n  skill: