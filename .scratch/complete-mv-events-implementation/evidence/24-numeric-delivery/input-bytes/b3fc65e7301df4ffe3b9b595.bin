//#region src/validation/identities.ts
function validateDeclarationIdentities(declarations, issues, snapshotMaps, snapshotTroops) {
	const mapEventIdentities = /* @__PURE__ */ new Set();
	const commonEventIds = /* @__PURE__ */ new Set();
	const switchIds = /* @__PURE__ */ new Set();
	const variableIds = /* @__PURE__ */ new Set();
	const troopIds = /* @__PURE__ */ new Set();
	const snapshotMapsById = snapshotMaps === void 0 ? void 0 : new Map(snapshotMaps.map((map) => [map.id, map]));
	const occupiedCoordinates = /* @__PURE__ */ new Set();
	for (const declaration of declarations) switch (declaration.kind) {
		case "troopEvent":
			if (!Number.isSafeInteger(declaration.troopId) || declaration.troopId <= 0 || !snapshotTroops?.some(({ id }) => id === declaration.troopId)) issues.push({
				level: "error",
				code: "MV-TROOP-IDENTITY",
				stage: "compile",
				identity: `troop:${declaration.troopId}`,
				dslPath: "troopId",
				expected: "positive existing Snapshot Troop identity",
				actual: describeValue(declaration.troopId),
				message: `compile error troop:${declaration.troopId}: MV-TROOP-IDENTITY at troopId; expected positive existing Snapshot Troop identity; actual ${describeValue(declaration.troopId)}.`
			});
			if (troopIds.has(declaration.troopId)) issues.push({
				level: "error",
				code: "MV-TROOP-IDENTITY-DUPLICATE",
				stage: "compile",
				identity: `troop:${declaration.troopId}`,
				dslPath: "troopId",
				expected: "unique Troop Event identity",
				actual: describeValue(declaration.troopId),
				message: `compile error troop:${declaration.troopId}: MV-TROOP-IDENTITY-DUPLICATE at troopId; expected unique Troop Event identity; actual ${describeValue(declaration.troopId)}.`
			});
			troopIds.add(declaration.troopId);
			break;
		case "mapEvent":
			validatePositiveInteger(declaration.mapId, "Map event mapId", declaration.name, issues);
			validatePositiveInteger(declaration.id, "Map event id", declaration.name, issues);
			trackUniqueIdentity(mapEventIdentities, mapEventIdentityKey(declaration), `Duplicate Map Event identity: mapId ${declaration.mapId}, eventId ${declaration.id}.`, issues);
			if (declaration.pages.length === 0) issues.push({
				level: "error",
				message: `Map event "${declaration.name}" must contain at least one page.`
			});
			if (declaration.pages.length > 20) issues.push({
				level: "warning",
				code: "MV-MAP-PAGE-COUNT",
				message: `Map event "${declaration.name}" has ${declaration.pages.length} pages; the editor creates at most 20. Page order and count are preserved.`
			});
			validateMapEventPlacement(declaration, snapshotMapsById, occupiedCoordinates, issues);
			break;
		case "commonEvent":
			validatePositiveInteger(declaration.id, "Common event id", declaration.name, issues);
			trackUniqueIdentity(commonEventIds, declaration.id, `Duplicate Common Event id: ${declaration.id}.`, issues);
			break;
		case "switchDefinition":
			validatePositiveInteger(declaration.id, "Switch id", declaration.name, issues);
			validateNonEmptyName(declaration.name, "Switch", issues);
			trackUniqueIdentity(switchIds, declaration.id, `Duplicate Switch id: ${declaration.id}.`, issues);
			break;
		case "variableDefinition":
			validatePositiveInteger(declaration.id, "Variable id", declaration.name, issues);
			validateNonEmptyName(declaration.name, "Variable", issues);
			trackUniqueIdentity(variableIds, declaration.id, `Duplicate Variable id: ${declaration.id}.`, issues);
			break;
	}
}
function validateMapEventPlacement(declaration, snapshotMapsById, occupiedCoordinates, issues) {
	if (snapshotMapsById === void 0) return;
	const map = snapshotMapsById.get(declaration.mapId);
	if (map === void 0) {
		issues.push({
			level: "error",
			message: `Map event "${declaration.name}" references unknown mapId ${declaration.mapId}.`
		});
		return;
	}
	if (map.width !== void 0 && !isCoordinateInBounds(declaration.x, map.width)) issues.push({
		level: "error",
