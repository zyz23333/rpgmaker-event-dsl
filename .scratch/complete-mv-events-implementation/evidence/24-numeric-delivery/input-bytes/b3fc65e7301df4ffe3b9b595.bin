	const snapshotOccupant = map.eventLocations.find((event) => event.eventId !== declaration.id && event.x === declaration.x && event.y === declaration.y);
	if (occupiedCoordinates.has(coordinateKey) || snapshotOccupant !== void 0) issues.push({
		level: "warning",
