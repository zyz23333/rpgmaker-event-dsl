//#region src/compiler/dispatch.ts
function compileNodes(nodes, indent, resolver, includeTerminator = true, sourcePath = "commands", origins = /* @__PURE__ */ new Map()) {
	assertDslCommandList(nodes, sourcePath);
	const output = [];
	for (const [nodeIndex, node] of nodes.entries()) {
		assertMapAppearanceInput(node.kind, node, `${sourcePath}[${nodeIndex}]`, true, resolver);
		const outputStart = output.length;
		switch (node.kind) {
			case "showText":
				output.push({
