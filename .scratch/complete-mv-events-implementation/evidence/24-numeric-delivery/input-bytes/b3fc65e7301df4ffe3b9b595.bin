function scriptGateIssue(nativePath, options, dslPath) {
	const level = options.stage === "compile" ? "error" : "warning";
	return {
		code: "MV-SCRIPT-GATE",
		level,
		stage: options.stage,
		identity: options.identity,
		nativePath,
		expected: "scriptEnabled: true",
		actual: "scriptEnabled: false",
		...dslPath ? { dslPath } : {},
		message: `${options.stage} ${level} ${options.identity}: MV-SCRIPT-GATE at ${nativePath}: Script commands require explicit config enablement; expected scriptEnabled: true; actual scriptEnabled: false.`
	};
}
function inspectNativeRouteInputs(route, path, options, dslPath) {
	return route.list.flatMap((record, index) => {
		if (record.code !== 45) return [];
		const native = `${path}.list[${index}].parameters[0]`;
		const authored = dslPath ? `${dslPath}.commands[${index}].script.code` : void 0;
		return [...movementStringRisk(record.parameters[0], native, options, authored), ...options.scriptEnabled ? [] : [scriptGateIssue(native, options, authored)]];
	});
}
function movementStringRisk(value, nativePath, options, dslPath) {
	if (!value.includes("\n") && !value.includes("\r")) return [];
	const reasons = [...value.includes("\n") ? ["LF exceeds the native single-line input"] : [], ...value.includes("\r") ? ["CR preservation on parameter reconfirmation needs native verification"] : []];
	return [{
		code: "MV-MOVEMENT-TEXT-RISK",
		level: "warning",
		stage: options.stage,
		identity: options.identity,
		nativePath,
		...dslPath === void 0 ? {} : { dslPath },
		expected: "Complete saved single-slot text retained; parameter reconfirmation may differ",
		actual: JSON.stringify(value),
		message: `${options.stage} warning ${options.identity}: MV-MOVEMENT-TEXT-RISK at ${nativePath}: ${reasons.join("; ")}. Saved text is retained exactly.`
	}];
}
function inspectNativeCommandInputs(commands, options) {
