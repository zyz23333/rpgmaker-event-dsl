t === \"number\" && operator !== null\n    ? {\n        expression: `{ kind: \"gold\", amount: ${amount}, operator: ${literal(operator)} }`,\n        helperNames: [],\n      }\n    : null;\n}\n\nexport function renderItemCondition(\n  parameters: readonly unknown[],\n): { expression: string; helperNames: readonly string[] } | null {\n  const itemId = readPositiveInteger(parameters[1]);\n  return itemId === null\n    ? null\n    : {\n        expression: `{ kind: \"item\", item: itemRef({ id: ${itemId} }) }`,\n        helperNames: [\"itemRef\"],\n      };\n}\n\nexport function renderWeaponCondition(\n  parameters: readonly unknown[],\n): { expression: string; helperNames: readonly string[] } | null {\n  const weaponId = readPositiveInteger(parameters[1]);\n  return weaponId === null || typeof parameters[2] !== \"boolean\"\n    ? null\n    : {\n        expression: `{ kind: \"weapon\", weapon: weaponRef({ id: ${weaponId} }), includeEquipment: ${parameters[2]} }`,\n        helperNames: [\"weaponRef\"],\n      };\n}\n\nexport function renderArmorCondition(\n  parameters: readonly unknown[],\n): { expression: string; helperNames: readonly string[] } | null {\n  const armorId = readPositiveInteger(parameters[1]);\n  return armorId === null || typeof parameters[2] !== \"boolean\"\n    ? null\n    : {\n        expression: `{ kind: \"armor\", armor: armorRef({ id: ${armorId} }), includeEquipment: ${parameters[2]} }`,\n        helperNames: [\"armorRef\"],\n      };\n}\n\nexport function renderButtonCondition(\n  parameters: readonly unknown[],\n): { expression: string; helperNames: readonly string[] } | null {\n  return isButtonName(parameters[1])\n    ? {\n        expression: `{ kind: \"button\", button: ${literal(parameters[1])} }`,\n        helperNames: [],\n      }\n    : null;\n}\n\nexport function renderVehicleCondition(\n  parameters: readonly unknown[],\n): { expression: string; helperNames: readonly string[] } | null {\n  const vehicle = vehicleFromCode(parameters[1]);\n\n  return vehicle === null\n    ? null\n    : {\n        expression: `{ kind: \"vehicle\", vehicle: ${literal(vehicle)} }`,\n        helperNames: [],\n      };\n}\n\nexport function vehicleFromCode(value: unknown): \"boat\" | \"ship\" | \"airship\" | null {\n  if (value === 0) {\n    return \"boat\";\n  }\n  if (value === 1) {\n    return \"ship\";\n  }\n  if (value === 2) {\n    return \"airship\";\n  }\n\n  return null;\n}\n\nexport function findConditionalBranchBodyEnd(\n  commands: readonly RawEventCommand[],\n  startIndex: number,\n  parentIndent: number,\n): number {\n  let index = startIndex;\n\n  while (index < commands.length) {\n    const command = commands[index];\n    if (command === undefined || command.indent < parentIndent) {\n      break;\n    }\n    if (command.indent === parentIndent && (command.code === 411 || command.code === 412)) {\n      break;\n    }\n    if (command.indent <= parentIndent) {\n      break;\n    }\n    index += 1;\n  }\n\n  return index;\n}\n\nexport function findLoopBodyEnd(\n  commands: readonly RawEventCommand[],\n  startIndex: number,\n  parentIndent: number,\n): number {\n  let index = startIndex;\n\n  while (index < commands.length) {\n    const command = commands[index];\n    if (command === undefined || command.indent < parentIndent) {\n      break;\n    }\n    if (command.indent === parentIndent && command.code === 413) {\n      break;\n    }\n    if (command.indent <= parentIndent) {\n      break;\n    }\n    index += 1;\n  }\n\n  if (commands[index]?.code !== 413 || commands[index]?.indent !== parentIndent) {\n    throw new Error(`MV-STRUCTURE: Loop at native command ${startIndex - 1} has no matching413.`);\n  }\n  return index;\n}\n\nexport function conditionalVariableOperatorFromCode(\n  value: unknown,\n): \"eq\" | \"ge\" | \"le\" | \"gt\" | \"lt\" | \"ne\" | null {\n  switch (value) {\n    case 0:\n      return \"eq\";\n    case 1:\n      return \"ge\";\n    case 2:\n      return \"le\";\n    case 3:\n      return \"gt\";\n    case 4:\n      return \"lt\";\n    case 5:\n      return \"ne\";\n    default:\n      return null;\n  }\n}\n\nexport function isButtonName(\n  value: unknown,\n): value is \"ok\" | \"cancel\" | \"shift\" | \"down\" | \"left\" | \"right\" | \"up\" | \"pageup\" | \"pagedown\" {\n  return (\n    value === \"ok\" ||\n    value === \"cancel\" ||\n    value === \"shift\" ||\n    value === \"down\" ||\n    value === \"left\" ||\n    value === \"right\" ||\n    value === \"up\" ||\n    value === \"pageup\" ||\n    value === \"pagedown\"\n  );\n}\n","import type { RawEventCommand, RenderedCommand } from \"../../decompiler/types.js\";\nimport {\n  isBlendMode,\n  isDirection,\n  isEventLocationDirection,\n  isFadeType,\n  literal,\n  readControlValue,\n  readPositiveInteger,\n} from \"../../decompiler/core.js\";\nimport { vehicleFromCode } from \"../flow/decompile.js\";\nimport { assertNativeMovementRoute, assertNativeMovementRecord } from \"./validation.js\";\nimport { renderJsonValue } from \"../../project-data/json-values.js\";\n\nexport function renderTransferPlayer(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const designation = command.parameters[0];\n  const direction = command.parameters[4];\n  const fadeType = command.parameters[5];\n\n  if (!isDirection(direction) || !isFadeType(fadeType)) {\n    return null;\n  }\n\n  if (designation === 0) {\n    const mapId = readPositiveInteger(command.parameters[1]);\n    const x = command.parameters[2];\n    const y = command.parameters[3];\n    return mapId === null || typeof x !== \"number\" || typeof y !== \"number\"\n      ? null\n      : {\n          expression: `transferPlayer({ destination: { kind: \"direct\", map: mapRef({ id: ${mapId} }), x: ${x}, y: ${y} }${renderOptionalDirectionAndFade(direction, fadeType)} })`,\n          helperNames: [\"mapRef\", \"transferPlayer\"],\n        };\n  }\n\n  if (designation === 1) {\n    const mapVariableId = readPositiveInteger(command.parameters[1]);\n    const xVariableId = readPositiveInteger(command.parameters[2]);\n    const yVariableId = readPositiveInteger(command.parameters[3]);\n    return mapVariableId === null || xVariableId === null || yVariableId === null\n      ? null\n      : {\n          expression: `transferPlayer({ destination: { kind: \"variables\", map: variableRef({ id: ${mapVariableId} }), x: variableRef({ id: ${xVariableId} }), y: variableRef({ id: ${yVariableId} }) }${renderOptionalDirectionAndFade(direction, fadeType)} })`,\n          helperNames: [\"transferPlayer\", \"variableRef\"],\n        };\n  }\n\n  return null;\n}\n\nexport function renderSetVehicleLocation(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const vehicle = vehicleFromCode(command.parameters[0]);\n  const designation = command.parameters[1];\n  if (vehicle === null) {\n    return null;\n  }\n\n  if (designation === 0) {\n    const mapId = readPositiveInteger(command.parameters[2]);\n    const x = command.parameters[3];\n    const y = command.parameters[4];\n    return mapId === null || typeof x !== \"number\" || typeof y !== \"number\"\n      ? null\n      : {\n          expression: `setVehicleLocation({ vehicle: ${literal(vehicle)}, destination: { kind: \"direct\", map: mapRef({ id: ${mapId} }), x: ${x}, y: ${y} } })`,\n          helperNames: [\"mapRef\", \"setVehicleLocation\"],\n        };\n  }\n\n  if (designation === 1) {\n    const mapVariableId = readPositiveInteger(command.parameters[2]);\n    const xVariableId = readPositiveInteger(command.parameters[3]);\n    const yVariableId = readPositiveInteger(command.parameters[4]);\n    return mapVariableId === null || xVariableId === null || yVariableId === null\n      ? null\n      : {\n          expression: `setVehicleLocation({ vehicle: ${literal(vehicle)}, destination: { kind: \"variables\", map: variableRef({ id: ${mapVariableId} }), x: variableRef({ id: ${xVariableId} }), y: variableRef({ id: ${yVariableId} }) } })`,\n          helperNames: [\"setVehicleLocation\", \"variableRef\"],\n        };\n  }\n\n  return null;\n}\n\nexport function renderSetEventLocation(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const character = renderCharacterRuntimeSelector(command.parameters[0]);\n  const designation = command.parameters[1];\n  const direction = command.parameters[4];\n  if (character === null || !isEventLocationDirection(direction)) {\n    return null;\n  }\n\n  if (designation === 0) {\n    const x = command.parameters[2];\n    const y = command.parameters[3];\n    return typeof x !== \"number\" || typeof y !== \"number\"\n      ? null\n      : {\n          expression: `setEventLocation({ character: ${character.expression}, destination: { kind: \"direct\", x: ${x}, y: ${y} }${renderOptionalEventDirection(direction)} })`,\n          helperNames: [\"setEventLocation\"],\n        };\n  }\n\n  if (designation === 1) {\n    const xVariableId = readPositiveInteger(command.parameters[2]);\n    const yVariableId = readPositiveInteger(command.parameters[3]);\n    return xVariableId === null || yVariableId === null\n      ? null\n      : {\n          expression: `setEventLocation({ character: ${character.expression}, destination: { kind: \"variables\", x: variableRef({ id: ${xVariableId} }), y: variableRef({ id: ${yVariableId} }) }${renderOptionalEventDirection(direction)} })`,\n          helperNames: [\"setEventLocation\", \"variableRef\"],\n        };\n  }\n\n  if (designation === 2) {\n    const exchangeCharacter = renderCharacterRuntimeSelector(command.parameters[2]);\n    return exchangeCharacter === null\n      ? null\n      : {\n          expression: `setEventLocation({ character: ${character.expression}, destination: { kind: \"exchange\", character: ${exchangeCharacter.expression} }${renderOptionalEventDirection(direction)} })`,\n          helperNames: [\"setEventLocation\"],\n        };\n  }\n\n  return null;\n}\n\nexport function renderScrollMap(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const direction = command.parameters[0];\n  const distance = command.parameters[1];\n  const speed = command.parameters[2];\n\n  return isDirection(direction) && typeof distance === \"number\" && typeof speed === \"number\"\n    ? {\n        expression: `scrollMap({ direction: ${direction}, distance: ${distance}, speed: ${speed} })`,\n        helperNames: [\"scrollMap\"],\n      }\n    : null;\n}\n\nexport function renderSetMovementRoute(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const target = renderCharacterRuntimeSelector(command.parameters[0]);\n  const route = command.parameters[1];\n\n  if (target === null || !route || typeof route !== \"object\" || Array.isArray(route)) {\n    return null;\n  }\n\n  const routeRecord = route as Record<string, unknown>;\n  if (\n    !Array.isArray(routeRecord.list) ||\n    typeof routeRecord.repeat !== \"boolean\" ||\n    typeof routeRecord.skippable !== \"boolean\" ||\n    typeof routeRecord.wait !== \"boolean\"\n  ) {\n    return null;\n  }\n\n  const renderedRoute = renderMovementRoute(routeRecord);\n  if (renderedRoute === null) return null;\n\n  return {\n    expression: `setMovementRoute({ target: ${target.expression}, route: ${renderedRoute.expression} })`,\n    helperNames: [\"setMovementRoute\", ...renderedRoute.helperNames],\n  };\n}\n\nexport function renderMovementRoute(\n  route: unknown,\n): { expression: string; helperNames: string[] } | null {\n  assertNativeMovementRoute(route, \"moveRoute\");\n  const renderedRoute = renderMoveRouteCommands(route.list);\n  if (renderedRoute === null) return null;\n\n  const fields = [`commands: [${renderedRoute.expressions.join(\", \")}]`];\n  if (!route.repeat) {\n    fields.push(\"repeat: false\");\n  }\n  if (route.skippable) {\n    fields.push(\"skippable: true\");\n  }\n  if (route.wait) {\n    fields.push(\"wait: true\");\n  }\n  if (renderedRoute.terminator !== undefined) fields.push(renderedRoute.terminator);\n\n  return {\n    expression: `{ ${fields.join(\", \")} }`,\n    helperNames: renderedRoute.helperNames,\n  };\n}\n\nexport function renderChangeTransparency(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const transparent = readControlValue(command.parameters[0]);\n  return transparent === null\n    ? null\n    : {\n        expression: `changeTransparency({ transparent: ${transparent} })`,\n        helperNames: [\"changeTransparency\"],\n      };\n}\n\nexport function renderShowAnimation(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const target = renderCharacterRuntimeSelector(command.parameters[0]);\n  const animationId = readPositiveInteger(command.parameters[1]);\n  const wait = command.parameters[2];\n\n  return target === null || animationId === null || typeof wait !== \"boolean\"\n    ? null\n    : {\n        expression: `showAnimation({ target: ${target.expression}, animation: animationRef({ id: ${animationId} })${wait ? \", wait: true\" : \"\"} })`,\n        helperNames: [\"animationRef\", \"showAnimation\"],\n      };\n}\n\nexport function renderShowBalloonIcon(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const target = renderCharacterRuntimeSelector(command.parameters[0]);\n  const balloon = balloonIconFromCode(command.parameters[1]);\n  const wait = command.parameters[2];\n\n  return target === null || balloon === null || typeof wait !== \"boolean\"\n    ? null\n    : {\n        expression: `showBalloonIcon({ target: ${target.expression}, balloon: ${balloon}${wait ? \", wait: true\" : \"\"} })`,\n        helperNames: [\"showBalloonIcon\"],\n      };\n}\n\nexport function renderChangePlayerFollowers(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const visible = readControlValue(command.parameters[0]);\n  return visible === null\n    ? null\n    : {\n        expression: `changePlayerFollowers({ visible: ${visible} })`,\n        helperNames: [\"changePlayerFollowers\"],\n      };\n}\n\nexport function renderMoveRouteCommands(\n  commands: readonly unknown[],\n): { expressions: string[]; helperNames: string[]; terminator?: string } | null {\n  const expressions: string[] = [];\n  const helperNames = new Set<string>();\n  assertNativeMovementRoute(\n    { list: commands, repeat: true, skippable: false, wait: false },\n    \"moveRoute\",\n  );\n\n  for (const command of commands) {\n    if (!command || typeof command !== \"object\" || Array.isArray(command)) {\n      return null;\n    }\n\n    const record = command as Record<string, unknown>;\n    if (record.code === 0) {\n      if (\n        Object.hasOwn(record, \"parameters\") &&\n        (!Array.isArray(record.parameters) || record.parameters.length !== 0)\n      ) {\n        return null;\n      }\n      continue;\n    }\n\n    const rendered = renderMoveRouteCommand(record);\n    if (rendered === null) {\n      return null;\n    }\n\n    expressions.push(rendered.expression);\n    for (const helperName of rendered.helperNames) {\n      helperNames.add(helperName);\n    }\n  }\n\n  return {\n    expressions,\n    helperNames: [...helperNames],\n    ...(Object.hasOwn(commands.at(-1) as object, \"parameters\")\n      ? {}\n      : { terminator: 'terminator: { parameters: \"absent\" }' }),\n  };\n}\n\nexport function renderMoveRouteCommand(\n  command: Record<string, unknown>,\n): { expression: string; helperNames: readonly string[] } | null {\n  assertNativeMovementRecord(command, { nativePath: \"moveRoute.list\" });\n  const rendered = renderMoveRouteInstruction(command);\n  if (rendered === null) return null;\n  if (command.indent === null || command.indent === 0) {\n    return {\n      ...rendered,\n      expression: `${rendered.expression.slice(0, -2)}, savedShape: { indent: \"${command.indent === null ? \"null\" : \"zero\"}\" } }`,\n    };\n  }\n  return rendered;\n}\n\nfunction renderMoveRouteInstruction(\n  command: Record<string, unknown>,\n): { expression: string; helperNames: readonly string[] } | null {\n  const parameters = Array.isArray(command.parameters)\n    ? command.parameters\n    : command.parameters === undefined\n      ? []\n      : null;\n  if (typeof command.code !== \"number\" || parameters === null) {\n    return null;\n  }\n\n  const simpleExpression = moveRouteSimpleExpressionFromCode(command.code);\n  if (simpleExpression !== null) {\n    return parameters.length === 0 ? { expression: simpleExpression, helperNames: [] } : null;\n  }\n\n  switch (command.code) {\n    case 14:\n      return typeof parameters[0] === \"number\" && typeof parameters[1] === \"number\"\n        ? {\n            expression: `{ kind: \"jump\", x: ${renderJsonValue(parameters[0])}, y: ${renderJsonValue(parameters[1])} }`,\n            helperNames: [],\n          }\n        : null;\n    case 15:\n      return typeof parameters[0] === \"number\"\n        ? { expression: `{ kind: \"wait\", frames: ${parameters[0]} }`, helperNames: [] }\n        : null;\n    case 27:\n    case 28: {\n      const switchId = readPositiveInteger(parameters[0]);\n      return switchId === null\n        ? null\n        : {\n            expression: `{ kind: ${literal(command.code === 27 ? \"switchOn\" : \"switchOff\")}, switch: switchRef({ id: ${switchId} }) }`,\n            helperNames: [\"switchRef\"],\n          };\n    }\n    case 29:\n      return typeof parameters[0] === \"number\"\n        ? { expression: `{ kind: \"changeSpeed\", speed: ${parameters[0]} }`, helperNames: [] }\n        : null;\n    case 30:\n      return typeof parameters[0] === \"number\"\n        ? {\n            expression: `{ kind: \"changeFrequency\", frequency: ${parameters[0]} }`,\n            helperNames: [],\n          }\n        : null;\n    case 31:\n    case 32:\n      return {\n        expression: `{ kind: \"walkAnimation\", enabled: ${command.code === 31} }`,\n        helperNames: [],\n      };\n    case 33:\n    case 34:\n      return {\n        expression: `{ kind: \"stepAnimation\", enabled: ${command.code === 33} }`,\n        helperNames: [],\n      };\n    case 35:\n    case 36:\n      return {\n        expression: `{ kind: \"directionFix\", enabled: ${command.code === 35} }`,\n        helperNames: [],\n      };\n    case 37:\n    case 38:\n      return {\n        expression: `{ kind: \"through\", enabled: ${command.code === 37} }`,\n        helperNames: [],\n      };\n    case 39:\n    case 40:\n      return {\n        expression: `{ kind: \"transparent\", enabled: ${command.code === 39} }`,\n        helperNames: [],\n      };\n    case 41:\n      return typeof parameters[0] === \"string\" && typeof parameters[1] === \"number\"\n        ? {\n            expression: `{ kind: \"changeImage\", character: ${parameters[0] === \"\" ? \"null\" : `imageAsset({ folder: \"characters\", name: ${literal(parameters[0])} })`}, characterIndex: ${renderJsonValue(parameters[1])} }`,\n            helperNames: parameters[0] === \"\" ? [] : [\"imageAsset\"],\n          }\n        : null;\n    case 42:\n      return typeof parameters[0] === \"number\"\n        ? {\n            expression: `{ kind: \"changeOpacity\", opacity: ${renderJsonValue(parameters[0])} }`,\n            helperNames: [],\n          }\n        : null;\n    case 43:\n      return isBlendMode(parameters[0])\n        ? {\n            expression: `{ kind: \"changeBlendMode\", blendMode: ${literal([\"normal\", \"additive\", \"multiply\", \"screen\"][parameters[0]])} }`,\n            helperNames: [],\n          }\n        : null;\n    case 44:\n      return renderMoveRoutePlaySe(parameters[0]);\n    case 45:\n      return typeof parameters[0] === \"string\"\n        ? {\n            expression: `{ kind: \"script\", script: scriptInput({ code: ${literal(parameters[0])} }) }`,\n            helperNames: [\"scriptInput\"],\n          }\n        : null;\n    default:\n      return null;\n  }\n}\n\nexport function moveRouteSimpleExpressionFromCode(code: number): string | null {\n  switch (code) {\n    case 1:\n      return `{ kind: \"moveDown\" }`;\n    case 2:\n      return `{ kind: \"moveLeft\" }`;\n    case 3:\n      return `{ kind: \"moveRight\" }`;\n    case 4:\n      return `{ kind: \"moveUp\" }`;\n    case 5:\n      return `{ kind: \"moveLowerLeft\" }`;\n    case 6:\n      return `{ kind: \"moveLowerRight\" }`;\n    case 7:\n      return `{ kind: \"moveUpperLeft\" }`;\n    case 8:\n      return `{ kind: \"moveUpperRight\" }`;\n    case 9:\n      return `{ kind: \"moveRandom\" }`;\n    case 10:\n      return `{ kind: \"moveTowardPlayer\" }`;\n    case 11:\n      return `{ kind: \"moveAwayFromPlayer\" }`;\n    case 12:\n      return `{ kind: \"moveForward\" }`;\n    case 13:\n      return `{ kind: \"moveBackward\" }`;\n    case 16:\n      return `{ kind: \"turnDown\" }`;\n    case 17:\n      return `{ kind: \"turnLeft\" }`;\n    case 18:\n      return `{ kind: \"turnRight\" }`;\n    case 19:\n      return `{ kind: \"turnUp\" }`;\n    case 20:\n      return `{ kind: \"turn90Right\" }`;\n    case 21:\n      return `{ kind: \"turn90Left\" }`;\n    case 22:\n      return `{ kind: \"turn180\" }`;\n    case 23:\n      return `{ kind: \"turn90RightOrLeft\" }`;\n    case 24:\n      return `{ kind: \"turnRandom\" }`;\n    case 25:\n      return `{ kind: \"turnTowardPlayer\" }`;\n    case 26:\n      return `{ kind: \"turnAwayFromPlayer\" }`;\n    default:\n      return null;\n  }\n}\n\nexport function renderMoveRoutePlaySe(\n  value: unknown,\n): { expression: string; helperNames: readonly string[] } | null {\n  if (!value || typeof value !== \"object\" || Array.isArray(value)) {\n    return null;\n  }\n\n  const audio = value as Record<string, unknown>;\n  if (\n    typeof audio.name !== \"string\" ||\n    typeof audio.volume !== \"number\" ||\n    typeof audio.pitch !== \"number\" ||\n    typeof audio.pan !== \"number\"\n  ) {\n    return null;\n  }\n\n  return {\n    expression: `{ kind: \"playSe\", audio: { asset: ${audio.name === \"\" ? \"null\" : `audioAsset({ folder: \"se\", name: ${literal(audio.name)} })`}, volume: ${renderJsonValue(audio.volume)}, pitch: ${renderJsonValue(audio.pitch)}, pan: ${renderJsonValue(audio.pan)} } }`,\n    helperNames: audio.name === \"\" ? [] : [\"audioAsset\"],\n  };\n}\n\nexport function renderCharacterRuntimeSelector(\n  value: unknown,\n): { expression: string; helperNames: readonly string[] } | null {\n  if (value === -1) {\n    return {\n      expression: `{ kind: \"runtimeSelector\", scope: \"character\", target: \"player\" }`,\n      helperNames: [],\n    };\n  }\n  if (value === 0) {\n    return {\n      expression: `{ kind: \"runtimeSelector\", scope: \"character\", target: \"currentEvent\" }`,\n      helperNames: [],\n    };\n  }\n  if (typeof value === \"number\" && Number.isInteger(value) && value > 0) {\n    return {\n      expression: `{ kind: \"runtimeSelector\", scope: \"character\", target: \"event\", id: ${value} }`,\n      helperNames: [],\n    };\n  }\n\n  return null;\n}\n\nexport function renderOptionalDirectionAndFade(\n  direction: 2 | 4 | 6 | 8,\n  fadeType: 0 | 1 | 2,\n): string {\n  const fields: string[] = [];\n  if (direction !== 2) {\n    fields.push(`direction: ${direction}`);\n  }\n  if (fadeType !== 0) {\n    fields.push(`fadeType: ${fadeType}`);\n  }\n\n  return fields.length === 0 ? \"\" : `, ${fields.join(\", \")}`;\n}\n\nexport function renderOptionalEventDirection(direction: 0 | 2 | 4 | 6 | 8): string {\n  return direction === 0 ? \"\" : `, direction: ${direction}`;\n}\n\nexport function balloonIconFromCode(value: unknown): string | null {\n  switch (value) {\n    case 1:\n      return '\"exclamation\"';\n    case 2:\n      return '\"question\"';\n    case 3:\n      return '\"musicNote\"';\n    case 4:\n      return '\"heart\"';\n    case 5:\n      return '\"anger\"';\n    case 6:\n      return '\"sweat\"';\n    case 7:\n      return '\"cobweb\"';\n    case 8:\n      return '\"silence\"';\n    case 9:\n      return '\"lightBulb\"';\n    case 10:\n      return '\"zzz\"';\n    default:\n      return typeof value === \"number\" && Number.isInteger(value) && value > 0\n        ? String(value)\n        : null;\n  }\n}\n","import type { RawEventCommand, RenderedCommand } from \"../../decompiler/types.js\";\nimport { isBlendMode, isNumberTuple, literal, readPositiveInteger } from \"../../decompiler/core.js\";\n\nexport function renderTintScreen(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const tone = renderTone(command.parameters[0]);\n  const duration = command.parameters[1];\n  const wait = command.parameters[2];\n\n  return tone === null || typeof duration !== \"number\" || typeof wait !== \"boolean\"\n    ? null\n    : {\n        expression: `tintScreen({ tone: ${tone}, duration: ${duration}${wait ? \", wait: true\" : \"\"} })`,\n        helperNames: [\"tintScreen\"],\n      };\n}\n\nexport function renderFlashScreen(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const color = renderColor(command.parameters[0]);\n  const duration = command.parameters[1];\n  const wait = command.parameters[2];\n\n  return color === null || typeof duration !== \"number\" || typeof wait !== \"boolean\"\n    ? null\n    : {\n        expression: `flashScreen({ color: ${color}, duration: ${duration}${wait ? \", wait: true\" : \"\"} })`,\n        helperNames: [\"flashScreen\"],\n      };\n}\n\nexport function renderShakeScreen(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const power = command.parameters[0];\n  const speed = command.parameters[1];\n  const duration = command.parameters[2];\n  const wait = command.parameters[3];\n\n  return typeof power !== \"number\" ||\n    typeof speed !== \"number\" ||\n    typeof duration !== \"number\" ||\n    typeof wait !== \"boolean\"\n    ? null\n    : {\n        expression: `shakeScreen({ power: ${power}, speed: ${speed}, duration: ${duration}${wait ? \", wait: true\" : \"\"} })`,\n        helperNames: [\"shakeScreen\"],\n      };\n}\n\nexport function renderShowPicture(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const pictureId = readPositiveInteger(command.parameters[0]);\n  const imageName = command.parameters[1];\n  const position = renderPicturePosition(\n    command.parameters[2],\n    command.parameters[3],\n    command.parameters[4],\n    command.parameters[5],\n  );\n  const display = renderPictureDisplay(\n    command.parameters[6],\n    command.parameters[7],\n    command.parameters[8],\n    command.parameters[9],\n  );\n\n  return pictureId === null ||\n    typeof imageName !== \"string\" ||\n    position === null ||\n    display === null\n    ? null\n    : {\n        expression: `showPicture({ pictureId: ${pictureId}, image: imageAsset({ folder: \"pictures\", name: ${literal(imageName)} }), position: ${position.expression}${display} })`,\n        helperNames: [\"imageAsset\", \"showPicture\", ...position.helperNames],\n      };\n}\n\nexport function renderMovePicture(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const pictureId = readPositiveInteger(command.parameters[0]);\n  const position = renderPicturePosition(\n    command.parameters[2],\n    command.parameters[3],\n    command.parameters[4],\n    command.parameters[5],\n  );\n  const display = renderPictureDisplay(\n    command.parameters[6],\n    command.parameters[7],\n    command.parameters[8],\n    command.parameters[9],\n  );\n  const duration = command.parameters[10];\n  const wait = command.parameters[11];\n\n  return pictureId === null ||\n    position === null ||\n    display === null ||\n    typeof duration !== \"number\" ||\n    typeof wait !== \"boolean\"\n    ? null\n    : {\n        expression: `movePicture({ pictureId: ${pictureId}, position: ${position.expression}${display}, duration: ${duration}${wait ? \", wait: true\" : \"\"} })`,\n        helperNames: [\"movePicture\", ...position.helperNames],\n      };\n}\n\nexport function renderRotatePicture(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const pictureId = readPositiveInteger(command.parameters[0]);\n  const speed = command.parameters[1];\n\n  return pictureId === null || typeof speed !== \"number\"\n    ? null\n    : {\n        expression: `rotatePicture({ pictureId: ${pictureId}, speed: ${speed} })`,\n        helperNames: [\"rotatePicture\"],\n      };\n}\n\nexport function renderTintPicture(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const pictureId = readPositiveInteger(command.parameters[0]);\n  const tone = renderTone(command.parameters[1]);\n  const duration = command.parameters[2];\n  const wait = command.parameters[3];\n\n  return pictureId === null ||\n    tone === null ||\n    typeof duration !== \"number\" ||\n    typeof wait !== \"boolean\"\n    ? null\n    : {\n        expression: `tintPicture({ pictureId: ${pictureId}, tone: ${tone}, duration: ${duration}${wait ? \", wait: true\" : \"\"} })`,\n        helperNames: [\"tintPicture\"],\n      };\n}\n\nexport function renderErasePicture(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const pictureId = readPositiveInteger(command.parameters[0]);\n  return pictureId === null\n    ? null\n    : {\n        expression: `erasePicture({ pictureId: ${pictureId} })`,\n        helperNames: [\"erasePicture\"],\n      };\n}\n\nexport function renderSetWeatherEffect(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const weather = weatherEffectFromCode(command.parameters[0]);\n  const power = command.parameters[1];\n  const duration = command.parameters[2];\n  const wait = command.parameters[3];\n\n  return weather === null ||\n    typeof power !== \"number\" ||\n    typeof duration !== \"number\" ||\n    typeof wait !== \"boolean\"\n    ? null\n    : {\n        expression: `setWeatherEffect({ weather: ${literal(weather)}, power: ${power}, duration: ${duration}${wait ? \", wait: true\" : \"\"} })`,\n        helperNames: [\"setWeatherEffect\"],\n      };\n}\n\nexport function renderPicturePosition(\n  originParameter: unknown,\n  designation: unknown,\n  xParameter: unknown,\n  yParameter: unknown,\n): { expression: string; helperNames: readonly string[] } | null {\n  const origin = pictureOriginFromCode(originParameter);\n  if (origin === null) {\n    return null;\n  }\n\n  if (designation === 0 && typeof xParameter === \"number\" && typeof yParameter === \"number\") {\n    return {\n      expression: `{ kind: \"direct\", x: ${xParameter}, y: ${yParameter}${origin === \"center\" ? ', origin: \"center\"' : \"\"} }`,\n      helperNames: [],\n    };\n  }\n\n  if (designation === 1) {\n    const xVariableId = readPositiveInteger(xParameter);\n    const yVariableId = readPositiveInteger(yParameter);\n    return xVariableId === null || yVariableId === null\n      ? null\n      : {\n          expression: `{ kind: \"variables\", x: variableRef({ id: ${xVariableId} }), y: variableRef({ id: ${yVariableId} })${origin === \"center\" ? ', origin: \"center\"' : \"\"} }`,\n          helperNames: [\"variableRef\"],\n        };\n  }\n\n  return null;\n}\n\nexport function renderCommandPosition(\n  designation: unknown,\n  xParameter: unknown,\n  yParameter: unknown,\n): { expression: string; helperNames: readonly string[] } | null {\n  if (designation === 0 && typeof xParameter === \"number\" && typeof yParameter === \"number\") {\n    return {\n      expression: `{ kind: \"direct\", x: ${xParameter}, y: ${yParameter} }`,\n      helperNames: [],\n    };\n  }\n\n  if (designation === 1) {\n    const xVariableId = readPositiveInteger(xParameter);\n    const yVariableId = readPositiveInteger(yParameter);\n    return xVariableId === null || yVariableId === null\n      ? null\n      : {\n          expression: `{ kind: \"variables\", x: variableRef({ id: ${xVariableId} }), y: variableRef({ id: ${yVariableId} }) }`,\n          helperNames: [\"variableRef\"],\n        };\n  }\n\n  return null;\n}\n\nexport function renderPictureDisplay(\n  scaleX: unknown,\n  scaleY: unknown,\n  opacity: unknown,\n  blendMode: unknown,\n): string | null {\n  if (\n    typeof scaleX !== \"number\" ||\n    typeof scaleY !== \"number\" ||\n    typeof opacity !== \"number\" ||\n    !isBlendMode(blendMode)\n  ) {\n    return null;\n  }\n\n  const fields: string[] = [];\n  if (scaleX !== 100) {\n    fields.push(`scaleX: ${scaleX}`);\n  }\n  if (scaleY !== 100) {\n    fields.push(`scaleY: ${scaleY}`);\n  }\n  if (opacity !== 255) {\n    fields.push(`opacity: ${opacity}`);\n  }\n  if (blendMode !== 0) {\n    fields.push(`blendMode: ${blendMode}`);\n  }\n\n  return fields.length === 0 ? \"\" : `, ${fields.join(\", \")}`;\n}\n\nexport function renderTone(value: unknown): string | null {\n  return isNumberTuple(value, 4) ? literal(value) : null;\n}\n\nexport function renderColor(value: unknown): string | null {\n  return isNumberTuple(value, 4) ? literal(value) : null;\n}\n\nexport function pictureOriginFromCode(value: unknown): \"upperLeft\" | \"center\" | null {\n  if (value === 0) {\n    return \"upperLeft\";\n  }\n  if (value === 1) {\n    return \"center\";\n  }\n\n  return null;\n}\n\nexport function weatherEffectFromCode(value: unknown): \"none\" | \"rain\" | \"storm\" | \"snow\" | null {\n  if (value === \"none\" || value === \"rain\" || value === \"storm\" || value === \"snow\") {\n    return value;\n  }\n\n  return null;\n}\n","import type { RawEventCommand, RenderedCommand } from \"../../decompiler/types.js\";\nimport { literal } from \"../../decompiler/core.js\";\nimport { vehicleFromCode } from \"../flow/decompile.js\";\n\nexport function renderAudioCommand(\n  command: RawEventCommand,\n  helperName: string,\n  folder: \"bgm\" | \"bgs\" | \"me\" | \"se\",\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const audio = renderAudioPayload(command.parameters[0], folder);\n  return audio === null\n    ? null\n    : {\n        expression: `${helperName}({ audio: ${audio} })`,\n        helperNames: [\"audioAsset\", helperName],\n      };\n}\n\nexport function renderDurationCommand(\n  command: RawEventCommand,\n  helperName: string,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const duration = command.parameters[0];\n  return typeof duration !== \"number\"\n    ? null\n    : {\n        expression: `${helperName}({ duration: ${duration} })`,\n        helperNames: [helperName],\n      };\n}\n\nexport function renderChangeVehicleBgm(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const vehicle = vehicleFromCode(command.parameters[0]);\n  const audio = renderAudioPayload(command.parameters[1], \"bgm\");\n  return vehicle === null || audio === null\n    ? null\n    : {\n        expression: `changeVehicleBgm({ vehicle: ${literal(vehicle)}, audio: ${audio} })`,\n        helperNames: [\"audioAsset\", \"changeVehicleBgm\"],\n      };\n}\n\nexport function renderPlayMovie(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const movieName = command.parameters[0];\n  return typeof movieName !== \"string\"\n    ? null\n    : {\n        expression: `playMovie({ movie: movieAsset({ name: ${literal(movieName)} }) })`,\n        helperNames: [\"movieAsset\", \"playMovie\"],\n      };\n}\n\nexport function renderAudioPayload(\n  value: unknown,\n  folder: \"bgm\" | \"bgs\" | \"me\" | \"se\",\n): string | null {\n  if (!value || typeof value !== \"object\" || Array.isArray(value)) {\n    return null;\n  }\n\n  const audio = value as Record<string, unknown>;\n  if (\n    typeof audio.name !== \"string\" ||\n    typeof audio.volume !== \"number\" ||\n    typeof audio.pitch !== \"number\" ||\n    typeof audio.pan !== \"number\"\n  ) {\n    return null;\n  }\n\n  return `{ asset: audioAsset({ folder: ${literal(folder)}, name: ${literal(audio.name)} }), volume: ${audio.volume}, pitch: ${audio.pitch}, pan: ${audio.pan} }`;\n}\n","import type { RawEventCommand, RenderedCommand } from \"../../decompiler/types.js\";\nimport { literal, readPositiveInteger } from \"../../decompiler/core.js\";\nimport { renderCommandPosition } from \"../screen/decompile.js\";\n\nexport function renderChangeTileset(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const tilesetId = readPositiveInteger(command.parameters[0]);\n  return tilesetId === null\n    ? null\n    : {\n        expression: `changeTileset({ tileset: tilesetRef({ id: ${tilesetId} }) })`,\n        helperNames: [\"changeTileset\", \"tilesetRef\"],\n      };\n}\n\nexport function renderChangeBattleBack(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const battleback1 = command.parameters[0];\n  const battleback2 = command.parameters[1];\n  return typeof battleback1 !== \"string\" || typeof battleback2 !== \"string\"\n    ? null\n    : {\n        expression: `changeBattleBack({ battleback1: ${battleback1 === \"\" ? \"null\" : `imageAsset({ folder: \"battlebacks1\", name: ${literal(battleback1)} })`}, battleback2: ${battleback2 === \"\" ? \"null\" : `imageAsset({ folder: \"battlebacks2\", name: ${literal(battleback2)} })`} })`,\n        helperNames: [\n          \"changeBattleBack\",\n          ...(battleback1 !== \"\" || battleback2 !== \"\" ? [\"imageAsset\"] : []),\n        ],\n      };\n}\n\nexport function renderChangeParallax(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const imageName = command.parameters[0];\n  const loopX = command.parameters[1];\n  const loopY = command.parameters[2];\n  const sx = command.parameters[3];\n  const sy = command.parameters[4];\n\n  if (\n    typeof imageName !== \"string\" ||\n    typeof loopX !== \"boolean\" ||\n    typeof loopY !== \"boolean\" ||\n    typeof sx !== \"number\" ||\n    typeof sy !== \"number\"\n  ) {\n    return null;\n  }\n\n  return {\n    expression: `changeParallax({ image: ${imageName === \"\" ? \"null\" : `imageAsset({ folder: \"parallaxes\", name: ${literal(imageName)} })`}, loopX: ${loopX}, loopY: ${loopY}, sx: ${literal(sx)}, sy: ${literal(sy)} })`,\n    helperNames: [\"changeParallax\", ...(imageName === \"\" ? [] : [\"imageAsset\"])],\n  };\n}\n\nexport function renderGetLocationInfo(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const variableId = readPositiveInteger(command.parameters[0]);\n  const info = locationInfoTypeFromCode(command.parameters[1]);\n  const location = renderCommandPosition(\n    command.parameters[2],\n    command.parameters[3],\n    command.parameters[4],\n  );\n\n  return variableId === null || info === null || location === null\n    ? null\n    : {\n        expression: `getLocationInfo({ variable: variableRef({ id: ${variableId} }), info: ${literal(info)}, location: ${location.expression} })`,\n        helperNames: [\"getLocationInfo\", \"variableRef\", ...location.helperNames],\n      };\n}\n\nexport function locationInfoTypeFromCode(\n  value: unknown,\n):\n  | \"terrainTag\"\n  | \"eventId\"\n  | \"tileIdLayer1\"\n  | \"tileIdLayer2\"\n  | \"tileIdLayer3\"\n  | \"tileIdLayer4\"\n  | \"regionId\"\n  | null {\n  switch (value) {\n    case 0:\n      return \"terrainTag\";\n    case 1:\n      return \"eventId\";\n    case 2:\n      return \"tileIdLayer1\";\n    case 3:\n      return \"tileIdLayer2\";\n    case 4:\n      return \"tileIdLayer3\";\n    case 5:\n      return \"tileIdLayer4\";\n    case 6:\n      return \"regionId\";\n    default:\n      return null;\n  }\n}\n","import type {\n  RawEventCommand,\n  RenderCommandList,\n  RenderedCommand,\n  RenderSimpleCommand,\n} from \"../../decompiler/types.js\";\nimport { literal, readPositiveInteger } from \"../../decompiler/core.js\";\nimport { findMessageBranchEnd, renderInlineCommandListSource } from \"../message/decompile.js\";\n\nexport function renderBattleProcessingCommand(\n  commands: readonly RawEventCommand[],\n  index: number,\n  renderCommandList: RenderCommandList,\n  renderSimpleCommand: RenderSimpleCommand,\n): RenderedCommand {\n  const command = commands[index];\n  if (command === undefined) {\n    throw new Error(\"Cannot render missing Battle Processing command.\");\n  }\n\n  const troop = renderBattleTroop(command.parameters);\n  if (\n    troop === null ||\n    typeof command.parameters[2] !== \"boolean\" ||\n    typeof command.parameters[3] !== \"boolean\"\n  ) {\n    return renderSimpleCommand(command, index);\n  }\n\n  const helperNames = new Set<string>([\"battleProcessing\", ...troop.helperNames]);\n  const fields = [`troop: ${troop.expression}`];\n  if (command.parameters[2]) {\n    fields.push(\"canEscape: true\");\n  }\n  if (command.parameters[3]) {\n    fields.push(\"canLose: true\");\n  }\n\n  let nextIndex = index;\n  while (commands[nextIndex + 1]?.indent === command.indent) {\n    const branchCommand = commands[nextIndex + 1];\n    if (\n      branchCommand === undefined ||\n      (branchCommand.code !== 601 && branchCommand.code !== 602 && branchCommand.code !== 603)\n    ) {\n      break;\n    }\n\n    const branchEndIndex = findMessageBranchEnd(commands, nextIndex + 2, command.indent);\n    const rendered = renderCommandList(commands.slice(nextIndex + 2, branchEndIndex));\n    for (const helperName of rendered.helperNames) {\n      helperNames.add(helperName);\n    }\n    fields.push(\n      `${battleBranchFieldName(branchCommand.code)}: [${renderInlineCommandListSource(rendered.source)}]`,\n    );\n    nextIndex = branchEndIndex - 1;\n  }\n\n  if (commands[nextIndex + 1]?.code === 604 && commands[nextIndex + 1]?.indent === command.indent) {\n    nextIndex += 1;\n  }\n\n  return {\n    expression: `battleProcessing({ ${fields.join(\", \")} })`,\n    helperNames: [...helperNames],\n    nextIndex,\n  };\n}\n\nexport function renderShopProcessingCommand(\n  commands: readonly RawEventCommand[],\n  index: number,\n  renderSimpleCommand: RenderSimpleCommand,\n): RenderedCommand {\n  const command = commands[index];\n  if (command === undefined) {\n    throw new Error(\"Cannot render missing Shop Processing command.\");\n  }\n\n  const firstGoods = renderShopGoods(command.parameters);\n  const allowSelling = command.parameters[4];\n  if (firstGoods === null || typeof allowSelling !== \"boolean\") {\n    return renderSimpleCommand(command, index);\n  }\n\n  const goods = [firstGoods.expression];\n  const helperNames = new Set<string>([\"shopProcessing\", ...firstGoods.helperNames]);\n  let nextIndex = index;\n\n  while (\n    commands[nextIndex + 1]?.code === 605 &&\n    commands[nextIndex + 1]?.indent === command.indent\n  ) {\n    const renderedGoods = renderShopGoods(commands[nextIndex + 1]?.parameters ?? []);\n    if (renderedGoods === null) {\n      break;\n    }\n    goods.push(renderedGoods.expression);\n    for (const helperName of renderedGoods.helperNames) {\n      helperNames.add(helperName);\n    }\n    nextIndex += 1;\n  }\n\n  const fields = [`goods: [${goods.join(\", \")}]`];\n  if (allowSelling) {\n    fields.push(\"allowSelling: true\");\n  }\n\n  return {\n    expression: `shopProcessing({ ${fields.join(\", \")} })`,\n    helperNames: [...helperNames],\n    nextIndex,\n  };\n}\n\nexport function renderBattleTroop(\n  parameters: readonly unknown[],\n): { expression: string; helperNames: readonly string[] } | null {\n  if (parameters[0] === 0) {\n    const troopId = readPositiveInteger(parameters[1]);\n    return troopId === null\n      ? null\n      : {\n          expression: `troopRef({ id: ${troopId} })`,\n          helperNames: [\"troopRef\"],\n        };\n  }\n\n  if (parameters[0] === 1) {\n    const variableId = readPositiveInteger(parameters[1]);\n    return variableId === null\n      ? null\n      : {\n          expression: `{ kind: \"troop\", variable: variableRef({ id: ${variableId} }) }`,\n          helperNames: [\"variableRef\"],\n        };\n  }\n\n  if (parameters[0] === 2) {\n    return {\n      expression: `{ kind: \"troop\", useRandomEncounter: true }`,\n      helperNames: [],\n    };\n  }\n\n  return null;\n}\n\nexport function battleBranchFieldName(code: number): \"escape\" | \"lose\" | \"win\" {\n  if (code === 602) {\n    return \"escape\";\n  }\n  if (code === 603) {\n    return \"lose\";\n  }\n  return \"win\";\n}\n\nexport function renderShopGoods(\n  parameters: readonly unknown[],\n): { expression: string; helperNames: readonly string[] } | null {\n  const kind = shopGoodsKindFromCode(parameters[0]);\n  const itemId = readPositiveInteger(parameters[1]);\n  const priceMode = parameters[2];\n  const price = parameters[3];\n  if (kind === null || itemId === null || (priceMode !== 0 && priceMode !== 1)) {\n    return null;\n  }\n  if (priceMode === 1 && typeof price !== \"number\") {\n    return null;\n  }\n\n  const helperName = kind === \"item\" ? \"itemRef\" : kind === \"weapon\" ? \"weaponRef\" : \"armorRef\";\n  const fields = [`kind: ${literal(kind)}`, `item: ${helperName}({ id: ${itemId} })`];\n  if (priceMode === 1) {\n    fields.push(`price: ${price}`);\n  }\n\n  return {\n    expression: `{ ${fields.join(\", \")} }`,\n    helperNames: [helperName],\n  };\n}\n\nexport function shopGoodsKindFromCode(value: unknown): \"armor\" | \"item\" | \"weapon\" | null {\n  if (value === 0) {\n    return \"item\";\n  }\n  if (value === 1) {\n    return \"weapon\";\n  }\n  if (value === 2) {\n    return \"armor\";\n  }\n  return null;\n}\n","import type { RawEventCommand, RenderedCommand } from \"../../decompiler/types.js\";\nimport { literal, readPositiveInteger } from \"../../decompiler/core.js\";\n\nexport function renderControlVariables(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const startVariableId = readPositiveInteger(command.parameters[0]);\n  const endVariableId = readPositiveInteger(command.parameters[1]);\n  const operationCode = command.parameters[2];\n  const operandKind = command.parameters[3];\n\n  if (\n    startVariableId === null ||\n    endVariableId === null ||\n    typeof operationCode !== \"number\" ||\n    typeof operandKind !== \"number\"\n  ) {\n    return null;\n  }\n\n  const operation = controlVariablesOperationFromCode(operationCode);\n  if (operation === null) {\n    return null;\n  }\n\n  if (operandKind === 0 && typeof command.parameters[4] === \"number\") {\n    return {\n      expression: `controlVariables({ variable: ${renderReferenceTarget(\"variableRef\", startVariableId, endVariableId)}, operation: ${literal(operation)}, value: ${command.parameters[4]} })`,\n      helperNames: [\"controlVariables\", \"variableRef\"],\n    };\n  }\n\n  if (operandKind === 1) {\n    const sourceVariableId = readPositiveInteger(command.parameters[4]);\n    return sourceVariableId === null\n      ? null\n      : {\n          expression: `controlVariables({ variable: ${renderReferenceTarget(\"variableRef\", startVariableId, endVariableId)}, operation: ${literal(operation)}, value: variableRef({ id: ${sourceVariableId} }) })`,\n          helperNames: [\"controlVariables\", \"variableRef\"],\n        };\n  }\n\n  if (\n    operandKind === 2 &&\n    typeof command.parameters[4] === \"number\" &&\n    typeof command.parameters[5] === \"number\"\n  ) {\n    return {\n      expression: `controlVariables({ variable: ${renderReferenceTarget(\"variableRef\", startVariableId, endVariableId)}, operation: ${literal(operation)}, value: { kind: \"random\", from: ${command.parameters[4]}, to: ${command.parameters[5]} } })`,\n      helperNames: [\"controlVariables\", \"variableRef\"],\n    };\n  }\n\n  if (operandKind === 3) {\n    const operand = renderControlVariablesGameDataOperand(\n      command.parameters[4],\n      command.parameters[5],\n      command.parameters[6],\n    );\n    return operand === null\n      ? null\n      : {\n          expression: `controlVariables({ variable: ${renderReferenceTarget(\"variableRef\", startVariableId, endVariableId)}, operation: ${literal(operation)}, value: ${operand.expression} })`,\n          helperNames: [\"controlVariables\", \"variableRef\", ...operand.helperNames],\n        };\n  }\n\n  if (operandKind === 4 && typeof command.parameters[4] === \"string\") {\n    return {\n      expression: `controlVariables({ variable: ${renderReferenceTarget(\"variableRef\", startVariableId, endVariableId)}, operation: ${literal(operation)}, value: { kind: \"script\", script: scriptInput({ code: ${literal(command.parameters[4])} }) } })`,\n      helperNames: [\"controlVariables\", \"scriptInput\", \"variableRef\"],\n    };\n  }\n\n  return null;\n}\n\nexport function renderReferenceTarget(\n  helperName: \"switchRef\" | \"variableRef\",\n  startId: number,\n  endId: number,\n): string {\n  if (startId === endId) {\n    return `${helperName}({ id: ${startId} })`;\n  }\n\n  return `{ kind: \"referenceRange\", from: ${helperName}({ id: ${startId} }), to: ${helperName}({ id: ${endId} }) }`;\n}\n\nexport function renderOperateValueOperand(\n  operationParameter: unknown,\n  operandType: unknown,\n  operand: unknown,\n): { expression: string; helperNames: readonly string[]; operation: \"gain\" | \"lose\" } | null {\n  const operation = operationParameter === 0 ? \"gain\" : operationParameter === 1 ? \"lose\" : null;\n  if (operation === null) {\n    return null;\n  }\n\n  if (operandType === 0 && typeof operand === \"number\") {\n    return { expression: `${operand}`, helperNames: [], operation };\n  }\n\n  if (operandType === 1) {\n    const variableId = readPositiveInteger(operand);\n    return variableId === null\n      ? null\n      : {\n          expression: `variableRef({ id: ${variableId} })`,\n          helperNames: [\"variableRef\"],\n          operation,\n        };\n  }\n\n  return null;\n}\n\nexport function renderControlVariablesGameDataOperand(\n  type: unknown,\n  param1: unknown,\n  param2: unknown,\n): { expression: string; helperNames: readonly string[] } | null {\n  switch (type) {\n    case 0: {\n      const itemId = readPositiveInteger(param1);\n      return itemId === null\n        ? null\n        : {\n            expression: `{ kind: \"gameData\", source: \"item\", item: itemRef({ id: ${itemId} }) }`,\n            helperNames: [\"itemRef\"],\n          };\n    }\n    case 1: {\n      const weaponId = readPositiveInteger(param1);\n      return weaponId === null\n        ? null\n        : {\n            expression: `{ kind: \"gameData\", source: \"weapon\", weapon: weaponRef({ id: ${weaponId} }) }`,\n            helperNames: [\"weaponRef\"],\n          };\n    }\n    case 2: {\n      const armorId = readPositiveInteger(param1);\n      return armorId === null\n        ? null\n        : {\n            expression: `{ kind: \"gameData\", source: \"armor\", armor: armorRef({ id: ${armorId} }) }`,\n            helperNames: [\"armorRef\"],\n          };\n    }\n    case 3:\n      return renderActorGameDataOperand(param1, param2);\n    case 4:\n      return renderEnemyGameDataOperand(param1, param2);\n    case 5:\n      return renderCharacterGameDataOperand(param1, param2);\n    case 6:\n      return typeof param1 === \"number\" && Number.isInteger(param1) && param1 >= 0\n        ? {\n            expression: `{ kind: \"gameData\", source: \"party\", memberIndex: ${param1} }`,\n            helperNames: [],\n          }\n        : null;\n    case 7: {\n      const value = otherGameDataValueFromCode(param1);\n      return value === null\n        ? null\n        : {\n            expression: `{ kind: \"gameData\", source: \"other\", value: ${literal(value)} }`,\n            helperNames: [],\n          };\n    }\n    default:\n      return null;\n  }\n}\n\nexport function renderActorGameDataOperand(\n  actorParameter: unknown,\n  valueParameter: unknown,\n): { expression: string; helperNames: readonly string[] } | null {\n  const actorId = readPositiveInteger(actorParameter);\n  const value = actorGameDataValueFromCode(valueParameter);\n  return actorId === null || value === null\n    ? null\n    : {\n        expression: `{ kind: \"gameData\", source: \"actor\", actor: actorRef({ id: ${actorId} }), value: ${literal(value)} }`,\n        helperNames: [\"actorRef\"],\n      };\n}\n\nexport function renderEnemyGameDataOperand(\n  enemyIndex: unknown,\n  valueParameter: unknown,\n): { expression: string; helperNames: readonly string[] } | null {\n  const value = enemyGameDataValueFromCode(valueParameter);\n  return typeof enemyIndex === \"number\" &&\n    Number.isInteger(enemyIndex) &&\n    enemyIndex >= 0 &&\n    value !== null\n    ? {\n        expression: `{ kind: \"gameData\", source: \"enemy\", enemyIndex: ${enemyIndex}, value: ${literal(value)} }`,\n        helperNames: [],\n      }\n    : null;\n}\n\nexport function renderCharacterGameDataOperand(\n  characterId: unknown,\n  valueParameter: unknown,\n): { expression: string; helperNames: readonly string[] } | null {\n  const value = characterGameDataValueFromCode(valueParameter);\n  return typeof characterId === \"number\" && Number.isInteger(characterId) && value !== null\n    ? {\n        expression: `{ kind: \"gameData\", source: \"character\", characterId: ${characterId}, value: ${literal(value)} }`,\n        helperNames: [],\n      }\n    : null;\n}\n\nexport function controlVariablesOperationFromCode(\n  value: number,\n): \"set\" | \"add\" | \"sub\" | \"mul\" | \"div\" | \"mod\" | null {\n  switch (value) {\n    case 0:\n      return \"set\";\n    case 1:\n      return \"add\";\n    case 2:\n      return \"sub\";\n    case 3:\n      return \"mul\";\n    case 4:\n      return \"div\";\n    case 5:\n      return \"mod\";\n    default:\n      return null;\n  }\n}\n\nexport function actorGameDataValueFromCode(\n  value: unknown,\n):\n  | \"level\"\n  | \"exp\"\n  | \"hp\"\n  | \"mp\"\n  | \"mhp\"\n  | \"mmp\"\n  | \"atk\"\n  | \"def\"\n  | \"mat\"\n  | \"mdf\"\n  | \"agi\"\n  | \"luk\"\n  | null {\n  switch (value) {\n    case 0:\n      return \"level\";\n    case 1:\n      return \"exp\";\n    case 2:\n      return \"hp\";\n    case 3:\n      return \"mp\";\n    case 4:\n      return \"mhp\";\n    case 5:\n      return \"mmp\";\n    case 6:\n      return \"atk\";\n    case 7:\n      return \"def\";\n    case 8:\n      return \"mat\";\n    case 9:\n      return \"mdf\";\n    case 10:\n      return \"agi\";\n    case 11:\n      return \"luk\";\n    default:\n      return null;\n  }\n}\n\nexport function enemyGameDataValueFromCode(\n  value: unknown,\n): \"hp\" | \"mp\" | \"mhp\" | \"mmp\" | \"atk\" | \"def\" | \"mat\" | \"mdf\" | \"agi\" | \"luk\" | null {\n  switch (value) {\n    case 0:\n      return \"hp\";\n    case 1:\n      return \"mp\";\n    case 2:\n      return \"mhp\";\n    case 3:\n      return \"mmp\";\n    case 4:\n      return \"atk\";\n    case 5:\n      return \"def\";\n    case 6:\n      return \"mat\";\n    case 7:\n      return \"mdf\";\n    case 8:\n      return \"agi\";\n    case 9:\n      return \"luk\";\n    default:\n      return null;\n  }\n}\n\nexport function characterGameDataValueFromCode(\n  value: unknown,\n): \"mapX\" | \"mapY\" | \"direction\" | \"screenX\" | \"screenY\" | null {\n  switch (value) {\n    case 0:\n      return \"mapX\";\n    case 1:\n      return \"mapY\";\n    case 2:\n      return \"direction\";\n    case 3:\n      return \"screenX\";\n    case 4:\n      return \"screenY\";\n    default:\n      return null;\n  }\n}\n\nexport function otherGameDataValueFromCode(\n  value: unknown,\n):\n  | \"mapId\"\n  | \"partyMembers\"\n  | \"gold\"\n  | \"steps\"\n  | \"playTime\"\n  | \"timer\"\n  | \"saveCount\"\n  | \"battleCount\"\n  | \"winCount\"\n  | \"escapeCount\"\n  | null {\n  switch (value) {\n    case 0:\n      return \"mapId\";\n    case 1:\n      return \"partyMembers\";\n    case 2:\n      return \"gold\";\n    case 3:\n      return \"steps\";\n    case 4:\n      return \"playTime\";\n    case 5:\n      return \"timer\";\n    case 6:\n      return \"saveCount\";\n    case 7:\n      return \"battleCount\";\n    case 8:\n      return \"winCount\";\n    case 9:\n      return \"escapeCount\";\n    default:\n      return null;\n  }\n}\n","import type { RawEventCommand, RenderedCommand } from \"../../decompiler/types.js\";\nimport { literal, readPositiveInteger } from \"../../decompiler/core.js\";\nimport { vehicleFromCode } from \"../flow/decompile.js\";\nimport { renderOperateValueOperand } from \"../variables/decompile.js\";\n\nexport function renderNameInputProcessing(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const actorId = readPositiveInteger(command.parameters[0]);\n  const maxCharacters = command.parameters[1];\n  return actorId === null || typeof maxCharacters !== \"number\"\n    ? null\n    : {\n        expression: `nameInputProcessing({ actor: actorRef({ id: ${actorId} }), maxCharacters: ${maxCharacters} })`,\n        helperNames: [\"actorRef\", \"nameInputProcessing\"],\n      };\n}\n\nexport function renderActorOperateValueCommand(\n  command: RawEventCommand,\n  helperName: \"changeExp\" | \"changeHp\" | \"changeLevel\" | \"changeMp\" | \"changeTp\",\n  hasTrailingBoolean: boolean,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const target = renderActorCommandTarget(command.parameters[0], command.parameters[1]);\n  const operand = renderOperateValueOperand(\n    command.parameters[2],\n    command.parameters[3],\n    command.parameters[4],\n  );\n  const trailing = command.parameters[5];\n  if (\n    target === null ||\n    operand === null ||\n    (hasTrailingBoolean && typeof trailing !== \"boolean\")\n  ) {\n    return null;\n  }\n\n  const trailingField =\n    hasTrailingBoolean && trailing\n      ? helperName === \"changeHp\"\n        ? \", allowDeath: true\"\n        : \", showLevelUp: true\"\n      : \"\";\n\n  return {\n    expression: `${helperName}({ target: ${target.expression}, operation: ${literal(operand.operation)}, value: ${operand.expression}${trailingField} })`,\n    helperNames: [helperName, ...target.helperNames, ...operand.helperNames],\n  };\n}\n\nexport function renderChangeState(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const target = renderActorCommandTarget(command.parameters[0], command.parameters[1]);\n  const operation =\n    command.parameters[2] === 0 ? \"add\" : command.parameters[2] === 1 ? \"remove\" : null;\n  const stateId = readPositiveInteger(command.parameters[3]);\n  return target === null || operation === null || stateId === null\n    ? null\n    : {\n        expression: `changeState({ target: ${target.expression}, operation: ${literal(operation)}, state: stateRef({ id: ${stateId} }) })`,\n        helperNames: [\"changeState\", \"stateRef\", ...target.helperNames],\n      };\n}\n\nexport function renderRecoverAll(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const target = renderActorCommandTarget(command.parameters[0], command.parameters[1]);\n  return target === null\n    ? null\n    : {\n        expression: `recoverAll({ target: ${target.expression} })`,\n        helperNames: [\"recoverAll\", ...target.helperNames],\n      };\n}\n\nexport function renderChangeParameter(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const target = renderActorCommandTarget(command.parameters[0], command.parameters[1]);\n  const parameter = actorParameterFromCode(command.parameters[2]);\n  const operand = renderOperateValueOperand(\n    command.parameters[3],\n    command.parameters[4],\n    command.parameters[5],\n  );\n  return target === null || parameter === null || operand === null\n    ? null\n    : {\n        expression: `changeParameter({ target: ${target.expression}, parameter: ${literal(parameter)}, operation: ${literal(operand.operation)}, value: ${operand.expression} })`,\n        helperNames: [\"changeParameter\", ...target.helperNames, ...operand.helperNames],\n      };\n}\n\nexport function renderChangeSkill(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const target = renderActorCommandTarget(command.parameters[0], command.parameters[1]);\n  const operation =\n    command.parameters[2] === 0 ? \"learn\" : command.parameters[2] === 1 ? \"forget\" : null;\n  const skillId = readPositiveInteger(command.parameters[3]);\n  return target === null || operation === null || skillId === null\n    ? null\n    : {\n        expression: `changeSkill({ target: ${target.expression}, operation: ${literal(operation)}, skill: skillRef({ id: ${skillId} }) })`,\n        helperNames: [\"changeSkill\", \"skillRef\", ...target.helperNames],\n      };\n}\n\nexport function renderChangeEquipment(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const actorId = readPositiveInteger(command.parameters[0]);\n  const equipmentTypeId = readPositiveInteger(command.parameters[1]);\n  const itemId = command.parameters[2];\n  if (\n    actorId === null ||\n    equipmentTypeId === null ||\n    typeof itemId !== \"number\" ||\n    !Number.isInteger(itemId) ||\n    itemId < 0\n  ) {\n    return null;\n  }\n\n  return {\n    expression: `changeEquipment({ actor: actorRef({ id: ${actorId} }), equipmentTypeId: ${equipmentTypeId}, itemId: ${itemId === 0 ? \"null\" : itemId} })`,\n    helperNames: [\"actorRef\", \"changeEquipment\"],\n  };\n}\n\nexport function renderActorStringCommand(\n  command: RawEventCommand,\n  helperName: \"changeName\" | \"changeNickname\" | \"changeProfile\",\n  fieldName: \"name\" | \"nickname\" | \"profile\",\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const actorId = readPositiveInteger(command.parameters[0]);\n  const value = command.parameters[1];\n  return actorId === null || typeof value !== \"string\"\n    ? null\n    : {\n        expression: `${helperName}({ actor: actorRef({ id: ${actorId} }), ${fieldName}: ${literal(value)} })`,\n        helperNames: [\"actorRef\", helperName],\n      };\n}\n\nexport function renderChangeClass(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const actorId = readPositiveInteger(command.parameters[0]);\n  const classId = readPositiveInteger(command.parameters[1]);\n  const keepExp = command.parameters[2];\n  return actorId === null || classId === null || typeof keepExp !== \"boolean\"\n    ? null\n    : {\n        expression: `changeClass({ actor: actorRef({ id: ${actorId} }), class: classRef({ id: ${classId} })${keepExp ? \", keepExp: true\" : \"\"} })`,\n        helperNames: [\"actorRef\", \"changeClass\", \"classRef\"],\n      };\n}\n\nexport function renderChangeActorImages(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const actorId = readPositiveInteger(command.parameters[0]);\n  const characterName = command.parameters[1];\n  const characterIndex = command.parameters[2];\n  const faceName = command.parameters[3];\n  const faceIndex = command.parameters[4];\n  const battlerName = command.parameters[5];\n  return actorId === null ||\n    typeof characterName !== \"string\" ||\n    typeof characterIndex !== \"number\" ||\n    typeof faceName !== \"string\" ||\n    typeof faceIndex !== \"number\" ||\n    typeof battlerName !== \"string\"\n    ? null\n    : {\n        expression: `changeActorImages({ actor: actorRef({ id: ${actorId} }), character: { image: imageAsset({ folder: \"characters\", name: ${literal(characterName)} }), index: ${characterIndex} }, face: { image: imageAsset({ folder: \"faces\", name: ${literal(faceName)} }), index: ${faceIndex} }, battler: imageAsset({ folder: \"sv_actors\", name: ${literal(battlerName)} }) })`,\n        helperNames: [\"actorRef\", \"changeActorImages\", \"imageAsset\"],\n      };\n}\n\nexport function renderChangeVehicleImage(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const vehicle = vehicleFromCode(command.parameters[0]);\n  const imageName = command.parameters[1];\n  const index = command.parameters[2];\n  return vehicle === null || typeof imageName !== \"string\" || typeof index !== \"number\"\n    ? null\n    : {\n        expression: `changeVehicleImage({ vehicle: ${literal(vehicle)}, image: imageAsset({ folder: \"characters\", name: ${literal(imageName)} }), index: ${index} })`,\n        helperNames: [\"changeVehicleImage\", \"imageAsset\"],\n      };\n}\n\nexport function renderActorCommandTarget(\n  targetKind: unknown,\n  targetValue: unknown,\n): { expression: string; helperNames: readonly string[] } | null {\n  if (targetKind === 0) {\n    const actorId =\n      typeof targetValue === \"number\" && Number.isInteger(targetValue) ? targetValue : null;\n    if (actorId === 0) {\n      return {\n        expression: `{ kind: \"runtimeSelector\", scope: \"actor\", target: \"entireParty\" }`,\n        helperNames: [],\n      };\n    }\n    return actorId !== null && actorId > 0\n      ? {\n          expression: `{ kind: \"runtimeSelector\", scope: \"actor\", target: \"actor\", actorId: ${actorId} }`,\n          helperNames: [],\n        }\n      : null;\n  }\n\n  if (targetKind === 1) {\n    const variableId = readPositiveInteger(targetValue);\n    return variableId === null\n      ? null\n      : {\n          expression: `{ kind: \"runtimeSelector\", scope: \"actor\", target: \"actorFromVariable\", variable: variableRef({ id: ${variableId} }) }`,\n          helperNames: [\"variableRef\"],\n        };\n  }\n\n  return null;\n}\n\nexport function actorParameterFromCode(value: unknown): string | null {\n  switch (value) {\n    case 0:\n      return \"mhp\";\n    case 1:\n      return \"mmp\";\n    case 2:\n      return \"atk\";\n    case 3:\n      return \"def\";\n    case 4:\n      return \"mat\";\n    case 5:\n      return \"mdf\";\n    case 6:\n      return \"agi\";\n    case 7:\n      return \"luk\";\n    default:\n      return null;\n  }\n}\n","import type { RawEventCommand, RenderedCommand } from \"../../decompiler/types.js\";\nimport { literal, readPositiveInteger } from \"../../decompiler/core.js\";\nimport { renderOperateValueOperand } from \"../variables/decompile.js\";\n\nexport function renderEnemyOperateValueCommand(\n  command: RawEventCommand,\n  helperName: \"changeEnemyHp\" | \"changeEnemyMp\" | \"changeEnemyTp\",\n  hasAllowDeath: boolean,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const target = renderEnemyCommandTarget(command.parameters[0]);\n  const operand = renderOperateValueOperand(\n    command.parameters[1],\n    command.parameters[2],\n    command.parameters[3],\n  );\n  const allowDeath = command.parameters[4];\n  if (target === null || operand === null || (hasAllowDeath && typeof allowDeath !== \"boolean\")) {\n    return null;\n  }\n\n  return {\n    expression: `${helperName}({ target: ${target.expression}, operation: ${literal(operand.operation)}, value: ${operand.expression}${hasAllowDeath && allowDeath ? \", allowDeath: true\" : \"\"} })`,\n    helperNames: [helperName, ...target.helperNames, ...operand.helperNames],\n  };\n}\n\nexport function renderChangeEnemyState(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const target = renderEnemyCommandTarget(command.parameters[0]);\n  const operation =\n    command.parameters[1] === 0 ? \"add\" : command.parameters[1] === 1 ? \"remove\" : null;\n  const stateId = readPositiveInteger(command.parameters[2]);\n  return target === null || operation === null || stateId === null\n    ? null\n    : {\n        expression: `changeEnemyState({ target: ${target.expression}, operation: ${literal(operation)}, state: stateRef({ id: ${stateId} }) })`,\n        helperNames: [\"changeEnemyState\", \"stateRef\", ...target.helperNames],\n      };\n}\n\nexport function renderEnemyTargetOnlyCommand(\n  command: RawEventCommand,\n  helperName: \"enemyAppear\" | \"enemyRecoverAll\",\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const target = renderEnemyCommandTarget(command.parameters[0]);\n  return target === null\n    ? null\n    : {\n        expression: `${helperName}({ target: ${target.expression} })`,\n        helperNames: [helperName, ...target.helperNames],\n      };\n}\n\nexport function renderEnemyTransform(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const target = renderEnemyCommandTarget(command.parameters[0]);\n  const enemyId = readPositiveInteger(command.parameters[1]);\n  return target === null || enemyId === null\n    ? null\n    : {\n        expression: `enemyTransform({ target: ${target.expression}, enemy: enemyRef({ id: ${enemyId} }) })`,\n        helperNames: [\"enemyRef\", \"enemyTransform\", ...target.helperNames],\n      };\n}\n\nexport function renderShowBattleAnimation(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const animationId = readPositiveInteger(command.parameters[1]);\n  const allEnemies = command.parameters[2];\n  const target =\n    allEnemies === true\n      ? renderEnemyCommandTarget(-1)\n      : renderEnemyCommandTarget(command.parameters[0]);\n  return target === null || animationId === null || typeof allEnemies !== \"boolean\"\n    ? null\n    : {\n        expression: `showBattleAnimation({ target: ${target.expression}, animation: animationRef({ id: ${animationId} }) })`,\n        helperNames: [\"animationRef\", \"showBattleAnimation\", ...target.helperNames],\n      };\n}\n\nexport function renderForceAction(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const subject = renderBattlerCommandTarget(command.parameters[0], command.parameters[1]);\n  const skillId = readPositiveInteger(command.parameters[2]);\n  const targetIndex = command.parameters[3];\n  return subject === null || skillId === null || typeof targetIndex !== \"number\"\n    ? null\n    : {\n        expression: `forceAction({ subject: ${subject.expression}, skill: skillRef({ id: ${skillId} }), targetIndex: ${targetIndex} })`,\n        helperNames: [\"forceAction\", \"skillRef\", ...subject.helperNames],\n      };\n}\n\nexport function renderEnemyCommandTarget(\n  value: unknown,\n): { expression: string; helperNames: readonly string[] } | null {\n  if (value === -1) {\n    return {\n      expression: `{ kind: \"runtimeSelector\", scope: \"enemy\", target: \"all\" }`,\n      helperNames: [],\n    };\n  }\n\n  return typeof value === \"number\" && Number.isInteger(value) && value >= 0\n    ? {\n        expression: `{ kind: \"runtimeSelector\", scope: \"enemy\", target: \"enemy\", index: ${value} }`,\n        helperNames: [],\n      }\n    : null;\n}\n\nexport function renderBattlerCommandTarget(\n  targetKind: unknown,\n  targetValue: unknown,\n): { expression: string; helperNames: readonly string[] } | null {\n  if (\n    targetKind === 0 &&\n    typeof targetValue === \"number\" &&\n    Number.isInteger(targetValue) &&\n    targetValue >= 0\n  ) {\n    return {\n      expression: `{ kind: \"runtimeSelector\", scope: \"battler\", target: \"enemy\", index: ${targetValue} }`,\n      helperNames: [],\n    };\n  }\n\n  const actorId = readPositiveInteger(targetValue);\n  if (targetKind === 1 && actorId !== null) {\n    return {\n      expression: `{ kind: \"runtimeSelector\", scope: \"battler\", target: \"actor\", actorId: ${actorId} }`,\n      helperNames: [],\n    };\n  }\n\n  return null;\n}\n","import type { RawEventCommand, RenderedCommand } from \"../../decompiler/types.js\";\nimport { literal } from \"../../decompiler/core.js\";\nimport { renderTone } from \"../screen/decompile.js\";\n\nexport function renderBooleanSystemCommand(\n  command: RawEventCommand,\n  helperName: string,\n  fieldName: \"disabled\" | \"enabled\",\n  zeroMeansTrue: boolean,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const value = command.parameters[0];\n  if (value !== 0 && value !== 1) {\n    return null;\n  }\n\n  const booleanValue = zeroMeansTrue ? value === 0 : value === 1;\n  return {\n    expression: `${helperName}({ ${fieldName}: ${booleanValue} })`,\n    helperNames: [helperName],\n  };\n}\n\nexport function renderChangeWindowColor(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const tone = renderTone(command.parameters[0]);\n  return tone === null\n    ? null\n    : {\n        expression: `changeWindowColor({ tone: ${tone} })`,\n        helperNames: [\"changeWindowColor\"],\n      };\n}\n\nexport function renderPluginCommand(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  const line = command.parameters[0];\n  if (typeof line !== \"string\" || line.length === 0) {\n    return null;\n  }\n  if (line.trim() !== line || line.includes(\"  \")) {\n    return null;\n  }\n\n  const [name = \"\", ...args] = line.split(\" \");\n  const fields = [`command: ${literal(name)}`];\n  if (args.length > 0) {\n    fields.push(`args: ${literal(args)}`);\n  }\n  return {\n    expression: `pluginCommand({ ${fields.join(\", \")} })`,\n    helperNames: [\"pluginCommand\"],\n  };\n}\n\nexport function renderNoParameterCommand(\n  command: RawEventCommand,\n  helperName:\n    | \"abortBattle\"\n    | \"breakLoop\"\n    | \"exitEventProcessing\"\n    | \"gameOver\"\n    | \"openMenuScreen\"\n    | \"openSaveScreen\"\n    | \"returnToTitleScreen\",\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  return command.parameters.length === 0\n    ? {\n        expression: `${helperName}()`,\n        helperNames: [helperName],\n      }\n    : null;\n}\n\nexport function renderRawCommand(command: RawEventCommand): string {\n  const indentLine = `\\n  indent: ${command.indent},`;\n\n  return `rawDslCommand({\n  code: ${command.code},${indentLine}\n  parameters: ${literal(command.parameters)},\n})`;\n}\n","import type {\n  DecompiledCommandListRendering,\n  RawEventCommand,\n  RenderedCommand,\n  RenderCommandList,\n} from \"./types.js\";\nimport { assertNativeSwitchCommand } from \"../commands/variables/validation.js\";\nimport {\n  isItemType,\n  isSelfSwitch,\n  literal,\n  readControlValue,\n  readPositiveInteger,\n  readStringParameter,\n} from \"./core.js\";\nimport {\n  renderShowTextCommand,\n  renderShowChoicesCommand,\n  renderShowScrollingTextCommand,\n  renderCommentCommand,\n  renderScriptCommand,\n} from \"../commands/message/decompile.js\";\nexport {\n  renderShowTextCommand,\n  renderShowChoicesCommand,\n  renderShowScrollingTextCommand,\n  renderCommentCommand,\n  renderScriptCommand,\n  findMessageBranchEnd,\n  renderInlineCommandListSource,\n} from \"../commands/message/decompile.js\";\nimport { renderConditionalCommand, renderLoopCommand } from \"../commands/flow/decompile.js\";\nexport {\n  renderConditionalCommand,\n  renderLoopCommand,\n  renderConditionalBranchCondition,\n  renderSwitchCondition,\n  renderVariableCondition,\n  renderSelfSwitchCondition,\n  renderTimerCondition,\n  renderActorCondition,\n  renderActorConditionCheck,\n  renderReferencedActorCheck,\n  renderEnemyCondition,\n  renderCharacterCondition,\n  renderGoldCondition,\n  renderItemCondition,\n  renderWeaponCondition,\n  renderArmorCondition,\n  renderButtonCondition,\n  renderVehicleCondition,\n  findConditionalBranchBodyEnd,\n  findLoopBodyEnd,\n  conditionalVariableOperatorFromCode,\n  vehicleFromCode,\n  isButtonName,\n} from \"../commands/flow/decompile.js\";\nimport {\n  renderTransferPlayer,\n  renderSetVehicleLocation,\n  renderSetEventLocation,\n  renderScrollMap,\n  renderSetMovementRoute,\n  renderChangeTransparency,\n  renderShowAnimation,\n  renderShowBalloonIcon,\n  renderChangePlayerFollowers,\n} from \"../commands/movement/decompile.js\";\nexport {\n  renderTransferPlayer,\n  renderSetVehicleLocation,\n  renderSetEventLocation,\n  renderScrollMap,\n  renderSetMovementRoute,\n  renderChangeTransparency,\n  renderShowAnimation,\n  renderShowBalloonIcon,\n  renderChangePlayerFollowers,\n  renderMoveRouteCommands,\n  renderMoveRouteCommand,\n  moveRouteSimpleExpressionFromCode,\n  renderMoveRoutePlaySe,\n  renderCharacterRuntimeSelector,\n  renderOptionalDirectionAndFade,\n  renderOptionalEventDirection,\n  balloonIconFromCode,\n} from \"../commands/movement/decompile.js\";\nimport {\n  renderTintScreen,\n  renderFlashScreen,\n  renderShakeScreen,\n  renderShowPicture,\n  renderMovePicture,\n  renderRotatePicture,\n  renderTintPicture,\n  renderErasePicture,\n  renderSetWeatherEffect,\n} from \"../commands/screen/decompile.js\";\nexport {\n  renderTintScreen,\n  renderFlashScreen,\n  renderShakeScreen,\n  renderShowPicture,\n  renderMovePicture,\n  renderRotatePicture,\n  renderTintPicture,\n  renderErasePicture,\n  renderSetWeatherEffect,\n  renderPicturePosition,\n  renderCommandPosition,\n  renderPictureDisplay,\n  renderTone,\n  renderColor,\n  pictureOriginFromCode,\n  weatherEffectFromCode,\n} from \"../commands/screen/decompile.js\";\nimport {\n  renderAudioCommand,\n  renderDurationCommand,\n  renderChangeVehicleBgm,\n  renderPlayMovie,\n} from \"../commands/audio/decompile.js\";\nexport {\n  renderAudioCommand,\n  renderDurationCommand,\n  renderChangeVehicleBgm,\n  renderPlayMovie,\n  renderAudioPayload,\n} from \"../commands/audio/decompile.js\";\nimport {\n  renderChangeTileset,\n  renderChangeBattleBack,\n  renderChangeParallax,\n  renderGetLocationInfo,\n} from \"../commands/map/decompile.js\";\nexport {\n  renderChangeTileset,\n  renderChangeBattleBack,\n  renderChangeParallax,\n  renderGetLocationInfo,\n  locationInfoTypeFromCode,\n} from \"../commands/map/decompile.js\";\nimport {\n  renderBattleProcessingCommand,\n  renderShopProcessingCommand,\n} from \"../commands/battle/decompile.js\";\nexport {\n  renderBattleProcessingCommand,\n  renderShopProcessingCommand,\n  renderBattleTroop,\n  battleBranchFieldName,\n  renderShopGoods,\n  shopGoodsKindFromCode,\n} from \"../commands/battle/decompile.js\";\nimport {\n  renderNameInputProcessing,\n  renderActorOperateValueCommand,\n  renderChangeState,\n  renderRecoverAll,\n  renderChangeParameter,\n  renderChangeSkill,\n  renderChangeEquipment,\n  renderActorStringCommand,\n  renderChangeClass,\n  renderChangeActorImages,\n  renderChangeVehicleImage,\n} from \"../commands/actor/decompile.js\";\nexport {\n  renderNameInputProcessing,\n  renderActorOperateValueCommand,\n  renderChangeState,\n  renderRecoverAll,\n  renderChangeParameter,\n  renderChangeSkill,\n  renderChangeEquipment,\n  renderActorStringCommand,\n  renderChangeClass,\n  renderChangeActorImages,\n  renderChangeVehicleImage,\n  renderActorCommandTarget,\n  actorParameterFromCode,\n} from \"../commands/actor/decompile.js\";\nimport {\n  renderEnemyOperateValueCommand,\n  renderChangeEnemyState,\n  renderEnemyTargetOnlyCommand,\n  renderEnemyTransform,\n  renderShowBattleAnimation,\n  renderForceAction,\n} from \"../commands/enemy/decompile.js\";\nexport {\n  renderEnemyOperateValueCommand,\n  renderChangeEnemyState,\n  renderEnemyTargetOnlyCommand,\n  renderEnemyTransform,\n  renderShowBattleAnimation,\n  renderForceAction,\n  renderEnemyCommandTarget,\n  renderBattlerCommandTarget,\n} from \"../commands/enemy/decompile.js\";\nimport {\n  renderControlVariables,\n  renderReferenceTarget,\n  renderOperateValueOperand,\n} from \"../commands/variables/decompile.js\";\nexport {\n  renderControlVariables,\n  renderReferenceTarget,\n  renderOperateValueOperand,\n  renderControlVariablesGameDataOperand,\n  renderActorGameDataOperand,\n  renderEnemyGameDataOperand,\n  renderCharacterGameDataOperand,\n  controlVariablesOperationFromCode,\n  actorGameDataValueFromCode,\n  enemyGameDataValueFromCode,\n  characterGameDataValueFromCode,\n  otherGameDataValueFromCode,\n} from \"../commands/variables/decompile.js\";\nimport {\n  renderBooleanSystemCommand,\n  renderChangeWindowColor,\n  renderPluginCommand,\n  renderNoParameterCommand,\n  renderRawCommand,\n} from \"../commands/system/decompile.js\";\nexport {\n  renderBooleanSystemCommand,\n  renderChangeWindowColor,\n  renderPluginCommand,\n  renderNoParameterCommand,\n  renderRawCommand,\n} from \"../commands/system/decompile.js\";\n\nimport { inspectCommandListStructure } from \"../validation/command-structure.js\";\nimport { isKnownCommandCode } from \"../validation/native-parameters.js\";\nimport { CommandStructureError } from \"../validation/command-errors.js\";\n\nexport function renderDecompiledCommandList(\n  commands: readonly RawEventCommand[],\n): DecompiledCommandListRendering {\n  // Nested family bodies are fragments at their own indentation, with the same ownership rules.\n  inspectCommandListStructure(commands, { baseIndent: commands[0]?.indent ?? 0 });\n  const indices = new Map(commands.map((command, index) => [command, index]));\n  const renderList: RenderCommandList = (list) => {\n    const rendered: string[] = [];\n    const helperNames = new Set<string>();\n\n    for (let index = 0; index < list.length; index += 1) {\n      const command = list[index];\n\n      if (command === undefined || command.code === 0) {\n        continue;\n      }\n\n      let commandRendering: RenderedCommand;\n      try {\n        commandRendering = renderCommandAt(list, index, (body) => {\n          const marker = body.at(-1);\n          if (body.length > 1 && marker?.code === 0)\n            throw new CommandStructureError(\n              \"MV-COMMAND-UNSUPPORTED\",\n              \"This current child-body helper cannot yet preserve a saved trailing Body End Marker after content.\",\n              {\n                nativePath: `list[${indices.get(marker)}]`,\n                expected: \"formal Child Command Body with explicit saved marker\",\n                actual: literal(marker),\n              },\n              undefined,\n              \"decompile\",\n            );\n          return renderList(body);\n        });\n      } catch (error) {\n        if (error instanceof CommandStructureError && error.stage !== \"decompile\") {\n          const remap = (path: string | undefined) =>\n            path?.replace(\n              /^list\\[(\\d+)\\]/u,\n              (_match, at: string) => `list[${indices.get(list[Number(at)]!) ?? at}]`,\n            );\n          const nativePath = remap(error.location.nativePath);\n          throw new CommandStructureError(\n            error.code,\n            error.detail,\n            { ...error.location, ...(nativePath ? { nativePath } : {}) },\n            undefined,\n            \"decompile\",\n          );\n        }\n        throw error;\n      }\n      rendered.push(commandRendering.expression);\n      for (const helperName of commandRendering.helperNames) {\n        helperNames.add(helperName);\n      }\n      index = commandRendering.nextIndex;\n    }\n\n    return {\n      helperNames: [...helperNames].sort((left, right) => left.localeCompare(right)),\n      source: rendered.map((line) => `${line},`).join(\"\\n\"),\n    };\n  };\n  return renderList(commands);\n}\n\nexport function renderCommands(commands: readonly RawEventCommand[]): string {\n  return renderDecompiledCommandList(commands).source;\n}\n\nexport function renderCommandAt(\n  commands: readonly RawEventCommand[],\n  index: number,\n  renderCommandList: RenderCommandList = renderDecompiledCommandList,\n): RenderedCommand {\n  const command = commands[index];\n\n  if (command === undefined) {\n    throw new Error(\"Cannot render missing event command.\");\n  }\n  if (\n    (command.code === 101 && command.parameters[0] === \"\" && command.parameters[1] !== 0) ||\n    (command.code === 101 && commands[index + 1]?.code !== 401) ||\n    (command.code === 105 && commands[index + 1]?.code !== 405)\n  )\n    throw new CommandStructureError(\n      \"MV-COMMAND-UNSUPPORTED\",\n      \"The current message helper cannot preserve these saved native slots.\",\n      {\n        nativePath: `list[${index}].parameters`,\n        expected: \"representable message header and continuation body\",\n        actual: literal(command.parameters),\n      },\n    );\n\n  switch (command.code) {\n    case 205: {\n      const rendered = renderSetMovementRoute(command);\n      if (rendered === null) return renderSimpleOrRawCommand(command, index);\n      let nextIndex = index;\n      while (commands[nextIndex + 1]?.code === 505) nextIndex += 1;\n      return { ...rendered, nextIndex };\n    }\n    case 101:\n      return renderShowTextCommand(commands, index, renderSimpleOrRawCommand);\n    case 102:\n      return renderShowChoicesCommand(commands, index, renderCommandList, renderSimpleOrRawCommand);\n    case 105:\n      return renderShowScrollingTextCommand(commands, index, renderSimpleOrRawCommand);\n    case 108:\n      return renderCommentCommand(commands, index);\n    case 111:\n      return renderConditionalCommand(commands, index, renderCommandList, renderSimpleOrRawCommand);\n    case 112:\n      return renderLoopCommand(commands, index, renderCommandList);\n    case 301:\n      return renderBattleProcessingCommand(\n        commands,\n        index,\n        renderCommandList,\n        renderSimpleOrRawCommand,\n      );\n    case 302:\n      return renderShopProcessingCommand(commands, index, renderSimpleOrRawCommand);\n    case 355:\n      return renderScriptCommand(commands, index, renderSimpleOrRawCommand);\n    default:\n      return renderSimpleOrRawCommand(command, index);\n  }\n}\n\nexport function renderSimpleOrRawCommand(command: RawEventCommand, index: number): RenderedCommand {\n  assertNativeSwitchCommand(command.code, command.parameters);\n  const helper = renderSimpleCommand(command);\n\n  if (helper !== null) {\n    return {\n      expression: helper.expression,\n      helperNames: helper.helperNames,\n      nextIndex: index,\n    };\n  }\n\n  if (isKnownCommandCode(command.code))\n    throw new CommandStructureError(\n      \"MV-COMMAND-UNSUPPORTED\",\n      \"Known native command cannot be represented by its current formal helper; raw fallback is unavailable.\",\n      {\n        nativePath: `list[${index}].parameters`,\n        expected: \"supported formal native command\",\n        actual: literal(command.parameters),\n      },\n    );\n\n  return {\n    expression: renderRawCommand(command),\n    helperNames: [\"rawDslCommand\"],\n    nextIndex: index,\n  };\n}\n\nexport function renderSimpleCommand(\n  command: RawEventCommand,\n): Omit<RenderedCommand, \"nextIndex\"> | null {\n  switch (command.code) {\n    case 117: {\n      const commonEventId = readPositiveInteger(command.parameters[0]);\n      return commonEventId === null\n        ? null\n        : {\n            expression: `callCommonEvent({ commonEvent: commonEventRef({ id: ${commonEventId} }) })`,\n            helperNames: [\"callCommonEvent\", \"commonEventRef\"],\n          };\n    }\n    case 118:\n      return {\n        expression: `label(${literal(readStringParameter(command.parameters[0]))})`,\n        helperNames: [\"label\"],\n      };\n    case 119:\n      return {\n        expression: `jumpToLabel(${literal(readStringParameter(command.parameters[0]))})`,\n        helperNames: [\"jumpToLabel\"],\n      };\n    case 121: {\n      const startSwitchId = readPositiveInteger(command.parameters[0]);\n      const endSwitchId = readPositiveInteger(command.parameters[1]);\n      const value = readControlValue(command.parameters[2]);\n      return startSwitchId === null || endSwitchId === null || value === null\n        ? null\n        : {\n            expression: `controlSwitches({ switch: ${renderReferenceTarget(\"switchRef\", startSwitchId, endSwitchId)}, value: ${value} })`,\n            helperNames: [\"controlSwitches\", \"switchRef\"],\n          };\n    }\n    case 122:\n      return renderControlVariables(command);\n    case 123: {\n      const selfSwitch = command.parameters[0];\n      const value = readControlValue(command.parameters[1]);\n      return isSelfSwitch(selfSwitch) && value !== null\n        ? {\n            expression: `controlSelfSwitch({ selfSwitch: ${literal(selfSwitch)}, value: ${value} })`,\n            helperNames: [\"controlSelfSwitch\"],\n          }\n        : null;\n    }\n    case 124: {\n      const action = command.parameters[0];\n      const seconds = command.parameters[1];\n      if (action === 0 && typeof seconds === \"number\") {\n        return {\n          expression: `controlTimer({ action: \"start\", seconds: ${seconds} })`,\n          helperNames: [\"controlTimer\"],\n        };\n      }\n      if (action === 1 && command.parameters.length === 1) {\n        return {\n          expression: `controlTimer({ action: \"stop\" })`,\n          helperNames: [\"controlTimer\"],\n        };\n      }\n      return null;\n    }\n    case 125: {\n      const operand = renderOperateValueOperand(\n        command.parameters[0],\n        command.parameters[1],\n        command.parameters[2],\n      );\n      return operand === null\n        ? null\n        : {\n            expression: `changeGold({ operation: ${literal(operand.operation)}, value: ${operand.expression} })`,\n            helperNames: [\"changeGold\", ...operand.helperNames],\n          };\n    }\n    case 113:\n      return renderNoParameterCommand(command, \"breakLoop\");\n    case 115:\n      return renderNoParameterCommand(command, \"exitEventProcessing\");\n    case 103: {\n      const variableId = readPositiveInteger(command.parameters[0]);\n      const digits = command.parameters[1];\n      return variableId !== null && typeof digits === \"number\"\n        ? {\n            expression: `inputNumber({ variable: variableRef({ id: ${variableId} }), digits: ${digits} })`,\n            helperNames: [\"inputNumber\", \"variableRef\"],\n          }\n        : null;\n    }\n    case 104: {\n      const variableId = readPositiveInteger(command.parameters[0]);\n      const itemType = command.parameters[1];\n      return variableId !== null && isItemType(itemType)\n        ? {\n            expression: `selectItem({ variable: variableRef({ id: ${variableId} }), itemType: ${itemType} })`,\n            helperNames: [\"selectItem\", \"variableRef\"],\n          }\n        : null;\n    }\n    case 126: {\n      const itemId = readPositiveInteger(command.parameters[0]);\n      const operand = renderOperateValueOperand(\n        command.parameters[1],\n        command.parameters[2],\n        command.parameters[3],\n      );\n      return itemId === null || operand === null\n        ? null\n        : {\n            expression: `changeItems({ item: itemRef({ id: ${itemId} }), operation: ${literal(operand.operation)}, amount: ${operand.expression} })`,\n            helperNames: [\"changeItems\", \"itemRef\", ...operand.helperNames],\n          };\n    }\n    case 127: {\n      const weaponId = readPositiveInteger(command.parameters[0]);\n      const operand = renderOperateValueOperand(\n        command.parameters[1],\n        command.parameters[2],\n        command.parameters[3],\n      );\n      const includeEquipment = command.parameters[4];\n      return weaponId === null || operand === null || typeof includeEquipment !== \"boolean\"\n        ? null\n        : {\n            expression: `changeWeapons({ weapon: weaponRef({ id: ${weaponId} }), operation: ${literal(operand.operation)}, amount: ${operand.expression}, includeEquipment: ${includeEquipment} })`,\n            helperNames: [\"changeWeapons\", \"weaponRef\", ...operand.helperNames],\n          };\n    }\n    case 128: {\n      const armorId = readPositiveInteger(command.parameters[0]);\n      const operand = renderOperateValueOperand(\n        command.parameters[1],\n        command.parameters[2],\n        command.parameters[3],\n      );\n      const includeEquipment = command.parameters[4];\n      return armorId === null || operand === null || typeof includeEquipment !== \"boolean\"\n        ? null\n        : {\n            expression: `changeArmors({ armor: armorRef({ id: ${armorId} }), operation: ${literal(operand.operation)}, amount: ${operand.expression}, includeEquipment: ${includeEquipment} })`,\n            helperNames: [\"armorRef\", \"changeArmors\", ...operand.helperNames],\n          };\n    }\n    case 129: {\n      const actorId = readPositiveInteger(command.parameters[0]);\n      const operation = command.parameters[1];\n      const initialize = command.parameters[2];\n      return actorId === null ||\n        (operation !== 0 && operation !== 1) ||\n        typeof initialize !== \"boolean\"\n        ? null\n        : {\n            expression: `changePartyMember({ actor: actorRef({ id: ${actorId} }), operation: ${literal(operation === 0 ? \"add\" : \"remove\")}, initialize: ${initialize} })`,\n            helperNames: [\"actorRef\", \"changePartyMember\"],\n          };\n    }\n    case 132:\n      return renderAudioCommand(command, \"changeBattleBgm\", \"bgm\");\n    case 133:\n      return renderAudioCommand(command, \"changeVictoryMe\", \"me\");\n    case 134:\n      return renderBooleanSystemCommand(command, \"changeSaveAccess\", \"enabled\", false);\n    case 135:\n      return renderBooleanSystemCommand(command, \"changeMenuAccess\", \"enabled\", false);\n    case 136:\n      return renderBooleanSystemCommand(command, \"changeEncounterDisable\", \"disabled\", true);\n    case 137:\n      return renderBooleanSystemCommand(command, \"changeFormationAccess\", \"enabled\", false);\n    case 138:\n      return renderChangeWindowColor(command);\n    case 139:\n      return renderAudioCommand(command, \"changeDefeatMe\", \"me\");\n    case 140:\n      return renderChangeVehicleBgm(command);\n    case 201:\n      return renderTransferPlayer(command);\n    case 202:\n      return renderSetVehicleLocation(command);\n    case 203:\n      return renderSetEventLocation(command);\n    case 204:\n      return renderScrollMap(command);\n    case 205:\n      return renderSetMovementRoute(command);\n    case 206:\n      return command.parameters.length === 0\n        ? {\n            expression: \"getOnOffVehicle()\",\n            helperNames: [\"getOnOffVehicle\"],\n          }\n        : null;\n    case 211:\n      return renderChangeTransparency(command);\n    case 212:\n      return renderShowAnimation(command);\n    case 213:\n      return renderShowBalloonIcon(command);\n    case 214:\n      return {\n        expression: \"eraseEvent()\",\n        helperNames: [\"eraseEvent\"],\n      };\n    case 216:\n      return renderChangePlayerFollowers(command);\n    case 217:\n      return command.parameters.length === 0\n        ? {\n            expression: \"gatherFollowers()\",\n            helperNames: [\"gatherFollowers\"],\n          }\n        : null;\n    case 221:\n      return command.parameters.length === 0\n        ? {\n            expression: \"fadeoutScreen()\",\n            helperNames: [\"fadeoutScreen\"],\n          }\n        : null;\n    case 222:\n      return command.parameters.length === 0\n        ? {\n            expression: \"fadeinScreen()\",\n            helperNames: [\"fadeinScreen\"],\n          }\n        : null;\n    case 223:\n      return renderTintScreen(command);\n    case 224:\n      return renderFlashScreen(command);\n    case 225:\n      return renderShakeScreen(command);\n    case 230: {\n      const frames = command.parameters[0];\n      return typeof frames === \"number\"\n        ? {\n            expression: `wait(${frames})`,\n            helperNames: [\"wait\"],\n          }\n        : null;\n    }\n    case 231:\n      return renderShowPicture(command);\n    case 232:\n      return renderMovePicture(command);\n    case 233:\n      return renderRotatePicture(command);\n    case 234:\n      return renderTintPicture(command);\n    case 235:\n      return renderErasePicture(command);\n    case 236:\n      return renderSetWeatherEffect(command);\n    case 241:\n      return renderAudioCommand(command, \"playBgm\", \"bgm\");\n    case 242:\n      return renderDurationCommand(command, \"fadeoutBgm\");\n    case 243:\n      return command.parameters.length === 0\n        ? {\n            expression: \"saveBgm()\",\n            helperNames: [\"saveBgm\"],\n          }\n        : null;\n    case 244:\n      return command.parameters.length === 0\n        ? {\n            expression: \"resumeBgm()\",\n            helperNames: [\"resumeBgm\"],\n          }\n        : null;\n    case 245:\n      return renderAudioCommand(command, \"playBgs\", \"bgs\");\n    case 246:\n      return renderDurationCommand(command, \"fadeoutBgs\");\n    case 249:\n      return renderAudioCommand(command, \"playMe\", \"me\");\n    case 250:\n      return renderAudioCommand(command, \"playSe\", \"se\");\n    case 251:\n      return command.parameters.length === 0\n        ? {\n            expression: \"stopSe()\",\n            helperNames: [\"stopSe\"],\n          }\n        : null;\n    case 261:\n      return renderPlayMovie(command);\n    case 281:\n      return renderBooleanSystemCommand(command, \"changeMapNameDisplay\", \"enabled\", true);\n    case 282:\n      return renderChangeTileset(command);\n    case 283:\n      return renderChangeBattleBack(command);\n    case 284:\n      return renderChangeParallax(command);\n    case 285:\n      return renderGetLocationInfo(command);\n    case 303:\n      return renderNameInputProcessing(command);\n    case 311:\n      return renderActorOperateValueCommand(command, \"changeHp\", true);\n    case 312:\n      return renderActorOperateValueCommand(command, \"changeMp\", false);\n    case 313:\n      return renderChangeState(command);\n    case 314:\n      return renderRecoverAll(command);\n    case 315:\n      return renderActorOperateValueCommand(command, \"changeExp\", true);\n    case 316:\n      return renderActorOperateValueCommand(command, \"changeLevel\", true);\n    case 317:\n      return renderChangeParameter(command);\n    case 318:\n      return renderChangeSkill(command);\n    case 319:\n      return renderChangeEquipment(command);\n    case 320:\n      return renderActorStringCommand(command, \"changeName\", \"name\");\n    case 321:\n      return renderChangeClass(command);\n    case 322:\n      return renderChangeActorImages(command);\n    case 323:\n      return renderChangeVehicleImage(command);\n    case 324:\n      return renderActorStringCommand(command, \"changeNickname\", \"nickname\");\n    case 325:\n      return renderActorStringCommand(command, \"changeProfile\", \"profile\");\n    case 326:\n      return renderActorOperateValueCommand(command, \"changeTp\", false);\n    case 331:\n      return renderEnemyOperateValueCommand(command, \"changeEnemyHp\", true);\n    case 332:\n      return renderEnemyOperateValueCommand(command, \"changeEnemyMp\", false);\n    case 333:\n      return renderChangeEnemyState(command);\n    case 334:\n      return renderEnemyTargetOnlyCommand(command, \"enemyRecoverAll\");\n    case 335:\n      return renderEnemyTargetOnlyCommand(command, \"enemyAppear\");\n    case 336:\n      return renderEnemyTransform(command);\n    case 337:\n      return renderShowBattleAnimation(command);\n    case 339:\n      return renderForceAction(command);\n    case 340:\n      return renderNoParameterCommand(command, \"abortBattle\");\n    case 342:\n      return renderEnemyOperateValueCommand(command, \"changeEnemyTp\", false);\n    case 351:\n      return renderNoParameterCommand(command, \"openMenuScreen\");\n    case 352:\n      return renderNoParameterCommand(command, \"openSaveScreen\");\n    case 353:\n      return renderNoParameterCommand(command, \"gameOver\");\n    case 354:\n      return renderNoParameterCommand(command, \"returnToTitleScreen\");\n    case 356:\n      return renderPluginCommand(command);\n    default:\n      return null;\n  }\n}\n","import type { ReferenceKind } from \"../domain/references.js\";\nimport type { ReferenceResolver } from \"./types.js\";\n\n// These existing commands exercise Snapshot context assembly. Their command-family\n// validators own the remaining saved slots, enums and execution-context warnings.\nexport function assertNativeContextReferences(\n  code: number,\n  parameters: readonly unknown[],\n  resolver: ReferenceResolver,\n): void {\n  let reference: { kind: ReferenceKind; index: number };\n  switch (code) {\n    case 212:\n      reference = { kind: \"animation\", index: 1 };\n      break;\n    case 282:\n      reference = { kind: \"tileset\", index: 0 };\n      break;\n    case 336:\n      reference = { kind: \"enemy\", index: 1 };\n      break;\n    default:\n      return;\n  }\n  try {\n    resolver.resolveReference({ kind: reference.kind, id: parameters[reference.index] as number });\n  } catch (error) {\n    throw new Error(\n      `MV-E${code}-REFERENCE parameters[${reference.index}]: ${error instanceof Error ? error.message : String(error)}`,\n    );\n  }\n}\n","import type { EventPage, PageConditions, ReferenceKind, ReferenceValue } from \"../domain/types.js\";\nimport type { ReferenceResolver } from \"../validation/types.js\";\n\nexport const pageTriggers = [\"action\", \"playerTouch\", \"eventTouch\", \"autorun\", \"parallel\"] as const;\nexport const pagePriorities = [\"below\", \"same\", \"above\"] as const;\nexport const pageDirections = [\"down\", \"left\", \"right\", \"up\"] as const;\nexport const nativeDirections = [2, 4, 6, 8] as const;\n\nexport function compilePageConditions(\n  conditions: PageConditions | undefined,\n  resolver: ReferenceResolver,\n): Record<string, unknown> {\n  const id = (\n    slot: { enabled: boolean; ref: ReferenceValue<ReferenceKind> } | undefined,\n  ): number => {\n    if (slot === undefined) return 1;\n    if (!slot.enabled && \"id\" in slot.ref) return slot.ref.id;\n    return resolver.resolveReference(slot.ref);\n  };\n  return {\n    actorId: id(conditions?.actor),\n    actorValid: conditions?.actor?.enabled ?? false,\n    itemId: id(conditions?.item),\n    itemValid: conditions?.item?.enabled ?? false,\n    selfSwitchCh: conditions?.selfSwitch?.value ?? \"A\",\n    selfSwitchValid: conditions?.selfSwitch?.enabled ?? false,\n    switch1Id: id(conditions?.switch1),\n    switch1Valid: conditions?.switch1?.enabled ?? false,\n    switch2Id: id(conditions?.switch2),\n    switch2Valid: conditions?.switch2?.enabled ?? false,\n    variableId: id(conditions?.variable),\n    variableValid: conditions?.variable?.enabled ?? false,\n    variableValue: conditions?.variable?.atLeast ?? 0,\n  };\n}\n\nexport function compilePageSettings(page: EventPage, resolver: ReferenceResolver) {\n  return {\n    conditions: compilePageConditions(page.conditions, resolver),\n    image: {\n      characterName: page.image?.character?.name ?? \"\",\n      characterIndex: page.image?.characterIndex ?? 0,\n      tileId: page.image?.tileId ?? 0,\n      direction: nativeDirections[pageDirections.indexOf(page.image?.direction ?? \"down\")],\n      pattern: page.image?.pattern ?? 0,\n    },\n    directionFix: page.options?.directionFix ?? false,\n    stepAnime: page.options?.stepAnimation ?? false,\n    through: page.options?.through ?? false,\n    walkAnime: page.options?.walkAnimation ?? true,\n    priorityType: pagePriorities.indexOf(page.priority ?? \"below\"),\n    trigger: pageTriggers.indexOf(page.trigger ?? \"action\"),\n  };\n}\n","import type { MapEventDefinition, PageConditions } from \"../domain/types.js\";\nimport type { ReferenceResolver, StagedDataGraph, ValidationIssue } from \"../validation/types.js\";\nimport { CommandStructureError } from \"../validation/command-errors.js\";\nimport { nativeDirections, pageDirections, pagePriorities, pageTriggers } from \"./page.js\";\n\nfunction fail(path: string, expected: string, value: unknown, code = \"MV-MAP-PAGE-INPUT\"): never {\n  throw new CommandStructureError(code, \"Invalid Map Event input.\", {\n    dslPath: path,\n    expected,\n    actual: Object.is(value, -0) ? \"-0\" : String(value),\n  });\n}\n\nfunction object(\n  value: unknown,\n  path: string,\n  allowed: readonly string[],\n  required: readonly string[] = [],\n): Record<string, unknown> {\n  if (\n    !value ||\n    typeof value !== \"object\" ||\n    Array.isArray(value) ||\n    ![Object.prototype, null].includes(Object.getPrototypeOf(value))\n  )\n    fail(path, \"plain object\", value);\n  const record = value as Record<string, unknown>;\n  for (const key of Reflect.ownKeys(record)) {\n    const descriptor = Object.getOwnPropertyDescriptor(record, key)!;\n    if (\n      typeof key !== \"string\" ||\n      !allowed.includes(key) ||\n      !(\"value\" in descriptor) ||\n      !descriptor.enumerable\n    )\n      fail(`${path}.${String(key)}`, \"supported input field\", key);\n  }\n  for (const key of required)\n    if (!Object.hasOwn(record, key)) fail(`${path}.${key}`, \"required field\", \"<missing>\");\n  return record;\n}\n\nfunction integer(\n  value: unknown,\n  path: string,\n  min: number,\n  max = Number.MAX_SAFE_INTEGER,\n  allowNegativeZero = false,\n): void {\n  if (\n    !Number.isSafeInteger(value) ||\n    (!allowNegativeZero && Object.is(value, -0)) ||\n    (value as number) < min ||\n    (value as number) > max\n  )\n    fail(path, `integer ${min}..${max}`, value);\n}\n\nexport function assertMapEventInput(event: MapEventDefinition): void {\n  const record = object(\n    event,\n    \"mapEvent\",\n    [\"kind\", \"mapId\", \"id\", \"name\", \"x\", \"y\", \"note\", \"pages\"],\n    [\"kind\", \"mapId\", \"id\", \"name\", \"x\", \"y\", \"pages\"],\n  );\n  for (const field of [\"mapId\", \"id\"]) integer(record[field], field, 1);\n  for (const field of [\"x\", \"y\"]) integer(record[field], field, 0);\n  if (typeof record.name !== \"string\") fail(\"name\", \"string\", record.name);\n  if (record.note !== undefined && typeof record.note !== \"string\")\n    fail(\"note\", \"string\", record.note);\n  if (!Array.isArray(record.pages) || record.pages.length === 0)\n    fail(\"pages\", \"nonempty dense page array\", record.pages);\n  for (let index = 0; index < event.pages.length; index++)\n    if (!Object.hasOwn(event.pages, index)) fail(`pages[${index}]`, \"page\", \"<missing>\");\n}\n\nexport function assertPageConditions(\n  value: PageConditions,\n  resolver: ReferenceResolver,\n  path = \"conditions\",\n): void {\n  const conditions = object(value, path, [\n    \"switch1\",\n    \"switch2\",\n    \"variable\",\n    \"selfSwitch\",\n    \"actor\",\n    \"item\",\n  ]);\n  for (const [field, slot] of Object.entries(conditions)) {\n    if (slot === undefined) continue;\n    const keys =\n      field === \"selfSwitch\"\n        ? [\"enabled\", \"value\"]\n        : field === \"variable\"\n          ? [\"enabled\", \"ref\", \"atLeast\"]\n          : [\"enabled\", \"ref\"];\n    const record = object(slot, `${path}.${field}`, keys, keys);\n    if (typeof record.enabled !== \"boolean\")\n      fail(`${path}.${field}.enabled`, \"boolean\", record.enabled);\n    if (field === \"selfSwitch\") {\n      if (![\"A\", \"B\", \"C\", \"D\"].includes(record.value as string))\n        fail(`${path}.${field}.value`, \"A/B/C/D\", record.value);\n      continue;\n    }\n    const ref = object(record.ref, `${path}.${field}.ref`, [\"kind\", \"id\", \"name\"], [\"kind\"]);\n    const kind = field === \"switch1\" || field === \"switch2\" ? \"switch\" : field;\n    if (ref.kind !== kind || Object.hasOwn(ref, \"id\") === Object.hasOwn(ref, \"name\"))\n      fail(`${path}.${field}.ref`, `${kind} reference with exactly one ID or name`, record.ref);\n    if (\"id\" in ref)\n      integer(\n        ref.id,\n        `${path}.${field}.ref.id`,\n        record.enabled ? 1 : 0,\n        Number.MAX_SAFE_INTEGER,\n        record.enabled === false,\n      );\n    else if (typeof ref.name !== \"string\" || ref.name.length === 0)\n      fail(`${path}.${field}.ref.name`, \"nonempty name\", ref.name);\n    if (field === \"variable\")\n      integer(record.atLeast, `${path}.${field}.atLeast`, -99999999, 99999999, true);\n    if (record.enabled || !(\"id\" in ref)) {\n      try {\n        resolver.resolveReference(\n          record.ref as Parameters<ReferenceResolver[\"resolveReference\"]>[0],\n        );\n      } catch (error) {\n        fail(\n          `${path}.${field}.ref`,\n          \"existing unique reference\",\n          error instanceof Error ? error.message : error,\n        );\n      }\n    }\n  }\n}\n\nexport function assertMapPageInput(\n  value: unknown,\n  resolver: ReferenceResolver,\n  path: string,\n): void {\n  const page = object(\n    value,\n    path,\n    [\"conditions\", \"image\", \"movement\", \"priority\", \"options\", \"trigger\", \"commands\"],\n    [\"commands\"],\n  );\n  assertPageConditions(\n    (page.conditions === undefined ? {} : page.conditions) as PageConditions,\n    resolver,\n    `${path}.conditions`,\n  );\n  if (page.priority !== undefined && !pagePriorities.includes(page.priority as \"below\"))\n    fail(`${path}.priority`, pagePriorities.join(\"/\"), page.priority);\n  if (page.trigger !== undefined && !pageTriggers.includes(page.trigger as \"action\"))\n    fail(`${path}.trigger`, pageTriggers.join(\"/\"), page.trigger);\n  if (page.image !== undefined) {\n    const image = object(page.image, `${path}.image`, [\n      \"character\",\n      \"characterIndex\",\n      \"tileId\",\n      \"direction\",\n      \"pattern\",\n    ]);\n    for (const [key, max] of [\n      [\"characterIndex\", 7],\n      [\"tileId\", 1023],\n      [\"pattern\", 2],\n    ] as const)\n      if (image[key] !== undefined) integer(image[key], `${path}.image.${key}`, 0, max, true);\n    if (image.direction !== undefined && !pageDirections.includes(image.direction as \"down\"))\n      fail(\n        `${path}.image.direction`,\n        `${pageDirections.join(\"/\")} (${nativeDirections.join(\"/\")})`,\n        image.direction,\n      );\n    if (image.character !== undefined && image.character !== null) {\n      const asset = object(\n        image.character,\n        `${path}.image.character`,\n        [\"kind\", \"category\", \"folder\", \"name\"],\n        [\"kind\", \"category\", \"folder\", \"name\"],\n      );\n      if (\n        asset.kind !== \"asset\" ||\n        asset.category !== \"image\" ||\n        asset.folder !== \"characters\" ||\n        typeof asset.name !== \"string\" ||\n        asset.name.length === 0\n      )\n        fail(\n          `${path}.image.character`,\n          \"characters Image Asset Reference or null\",\n          image.character,\n        );\n    }\n  }\n  if (page.options !== undefined) {\n    const options = object(page.options, `${path}.options`, [\n      \"walkAnimation\",\n      \"stepAnimation\",\n      \"directionFix\",\n      \"through\",\n    ]);\n    for (const [field, value] of Object.entries(options))\n      if (value !== undefined && typeof value !== \"boolean\")\n        fail(`${path}.options.${field}`, \"boolean\", value);\n  }\n}\n\nexport function validateMapEventInputs(graph: StagedDataGraph, issues: ValidationIssue[]): void {\n  for (const event of graph.declarations) {\n    if (event.kind !== \"mapEvent\") continue;\n    const identity = `map:${event.mapId}/event:${event.id}`;\n    try {\n      assertMapEventInput(event);\n      for (const [index, page] of event.pages.entries()) {\n        assertMapPageInput(page, graph.resolver, `pages[${index}]`);\n        const tileId = page.image?.tileId ?? 0;\n        if (tileId === 0) continue;\n        const map = graph.snapshotMaps?.find((map) => map.id === event.mapId);\n        const tileset = graph.snapshotTilesets?.find((tileset) => tileset.id === map?.tilesetId);\n        const group = Math.floor(tileId / 256) + 5;\n        const groupName = Array.isArray(tileset?.tilesetNames)\n          ? tileset.tilesetNames[group]\n          : undefined;\n        if (\n          !Number.isSafeInteger(map?.tilesetId) ||\n          (map!.tilesetId as number) <= 0 ||\n          tileset === undefined ||\n          typeof groupName !== \"string\"\n        )\n          fail(\n            `pages[${index}].image.tileId`,\n            \"existing Map tileset and saved B/C/D/E group name\",\n            tileId,\n            \"MV-MAP-TILESET\",\n          );\n        if (groupName === \"\")\n          issues.push({\n            level: \"warning\",\n            code: \"MV-MAP-TILESET-EMPTY\",\n            stage: \"compile\",\n            identity,\n            nativePath: `pages[${index}].image.tileId`,\n            dslPath: `pages[${index}].image.tileId`,\n            message: `${identity} page ${index + 1} uses tile ${tileId} from empty tileset group ${[\"B\", \"C\", \"D\", \"E\"][group - 5]}; saved values are preserved.`,\n          });\n      }\n    } catch (error) {\n      if (error instanceof CommandStructureError) issues.push(error.issue(identity, \"compile\"));\n      else throw error;\n    }\n  }\n}\n","import type { ReferenceEntry, ValidationIssue, DuplicateAwareNameIndex } from \"./types.js\";\n\nexport function buildDuplicateAwareNameIndex(\n  entries: readonly ReferenceEntry[],\n  includeEmptyNames = false,\n): DuplicateAwareNameIndex {\n  const index: DuplicateAwareNameIndex = new Map();\n\n  for (const entry of entries) {\n    if (!includeEmptyNames && entry.name.length === 0) continue;\n    const existing = index.get(entry.name);\n    if (existing) {\n      existing.push(entry.id);\n    } else {\n      index.set(entry.name, [entry.id]);\n    }\n  }\n\n  return index;\n}\n\nexport function captureReferenceIssue(callback: () => number, issues: ValidationIssue[]): void {\n  try {\n    callback();\n  } catch (error) {\n    issues.push({\n      level: \"error\",\n      message: error instanceof Error ? error.message : String(error),\n    });\n  }\n}\n","import type {\n  ConditionalBranchCondition,\n  DslCommand,\n  EventPage,\n  MovementRoute,\n  PageConditions,\n  ReferenceKind,\n  ReferenceValue,\n  RuntimeSelector,\n} from \"../domain/types.js\";\nimport { isProjectDataReference } from \"../domain/references.js\";\nimport type { ReferenceResolver, ValidationIssue } from \"./types.js\";\nimport { captureReferenceIssue } from \"./shared.js\";\nimport { isReferenceValue } from \"./inspection.js\";\nimport { assertNativeSwitchCommand } from \"../commands/variables/validation.js\";\nimport { assertNativeContextReferences } from \"./native-context-references.js\";\nimport { resolveCommonEventCall, assertLoopCommand } from \"../commands/flow/validation.js\";\nimport {\n  assertSetMovementRoute,\n  validateNativeMovementRouteInputs,\n} from \"../commands/movement/validation.js\";\nimport { CommandStructureError } from \"./command-structure.js\";\nimport { assertDslCommandList } from \"./dsl-command-inputs.js\";\nimport { assertMapAppearanceInput } from \"../commands/map/validation.js\";\n\ntype CommandValidationOptions = { scriptEnabled: boolean; identity?: string; path?: string };\n\nexport function validatePages(\n  pages: readonly EventPage[],\n  resolver: ReferenceResolver,\n  options: CommandValidationOptions,\n  issues: ValidationIssue[],\n): void {\n  for (const [pageIndex, page] of pages.entries()) {\n    validateCondition(page.conditions, resolver, issues);\n    validateNodes(\n      page.commands,\n      resolver,\n      { ...options, path: `pages[${pageIndex}].commands` },\n      issues,\n    );\n  }\n}\n\nexport function validateNodes(\n  nodes: readonly DslCommand[],\n  resolver: ReferenceResolver,\n  options: CommandValidationOptions,\n  issues: ValidationIssue[],\n): void {\n  try {\n    assertDslCommandList(nodes, options.path ?? \"commands\", false);\n  } catch (error) {\n    if (error instanceof CommandStructureError)\n      issues.push(error.issue(options.identity ?? \"event\", \"compile\"));\n    else throw error;\n    return;\n  }\n  for (const [nodeIndex, node] of nodes.entries()) {\n    const nodePath = `${options.path ?? \"commands\"}[${nodeIndex}]`;\n    try {\n      assertMapAppearanceInput(node.kind, node, nodePath, true, resolver);\n    } catch (error) {\n      if (error instanceof CommandStructureError)\n        issues.push(error.issue(options.identity ?? \"event\", \"compile\"));\n      else throw error;\n      continue;\n    }\n    const childOptions = (field: string): CommandValidationOptions => ({\n      ...options,\n      path: `${nodePath}.${field}`,\n    });\n    if (node.kind === \"loop\") {\n      try {\n        assertLoopCommand(node, nodePath);\n      } catch {\n        continue;\n      }\n      validateNodes(node.body.commands, resolver, childOptions(\"body.commands\"), issues);\n    }\n    const captureSwitchIssue = (\n      code: string,\n      field: string,\n      action: () => unknown,\n    ): number | undefined => {\n      try {\n        return action() as number | undefined;\n      } catch (error) {\n        issues.push({\n          level: \"error\",\n          message: `${code} validation ${options.identity ?? \"event\"}.${nodePath}.${field}: ${error instanceof Error ? error.message : String(error)}`,\n        });\n        return undefined;\n      }\n    };\n    if (node.kind === \"script\" && !options.scriptEnabled) {\n      issues.push({\n        level: \"error\",\n        message: \"Script commands require explicit config enablement.\",\n      });\n    }\n    if (node.kind === \"controlSwitches\") {\n      const value: unknown = node.value;\n      if (\"from\" in node.switch) {\n        const range = node.switch;\n        const from = captureSwitchIssue(\"MV-E121-REFERENCE\", \"switch.from\", () =>\n          resolver.resolveReference(range.from),\n        );\n        const to = captureSwitchIssue(\"MV-E121-REFERENCE\", \"switch.to\", () =>\n          resolver.resolveReference(range.to),\n        );\n        if (from !== undefined && to !== undefined && from > to)\n          captureSwitchIssue(\"MV-E121-RANGE\", \"switch\", () => {\n            throw new Error(\n              `expected start <= end; received ${from}..${to}. Ranges are not reordered.`,\n            );\n          });\n      } else {\n        captureSwitchIssue(\"MV-E121-REFERENCE\", \"switch\", () =>\n          resolver.resolveReference(node.switch as ReferenceValue<\"switch\">),\n        );\n      }\n      if (typeof value !== \"boolean\")\n        captureSwitchIssue(\"MV-E121-VALUE\", \"value\", () => {\n          throw new Error(`expected explicit boolean; received ${String(value)}.`);\n        });\n    }\n    if (node.kind === \"controlSelfSwitch\") {\n      const value: unknown = node.value;\n      if (typeof value !== \"boolean\")\n        captureSwitchIssue(\"MV-E123-VALUE\", \"value\", () => {\n          throw new Error(`expected explicit boolean; received ${String(value)}.`);\n        });\n      captureSwitchIssue(\"MV-E123-LETTER\", \"selfSwitch\", () =>\n        assertNativeSwitchCommand(123, [node.selfSwitch, node.value ? 0 : 1]),\n      );\n    }\n    if (node.kind === \"rawDslCommand\" && (node.code === 121 || node.code === 123)) {\n      captureSwitchIssue(`MV-E${node.code}-RAW`, \"parameters\", () =>\n        assertNativeSwitchCommand(node.code, node.parameters, resolver),\n      );\n    }\n    if (node.kind === \"rawDslCommand\") {\n      try {\n        assertNativeContextReferences(node.code, node.parameters, resolver);\n      } catch (error) {\n        issues.push({\n          level: \"error\",\n          message: `validation ${options.identity ?? \"event\"}.${nodePath}: ${error instanceof Error ? error.message : String(error)}`,\n        });\n      }\n    }\n    if (node.kind === \"controlVariables\") {\n      validateReferenceOrRange(node.variable, resolver, issues);\n      if (isVariableReferenceValue(node.value)) {\n        const valueRef = node.value;\n        captureReferenceIssue(() => resolver.resolveReference(valueRef), issues);\n      }\n      if (typeof node.value === \"object\" && node.value !== null && \"kind\" in node.value) {\n        if (node.value.kind === \"script\" && !options.scriptEnabled) {\n          issues.push({\n            level: \"error\",\n            message: \"Control Variables script operands require explicit config enablement.\",\n          });\n        }\n        if (node.value.kind === \"gameData\") {\n          validateControlVariablesGameDataOperand(node.value, resolver, issues);\n        }\n      }\n    }\n    if (node.kind === \"changeItems\") {\n      captureReferenceIssue(() => resolver.resolveReference(node.item), issues);\n      if (isVariableReferenceValue(node.amount)) {\n        const amountRef = node.amount;\n        captureReferenceIssue(() => resolver.resolveReference(amountRef), issues);\n      }\n    }\n    if (node.kind === \"changeWeapons\") {\n      captureReferenceIssue(() => resolver.resolveReference(node.weapon), issues);\n      if (isVariableReferenceValue(node.amount)) {\n        const amountRef = node.amount;\n        captureReferenceIssue(() => resolver.resolveReference(amountRef), issues);\n      }\n    }\n    if (node.kind === \"changeArmors\") {\n      captureReferenceIssue(() => resolver.resolveReference(node.armor), issues);\n      if (isVariableReferenceValue(node.amount)) {\n        const amountRef = node.amount;\n        captureReferenceIssue(() => resolver.resolveReference(amountRef), issues);\n      }\n    }\n    if (node.kind === \"changeGold\" && isVariableReferenceValue(node.value)) {\n      const valueRef = node.value;\n      captureReferenceIssue(() => resolver.resolveReference(valueRef), issues);\n    }\n    if (node.kind === \"changePartyMember\") {\n      captureReferenceIssue(() => resolver.resolveReference(node.actor), issues);\n    }\n    if (node.kind === \"inputNumber\" || node.kind === \"selectItem\") {\n      captureReferenceIssue(() => resolver.resolveReference(node.variable), issues);\n    }\n    if (node.kind === \"showChoices\" && node.branches.length !== node.choices.length) {\n      issues.push({\n        level: \"error\",\n        message: \"Show Choices branches must match the choice count.\",\n      });\n    }\n    if (node.kind === \"showChoices\") {\n      for (const [branchIndex, branch] of node.branches.entries()) {\n        validateNodes(branch, resolver, childOptions(`branches[${branchIndex}]`), issues);\n      }\n      if (node.cancelBranch) {\n        validateNodes(node.cancelBranch, resolver, childOptions(\"cancelBranch\"), issues);\n      }\n    }\n    if (node.kind === \"commonEvent\") {\n      try {\n        resolveCommonEventCall(node, resolver, nodePath);\n      } catch (error) {\n        if (error instanceof CommandStructureError)\n          issues.push(error.issue(options.identity ?? \"event\", \"compile\"));\n        else throw error;\n        continue;\n      }\n    }\n    if (node.kind === \"transferPlayer\") {\n      validateMapDestination(node.destination, resolver, issues);\n    }\n    if (node.kind === \"setVehicleLocation\") {\n      validateMapDestination(node.destination, resolver, issues);\n    }\n    if (node.kind === \"setEventLocation\") {\n      validateCharacterRuntimeSelector(node.character, \"Set Event Location character\", issues);\n      validateEventLocationDestination(node.destination, resolver, issues);\n    }\n    if (node.kind === \"setMovementRoute\") {\n      try {\n        assertSetMovementRoute(node, nodePath);\n      } catch (error) {\n        if (error instanceof CommandStructureError)\n          issues.push(error.issue(options.identity ?? \"event\", \"compile\"));\n        continue;\n      }\n      validateCharacterRuntimeSelector(node.target, \"Set Movement Route target\", issues);\n      validateMoveRouteCommands(node.route, resolver, childOptions(\"route\"), issues);\n    }\n    if (node.kind === \"rawDslCommand\" && node.code === 205) {\n      try {\n        validateNativeMovementRouteInputs(\n          node.parameters?.[1],\n          resolver,\n          {\n            ...options,\n            dslPath: `${nodePath}.parameters[1]`,\n            nativePath: `${nodePath}.parameters[1]`,\n          },\n          issues,\n        );\n      } catch (error) {\n        if (error instanceof CommandStructureError)\n          issues.push(error.issue(options.identity ?? \"event\", \"compile\"));\n      }\n    }\n    if (node.kind === \"showAnimation\") {\n      validateCharacterRuntimeSelector(node.target, \"Show Animation target\", issues);\n      captureSwitchIssue(\"MV-E212-REFERENCE\", \"animation\", () =>\n        resolver.resolveReference(node.animation),\n      );\n    }\n    if (node.kind === \"showBalloonIcon\") {\n      validateCharacterRuntimeSelector(node.target, \"Show Balloon Icon target\", issues);\n    }\n    if (node.kind === \"showPicture\" || node.kind === \"movePicture\") {\n      validateCommandPosition(node.position, resolver, issues);\n    }\n    if (node.kind === \"battleProcessing\" && isReferenceValue(node.troop)) {\n      const troopRef = node.troop;\n      captureReferenceIssue(() => resolver.resolveReference(troopRef), issues);\n    }\n    if (\n      node.kind === \"battleProcessing\" &&\n      typeof node.troop === \"object\" &&\n      node.troop.kind === \"troop\" &&\n      \"variable\" in node.troop\n    ) {\n      const troopVariable = node.troop.variable;\n      captureReferenceIssue(() => resolver.resolveReference(troopVariable), issues);\n    }\n    if (node.kind === \"battleProcessing\") {\n      if (node.win) {\n        validateNodes(node.win, resolver, childOptions(\"win\"), issues);\n      }\n      if (node.escape) {\n        if (node.canEscape !== true) {\n          issues.push({\n            level: \"error\",\n            message: \"Battle Processing escape branch requires canEscape: true.\",\n          });\n        }\n        validateNodes(node.escape, resolver, childOptions(\"escape\"), issues);\n      }\n      if (node.lose) {\n        if (node.canLose !== true) {\n          issues.push({\n            level: \"error\",\n            message: \"Battle Processing lose branch requires canLose: true.\",\n          });\n        }\n        validateNodes(node.lose, resolver, childOptions(\"lose\"), issues);\n      }\n    }\n    if (node.kind === \"shopProcessing\") {\n      for (const goods of node.goods) {\n        captureReferenceIssue(() => resolver.resolveReference(goods.item), issues);\n      }\n    }\n    if (node.kind === \"nameInputProcessing\") {\n      captureReferenceIssue(() => resolver.resolveReference(node.actor), issues);\n    }\n    if (\n      node.kind === \"changeHp\" ||\n      node.kind === \"changeMp\" ||\n      node.kind === \"recoverAll\" ||\n      node.kind === \"changeExp\" ||\n      node.kind === \"changeLevel\" ||\n      node.kind === \"changeParameter\" ||\n      node.kind === \"changeSkill\" ||\n      node.kind === \"changeTp\"\n    ) {\n      validateActorCommandTarget(node.target, resolver, `${node.kind} target`, issues);\n    }\n    if (\n      node.kind === \"changeHp\" ||\n      node.kind === \"changeMp\" ||\n      node.kind === \"changeExp\" ||\n      node.kind === \"changeLevel\" ||\n      node.kind === \"changeParameter\" ||\n      node.kind === \"changeTp\"\n    ) {\n      validateOperateValueOperand(node.value, resolver, issues);\n    }\n    if (node.kind === \"changeState\") {\n      validateActorCommandTarget(node.target, resolver, \"Change State target\", issues);\n      captureReferenceIssue(() => resolver.resolveReference(node.state), issues);\n    }\n    if (node.kind === \"changeSkill\") {\n      captureReferenceIssue(() => resolver.resolveReference(node.skill), issues);\n    }\n    if (node.kind === \"changeEquipment\") {\n      captureReferenceIssue(() => resolver.resolveReference(node.actor), issues);\n      validateCommandPositiveInteger(\n        node.equipmentTypeId,\n        \"Change Equipment equipment type id\",\n        issues,\n      );\n      validateCommandNonNegativeInteger(node.itemId ?? 0, \"Change Equipment item id\", issues);\n    }\n    if (node.kind === \"changeName\") {\n      captureReferenceIssue(() => resolver.resolveReference(node.actor), issues);\n    }\n    if (node.kind === \"changeClass\") {\n      captureReferenceIssue(() => resolver.resolveReference(node.actor), issues);\n      captureReferenceIssue(() => resolver.resolveReference(node.class), issues);\n    }\n    if (node.kind === \"changeActorImages\") {\n      captureReferenceIssue(() => resolver.resolveReference(node.actor), issues);\n    }\n    if (node.kind === \"changeNickname\" || node.kind === \"changeProfile\") {\n      captureReferenceIssue(() => resolver.resolveReference(node.actor), issues);\n    }\n    if (\n      node.kind === \"changeEnemyHp\" ||\n      node.kind === \"changeEnemyMp\" ||\n      node.kind === \"enemyRecoverAll\" ||\n      node.kind === \"enemyAppear\" ||\n      node.kind === \"enemyTransform\" ||\n      node.kind === \"showBattleAnimation\" ||\n      node.kind === \"changeEnemyTp\"\n    ) {\n      validateEnemyCommandTarget(node.target, `${node.kind} target`, issues);\n    }\n    if (\n      node.kind === \"changeEnemyHp\" ||\n      node.kind === \"changeEnemyMp\" ||\n      node.kind === \"changeEnemyTp\"\n    ) {\n      validateOperateValueOperand(node.value, resolver, issues);\n    }\n    if (node.kind === \"changeEnemyState\") {\n      validateEnemyCommandTarget(node.target, \"Change Enemy State target\", issues);\n      captureReferenceIssue(() => resolver.resolveReference(node.state), issues);\n    }\n    if (node.kind === \"enemyTransform\") {\n      captureSwitchIssue(\"MV-E336-REFERENCE\", \"enemy\", () => resolver.resolveReference(node.enemy));\n    }\n    if (node.kind === \"showBattleAnimation\") {\n      captureReferenceIssue(() => resolver.resolveReference(node.animation), issues);\n    }\n    if (node.kind === \"forceAction\") {\n      validateBattlerCommandTarget(node.subject, \"Force Action subject\", issues);\n      captureReferenceIssue(() => resolver.resolveReference(node.skill), issues);\n    }\n    if (node.kind === \"changeTileset\") {\n      captureSwitchIssue(\"MV-E282-REFERENCE\", \"tileset\", () =>\n        resolver.resolveReference(node.tileset),\n      );\n    }\n    if (node.kind === \"getLocationInfo\") {\n      captureReferenceIssue(() => resolver.resolveReference(node.variable), issues);\n      validateCommandPosition(node.location, resolver, issues);\n    }\n    if (node.kind === \"conditional\") {\n      validateConditionalBranchCondition(node.condition, resolver, options, issues);\n      validateNodes(node.then, resolver, childOptions(\"then\"), issues);\n      if (node.else) {\n        validateNodes(node.else, resolver, childOptions(\"else\"), issues);\n      }\n    }\n  }\n}\n\nexport function validateCommandPosition(\n  position: Extract<DslCommand, { kind: \"showPicture\" | \"movePicture\" }>[\"position\"],\n  resolver: ReferenceResolver,\n  issues: ValidationIssue[],\n): void {\n  if (position.kind === \"variables\") {\n    captureReferenceIssue(() => resolver.resolveReference(position.x), issues);\n    captureReferenceIssue(() => resolver.resolveReference(position.y), issues);\n  }\n}\n\nexport function validateMoveRouteCommands(\n  route: MovementRoute,\n  resolver: ReferenceResolver,\n  options: CommandValidationOptions,\n  issues: ValidationIssue[],\n): void {\n  for (const [index, command] of route.commands.entries()) {\n    if (command.kind === \"switchOn\" || command.kind === \"switchOff\") {\n      captureReferenceIssue(() => resolver.resolveReference(command.switch), issues);\n    }\n\n    if (command.kind === \"script\" && !options.scriptEnabled) {\n      issues.push({\n        level: \"error\",\n        code: \"MV-MOVEMENT-SCRIPT\",\n        stage: \"compile\",\n        ...(options.identity === undefined ? {} : { identity: options.identity }),\n        dslPath: `${options.path ?? \"route\"}.commands[${index}].script`,\n        message: \"Set Movement Route script commands require explicit config enablement.\",\n      });\n    }\n  }\n}\n\nexport function validateMapDestination(\n  destination: Extract<\n    DslCommand,\n    { kind: \"setVehicleLocation\" | \"transferPlayer\" }\n  >[\"destination\"],\n  resolver: ReferenceResolver,\n  issues: ValidationIssue[],\n): void {\n  if (destination.kind === \"direct\") {\n    captureReferenceIssue(() => resolver.resolveReference(destination.map), issues);\n    return;\n  }\n\n  captureReferenceIssue(() => resolver.resolveReference(destination.map), issues);\n  captureReferenceIssue(() => resolver.resolveReference(destination.x), issues);\n  captureReferenceIssue(() => resolver.resolveReference(destination.y), issues);\n}\n\nexport function validateEventLocationDestination(\n  destination: Extract<DslCommand, { kind: \"setEventLocation\" }>[\"destination\"],\n  resolver: ReferenceResolver,\n  issues: ValidationIssue[],\n): void {\n  if (destination.kind === \"variables\") {\n    captureReferenceIssue(() => resolver.resolveReference(destination.x), issues);\n    captureReferenceIssue(() => resolver.resolveReference(destination.y), issues);\n    return;\n  }\n\n  if (destination.kind === \"exchange\") {\n    validateCharacterRuntimeSelector(\n      destination.character,\n      \"Set Event Location exchange character\",\n      issues,\n    );\n  }\n}\n\nexport function validateCharacterRuntimeSelector(\n  selector: RuntimeSelector,\n  fieldName: string,\n  issues: ValidationIssue[],\n): void {\n  if (selector.scope !== \"character\") {\n    issues.push({\n      level: \"error\",\n      message: `${fieldName} must use the character runtime selector scope.`,\n    });\n    return;\n  }\n\n  if (selector.target === \"player\" || selector.target === \"currentEvent\") {\n    if (\"id\" in selector) {\n      issues.push({\n        level: \"error\",\n        message: `${fieldName} must not include an id for ${selector.target}.`,\n      });\n    }\n    return;\n  }\n\n  if (selector.target === \"event\") {\n    const eventSelector = selector as RuntimeSelector & { id?: unknown };\n    if (\n      typeof eventSelector.id !== \"number\" ||\n      !Number.isInteger(eventSelector.id) ||\n      eventSelector.id <= 0\n    ) {\n      issues.push({\n        level: \"error\",\n        message: `${fieldName} event id must be a positive integer.`,\n      });\n    }\n    return;\n  }\n\n  issues.push({\n    level: \"error\",\n    message: `${fieldName} target must be player, currentEvent, or event.`,\n  });\n}\n\nexport function validateActorCommandTarget(\n  selector: RuntimeSelector,\n  resolver: ReferenceResolver,\n  fieldName: string,\n  issues: ValidationIssue[],\n): void {\n  if (selector.scope !== \"actor\") {\n    issues.push({\n      level: \"error\",\n      message: `${fieldName} must use the actor runtime selector scope.`,\n    });\n    return;\n  }\n\n  if (selector.target === \"entireParty\") {\n    return;\n  }\n\n  const actorSelector = selector as RuntimeSelector & {\n    actorId?: unknown;\n    variable?: ReferenceValue<\"variable\">;\n  };\n  if (selector.target === \"actor\") {\n    if (\n      typeof actorSelector.actorId !== \"number\" ||\n      !Number.isInteger(actorSelector.actorId) ||\n      actorSelector.actorId <= 0\n    ) {\n      issues.push({\n        level: \"error\",\n        message: `${fieldName} actor id must be a positive integer.`,\n      });\n    }\n    return;\n  }\n\n  if (selector.target === \"actorFromVariable\") {\n    const actorVariable = actorSelector.variable;\n    if (actorVariable === undefined) {\n      issues.push({\n        level: \"error\",\n        message: `${fieldName} actorFromVariable target requires a variable reference.`,\n      });\n      return;\n    }\n    captureReferenceIssue(() => resolver.resolveReference(actorVariable), issues);\n    return;\n  }\n\n  issues.push({\n    level: \"error\",\n    message: `${fieldName} target must be entireParty, actor, or actorFromVariable.`,\n  });\n}\n\nexport function validateEnemyCommandTarget(\n  selector: RuntimeSelector,\n  fieldName: string,\n  issues: ValidationIssue[],\n): void {\n  if (selector.scope !== \"enemy\") {\n    issues.push({\n      level: \"error\",\n      message: `${fieldName} must use the enemy runtime selector scope.`,\n    });\n    return;\n  }\n\n  if (selector.target === \"all\") {\n    return;\n  }\n\n  const enemySelector = selector as RuntimeSelector & { index?: unknown };\n  if (selector.target === \"enemy\") {\n    if (\n      typeof enemySelector.index !== \"number\" ||\n      !Number.isInteger(enemySelector.index) ||\n      enemySelector.index < 0\n    ) {\n      issues.push({\n        level: \"error\",\n        message: `${fieldName} enemy index must be a zero-based integer.`,\n      });\n    }\n    return;\n  }\n\n  issues.push({\n    level: \"error\",\n    message: `${fieldName} target must be all or enemy.`,\n  });\n}\n\nexport function validateBattlerCommandTarget(\n  selector: RuntimeSelector,\n  fieldName: string,\n  issues: ValidationIssue[],\n): void {\n  if (selector.scope !== \"battler\") {\n    issues.push({\n      level: \"error\",\n      message: `${fieldName} must use the battler runtime selector scope.`,\n    });\n    return;\n  }\n\n  const battlerSelector = selector as RuntimeSelector & { actorId?: unknown; index?: unknown };\n  if (selector.target === \"enemy\") {\n    if (\n      typeof battlerSelector.index !== \"number\" ||\n      !Number.isInteger(battlerSelector.index) ||\n      battlerSelector.index < 0\n    ) {\n      issues.push({\n        level: \"error\",\n        message: `${fieldName} enemy index must be a zero-based integer.`,\n      });\n    }\n    return;\n  }\n\n  if (selector.target === \"actor\") {\n    if (\n      typeof battlerSelector.actorId !== \"number\" ||\n      !Number.isInteger(battlerSelector.actorId) ||\n      battlerSelector.actorId <= 0\n    ) {\n      issues.push({\n        level: \"error\",\n        message: `${fieldName} actor id must be a positive integer.`,\n      });\n    }\n    return;\n  }\n\n  issues.push({\n    level: \"error\",\n    message: `${fieldName} target must be enemy or actor.`,\n  });\n}\n\nexport function validateOperateValueOperand(\n  operand: number | ReferenceValue<\"variable\">,\n  resolver: ReferenceResolver,\n  issues: ValidationIssue[],\n): void {\n  if (isVariableReferenceValue(operand)) {\n    captureReferenceIssue(() => resolver.resolveReference(operand), issues);\n  }\n}\n\nexport function validateCommandPositiveInteger(\n  value: unknown,\n  fieldName: string,\n  issues: ValidationIssue[],\n): void {\n  if (typeof value !== \"number\" || !Number.isInteger(value) || value <= 0) {\n    issues.push({\n      level: \"error\",\n      message: `${fieldName} must be a positive integer.`,\n    });\n  }\n}\n\nexport function validateCommandNonNegativeInteger(\n  value: unknown,\n  fieldName: string,\n  issues: ValidationIssue[],\n): void {\n  if (typeof value !== \"number\" || !Number.isInteger(value) || value < 0) {\n    issues.push({\n      level: \"error\",\n      message: `${fieldName} must be a non-negative integer.`,\n    });\n  }\n}\n\nexport function validateReferenceOrRange<TKind extends ReferenceKind>(\n  value: ReferenceValue<TKind> | { from: ReferenceValue<TKind>; to: ReferenceValue<TKind> },\n  resolver: ReferenceResolver,\n  issues: ValidationIssue[],\n): void {\n  if (\"from\" in value) {\n    let from: number | undefined;\n    let to: number | undefined;\n    captureReferenceIssue(() => {\n      from = resolver.resolveReference(value.from);\n      return from;\n    }, issues);\n    captureReferenceIssue(() => {\n      to = resolver.resolveReference(value.to);\n      return to;\n    }, issues);\n    if (from !== undefined && to !== undefined && from > to) {\n      issues.push({\n        level: \"error\",\n        message: `MV-REFERENCE-RANGE range start ${from} exceeds end ${to}; ranges are not reordered.`,\n      });\n    }\n    return;\n  }\n\n  captureReferenceIssue(() => resolver.resolveReference(value), issues);\n}\n\nexport function validateControlVariablesGameDataOperand(\n  operand: Extract<\n    Extract<DslCommand, { kind: \"controlVariables\" }>[\"value\"],\n    { kind: \"gameData\" }\n  >,\n  resolver: ReferenceResolver,\n  issues: ValidationIssue[],\n): void {\n  switch (operand.source) {\n    case \"item\":\n      captureReferenceIssue(() => resolver.resolveReference(operand.item), issues);\n      break;\n    case \"weapon\":\n      captureReferenceIssue(() => resolver.resolveReference(operand.weapon), issues);\n      break;\n    case \"armor\":\n      captureReferenceIssue(() => resolver.resolveReference(operand.armor), issues);\n      break;\n    case \"actor\":\n      captureReferenceIssue(() => resolver.resolveReference(operand.actor), issues);\n      break;\n    case \"enemy\":\n    case \"character\":\n    case \"party\":\n    case \"other\":\n      break;\n  }\n}\n\nexport function validateConditionalBranchCondition(\n  condition: ConditionalBranchCondition,\n  resolver: ReferenceResolver,\n  options: { scriptEnabled: boolean },\n  issues: ValidationIssue[],\n): void {\n  switch (condition.kind) {\n    case \"switch\":\n      captureReferenceIssue(() => resolver.resolveReference(condition.switch), issues);\n      break;\n    case \"variable\":\n      captureReferenceIssue(() => resolver.resolveReference(condition.variable), issues);\n      if (isVariableReferenceValue(condition.value)) {\n        const valueRef = condition.value;\n        captureReferenceIssue(() => resolver.resolveReference(valueRef), issues);\n      }\n      break;\n    case \"actor\":\n      captureReferenceIssue(() => resolver.resolveReference(condition.actor), issues);\n      validateActorConditionCheck(condition.check, resolver, issues);\n      break;\n    case \"enemy\":\n      if (condition.check.kind === \"state\") {\n        const stateRef = condition.check.state;\n        captureReferenceIssue(() => resolver.resolveReference(stateRef), issues);\n      }\n      break;\n    case \"item\":\n      captureReferenceIssue(() => resolver.resolveReference(condition.item), issues);\n      break;\n    case \"weapon\":\n      captureReferenceIssue(() => resolver.resolveReference(condition.weapon), issues);\n      break;\n    case \"armor\":\n      captureReferenceIssue(() => resolver.resolveReference(condition.armor), issues);\n      break;\n    case \"script\":\n      if (!options.scriptEnabled) {\n        issues.push({\n          level: \"error\",\n          message: \"Conditional Branch script conditions require explicit config enablement.\",\n        });\n      }\n      break;\n    case \"selfSwitch\":\n    case \"timer\":\n    case \"character\":\n    case \"gold\":\n    case \"button\":\n    case \"vehicle\":\n      break;\n  }\n}\n\nexport function validateActorConditionCheck(\n  check: Extract<ConditionalBranchCondition, { kind: \"actor\" }>[\"check\"],\n  resolver: ReferenceResolver,\n  issues: ValidationIssue[],\n): void {\n  switch (check.kind) {\n    case \"class\":\n      captureReferenceIssue(() => resolver.resolveReference(check.class), issues);\n      break;\n    case \"skill\":\n      captureReferenceIssue(() => resolver.resolveReference(check.skill), issues);\n      break;\n    case \"weapon\":\n      captureReferenceIssue(() => resolver.resolveReference(check.weapon), issues);\n      break;\n    case \"armor\":\n      captureReferenceIssue(() => resolver.resolveReference(check.armor), issues);\n      break;\n    case \"state\":\n      captureReferenceIssue(() => resolver.resolveReference(check.state), issues);\n      break;\n    case \"inParty\":\n    case \"name\":\n      break;\n  }\n}\n\nexport function validateCondition(\n  condition: PageConditions,\n  resolver: ReferenceResolver,\n  issues: ValidationIssue[],\n): void {\n  for (const slot of [\n    condition.actor,\n    condition.item,\n    condition.switch1,\n    condition.switch2,\n    condition.variable,\n  ]) {\n    if (slot && (slot.enabled || !(\"id\" in slot.ref)))\n      captureReferenceIssue(() => resolver.resolveReference(slot.ref), issues);\n  }\n}\n\nexport function isVariableReferenceValue(value: unknown): value is ReferenceValue<\"variable\"> {\n  return isProjectDataReference(value) && value.kind === \"variable\";\n}\n","import type {\n  CommonEventDefinition,\n  SwitchDefinition,\n  VariableDefinition,\n} from \"../domain/types.js\";\nimport type { ReferenceEntry } from \"./types.js\";\n\nexport function toReferenceEntry(\n  declaration: CommonEventDefinition | SwitchDefinition | VariableDefinition,\n): ReferenceEntry {\n  return {\n    id: declaration.id,\n    name: declaration.name,\n  };\n}\n\nexport function readObjectReferenceEntries(values: readonly unknown[]): ReferenceEntry[] {\n  return values.flatMap((value) => {\n    if (!value || typeof value !== \"object\" || Array.isArray(value)) {\n      return [];\n    }\n    const record = value as Record<string, unknown>;\n    const id = readPositiveInteger(record.id);\n    const name = typeof record.name === \"string\" ? record.name : \"\";\n\n    return id === null ? [] : [{ id, name }];\n  });\n}\n\nexport function readSystemNameEntries(\n  system: Record<string, unknown>,\n  key: \"switches\" | \"variables\",\n): ReferenceEntry[] {\n  const values = system[key];\n  if (!Array.isArray(values)) {\n    return [];\n  }\n\n  return values.flatMap((value, index) => {\n    if (typeof value === \"string\") {\n      return value.length > 0 ? [{ id: index, name: value }] : [];\n    }\n    if (!value || typeof value !== \"object\") {\n      return [];\n    }\n\n    const name = readNonEmptyString((value as Record<string, unknown>).name);\n    return name === null ? [] : [{ id: index, name }];\n  });\n}\n\nexport function readPositiveInteger(value: unknown): number | null {\n  return typeof value === \"number\" && Number.isInteger(value) && value > 0 ? value : null;\n}\n\nexport function readNonEmptyString(value: unknown): string | null {\n  return typeof value === \"string\" && value.length > 0 ? value : null;\n}\n","import type { DslOwnedDeclaration } from \"../domain/types.js\";\nimport type {\n  ReferenceEntry,\n  ReferenceResolver,\n  ReferenceScope,\n  ReferenceScopes,\n  SnapshotReferenceInput,\n  ValidationIssue,\n} from \"./types.js\";\nimport { validateNodes, validatePages } from \"./commands.js\";\nimport { toReferenceEntry } from \"./snapshot.js\";\nimport { buildDuplicateAwareNameIndex } from \"./shared.js\";\nimport { CommandStructureError } from \"./command-errors.js\";\nimport { assertCommonEventInput } from \"./common-events.js\";\n\nexport function buildReferenceScopes(input: {\n  declarations: readonly DslOwnedDeclaration[];\n  snapshotReferences: SnapshotReferenceInput;\n}): ReferenceScopes {\n  for (const declaration of input.declarations) {\n    if (declaration.kind === \"commonEvent\") assertCommonEventInput(declaration, true);\n  }\n  const commonEvents = input.declarations.flatMap((declaration) =>\n    declaration.kind === \"commonEvent\" ? [toReferenceEntry(declaration)] : [],\n  );\n  const switches = input.declarations.flatMap((declaration) =>\n    declaration.kind === \"switchDefinition\" ? [toReferenceEntry(declaration)] : [],\n  );\n  const variables = input.declarations.flatMap((declaration) =>\n    declaration.kind === \"variableDefinition\" ? [toReferenceEntry(declaration)] : [],\n  );\n\n  return {\n    actor: buildReferenceScope(input.snapshotReferences.actors ?? []),\n    animation: buildReferenceScope(input.snapshotReferences.animations ?? []),\n    armor: buildReferenceScope(input.snapshotReferences.armors ?? []),\n    class: buildReferenceScope(input.snapshotReferences.classes ?? []),\n    commonEvent: buildReferenceScope(commonEvents, true),\n    enemy: buildReferenceScope(input.snapshotReferences.enemies ?? []),\n    item: buildReferenceScope(input.snapshotReferences.items ?? []),\n    map: buildReferenceScope(input.snapshotReferences.maps ?? []),\n    skill: buildReferenceScope(input.snapshotReferences.skills ?? []),\n    state: buildReferenceScope(input.snapshotReferences.states ?? []),\n    switch: buildSystemScope(\n      switches,\n      input.snapshotReferences.switches ?? [],\n      input.snapshotReferences.switchCapacity,\n    ),\n    tileset: buildReferenceScope(input.snapshotReferences.tilesets ?? []),\n    troop: buildReferenceScope(input.snapshotReferences.troops ?? []),\n    variable: buildSystemScope(\n      variables,\n      input.snapshotReferences.variables ?? [],\n      input.snapshotReferences.variableCapacity,\n    ),\n    weapon: buildReferenceScope(input.snapshotReferences.weapons ?? []),\n  };\n}\n\nfunction buildSystemScope(\n  declarations: readonly ReferenceEntry[],\n  snapshot: readonly ReferenceEntry[],\n  capacity = 0,\n): ReferenceScope {\n  return {\n    ...buildReferenceScope(declarations),\n    capacity: [...snapshot, ...declarations].reduce(\n      (maximum, { id }) => (Number.isSafeInteger(id) && id > maximum ? id : maximum),\n      Math.max(capacity, 0),\n    ),\n  };\n}\n\nexport function buildReferenceScope(\n  entries: readonly ReferenceEntry[],\n  includeEmptyNames = false,\n): ReferenceScope {\n  return {\n    byId: new Map(entries.map((entry) => [entry.id, entry])),\n    byName: buildDuplicateAwareNameIndex(entries, includeEmptyNames),\n  };\n}\n\nexport function createReferenceResolver(scopes: ReferenceScopes): ReferenceResolver {\n  return {\n    resolveReference(ref) {\n      const scope = scopes[ref.kind];\n\n      if (\"id\" in ref) {\n        if (\n          !Number.isSafeInteger(ref.id) ||\n          ref.id <= 0 ||\n          (!scope.byId.has(ref.id) && !(scope.capacity !== undefined && ref.id <= scope.capacity))\n        ) {\n          throw new Error(`Unknown ${ref.kind} reference id: ${ref.id}`);\n        }\n\n        return ref.id;\n      }\n\n      const ids = scope.byName.get(ref.name) ?? [];\n      if (ids.length === 0) {\n        throw new Error(`Unknown ${ref.kind} reference: ${ref.name}`);\n      }\n      if (ids.length > 1) {\n        throw new Error(`Ambiguous ${ref.kind} reference: ${ref.name}`);\n      }\n\n      return ids[0] as number;\n    },\n  };\n}\n\nexport function validateDeclarationReferences(\n  declarations: readonly DslOwnedDeclaration[],\n  resolver: ReferenceResolver,\n  options: { scriptEnabled: boolean },\n  issues: ValidationIssue[],\n): void {\n  for (const declaration of declarations) {\n    if (declaration.kind === \"mapEvent\") {\n      validatePages(\n        declaration.pages,\n        resolver,\n        { ...options, identity: `map ${declaration.mapId} event ${declaration.id}` },\n        issues,\n      );\n      continue;\n    }\n\n    if (declaration.kind === \"commonEvent\") {\n      try {\n        assertCommonEventInput(declaration, true);\n      } catch (error) {\n        if (error instanceof CommandStructureError)\n          issues.push(error.issue(`commonEvent:${declaration.id}`, \"compile\"));\n        else throw error;\n        continue;\n      }\n      if (declaration.switch) {\n        try {\n          resolver.resolveReference(declaration.switch);\n        } catch (error) {\n          issues.push(\n            new CommandStructureError(\n              \"MV-COMMON-REFERENCE\",\n              error instanceof Error ? error.message : String(error),\n              {\n                dslPath: \"commonEvent.switch\",\n                expected: \"existing Switch reference\",\n              },\n            ).issue(`commonEvent:${declaration.id}`, \"compile\"),\n          );\n        }\n      }\n      validateNodes(\n        declaration.commands,\n        resolver,\n        { ...options, identity: `common event ${declaration.id}` },\n        issues,\n      );\n    }\n  }\n}\n\nexport { captureReferenceIssue } from \"./shared.js\";\n","import type { DslOwnedDeclaration, MapEventDefinition } from \"../domain/types.js\";\nimport { describeValue } from \"../project-data/json-values.js\";\nimport type {\n  SnapshotMapValidationEntry,\n  SnapshotTroopValidationEntry,\n  ValidationIssue,\n} from \"./types.js\";\n\nexport type { SnapshotMapValidationEntry } from \"./types.js\";\n\nexport function validateDeclarationIdentities(\n  declarations: readonly DslOwnedDeclaration[],\n  issues: ValidationIssue[],\n  snapshotMaps?: readonly SnapshotMapValidationEntry[],\n  snapshotTroops?: readonly SnapshotTroopValidationEntry[],\n): void {\n  const mapEventIdentities = new Set<string>();\n  const commonEventIds = new Set<number>();\n  const switchIds = new Set<number>();\n  const variableIds = new Set<number>();\n  const troopIds = new Set<number>();\n  const snapshotMapsById =\n    snapshotMaps === undefined ? undefined : new Map(snapshotMaps.map((map) => [map.id, map]));\n  const occupiedCoordinates = new Set<string>();\n\n  for (const declaration of declarations) {\n    switch (declaration.kind) {\n      case \"troopEvent\":\n        if (\n          !Number.isSafeInteger(declaration.troopId) ||\n          declaration.troopId <= 0 ||\n          !snapshotTroops?.some(({ id }) => id === declaration.troopId)\n        )\n          issues.push({\n            level: \"error\",\n            code: \"MV-TROOP-IDENTITY\",\n            stage: \"compile\",\n            identity: `troop:${declaration.troopId}`,\n            dslPath: \"troopId\",\n            expected: \"positive existing Snapshot Troop identity\",\n            actual: describeValue(declaration.troopId),\n            message: `compile error troop:${declaration.troopId}: MV-TROOP-IDENTITY at troopId; expected positive existing Snapshot Troop identity; actual ${describeValue(declaration.troopId)}.`,\n          });\n        if (troopIds.has(declaration.troopId))\n          issues.push({\n            level: \"error\",\n            code: \"MV-TROOP-IDENTITY-DUPLICATE\",\n            stage: \"compile\",\n            identity: `troop:${declaration.troopId}`,\n            dslPath: \"troopId\",\n            expected: \"unique Troop Event identity\",\n            actual: describeValue(declaration.troopId),\n            message: `compile error troop:${declaration.troopId}: MV-TROOP-IDENTITY-DUPLICATE at troopId; expected unique Troop Event identity; actual ${describeValue(declaration.troopId)}.`,\n          });\n        troopIds.add(declaration.troopId);\n        break;\n      case \"mapEvent\":\n        validatePositiveInteger(declaration.mapId, \"Map event mapId\", declaration.name, issues);\n        validatePositiveInteger(declaration.id, \"Map event id\", declaration.name, issues);\n        trackUniqueIdentity(\n          mapEventIdentities,\n          mapEventIdentityKey(declaration),\n          `Duplicate Map Event identity: mapId ${declaration.mapId}, eventId ${declaration.id}.`,\n          issues,\n        );\n        if (declaration.pages.length === 0) {\n          issues.push({\n            level: \"error\",\n            message: `Map event \"${declaration.name}\" must contain at least one page.`,\n          });\n        }\n        if (declaration.pages.length > 20)\n          issues.push({\n            level: \"warning\",\n            code: \"MV-MAP-PAGE-COUNT\",\n            message: `Map event \"${declaration.name}\" has ${declaration.pages.length} pages; the editor creates at most 20. Page order and count are preserved.`,\n          });\n        validateMapEventPlacement(declaration, snapshotMapsById, occupiedCoordinates, issues);\n        break;\n      case \"commonEvent\":\n        validatePositiveInteger(declaration.id, \"Common event id\", declaration.name, issues);\n        trackUniqueIdentity(\n          commonEventIds,\n          declaration.id,\n          `Duplicate Common Event id: ${declaration.id}.`,\n          issues,\n        );\n        break;\n      case \"switchDefinition\":\n        validatePositiveInteger(declaration.id, \"Switch id\", declaration.name, issues);\n        validateNonEmptyName(declaration.name, \"Switch\", issues);\n        trackUniqueIdentity(\n          switchIds,\n          declaration.id,\n          `Duplicate Switch id: ${declaration.id}.`,\n          issues,\n        );\n        break;\n      case \"variableDefinition\":\n        validatePositiveInteger(declaration.id, \"Variable id\", declaration.name, issues);\n        validateNonEmptyName(declaration.name, \"Variable\", issues);\n        trackUniqueIdentity(\n          variableIds,\n          declaration.id,\n          `Duplicate Variable id: ${declaration.id}.`,\n          issues,\n        );\n        break;\n    }\n  }\n}\n\nfunction validateMapEventPlacement(\n  declaration: MapEventDefinition,\n  snapshotMapsById: ReadonlyMap<number, SnapshotMapValidationEntry> | undefined,\n  occupiedCoordinates: Set<string>,\n  issues: ValidationIssue[],\n): void {\n  if (snapshotMapsById === undefined) {\n    return;\n  }\n\n  const map = snapshotMapsById.get(declaration.mapId);\n  if (map === undefined) {\n    issues.push({\n      level: \"error\",\n      message: `Map event \"${declaration.name}\" references unknown mapId ${declaration.mapId}.`,\n    });\n    return;\n  }\n\n  if (map.width !== undefined && !isCoordinateInBounds(declaration.x, map.width)) {\n    issues.push({\n      level: \"error\",\n      message: `Map event \"${declaration.name}\" x coordinate ${declaration.x} is outside map ${map.id} bounds 0-${map.width - 1}.`,\n    });\n  }\n  if (map.height !== undefined && !isCoordinateInBounds(declaration.y, map.height)) {\n    issues.push({\n      level: \"error\",\n      message: `Map event \"${declaration.name}\" y coordinate ${declaration.y} is outside map ${map.id} bounds 0-${map.height - 1}.`,\n    });\n  }\n\n  const coordinateKey = `${declaration.mapId}:${declaration.x}:${declaration.y}`;\n  const snapshotOccupant = map.eventLocations.find(\n    (event) =>\n      event.eventId !== declaration.id && event.x === declaration.x && event.y === declaration.y,\n  );\n  if (occupiedCoordinates.has(coordinateKey) || snapshotOccupant !== undefined) {\n    issues.push({\n      level: \"warning\",\n      message: `Map event \"${declaration.name}\" uses occupied coordinate (${declaration.x}, ${declaration.y}) on map ${declaration.mapId}.`,\n    });\n  }\n  occupiedCoordinates.add(coordinateKey);\n}\n\nfunction isCoordinateInBounds(value: number, size: number): boolean {\n  return Number.isInteger(value) && value >= 0 && value < size;\n}\n\nexport function validatePositiveInteger(\n  value: unknown,\n  fieldName: string,\n  displayName: string,\n  issues: ValidationIssue[],\n): void {\n  if (typeof value !== \"number\" || !Number.isInteger(value) || value <= 0) {\n    issues.push({\n      level: \"error\",\n      message: `${fieldName} for \"${displayName}\" must be a positive integer.`,\n    });\n  }\n}\n\nexport function validateNonEmptyName(\n  name: string,\n  domainName: string,\n  issues: ValidationIssue[],\n): void {\n  if (name.length === 0) {\n    issues.push({\n      level: \"error\",\n      message: `${domainName} name must be a non-empty string.`,\n    });\n  }\n}\n\nexport function trackUniqueIdentity<T>(\n  identities: Set<T>,\n  identity: T,\n  message: string,\n  issues: ValidationIssue[],\n): void {\n  if (identities.has(identity)) {\n    issues.push({ level: \"error\", message });\n    return;\n  }\n\n  identities.add(identity);\n}\n\nexport function mapEventIdentityKey(definition: MapEventDefinition): string {\n  return `${definition.mapId}:${definition.id}`;\n}\n","import type {\n  CommandPosition,\n  PicturePosition,\n  ShowBalloonIconDslCommand,\n  ToneInput,\n  ColorInput,\n  WeatherEffectType,\n} from \"../../domain/types.js\";\nimport type { ReferenceResolver } from \"../../validation/types.js\";\n\nexport function balloonIconToCode(balloon: ShowBalloonIconDslCommand[\"balloon\"]): number {\n  if (typeof balloon === \"number\") {\n    return balloon;\n  }\n\n  switch (balloon) {\n    case \"exclamation\":\n      return 1;\n    case \"question\":\n      return 2;\n    case \"musicNote\":\n      return 3;\n    case \"heart\":\n      return 4;\n    case \"anger\":\n      return 5;\n    case \"sweat\":\n      return 6;\n    case \"cobweb\":\n      return 7;\n    case \"silence\":\n      return 8;\n    case \"lightBulb\":\n      return 9;\n    case \"zzz\":\n      return 10;\n  }\n}\n\nexport function compileTone(tone: ToneInput): [number, number, number, number] {\n  return \"red\" in tone\n    ? [tone.red, tone.green, tone.blue, tone.gray]\n    : [tone[0], tone[1], tone[2], tone[3]];\n}\n\nexport function compileColor(color: ColorInput): [number, number, number, number] {\n  return \"red\" in color\n    ? [color.red, color.green, color.blue, color.alpha]\n    : [color[0], color[1], color[2], color[3]];\n}\n\nexport function pictureOriginToCode(origin: PicturePosition[\"origin\"]): number {\n  return origin === \"center\" ? 1 : 0;\n}\n\nexport function compilePicturePosition(\n  position: CommandPosition,\n  resolver: ReferenceResolver,\n): [number, number, number] {\n  if (position.kind === \"direct\") {\n    return [0, position.x, position.y];\n  }\n\n  return [1, resolver.resolveReference(position.x), resolver.resolveReference(position.y)];\n}\n\nexport function weatherEffectToCode(weather: WeatherEffectType): string {\n  return weather === \"none\" ? \"none\" : weather;\n}\n","import type { BattleProcessingDslCommand, DslCommand, ShopGoods } from \"../../domain/types.js\";\nimport type { ReferenceResolver } from \"../../validation/types.js\";\nimport type { CompileCommandList, RawEventCommand } from \"../types.js\";\n\nexport function compileChoiceBranches(\n  node: Extract<DslCommand, { kind: \"showChoices\" }>,\n  indent: number,\n  resolver: ReferenceResolver,\n  compileCommandList: CompileCommandList,\n  sourcePath = \"commands\",\n): RawEventCommand[] {\n  const output: RawEventCommand[] = [];\n\n  node.branches.forEach((branch, index) => {\n    output.push({\n      code: 402,\n      indent,\n      parameters: [index, node.choices[index]],\n    });\n    output.push(\n      ...compileCommandList(\n        branch,\n        indent + 1,\n        resolver,\n        false,\n        `${sourcePath}.branches[${index}]`,\n      ),\n    );\n    if (branch.length === 0) output.push({ code: 0, indent: indent + 1, parameters: [] });\n  });\n\n  if (node.cancelBranch) {\n    output.push({\n      code: 403,\n      indent,\n      parameters: [],\n    });\n    output.push(\n      ...compileCommandList(\n        node.cancelBranch,\n        indent + 1,\n        resolver,\n        false,\n        `${sourcePath}.cancelBranch`,\n      ),\n    );\n    if (node.cancelBranch.length === 0)\n      output.push({ code: 0, indent: indent + 1, parameters: [] });\n  }\n\n  return output;\n}\n\nexport function compileBattleProcessingParameters(\n  node: BattleProcessingDslCommand,\n  resolver: ReferenceResolver,\n): unknown[] {\n  if (\"useRandomEncounter\" in node.troop) {\n    return [2, 0, node.canEscape ?? false, node.canLose ?? false];\n  }\n\n  if (\"variable\" in node.troop) {\n    return [\n      1,\n      resolver.resolveReference(node.troop.variable),\n      node.canEscape ?? false,\n      node.canLose ?? false,\n    ];\n  }\n\n  return [0, resolver.resolveReference(node.troop), node.canEscape ?? false, node.canLose ?? false];\n}\n\nexport function compileShopGoodsParameters(\n  goods: ShopGoods,\n  resolver: ReferenceResolver,\n): unknown[] {\n  return [\n    shopGoodsTypeToCode(goods.kind),\n    resolver.resolveReference(goods.item),\n    goods.price === undefined ? 0 : 1,\n    goods.price ?? 0,\n  ];\n}\n\nexport function shopGoodsTypeToCode(kind: ShopGoods[\"kind\"]): number {\n  switch (kind) {\n    case \"item\":\n      return 0;\n    case \"weapon\":\n      return 1;\n    case \"armor\":\n      return 2;\n  }\n}\n","import type {\n  ActorCommandTarget,\n  BattlerCommandTarget,\n  EnemyCommandTarget,\n  ActorParameter,\n} from \"../../domain/types.js\";\nimport type { ReferenceResolver } from \"../../validation/types.js\";\n\nexport function compileActorCommandTarget(\n  target: ActorCommandTarget,\n  resolver: ReferenceResolver,\n): [number, number] {\n  switch (target.target) {\n    case \"entireParty\":\n      return [0, 0];\n    case \"actor\":\n      return [0, target.actorId];\n    case \"actorFromVariable\":\n      return [1, resolver.resolveReference(target.variable)];\n  }\n}\n\nexport function enemyTargetToCode(target: EnemyCommandTarget): number {\n  return target.target === \"all\" ? -1 : target.index;\n}\n\nexport function battlerTargetTypeToCode(target: BattlerCommandTarget): number {\n  return target.target === \"enemy\" ? 0 : 1;\n}\n\nexport function battlerTargetIdToCode(target: BattlerCommandTarget): number {\n  return target.target === \"enemy\" ? target.index : target.actorId;\n}\n\nexport function actorParameterToCode(parameter: ActorParameter): number {\n  switch (parameter) {\n    case \"mhp\":\n      return 0;\n    case \"mmp\":\n      return 1;\n    case \"atk\":\n      return 2;\n    case \"def\":\n      return 3;\n    case \"mat\":\n      return 4;\n    case \"mdf\":\n      return 5;\n    case \"agi\":\n      return 6;\n    case \"luk\":\n      return 7;\n  }\n}\n","import type { AudioPayload, CommandPosition, LocationInfoType } from \"../../domain/types.js\";\nimport type { ReferenceResolver } from \"../../validation/types.js\";\n\nexport function compileAudioPayload(audio: AudioPayload): {\n  name: string;\n  pan: number;\n  pitch: number;\n  volume: number;\n} {\n  return {\n    name: audio.asset.name,\n    volume: audio.volume ?? 90,\n    pitch: audio.pitch ?? 100,\n    pan: audio.pan ?? 0,\n  };\n}\n\nexport function compileLocationInfoPosition(\n  position: CommandPosition,\n  resolver: ReferenceResolver,\n): [number, number, number] {\n  if (position.kind === \"direct\") {\n    return [0, position.x, position.y];\n  }\n\n  return [1, resolver.resolveReference(position.x), resolver.resolveReference(position.y)];\n}\n\nexport function locationInfoTypeToCode(info: LocationInfoType): number {\n  switch (info) {\n    case \"terrainTag\":\n      return 0;\n    case \"eventId\":\n      return 1;\n    case \"tileIdLayer1\":\n      return 2;\n    case \"tileIdLayer2\":\n      return 3;\n    case \"tileIdLayer3\":\n      return 4;\n    case \"tileIdLayer4\":\n      return 5;\n    case \"regionId\":\n      return 6;\n  }\n}\n","import type { CommonEventDefinition, DslCommand } from \"../domain/types.js\";\nimport type { ReferenceResolver } from \"../validation/types.js\";\nimport type { RawEventCommand, CommandOrigins } from \"./types.js\";\nimport { assertDslCommandList } from \"../validation/dsl-command-inputs.js\";\nimport { assertMapAppearanceInput } from \"../commands/map/validation.js\";\nimport {\n  resolveCommonEventCall,\n  assertLoopCommand,\n  assertParameterlessFlowCommand,\n} from \"../commands/flow/validation.js\";\nimport {\n  assertNativeCommandEnvelope,\n  CommandStructureError,\n  inspectCommandListStructure,\n} from \"../validation/command-structure.js\";\nimport { compileConditionalBranchParameters, vehicleToCode } from \"./shared/conditions.js\";\nexport {\n  compileConditionalBranchParameters,\n  conditionalVariableOperatorToCode,\n  actorConditionCheckToCode,\n  actorConditionCheckValue,\n  goldConditionOperatorToCode,\n  vehicleToCode,\n} from \"./shared/conditions.js\";\nimport {\n  balloonIconToCode,\n  compileTone,\n  compileColor,\n  pictureOriginToCode,\n  compilePicturePosition,\n  weatherEffectToCode,\n} from \"../commands/screen/compile.js\";\nexport {\n  balloonIconToCode,\n  compileTone,\n  compileColor,\n  pictureOriginToCode,\n  compilePicturePosition,\n  weatherEffectToCode,\n} from \"../commands/screen/compile.js\";\nimport {\n  resolveControlValue,\n  compileControlVariablesParameters,\n  compileReferenceTargetRange,\n  compileOperateValueParameters,\n} from \"../commands/variables/compile.js\";\nexport {\n  resolveControlValue,\n  isReferenceValue,\n  compileControlVariablesParameters,\n  compileReferenceTargetRange,\n  compileOperateValueParameters,\n  compileControlVariablesGameDataOperand,\n  actorGameDataValueToCode,\n  enemyGameDataValueToCode,\n  characterGameDataValueToCode,\n  otherGameDataValueToCode,\n} from \"../commands/variables/compile.js\";\nimport {\n  compileChoiceBranches,\n  compileBattleProcessingParameters,\n  compileShopGoodsParameters,\n} from \"./shared/branches.js\";\nexport {\n  compileChoiceBranches,\n  compileBattleProcessingParameters,\n  compileShopGoodsParameters,\n  shopGoodsTypeToCode,\n} from \"./shared/branches.js\";\nimport {\n  compileActorCommandTarget,\n  enemyTargetToCode,\n  battlerTargetTypeToCode,\n  battlerTargetIdToCode,\n  actorParameterToCode,\n} from \"./shared/targets.js\";\nexport {\n  compileActorCommandTarget,\n  enemyTargetToCode,\n  battlerTargetTypeToCode,\n  battlerTargetIdToCode,\n  actorParameterToCode,\n} from \"./shared/targets.js\";\nimport {\n  characterSelectorToCode,\n  compileSetVehicleLocationParameters,\n  compileSetEventLocationParameters,\n  compileMovementRoute,\n} from \"../commands/movement/compile.js\";\nimport {\n  assertSetMovementRoute,\n  assertNativeMovementCommandParameters,\n} from \"../commands/movement/validation.js\";\nexport {\n  characterSelectorToCode,\n  compileSetVehicleLocationParameters,\n  compileSetEventLocationParameters,\n  compileMoveRouteCommands,\n  compileMoveRouteCommand,\n} from \"../commands/movement/compile.js\";\nimport {\n  compileAudioPayload,\n  compileLocationInfoPosition,\n  locationInfoTypeToCode,\n} from \"./shared/media.js\";\nexport {\n  compileAudioPayload,\n  compileLocationInfoPosition,\n  locationInfoTypeToCode,\n} from \"./shared/media.js\";\nexport type { RawEventCommand } from \"./types.js\";\n\nexport function compileNodes(\n  nodes: readonly DslCommand[],\n  indent: number,\n  resolver: ReferenceResolver,\n  includeTerminator = true,\n  sourcePath = \"commands\",\n  origins: CommandOrigins = new Map(),\n): RawEventCommand[] {\n  assertDslCommandList(nodes, sourcePath);\n  const output: RawEventCommand[] = [];\n\n  for (const [nodeIndex, node] of nodes.entries()) {\n    assertMapAppearanceInput(node.kind, node, `${sourcePath}[${nodeIndex}]`, true, resolver);\n    const outputStart = output.length;\n    switch (node.kind) {\n      case \"showText\":\n        output.push({\n          code: 101,\n          indent,\n          parameters: [\n            node.face?.image.name ?? \"\",\n            node.face?.index ?? 0,\n            node.background ?? 0,\n            node.positionType ?? 2,\n          ],\n        });\n        for (const line of node.lines) {\n          output.push({\n            code: 401,\n            indent,\n            parameters: [line],\n          });\n        }\n        break;\n      case \"inputNumber\":\n        output.push({\n          code: 103,\n          indent,\n          parameters: [resolver.resolveReference(node.variable), node.digits],\n        });\n        break;\n      case \"selectItem\":\n        output.push({\n          code: 104,\n          indent,\n          parameters: [resolver.resolveReference(node.variable), node.itemType ?? 2],\n        });\n        break;\n      case \"showScrollingText\":\n        output.push({\n          code: 105,\n          indent,\n          parameters: [node.speed ?? 2, node.noFastForward ?? false],\n        });\n        for (const line of node.lines) {\n          output.push({\n            code: 405,\n            indent,\n            parameters: [line],\n          });\n        }\n        break;\n      case \"conditional\":\n        output.push({\n          code: 111,\n          indent,\n          parameters: compileConditionalBranchParameters(node.condition, resolver),\n        });\n        output.push(\n          ...compileNodes(\n            node.then,\n            indent + 1,\n            resolver,\n            false,\n            `${sourcePath}[${nodeIndex}].then`,\n            origins,\n          ),\n        );\n        if (node.then.length === 0) output.push({ code: 0, indent: indent + 1, parameters: [] });\n        if (node.else) {\n          output.push({\n            code: 411,\n            indent,\n            parameters: [],\n          });\n          output.push(\n            ...compileNodes(\n              node.else,\n              indent + 1,\n              resolver,\n              false,\n              `${sourcePath}[${nodeIndex}].else`,\n              origins,\n            ),\n          );\n          if (node.else.length === 0) output.push({ code: 0, indent: indent + 1, parameters: [] });\n        }\n        output.push({ code: 412, indent, parameters: [] });\n        break;\n      case \"comment\":\n        output.push({\n          code: 108,\n          indent,\n          parameters: [node.lines[0]],\n        });\n        for (let index = 1; index < node.lines.length; index += 1) {\n          output.push({\n            code: 408,\n            indent,\n            parameters: [node.lines[index]],\n          });\n        }\n        break;\n      case \"loop\": {\n        assertLoopCommand(node, `${sourcePath}[${nodeIndex}]`);\n        const body = compileNodes(\n          node.body.commands,\n          indent + 1,\n          resolver,\n          false,\n          `${sourcePath}[${nodeIndex}].body.commands`,\n          origins,\n        );\n        if (body.at(-1)?.code === 0 && body.at(-1)?.indent === indent + 1) {\n          throw new CommandStructureError(\n            \"MV-BODY-MARKER-CONFLICT\",\n            \"Raw output contradicts the owning body's declared Body End Marker.\",\n            {\n              dslPath: `${sourcePath}[${nodeIndex}].body.endMarker`,\n            },\n          );\n        }\n        output.push({\n          code: 112,\n          indent,\n          parameters: [],\n        });\n        output.push(...body);\n        if (node.body.endMarker !== \"absent\")\n          output.push({ code: 0, indent: indent + 1, parameters: [] });\n        output.push({\n          code: 413,\n          indent,\n          parameters: [],\n        });\n        break;\n      }\n      case \"breakLoop\":\n        assertParameterlessFlowCommand(node, `${sourcePath}[${nodeIndex}]`);\n        output.push({ code: 113, indent, parameters: [] });\n        break;\n      case \"exitEventProcessing\":\n        assertParameterlessFlowCommand(node, `${sourcePath}[${nodeIndex}]`);\n        output.push({ code: 115, indent, parameters: [] });\n        break;\n      case \"commonEvent\":\n        output.push({\n          code: 117,\n          indent,\n          parameters: [resolveCommonEventCall(node, resolver, `${sourcePath}[${nodeIndex}]`)],\n        });\n        break;\n      case \"label\":\n        output.push({ code: 118, indent, parameters: [node.name] });\n        break;\n      case \"jumpToLabel\":\n        output.push({ code: 119, indent, parameters: [node.name] });\n        break;\n      case \"controlSwitches\": {\n        const [startSwitchId, endSwitchId] = compileReferenceTargetRange(node.switch, resolver);\n        output.push({\n          code: 121,\n          indent,\n          parameters: [startSwitchId, endSwitchId, resolveControlValue(node.value)],\n        });\n        break;\n      }\n      case \"controlVariables\":\n        output.push({\n          code: 122,\n          indent,\n          parameters: compileControlVariablesParameters(node, resolver),\n        });\n        break;\n      case \"controlSelfSwitch\":\n        output.push({\n          code: 123,\n          indent,\n          parameters: [node.selfSwitch, resolveControlValue(node.value)],\n        });\n        break;\n      case \"controlTimer\":\n        output.push({\n          code: 124,\n          indent,\n          parameters: node.action === \"start\" ? [0, node.seconds] : [1, 0],\n        });\n        break;\n      case \"changeGold\":\n        output.push({\n          code: 125,\n          indent,\n          parameters: compileOperateValueParameters(node.operation, node.value, resolver),\n        });\n        break;\n      case \"changeItems\":\n        output.push({\n          code: 126,\n          indent,\n          parameters: [\n            resolver.resolveReference(node.item),\n            ...compileOperateValueParameters(node.operation, node.amount, resolver),\n          ],\n        });\n        break;\n      case \"changeWeapons\":\n        output.push({\n          code: 127,\n          indent,\n          parameters: [\n            resolver.resolveReference(node.weapon),\n            ...compileOperateValueParameters(node.operation, node.amount, resolver),\n            node.includeEquipment ?? false,\n          ],\n        });\n        break;\n      case \"changeArmors\":\n        output.push({\n          code: 128,\n          indent,\n          parameters: [\n            resolver.resolveReference(node.armor),\n            ...compileOperateValueParameters(node.operation, node.amount, resolver),\n            node.includeEquipment ?? false,\n          ],\n        });\n        break;\n      case \"changePartyMember\":\n        output.push({\n          code: 129,\n          indent,\n          parameters: [\n            resolver.resolveReference(node.actor),\n            node.operation === \"add\" ? 0 : 1,\n            node.initialize ?? false,\n          ],\n        });\n        break;\n      case \"changeBattleBgm\":\n        output.push({\n          code: 132,\n          indent,\n          parameters: [compileAudioPayload(node.audio)],\n        });\n        break;\n      case \"changeVictoryMe\":\n        output.push({\n          code: 133,\n          indent,\n          parameters: [compileAudioPayload(node.audio)],\n        });\n        break;\n      case \"changeSaveAccess\":\n        output.push({\n          code: 134,\n          indent,\n          parameters: [node.enabled ? 1 : 0],\n        });\n        break;\n      case \"changeMenuAccess\":\n        output.push({\n          code: 135,\n          indent,\n          parameters: [node.enabled ? 1 : 0],\n        });\n        break;\n      case \"changeEncounterDisable\":\n        output.push({\n          code: 136,\n          indent,\n          parameters: [node.disabled ? 0 : 1],\n        });\n        break;\n      case \"changeFormationAccess\":\n        output.push({\n          code: 137,\n          indent,\n          parameters: [node.enabled ? 1 : 0],\n        });\n        break;\n      case \"changeWindowColor\":\n        output.push({\n          code: 138,\n          indent,\n          parameters: [compileTone(node.tone)],\n        });\n        break;\n      case \"changeDefeatMe\":\n        output.push({\n          code: 139,\n          indent,\n          parameters: [compileAudioPayload(node.audio)],\n        });\n        break;\n      case \"changeVehicleBgm\":\n        output.push({\n          code: 140,\n          indent,\n          parameters: [vehicleToCode(node.vehicle), compileAudioPayload(node.audio)],\n        });\n        break;\n      case \"wait\":\n        output.push({\n          code: 230,\n          indent,\n          parameters: [node.frames],\n        });\n        break;\n      case \"eraseEvent\":\n        output.push({\n          code: 214,\n          indent,\n          parameters: [],\n        });\n        break;\n      case \"battleProcessing\":\n        output.push({\n          code: 301,\n          indent,\n          parameters: compileBattleProcessingParameters(node, resolver),\n        });\n        if (node.win) {\n          output.push({ code: 601, indent, parameters: [] });\n          output.push(\n            ...compileNodes(\n              node.win,\n              indent + 1,\n              resolver,\n              false,\n              `${sourcePath}[${nodeIndex}].win`,\n              origins,\n            ),\n          );\n          if (node.win.length === 0) output.push({ code: 0, indent: indent + 1, parameters: [] });\n        }\n        if (node.escape) {\n          output.push({ code: 602, indent, parameters: [] });\n          output.push(\n            ...compileNodes(\n              node.escape,\n              indent + 1,\n              resolver,\n              false,\n              `${sourcePath}[${nodeIndex}].escape`,\n              origins,\n            ),\n          );\n          if (node.escape.length === 0)\n            output.push({ code: 0, indent: indent + 1, parameters: [] });\n        }\n        if (node.lose) {\n          output.push({ code: 603, indent, parameters: [] });\n          output.push(\n            ...compileNodes(\n              node.lose,\n              indent + 1,\n              resolver,\n              false,\n              `${sourcePath}[${nodeIndex}].lose`,\n              origins,\n            ),\n          );\n          if (node.lose.length === 0) output.push({ code: 0, indent: indent + 1, parameters: [] });\n        }\n        if (node.canEscape || node.canLose || node.win || node.escape || node.lose) {\n          output.push({ code: 604, indent, parameters: [] });\n        }\n        break;\n      case \"script\":\n        output.push({\n          code: 355,\n          indent,\n          parameters: [node.script.code.split(\"\\n\")[0] ?? \"\"],\n        });\n        for (const line of node.script.code.split(\"\\n\").slice(1)) {\n          output.push({\n            code: 655,\n            indent,\n            parameters: [line],\n          });\n        }\n        break;\n      case \"pluginCommand\":\n        output.push({\n          code: 356,\n          indent,\n          parameters: [\n            node.args !== undefined && node.args.length > 0\n              ? `${node.command} ${node.args.join(\" \")}`\n              : node.command,\n          ],\n        });\n        break;\n      case \"transferPlayer\":\n        if (node.destination.kind === \"direct\") {\n          output.push({\n            code: 201,\n            indent,\n            parameters: [\n              0,\n              resolver.resolveReference(node.destination.map),\n              node.destination.x,\n              node.destination.y,\n              node.direction ?? 2,\n              node.fadeType ?? 0,\n            ],\n          });\n        } else {\n          output.push({\n            code: 201,\n            indent,\n            parameters: [\n              1,\n              resolver.resolveReference(node.destination.map),\n              resolver.resolveReference(node.destination.x),\n              resolver.resolveReference(node.destination.y),\n              node.direction ?? 2,\n              node.fadeType ?? 0,\n            ],\n          });\n        }\n        break;\n      case \"setVehicleLocation\":\n        output.push({\n          code: 202,\n          indent,\n          parameters: compileSetVehicleLocationParameters(node.vehicle, node.destination, resolver),\n        });\n        break;\n      case \"setEventLocation\":\n        output.push({\n          code: 203,\n          indent,\n          parameters: compileSetEventLocationParameters(node, resolver),\n        });\n        break;\n      case \"scrollMap\":\n        output.push({\n          code: 204,\n          indent,\n          parameters: [node.direction, node.distance, node.speed],\n        });\n        break;\n      case \"setMovementRoute\": {\n        assertSetMovementRoute(node, `${sourcePath}[${nodeIndex}]`);\n        const route = compileMovementRoute(\n          node.route,\n          resolver,\n          `${sourcePath}[${nodeIndex}].route`,\n        );\n        output.push({\n          code: 205,\n          indent,\n          parameters: [characterSelectorToCode(node.target), route],\n        });\n        for (const record of route.list.slice(0, -1))\n          output.push({ code: 505, indent, parameters: [record] });\n        break;\n      }\n      case \"getOnOffVehicle\":\n        output.push({\n          code: 206,\n          indent,\n          parameters: [],\n        });\n        break;\n      case \"changeTransparency\":\n        output.push({\n          code: 211,\n          indent,\n          parameters: [node.transparent ? 0 : 1],\n        });\n        break;\n      case \"showAnimation\":\n        output.push({\n          code: 212,\n          indent,\n          parameters: [\n            characterSelectorToCode(node.target),\n            resolver.resolveReference(node.animation),\n            node.wait ?? false,\n          ],\n        });\n        break;\n      case \"showBalloonIcon\":\n        output.push({\n          code: 213,\n          indent,\n          parameters: [\n            characterSelectorToCode(node.target),\n            balloonIconToCode(node.balloon),\n            node.wait ?? false,\n          ],\n        });\n        break;\n      case \"changePlayerFollowers\":\n        output.push({\n          code: 216,\n          indent,\n          parameters: [node.visible ? 0 : 1],\n        });\n        break;\n      case \"gatherFollowers\":\n        output.push({\n          code: 217,\n          indent,\n          parameters: [],\n        });\n        break;\n      case \"fadeoutScreen\":\n        output.push({\n          code: 221,\n          indent,\n          parameters: [],\n        });\n        break;\n      case \"fadeinScreen\":\n        output.push({\n          code: 222,\n          indent,\n          parameters: [],\n        });\n        break;\n      case \"tintScreen\":\n        output.push({\n          code: 223,\n          indent,\n          parameters: [compileTone(node.tone), node.duration, node.wait ?? false],\n        });\n        break;\n      case \"flashScreen\":\n        output.push({\n          code: 224,\n          indent,\n          parameters: [compileColor(node.color), node.duration, node.wait ?? false],\n        });\n        break;\n      case \"shakeScreen\":\n        output.push({\n          code: 225,\n          indent,\n          parameters: [node.power, node.speed, node.duration, node.wait ?? false],\n        });\n        break;\n      case \"showChoices\":\n        output.push({\n          code: 102,\n          indent,\n          parameters: [\n            node.choices,\n            node.cancelBranch === undefined ? (node.cancelType ?? -1) : -2,\n            node.defaultType ?? 0,\n            node.positionType ?? 2,\n            node.background ?? 0,\n          ],\n        });\n        output.push(\n          ...compileChoiceBranches(\n            node,\n            indent,\n            resolver,\n            (children, childIndent, childResolver, childTerminator, childPath) =>\n              compileNodes(\n                children,\n                childIndent,\n                childResolver,\n                childTerminator,\n                childPath,\n                origins,\n              ),\n            `${sourcePath}[${nodeIndex}]`,\n          ),\n        );\n        output.push({ code: 404, indent, parameters: [] });\n        break;\n      case \"shopProcessing\":\n        node.goods.forEach((goods, index) => {\n          output.push({\n            code: index === 0 ? 302 : 605,\n            indent,\n            parameters:\n              index === 0\n                ? [...compileShopGoodsParameters(goods, resolver), node.allowSelling ?? false]\n                : compileShopGoodsParameters(goods, resolver),\n          });\n        });\n        break;\n      case \"nameInputProcessing\":\n        output.push({\n          code: 303,\n          indent,\n          parameters: [resolver.resolveReference(node.actor), node.maxCharacters],\n        });\n        break;\n      case \"changeHp\":\n        output.push({\n          code: 311,\n          indent,\n          parameters: [\n            ...compileActorCommandTarget(node.target, resolver),\n            ...compileOperateValueParameters(node.operation, node.value, resolver),\n            node.allowDeath ?? false,\n          ],\n        });\n        break;\n      case \"changeMp\":\n        output.push({\n          code: 312,\n          indent,\n          parameters: [\n            ...compileActorCommandTarget(node.target, resolver),\n            ...compileOperateValueParameters(node.operation, node.value, resolver),\n          ],\n        });\n        break;\n      case \"changeState\":\n        output.push({\n          code: 313,\n          indent,\n          parameters: [\n            ...compileActorCommandTarget(node.target, resolver),\n            node.operation === \"add\" ? 0 : 1,\n            resolver.resolveReference(node.state),\n          ],\n        });\n        break;\n      case \"recoverAll\":\n        output.push({\n          code: 314,\n          indent,\n          parameters: compileActorCommandTarget(node.target, resolver),\n        });\n        break;\n      case \"changeExp\":\n        output.push({\n          code: 315,\n          indent,\n          parameters: [\n            ...compileActorCommandTarget(node.target, resolver),\n            ...compileOperateValueParameters(node.operation, node.value, resolver),\n            node.showLevelUp ?? false,\n          ],\n        });\n        break;\n      case \"changeLevel\":\n        output.push({\n          code: 316,\n          indent,\n          parameters: [\n            ...compileActorCommandTarget(node.target, resolver),\n            ...compileOperateValueParameters(node.operation, node.value, resolver),\n            node.showLevelUp ?? false,\n          ],\n        });\n        break;\n      case \"changeParameter\":\n        output.push({\n          code: 317,\n          indent,\n          parameters: [\n            ...compileActorCommandTarget(node.target, resolver),\n            actorParameterToCode(node.parameter),\n            ...compileOperateValueParameters(node.operation, node.value, resolver),\n          ],\n        });\n        break;\n      case \"changeSkill\":\n        output.push({\n          code: 318,\n          indent,\n          parameters: [\n            ...compileActorCommandTarget(node.target, resolver),\n            node.operation === \"learn\" ? 0 : 1,\n            resolver.resolveReference(node.skill),\n          ],\n        });\n        break;\n      case \"changeEquipment\":\n        output.push({\n          code: 319,\n          indent,\n          parameters: [\n            resolver.resolveReference(node.actor),\n            node.equipmentTypeId,\n            node.itemId ?? 0,\n          ],\n        });\n        break;\n      case \"changeName\":\n        output.push({\n          code: 320,\n          indent,\n          parameters: [resolver.resolveReference(node.actor), node.name],\n        });\n        break;\n      case \"changeClass\":\n        output.push({\n          code: 321,\n          indent,\n          parameters: [\n            resolver.resolveReference(node.actor),\n            resolver.resolveReference(node.class),\n            node.keepExp ?? false,\n          ],\n        });\n        break;\n      case \"changeActorImages\":\n        output.push({\n          code: 322,\n          indent,\n          parameters: [\n            resolver.resolveReference(node.actor),\n            node.character.image.name,\n            node.character.index,\n            node.face.image.name,\n            node.face.index,\n            node.battler.name,\n          ],\n        });\n        break;\n      case \"changeVehicleImage\":\n        output.push({\n          code: 323,\n          indent,\n          parameters: [vehicleToCode(node.vehicle), node.image.name, node.index],\n        });\n        break;\n      case \"changeNickname\":\n        output.push({\n          code: 324,\n          indent,\n          parameters: [resolver.resolveReference(node.actor), node.nickname],\n        });\n        break;\n      case \"changeProfile\":\n        output.push({\n          code: 325,\n          indent,\n          parameters: [resolver.resolveReference(node.actor), node.profile],\n        });\n        break;\n      case \"changeTp\":\n        output.push({\n          code: 326,\n          indent,\n          parameters: [\n            ...compileActorCommandTarget(node.target, resolver),\n            ...compileOperateValueParameters(node.operation, node.value, resolver),\n          ],\n        });\n        break;\n      case \"changeEnemyHp\":\n        output.push({\n          code: 331,\n          indent,\n          parameters: [\n            enemyTargetToCode(node.target),\n            ...compileOperateValueParameters(node.operation, node.value, resolver),\n            node.allowDeath ?? false,\n          ],\n        });\n        break;\n      case \"changeEnemyMp\":\n        output.push({\n          code: 332,\n          indent,\n          parameters: [\n            enemyTargetToCode(node.target),\n            ...compileOperateValueParameters(node.operation, node.value, resolver),\n          ],\n        });\n        break;\n      case \"changeEnemyState\":\n        output.push({\n          code: 333,\n          indent,\n          parameters: [\n            enemyTargetToCode(node.target),\n            node.operation === \"add\" ? 0 : 1,\n            resolver.resolveReference(node.state),\n          ],\n        });\n        break;\n      case \"enemyRecoverAll\":\n        output.push({ code: 334, indent, parameters: [enemyTargetToCode(node.target)] });\n        break;\n      case \"enemyAppear\":\n        output.push({ code: 335, indent, parameters: [enemyTargetToCode(node.target)] });\n        break;\n      case \"enemyTransform\":\n        output.push({\n          code: 336,\n          indent,\n          parameters: [enemyTargetToCode(node.target), resolver.resolveReference(node.enemy)],\n        });\n        break;\n      case \"showBattleAnimation\":\n        output.push({\n          code: 337,\n          indent,\n          parameters: [\n            node.target.target === \"all\" ? 0 : node.target.index,\n            resolver.resolveReference(node.animation),\n            node.target.target === \"all\",\n          ],\n        });\n        break;\n      case \"forceAction\":\n        output.push({\n          code: 339,\n          indent,\n          parameters: [\n            battlerTargetTypeToCode(node.subject),\n            battlerTargetIdToCode(node.subject),\n            resolver.resolveReference(node.skill),\n            node.targetIndex,\n          ],\n        });\n        break;\n      case \"abortBattle\":\n        output.push({ code: 340, indent, parameters: [] });\n        break;\n      case \"changeEnemyTp\":\n        output.push({\n          code: 342,\n          indent,\n          parameters: [\n            enemyTargetToCode(node.target),\n            ...compileOperateValueParameters(node.operation, node.value, resolver),\n          ],\n        });\n        break;\n      case \"openMenuScreen\":\n        output.push({ code: 351, indent, parameters: [] });\n        break;\n      case \"openSaveScreen\":\n        output.push({ code: 352, indent, parameters: [] });\n        break;\n      case \"gameOver\":\n        output.push({ code: 353, indent, parameters: [] });\n        break;\n      case \"returnToTitleScreen\":\n        output.push({ code: 354, indent, parameters: [] });\n        break;\n      case \"showPicture\":\n        output.push({\n          code: 231,\n          indent,\n          parameters: [\n            node.pictureId,\n            node.image.name,\n            pictureOriginToCode(node.position.origin),\n            ...compilePicturePosition(node.position, resolver),\n            node.scaleX ?? 100,\n            node.scaleY ?? 100,\n            node.opacity ?? 255,\n            node.blendMode ?? 0,\n          ],\n        });\n        break;\n      case \"movePicture\":\n        output.push({\n          code: 232,\n          indent,\n          parameters: [\n            node.pictureId,\n            0,\n            pictureOriginToCode(node.position.origin),\n            ...compilePicturePosition(node.position, resolver),\n            node.scaleX ?? 100,\n            node.scaleY ?? 100,\n            node.opacity ?? 255,\n            node.blendMode ?? 0,\n            node.duration,\n            node.wait ?? false,\n          ],\n        });\n        break;\n      case \"rotatePicture\":\n        output.push({\n          code: 233,\n          indent,\n          parameters: [node.pictureId, node.speed],\n        });\n        break;\n      case \"tintPicture\":\n        output.push({\n          code: 234,\n          indent,\n          parameters: [node.pictureId, compileTone(node.tone), node.duration, node.wait ?? false],\n        });\n        break;\n      case \"erasePicture\":\n        output.push({\n          code: 235,\n          indent,\n          parameters: [node.pictureId],\n        });\n        break;\n      case \"setWeatherEffect\":\n        output.push({\n          code: 236,\n          indent,\n          parameters: [\n            weatherEffectToCode(node.weather),\n            node.power,\n            node.duration,\n            node.wait ?? false,\n          ],\n        });\n        break;\n      case \"playBgm\":\n        output.push({\n          code: 241,\n          indent,\n          parameters: [compileAudioPayload(node.audio)],\n        });\n        break;\n      case \"fadeoutBgm\":\n        output.push({\n          code: 242,\n          indent,\n          parameters: [node.duration],\n        });\n        break;\n      case \"saveBgm\":\n        output.push({\n          code: 243,\n          indent,\n          parameters: [],\n        });\n        break;\n      case \"resumeBgm\":\n        output.push({\n          code: 244,\n          indent,\n          parameters: [],\n        });\n        break;\n      case \"playBgs\":\n        output.push({\n          code: 245,\n          indent,\n          parameters: [compileAudioPayload(node.audio)],\n        });\n        break;\n      case \"fadeoutBgs\":\n        output.push({\n          code: 246,\n          indent,\n          parameters: [node.duration],\n        });\n        break;\n      case \"playMe\":\n        output.push({\n          code: 249,\n          indent,\n          parameters: [compileAudioPayload(node.audio)],\n        });\n        break;\n      case \"playSe\":\n        output.push({\n          code: 250,\n          indent,\n          parameters: [compileAudioPayload(node.audio)],\n        });\n        break;\n      case \"stopSe\":\n        output.push({\n          code: 251,\n          indent,\n          parameters: [],\n        });\n        break;\n      case \"playMovie\":\n        output.push({\n          code: 261,\n          indent,\n          parameters: [node.movie.name],\n        });\n        break;\n      case \"changeMapNameDisplay\":\n        output.push({\n          code: 281,\n          indent,\n          parameters: [node.enabled ? 0 : 1],\n        });\n        break;\n      case \"changeTileset\":\n        output.push({\n          code: 282,\n          indent,\n          parameters: [resolver.resolveReference(node.tileset)],\n        });\n        break;\n      case \"changeBattleBack\":\n        output.push({\n          code: 283,\n          indent,\n          parameters: [node.battleback1?.name ?? \"\", node.battleback2?.name ?? \"\"],\n        });\n        break;\n      case \"changeParallax\":\n        output.push({\n          code: 284,\n          indent,\n          parameters: [node.image?.name ?? \"\", node.loopX, node.loopY, node.sx, node.sy],\n        });\n        break;\n      case \"getLocationInfo\":\n        output.push({\n          code: 285,\n          indent,\n          parameters: [\n            resolver.resolveReference(node.variable),\n            locationInfoTypeToCode(node.info),\n            ...compileLocationInfoPosition(node.location, resolver),\n          ],\n        });\n        break;\n      case \"rawDslCommand\":\n        if (node.code === 205 || node.code === 505)\n          assertNativeMovementCommandParameters(node.code, node.parameters, {\n            dslPath: `${sourcePath}[${nodeIndex}]`,\n          });\n        {\n          try {\n            assertNativeCommandEnvelope(\n              {\n                code: node.code,\n                indent: node.indent === undefined ? indent : node.indent,\n                parameters: node.parameters,\n              },\n              output.length,\n            );\n          } catch (error) {\n            if (error instanceof CommandStructureError)\n              throw new CommandStructureError(error.code, error.detail, {\n                ...error.location,\n                dslPath: `${sourcePath}[${nodeIndex}]`,\n              });\n            throw error;\n          }\n        }\n        output.push({\n          code: node.code,\n          indent: node.indent === undefined ? indent : node.indent,\n          parameters: [...node.parameters],\n        });\n        break;\n      default:\n        throw new CommandStructureError(\"MV-DSL-KIND\", \"Unknown authored command kind.\", {\n          dslPath: `${sourcePath}[${nodeIndex}].kind`,\n          expected: \"supported command kind\",\n          actual: String((node as { kind: unknown }).kind),\n        });\n    }\n    if (origins)\n      for (const command of output.slice(outputStart))\n        if (!origins.has(command))\n          origins.set(command, { path: `${sourcePath}[${nodeIndex}]`, kind: node.kind });\n  }\n\n  if (includeTerminator && !(output.at(-1)?.code === 0 && output.at(-1)?.indent === indent)) {\n    output.push({ code: 0, indent, parameters: [] });\n  }\n  if (includeTerminator && indent === 0)\n    try {\n      inspectCommandListStructure(output, { requireTerminator: true });\n    } catch (error) {\n      if (error instanceof CommandStructureError) {\n        const dslAt = (path: string | undefined) =>\n          path ? origins.get(output[Number(/^list\\[(\\d+)\\]/u.exec(path)?.[1])]!)?.path : undefined;\n        const dslPath = dslAt(error.location.nativePath);\n        throw new CommandStructureError(error.code, error.detail, {\n          ...error.location,\n          ...(dslPath ? { dslPath } : {}),\n          ...(error.location.relatedLocations\n            ? {\n                relatedLocations: error.location.relatedLocations.map((related) => {\n                  const source = dslAt(related.nativePath);\n                  return { ...related, ...(source ? { dslPath: source } : {}) };\n                }),\n              }\n            : {}),\n        });\n      }\n      throw error;\n    }\n  return output;\n}\n\nexport { compilePageConditions as compileConditions } from \"../map-event/page.js\";\n\nexport function commonEventTriggerToCode(trigger: CommonEventDefinition[\"trigger\"]): number {\n  switch (trigger) {\n    case \"none\":\n      return 0;\n    case \"autorun\":\n      return 1;\n    case \"parallel\":\n      return 2;\n  }\n}\n","import type { RawEventCommand, CommandOrigins } from \"../compiler/types.js\";\nimport type { ValidationIssue } from \"./types.js\";\nimport type { NativeMovementRoute } from \"../commands/movement/types.js\";\nimport { isKnownCommandCode } from \"./native-parameters.js\";\n\nexport type NativeInputOptions = {\n  identity: string;\n  stage: \"compile\" | \"decompile\";\n  scriptEnabled: boolean;\n  prefix?: string;\n  origins?: CommandOrigins;\n};\n\nexport function scriptGateIssue(\n  nativePath: string,\n  options: NativeInputOptions,\n  dslPath?: string,\n): ValidationIssue {\n  const level = options.stage === \"compile\" ? \"error\" : \"warning\";\n  return {\n    code: \"MV-SCRIPT-GATE\",\n    level,\n    stage: options.stage,\n    identity: options.identity,\n    nativePath,\n    expected: \"scriptEnabled: true\",\n    actual: \"scriptEnabled: false\",\n    ...(dslPath ? { dslPath } : {}),\n    message: `${options.stage} ${level} ${options.identity}: MV-SCRIPT-GATE at ${nativePath}: Script commands require explicit config enablement; expected scriptEnabled: true; actual scriptEnabled: false.`,\n  };\n}\n\nexport function inspectNativeRouteInputs(\n  route: NativeMovementRoute,\n  path: string,\n  options: NativeInputOptions,\n  dslPath?: string,\n): ValidationIssue[] {\n  return route.list.flatMap((record, index) => {\n    if (record.code !== 45) return [];\n    const native = `${path}.list[${index}].parameters[0]`;\n    const authored = dslPath ? `${dslPath}.commands[${index}].script.code` : undefined;\n    return [\n      ...movementStringRisk(record.parameters![0] as string, native, options, authored),\n      ...(options.scriptEnabled ? [] : [scriptGateIssue(native, options, authored)]),\n    ];\n  });\n}\n\nfunction movementStringRisk(\n  value: string,\n  nativePath: string,\n  options: NativeInputOptions,\n  dslPath?: string,\n): ValidationIssue[] {\n  if (!value.includes(\"\\n\") && !value.includes(\"\\r\")) return [];\n  const reasons = [\n    ...(value.includes(\"\\n\") ? [\"LF exceeds the native single-line input\"] : []),\n    ...(value.includes(\"\\r\")\n      ? [\"CR preservation on parameter reconfirmation needs native verification\"]\n      : []),\n  ];\n  return [\n    {\n      code: \"MV-MOVEMENT-TEXT-RISK\",\n      level: \"warning\",\n      stage: options.stage,\n      identity: options.identity,\n      nativePath,\n      ...(dslPath === undefined ? {} : { dslPath }),\n      expected: \"Complete saved single-slot text retained; parameter reconfirmation may differ\",\n      actual: JSON.stringify(value),\n      message: `${options.stage} warning ${options.identity}: MV-MOVEMENT-TEXT-RISK at ${nativePath}: ${reasons.join(\"; \")}. Saved text is retained exactly.`,\n    },\n  ];\n}\n\n// Called only after the complete known structure and saved envelopes are validated.\n// Scan every stored record; execution reachability and string truthiness are irrelevant.\nexport function inspectNativeCommandInputs(\n  commands: readonly RawEventCommand[],\n  options: NativeInputOptions,\n): ValidationIssue[] {\n  const issues: ValidationIssue[] = [];\n  for (const [index, command] of commands.entries()) {\n    const path = `${options.prefix ?? \"\"}list[${index}]`;\n    const origin = options.origins?.get(command);\n    if (command.code === 205) {\n      const route = command.parameters[1] as NativeMovementRoute;\n      for (const [routeIndex, record] of route.list.entries())\n        if (record.code === 45)\n          issues.push(\n            ...movementStringRisk(\n              record.parameters![0] as string,\n              `${path}.parameters[1].list[${routeIndex}].parameters[0]`,\n              options,\n              origin\n                ? origin.path +\n                    (origin.kind === \"rawDslCommand\"\n                      ? `.parameters[1].list[${routeIndex}].parameters[0]`\n                      : `.route.commands[${routeIndex}].script.code`)\n                : undefined,\n            ),\n          );\n    }\n    if (command.code === 505 && (command.parameters[0] as { code: number }).code === 45)\n      issues.push(\n        ...movementStringRisk(\n          (command.parameters[0] as { parameters: string[] }).parameters[0]!,\n          `${path}.parameters[0].parameters[0]`,\n          options,\n          origin?.kind === \"rawDslCommand\"\n            ? `${origin.path}.parameters[0].parameters[0]`\n            : undefined,\n        ),\n      );\n    if (!isKnownCommandCode(command.code))\n      issues.push({\n        code: \"MV-UNKNOWN-COMMAND\",\n        level: \"warning\",\n        stage: options.stage,\n        identity: options.identity,\n        nativePath: path,\n        expected: \"known native event code\",\n        actual: String(command.code),\n        message: `${options.stage} warning ${options.identity}: MV-UNKNOWN-COMMAND at ${path}: unknown code ${command.code} is preserved as one raw record; its payload semantics are uninterpreted.`,\n      });\n    if (options.scriptEnabled) continue;\n    let slot: number | undefined;\n    if (command.code === 355 || command.code === 655) slot = 0;\n    if (command.code === 111 && command.parameters[0] === 12) slot = 1;\n    if (command.code === 122 && command.parameters[3] === 4) slot = 4;\n    if (slot !== undefined) {\n      const field =\n        origin?.kind === \"rawDslCommand\"\n          ? `.parameters[${slot}]`\n          : command.code === 111\n            ? \".condition.script.code\"\n            : command.code === 122\n              ? \".value.script.code\"\n              : \".script.code\";\n      issues.push(\n        scriptGateIssue(\n          `${path}.parameters[${slot}]`,\n          options,\n          origin ? origin.path + field : undefined,\n        ),\n      );\n    }\n    if (command.code === 205) {\n      const route = command.parameters[1] as NativeMovementRoute;\n      for (const [routeIndex, record] of route.list.entries())\n        if (record.code === 45)\n          issues.push(\n            scriptGateIssue(\n              `${path}.parameters[1].list[${routeIndex}].parameters[0]`,\n              options,\n              origin\n                ? origin.path +\n                    (origin.kind === \"rawDslCommand\"\n                      ? `.parameters[1].list[${routeIndex}].parameters[0]`\n                      : `.route.commands[${routeIndex}].script.code`)\n                : undefined,\n            ),\n          );\n    }\n    if (command.code === 505 && (command.parameters[0] as { code: number }).code === 45)\n      issues.push(\n        scriptGateIssue(\n          `${path}.parameters[0].parameters[0]`,\n          options,\n          origin?.kind === \"rawDslCommand\"\n            ? `${origin.path}.parameters[0].parameters[0]`\n            : origin\n              ? `${origin.path}.route`\n              : undefined,\n        ),\n      );\n  }\n  return issues;\n}\n","import type { RawEventCommand, CommandOrigins } from \"../compiler/types.js\";\nimport type { ReferenceKind } from \"../domain/types.js\";\nimport type { ReferenceResolver, ValidationIssue } from \"./types.js\";\nimport { CommandStructureError } from \"./command-errors.js\";\nimport { renderJsonValue } from \"../project-data/json-values.js\";\n\n// References already supported by current formal commands enter here after compilation,\n// so handwritten known raw cannot bypass those fixed-ID checks. Runtime selectors remain\n// selectors; family tickets own their context-dependent warnings and complete value domains.\nexport function inspectNativeCommandReferences(\n  commands: readonly RawEventCommand[],\n  resolver: ReferenceResolver,\n  options: {\n    identity: string;\n    stage: \"compile\" | \"decompile\";\n    prefix?: string;\n    origins?: CommandOrigins;\n  },\n): ValidationIssue[] {\n  const issues: ValidationIssue[] = [];\n  for (const [index, command] of commands.entries()) {\n    const p = command.parameters;\n    const refs: Array<[ReferenceKind, number]> = [];\n    const ref = (kind: ReferenceKind, slot: number) => refs.push([kind, slot]);\n    const operand = (type: number, value: number) => {\n      if (p[type] === 1) ref(\"variable\", value);\n    };\n    const actorTarget = () => {\n      if (p[0] === 1) ref(\"variable\", 1);\n      else if (p[0] === 0 && p[1] !== 0) ref(\"actor\", 1);\n    };\n    switch (command.code) {\n      case 103:\n      case 104:\n        ref(\"variable\", 0);\n        break;\n      case 117:\n        ref(\"commonEvent\", 0);\n        break;\n      case 121:\n        ref(\"switch\", 0);\n        ref(\"switch\", 1);\n        break;\n      case 111:\n        if (p[0] === 0) ref(\"switch\", 1);\n        if (p[0] === 1) {\n          ref(\"variable\", 1);\n          operand(2, 3);\n        }\n        if (p[0] === 4) {\n          ref(\"actor\", 1);\n          const kinds: Record<number, ReferenceKind> = {\n            2: \"class\",\n            3: \"skill\",\n            4: \"weapon\",\n            5: \"armor\",\n            6: \"state\",\n          };\n          if (kinds[p[2] as number]) ref(kinds[p[2] as number]!, 3);\n        }\n        if (p[0] === 5 && p[2] === 1) ref(\"state\", 3);\n        if (p[0] === 8) ref(\"item\", 1);\n        if (p[0] === 9) ref(\"weapon\", 1);\n        if (p[0] === 10) ref(\"armor\", 1);\n        break;\n      case 122:\n        ref(\"variable\", 0);\n        ref(\"variable\", 1);\n        if (p[3] === 1) ref(\"variable\", 4);\n        if (p[3] === 3) {\n          const kinds: Record<number, ReferenceKind> = {\n            0: \"item\",\n            1: \"weapon\",\n            2: \"armor\",\n            3: \"actor\",\n          };\n          if (kinds[p[4] as number]) ref(kinds[p[4] as number]!, 5);\n        }\n        break;\n      case 125:\n        operand(1, 2);\n        break;\n      case 126:\n      case 127:\n      case 128:\n        ref(command.code === 126 ? \"item\" : command.code === 127 ? \"weapon\" : \"armor\", 0);\n        operand(2, 3);\n        break;\n      case 129:\n        ref(\"actor\", 0);\n        break;\n      case 201:\n        if (p[0] === 0) ref(\"map\", 1);\n        else {\n          ref(\"variable\", 1);\n          ref(\"variable\", 2);\n          ref(\"variable\", 3);\n        }\n        break;\n      case 202:\n        if (p[1] === 0) ref(\"map\", 2);\n        else {\n          ref(\"variable\", 2);\n          ref(\"variable\", 3);\n          ref(\"variable\", 4);\n        }\n        break;\n      case 203:\n        if (p[1] === 1) {\n          ref(\"variable\", 2);\n          ref(\"variable\", 3);\n        }\n        break;\n      case 212:\n        ref(\"animation\", 1);\n        break;\n      case 231:\n      case 232:\n        if (p[3] === 1) {\n          ref(\"variable\", 4);\n          ref(\"variable\", 5);\n        }\n        break;\n      case 282:\n        ref(\"tileset\", 0);\n        break;\n      case 285:\n        ref(\"variable\", 0);\n        if (p[2] === 1) {\n          ref(\"variable\", 3);\n          ref(\"variable\", 4);\n        }\n        break;\n      case 301:\n        if (p[0] === 0) ref(\"troop\", 1);\n        if (p[0] === 1) ref(\"variable\", 1);\n        break;\n      case 302:\n      case 605:\n        if (p[1] !== 0) {\n          const kinds: Record<number, ReferenceKind> = { 0: \"item\", 1: \"weapon\", 2: \"armor\" };\n          if (kinds[p[0] as number]) ref(kinds[p[0] as number]!, 1);\n        }\n        break;\n      case 303:\n      case 319:\n      case 320:\n      case 322:\n      case 324:\n      case 325:\n        ref(\"actor\", 0);\n        break;\n      case 321:\n        ref(\"actor\", 0);\n        ref(\"class\", 1);\n        break;\n      case 311:\n      case 312:\n      case 315:\n      case 316:\n      case 326:\n        actorTarget();\n        operand(3, 4);\n        break;\n      case 313:\n        actorTarget();\n        ref(\"state\", 3);\n        break;\n      case 314:\n        actorTarget();\n        break;\n      case 317:\n        actorTarget();\n        operand(4, 5);\n        break;\n      case 318:\n        actorTarget();\n        ref(\"skill\", 3);\n        break;\n      case 331:\n      case 332:\n      case 342:\n        operand(2, 3);\n        break;\n      case 333:\n        ref(\"state\", 2);\n        break;\n      case 336:\n        ref(\"enemy\", 1);\n        break;\n      case 337:\n        ref(\"animation\", 1);\n        break;\n      case 339:\n        if (p[0] === 1) ref(\"actor\", 1);\n        ref(\"skill\", 2);\n        break;\n    }\n    for (const [kind, slot] of refs)\n      try {\n        resolver.resolveReference({ kind, id: p[slot] as number });\n      } catch (error) {\n        const origin = options.origins?.get(command);\n        const suffix = `.parameters[${slot}]`;\n        issues.push(\n          new CommandStructureError(\n            `MV-E${command.code}-REFERENCE`,\n            error instanceof Error ? error.message : String(error),\n            {\n              nativePath: `${options.prefix ?? \"\"}list[${index}]${suffix}`,\n              ...(origin\n                ? { dslPath: origin.path + (origin.kind === \"rawDslCommand\" ? suffix : \"\") }\n                : {}),\n              expected: `existing ${kind} ID`,\n              actual: renderJsonValue(p[slot]),\n            },\n          ).issue(options.identity, options.stage),\n        );\n      }\n  }\n  return issues;\n}\n","import { compileNodes } from \"../compiler/dispatch.js\";\nimport { CommandStructureError, inspectCommandListStructure } from \"./command-structure.js\";\nimport type { StagedDataGraph, ValidationIssue } from \"./types.js\";\nimport { inspectNativeCommandInputs, inspectNativeRouteInputs } from \"./native-command-inputs.js\";\nimport { compilePageMovement } from \"../commands/movement/page.js\";\nimport { validateNativeMovementRouteInputs } from \"../commands/movement/validation.js\";\nimport { inspectNativeCommandReferences } from \"./native-references.js\";\nimport type { RawEventCommand, CommandOrigins } from \"../compiler/types.js\";\n\nexport function validateCompiledCommandLists(\n  graph: StagedDataGraph,\n  issues: ValidationIssue[],\n  options: { scriptEnabled: boolean },\n): void {\n  for (const declaration of graph.declarations) {\n    const lists =\n      declaration.kind === \"commonEvent\"\n        ? [\n            {\n              commands: declaration.commands,\n              identity: `commonEvent:${declaration.id}`,\n              path: \"commands\",\n              movement: undefined,\n            },\n          ]\n        : declaration.kind === \"mapEvent\"\n          ? declaration.pages.map((page, index) => ({\n              commands: page.commands,\n              identity: `map:${declaration.mapId}/event:${declaration.id}`,\n              path: `pages[${index}].commands`,\n              movement: page.movement,\n            }))\n          : declaration.kind === \"troopEvent\" && Array.isArray(declaration.pages)\n            ? declaration.pages.flatMap((page, index) =>\n                page && Array.isArray(page.commands)\n                  ? [\n                      {\n                        commands: page.commands,\n                        identity: `troop:${declaration.troopId}`,\n                        path: `pages[${index}].commands`,\n                        movement: undefined,\n                      },\n                    ]\n                  : [],\n              )\n            : [];\n    for (const list of lists) {\n      let commands: RawEventCommand[] = [];\n      const origins: CommandOrigins = new Map();\n      const prefix = list.path.replace(/commands$/u, \"\");\n      try {\n        if (list.movement !== undefined) {\n          const prefix = list.path.replace(/commands$/u, \"\");\n          const movement = compilePageMovement(list.movement, graph.resolver, `${prefix}movement`);\n          validateNativeMovementRouteInputs(\n            movement.moveRoute,\n            graph.resolver,\n            {\n              scriptEnabled: true,\n              identity: list.identity,\n              dslPath: `${prefix}movement.route`,\n              nativePath: `${prefix}moveRoute`,\n            },\n            issues,\n          );\n          issues.push(\n            ...inspectNativeRouteInputs(\n              movement.moveRoute,\n              `${prefix}moveRoute`,\n              { ...options, stage: \"compile\", identity: list.identity },\n              `${prefix}movement.route`,\n            ),\n          );\n        }\n        commands = compileNodes(list.commands, 0, graph.resolver, true, list.path, origins);\n        const { breaksOutsideLoops } = inspectCommandListStructure(commands, {\n          requireTerminator: true,\n        });\n        issues.push(\n          ...inspectNativeCommandInputs(commands, {\n            ...options,\n            stage: \"compile\",\n            identity: list.identity,\n            prefix,\n            origins,\n          }),\n        );\n        issues.push(\n          ...inspectNativeCommandReferences(commands, graph.resolver, {\n            stage: \"compile\",\n            identity: list.identity,\n            prefix,\n            origins,\n          }),\n        );\n        for (const index of breaksOutsideLoops)\n          issues.push({\n            level: \"warning\",\n            code: \"MV-BREAK-OUTSIDE-LOOP\",\n            stage: \"compile\",\n            identity: list.identity,\n            nativePath: `${list.path.replace(/commands$/u, \"list\")}[${index}]`,\n            message: `${list.identity}: Break Loop outside a Loop can skip the remaining event commands while looking for a matching Repeat Above record.`,\n          });\n      } catch (error) {\n        if (error instanceof CommandStructureError) {\n          const location = { ...error.location };\n          const sourceAt = (path: string) => {\n            const index = Number(/^list\\[(\\d+)\\]/u.exec(path)?.[1]);\n            return origins.get(commands[index]!)?.path;\n          };\n          if (location.nativePath !== undefined) {\n            const source = sourceAt(location.nativePath);\n            if (location.dslPath === undefined && source !== undefined) location.dslPath = source;\n            if (!location.nativePath.startsWith(\"pages[\"))\n              location.nativePath = prefix + location.nativePath;\n          }\n          if (location.relatedLocations)\n            location.relatedLocations = location.relatedLocations.map((related) => {\n              const source = related.nativePath ? sourceAt(related.nativePath) : undefined;\n              return {\n                ...related,\n                ...(source ? { dslPath: source } : {}),\n                ...(related.nativePath && !related.nativePath.startsWith(\"pages[\")\n                  ? { nativePath: prefix + related.nativePath }\n                  : {}),\n              };\n            });\n          issues.push(\n            new CommandStructureError(error.code, error.detail, location).issue(\n              list.identity,\n              \"compile\",\n            ),\n          );\n        } else {\n          const detail = error instanceof Error ? error.message : String(error);\n          if (!issues.some((issue) => issue.level === \"error\" && issue.message.includes(detail)))\n            issues.push(\n              new CommandStructureError(\"MV-COMMAND-INPUT\", detail, {\n                dslPath: list.path,\n                expected: \"valid authored commands and resolvable inputs\",\n                actual: detail,\n              }).issue(list.identity, \"compile\"),\n            );\n        }\n      }\n    }\n  }\n}\n","// The single native default state used by compilation and exact Blank classification.\nexport function blankBattleEventPage() {\n  return {\n    conditions: {\n      actorHp: 50,\n      actorId: 1,\n      actorValid: false,\n      enemyHp: 50,\n      enemyIndex: 0,\n      enemyValid: false,\n      switchId: 1,\n      switchValid: false,\n      turnA: 0,\n      turnB: 0,\n      turnEnding: false,\n      turnValid: false,\n    },\n    span: 0,\n    list: [{ code: 0, indent: 0, parameters: [] as unknown[] }],\n  };\n}\n","import type { BattleEventPage, TroopEventDefinition } from \"../domain/types.js\";\nimport type { ReferenceResolver, StagedDataGraph, ValidationIssue } from \"./types.js\";\nimport { validateNodes } from \"./commands.js\";\nimport { blankBattleEventPage } from \"../domain/battle-page-defaults.js\";\nimport type { RawEventCommand } from \"../compiler/types.js\";\nimport { CommandStructureError } from \"./command-errors.js\";\nimport { describeValue, renderJsonValue } from \"../project-data/json-values.js\";\n\nclass BattlePageInputError extends Error {\n  constructor(\n    readonly path: string,\n    readonly expected: string,\n    readonly actual: string,\n  ) {\n    super(`${path}: expected ${expected}; actual ${actual}.`);\n  }\n}\nfunction location(error: unknown, fallback: string) {\n  return error instanceof BattlePageInputError\n    ? { dslPath: error.path, expected: error.expected, actual: error.actual }\n    : { dslPath: fallback };\n}\n\nexport function validateBattlePages(\n  definition: TroopEventDefinition,\n  graph: StagedDataGraph,\n  options: { scriptEnabled: boolean },\n  issues: ValidationIssue[],\n): void {\n  const identity = `troop:${definition.troopId}`;\n  const members = graph.snapshotTroops?.find(({ id }) => id === definition.troopId)?.members;\n  try {\n    object(definition, [\"kind\", \"troopId\", \"pages\"], [\"kind\", \"troopId\", \"pages\"], identity);\n    densePages(definition.pages, `${identity}.pages`);\n  } catch (error) {\n    issues.push({\n      level: \"error\",\n      identity,\n      stage: \"compile\",\n      code: \"MV-BATTLE-PAGE-INPUT\",\n      ...location(error, \"pages\"),\n      message: `compile error ${identity}: MV-BATTLE-PAGE-INPUT: ${error instanceof Error ? error.message : String(error)}`,\n    });\n    return;\n  }\n  if (definition.pages.length > 20)\n    issues.push({\n      level: \"warning\",\n      identity,\n      dslPath: \"pages\",\n      message: `${identity}: ${definition.pages.length} Battle Event Pages exceed the editor's 20-page picker; all pages are preserved.`,\n    });\n  for (const [pageIndex, page] of definition.pages.entries()) {\n    try {\n      assertBattlePageInput(page, graph.resolver, `pages[${pageIndex}]`);\n    } catch (error) {\n      issues.push({\n        level: \"error\",\n        identity,\n        stage: \"compile\",\n        code: \"MV-BATTLE-PAGE-INPUT\",\n        ...location(error, `pages[${pageIndex}]`),\n        message: `compile error ${identity}: MV-BATTLE-PAGE-INPUT: ${error instanceof Error ? error.message : String(error)}`,\n      });\n      continue;\n    }\n    const condition = page.conditions?.enemy;\n    if (condition?.enabled) {\n      if (\n        !Array.isArray(members) ||\n        !Number.isSafeInteger(condition.index) ||\n        condition.index < 0 ||\n        condition.index >= members.length\n      ) {\n        issues.push(\n          new CommandStructureError(\n            \"MV-BATTLE-ENEMY-POSITION\",\n            \"Enabled enemy condition requires an existing raw member position.\",\n            {\n              nativePath: `pages[${pageIndex}].conditions.enemyIndex`,\n              dslPath: `pages[${pageIndex}].conditions.enemy.index`,\n              expected: \"existing raw member position\",\n              actual: describeValue(condition.index),\n            },\n            identity,\n            \"compile\",\n          ).issue(identity, \"compile\"),\n        );\n      }\n      if (Array.isArray(members))\n        for (const [index, member] of members.entries()) {\n          const enemyId =\n            member && typeof member === \"object\" && \"enemyId\" in member\n              ? member.enemyId\n              : undefined;\n          try {\n            graph.resolver.resolveReference({ kind: \"enemy\", id: enemyId as number });\n          } catch (error) {\n            issues.push(\n              new CommandStructureError(\n                \"MV-BATTLE-MEMBER-ENEMY\",\n                `Invalid Enemy in raw member position ${index}: ${error instanceof Error ? error.message : String(error)}`,\n                {\n                  nativePath: `members[${index}].enemyId`,\n                  dslPath: `pages[${pageIndex}].conditions.enemy`,\n                  expected: \"existing Enemy reference\",\n                  actual: describeValue(enemyId),\n                },\n                identity,\n                \"compile\",\n              ).issue(identity, \"compile\"),\n            );\n          }\n        }\n    }\n    validateNodes(\n      page.commands,\n      graph.resolver,\n      { ...options, identity, path: `pages[${pageIndex}].commands` },\n      issues,\n    );\n  }\n}\n\nexport function assertBattlePageInput(\n  value: unknown,\n  resolver: ReferenceResolver,\n  path = \"page\",\n): asserts value is BattleEventPage {\n  const page = object(value, [\"conditions\", \"span\", \"commands\"], [\"commands\"], path);\n  if (!Array.isArray(page.commands)) fail(`${path}.commands`, \"command array\", page.commands);\n  if (page.span !== undefined && ![\"battle\", \"turn\", \"moment\"].includes(page.span as string))\n    fail(`${path}.span`, \"battle, turn or moment\", page.span);\n  if (page.conditions === undefined) return;\n  const conditions = object(\n    page.conditions,\n    [\"turnEnd\", \"turn\", \"enemy\", \"actor\", \"switch\"],\n    [],\n    `${path}.conditions`,\n  );\n  if (conditions.turnEnd !== undefined) boolean(conditions.turnEnd, `${path}.conditions.turnEnd`);\n  for (const slot of [\"turn\", \"enemy\", \"actor\", \"switch\"] as const) {\n    if (conditions[slot] === undefined) continue;\n    const slotPath = `${path}.conditions.${slot}`;\n    const fields =\n      slot === \"turn\"\n        ? [\"enabled\", \"a\", \"b\"]\n        : slot === \"enemy\"\n          ? [\"enabled\", \"index\", \"hpAtMost\"]\n          : slot === \"actor\"\n            ? [\"enabled\", \"ref\", \"hpAtMost\"]\n            : [\"enabled\", \"ref\"];\n    const condition = object(conditions[slot], fields, fields, slotPath);\n    boolean(condition.enabled, `${slotPath}.enabled`);\n    if (slot === \"turn\") {\n      integer(condition.a, 0, 9999, `${slotPath}.a`);\n      integer(condition.b, 0, 9999, `${slotPath}.b`);\n    }\n    if (slot === \"enemy\") integer(condition.index, 0, Number.MAX_SAFE_INTEGER, `${slotPath}.index`);\n    if (slot === \"actor\" || slot === \"enemy\")\n      integer(condition.hpAtMost, 0, 100, `${slotPath}.hpAtMost`);\n    if (slot === \"actor\" || slot === \"switch\") {\n      const ref = object(condition.ref, [\"kind\", \"id\", \"name\"], [\"kind\"], `${slotPath}.ref`);\n      if (ref.kind !== slot || \"id\" in ref === \"name\" in ref)\n        fail(`${slotPath}.ref`, `one ${slot} ID or name reference`, ref);\n      if (\"id\" in ref)\n        integer(ref.id, condition.enabled ? 1 : 0, Number.MAX_SAFE_INTEGER, `${slotPath}.ref.id`);\n      else if (typeof ref.name !== \"string\" || ref.name.length === 0)\n        fail(`${slotPath}.ref.name`, \"nonempty name\", ref.name);\n      if (condition.enabled || !(\"id\" in ref))\n        resolveSavedReference(resolver, ref, `${slotPath}.ref`);\n    }\n  }\n}\n\nfunction resolveSavedReference(\n  resolver: ReferenceResolver,\n  ref: Record<string, unknown>,\n  path: string,\n  actual: unknown = ref,\n): void {\n  try {\n    resolver.resolveReference(ref as never);\n  } catch {\n    fail(path, `existing ${String(ref.kind)} reference`, actual);\n  }\n}\n\nfunction fail(path: string, expected: string, actual?: unknown): never {\n  let text: string;\n  try {\n    text = actual === undefined ? \"absent/undefined\" : renderJsonValue(actual);\n  } catch {\n    text = String(actual);\n  }\n  throw new BattlePageInputError(path, expected, text);\n}\nfunction object(\n  value: unknown,\n  allowed: readonly string[],\n  required: readonly string[],\n  path: string,\n): Record<string, unknown> {\n  if (!value || typeof value !== \"object\" || Array.isArray(value)) fail(path, \"object\", value);\n  const record = value as Record<string, unknown>;\n  for (const key of Object.keys(record))\n    if (!allowed.includes(key)) fail(`${path}.${key}`, \"supported field\", record[key]);\n  for (const key of required)\n    if (!Object.hasOwn(record, key)) fail(`${path}.${key}`, \"required field\");\n  return record;\n}\nfunction boolean(value: unknown, path: string): void {\n  if (typeof value !== \"boolean\") fail(path, \"boolean\", value);\n}\nfunction integer(value: unknown, min: number, max: number, path: string): void {\n  if (!Number.isSafeInteger(value) || Number(value) < min || Number(value) > max)\n    fail(path, `integer ${min}..${max}`, value);\n}\nfunction densePages(value: unknown, path: string): asserts value is unknown[] {\n  if (!Array.isArray(value) || value.length === 0)\n    fail(path, \"nonempty dense ordered page array\", value);\n  for (let index = 0; index < value.length; index += 1)\n    if (!Object.hasOwn(value, index) || !value[index]) fail(`${path}[${index}]`, \"page object\");\n}\n\nexport type NativeBattleEventPage = {\n  conditions: ReturnType<typeof blankBattleEventPage>[\"conditions\"];\n  span: number;\n  list: RawEventCommand[];\n};\n\n/** Native ownership is exact; validate before rendering or normalizing any saved values. */\nexport function assertNativeBattlePages(\n  value: unknown,\n  members: unknown,\n  resolver: ReferenceResolver,\n  identity: string,\n  stage: \"compile\" | \"decompile\" = \"compile\",\n): asserts value is NativeBattleEventPage[] {\n  try {\n    densePages(value, `${identity}.pages`);\n    for (const [index, valuePage] of value.entries()) {\n      const path = `${identity}.pages[${index}]`;\n      const page = object(\n        valuePage,\n        [\"conditions\", \"span\", \"list\"],\n        [\"conditions\", \"span\", \"list\"],\n        path,\n      );\n      const fields = Object.keys(blankBattleEventPage().conditions);\n      const c = object(page.conditions, fields, fields, `${path}.conditions`);\n      for (const field of [\"turnEnding\", \"turnValid\", \"enemyValid\", \"actorValid\", \"switchValid\"])\n        boolean(c[field], `${path}.conditions.${field}`);\n      for (const field of [\"turnA\", \"turnB\"])\n        integer(c[field], 0, 9999, `${path}.conditions.${field}`);\n      for (const field of [\"actorHp\", \"enemyHp\"])\n        integer(c[field], 0, 100, `${path}.conditions.${field}`);\n      integer(c.enemyIndex, 0, Number.MAX_SAFE_INTEGER, `${path}.conditions.enemyIndex`);\n      integer(\n        c.actorId,\n        c.actorValid ? 1 : 0,\n        Number.MAX_SAFE_INTEGER,\n        `${path}.conditions.actorId`,\n      );\n      integer(\n        c.switchId,\n        c.switchValid ? 1 : 0,\n        Number.MAX_SAFE_INTEGER,\n        `${path}.conditions.switchId`,\n      );\n      if (![0, 1, 2].some((span) => Object.is(page.span, span)))\n        fail(`${path}.span`, \"native span 0, 1 or 2\", page.span);\n      if (!Array.isArray(page.list)) fail(`${path}.list`, \"complete command list\", page.list);\n      if (c.actorValid)\n        resolveSavedReference(\n          resolver,\n          { kind: \"actor\", id: c.actorId },\n          `${path}.conditions.actorId`,\n          c.actorId,\n        );\n      if (c.switchValid)\n        resolveSavedReference(\n          resolver,\n          { kind: \"switch\", id: c.switchId },\n          `${path}.conditions.switchId`,\n          c.switchId,\n        );\n      if (c.enemyValid) {\n        if (!Array.isArray(members) || Number(c.enemyIndex) >= members.length)\n          fail(`${path}.conditions.enemyIndex`, \"existing raw member position\", c.enemyIndex);\n        for (const [memberIndex, member] of members.entries()) {\n          const enemyId =\n            member && typeof member === \"object\" && \"enemyId\" in member\n              ? member.enemyId\n              : undefined;\n          resolveSavedReference(\n            resolver,\n            { kind: \"enemy\", id: enemyId },\n            `${identity}.members[${memberIndex}].enemyId`,\n            enemyId,\n          );\n        }\n      }\n    }\n  } catch (error) {\n    if (error instanceof BattlePageInputError)\n      throw new CommandStructureError(\n        \"MV-BATTLE-PAGE-INPUT\",\n        \"Invalid native Battle Event Page saved state.\",\n        {\n          nativePath: error.path.replace(`${identity}.`, \"\"),\n          expected: error.expected,\n          actual: error.actual,\n        },\n        identity,\n        stage,\n      );\n    throw error;\n  }\n}\n","import { validateMapEventInputs } from \"../map-event/validation.js\";\nimport type {\n  CommonEventDefinition,\n  DslOwnedDeclaration,\n  MapEventDefinition,\n  SwitchDefinition,\n  VariableDefinition,\n  TroopEventDefinition,\n} from \"../domain/types.js\";\nimport type {\n  CommandInputPrimitiveInspection,\n  SnapshotMapValidationEntry,\n  SnapshotReferenceInput,\n  SnapshotReferenceSource,\n  SnapshotTroopValidationEntry,\n  SnapshotTilesetValidationEntry,\n  StagedDataGraph,\n  ValidationIssue,\n  ValidationResult,\n} from \"./types.js\";\nimport {\n  buildReferenceScopes,\n  createReferenceResolver,\n  validateDeclarationReferences,\n} from \"./references.js\";\nexport {\n  buildReferenceScopes,\n  buildReferenceScope,\n  createReferenceResolver,\n  validateDeclarationReferences,\n} from \"./references.js\";\nimport { validateDeclarationIdentities, mapEventIdentityKey } from \"./identities.js\";\nexport {\n  validateDeclarationIdentities,\n  validatePositiveInteger,\n  validateNonEmptyName,\n  trackUniqueIdentity,\n  mapEventIdentityKey,\n} from \"./identities.js\";\nexport {\n  validatePages,\n  validateNodes,\n  validateCommandPosition,\n  validateMoveRouteCommands,\n  validateMapDestination,\n  validateEventLocationDestination,\n  validateCharacterRuntimeSelector,\n  validateActorCommandTarget,\n  validateEnemyCommandTarget,\n  validateBattlerCommandTarget,\n  validateOperateValueOperand,\n  validateCommandPositiveInteger,\n  validateCommandNonNegativeInteger,\n  validateReferenceOrRange,\n  validateControlVariablesGameDataOperand,\n  validateConditionalBranchCondition,\n  validateActorConditionCheck,\n  validateCondition,\n  isVariableReferenceValue,\n} from \"./commands.js\";\nimport { collectCommandInputPrimitives } from \"./inspection.js\";\nexport { collectCommandInputPrimitives, isReferenceValue } from \"./inspection.js\";\nimport { readObjectReferenceEntries, readSystemNameEntries } from \"./snapshot.js\";\nimport { validateCompiledCommandLists } from \"./compiled-commands.js\";\nimport { validateBattlePages } from \"./battle-pages.js\";\nexport {\n  toReferenceEntry,\n  readObjectReferenceEntries,\n  readSystemNameEntries,\n  readPositiveInteger,\n  readNonEmptyString,\n} from \"./snapshot.js\";\nexport { buildDuplicateAwareNameIndex } from \"./shared.js\";\nexport type {\n  CommandInputPrimitiveInspection,\n  DuplicateAwareNameIndex,\n  ReferenceEntry,\n  ReferenceResolver,\n  ReferenceScope,\n  ReferenceScopes,\n  SnapshotMapValidationEntry,\n  SnapshotReferenceInput,\n  SnapshotReferenceSource,\n  StagedDataGraph,\n  ValidationIssue,\n  ValidationResult,\n} from \"./types.js\";\n\nexport function buildStagedDataGraph(input: {\n  declarations: readonly DslOwnedDeclaration[];\n  snapshotReferences?: SnapshotReferenceInput;\n  snapshotMaps?: readonly SnapshotMapValidationEntry[];\n  snapshotTroops?: readonly SnapshotTroopValidationEntry[];\n  snapshotTilesets?: readonly SnapshotTilesetValidationEntry[];\n  snapshotEquipmentTypes?: unknown;\n}): StagedDataGraph {\n  const declarations = [...input.declarations];\n  const mapEventsByIdentity = new Map<string, MapEventDefinition>();\n  const commonEventsById = new Map<number, CommonEventDefinition>();\n  const troopEventsById = new Map<number, TroopEventDefinition>();\n  const switchesById = new Map<number, SwitchDefinition>();\n  const variablesById = new Map<number, VariableDefinition>();\n  const scopes = buildReferenceScopes({\n    declarations,\n    snapshotReferences: input.snapshotReferences ?? {},\n  });\n\n  for (const declaration of declarations) {\n    switch (declaration.kind) {\n      case \"troopEvent\":\n        troopEventsById.set(declaration.troopId, declaration);\n        break;\n      case \"mapEvent\":\n        mapEventsByIdentity.set(mapEventIdentityKey(declaration), declaration);\n        break;\n      case \"commonEvent\":\n        commonEventsById.set(declaration.id, declaration);\n        break;\n      case \"switchDefinition\":\n        switchesById.set(declaration.id, declaration);\n        break;\n      case \"variableDefinition\":\n        variablesById.set(declaration.id, declaration);\n        break;\n    }\n  }\n\n  return {\n    declarations,\n    mapEventsByIdentity,\n    commonEventsById,\n    troopEventsById,\n    switchesById,\n    variablesById,\n    ...(input.snapshotMaps === undefined ? {} : { snapshotMaps: input.snapshotMaps }),\n    ...(input.snapshotTroops === undefined ? {} : { snapshotTroops: input.snapshotTroops }),\n    ...(input.snapshotTilesets === undefined ? {} : { snapshotTilesets: input.snapshotTilesets }),\n    ...(\"snapshotEquipmentTypes\" in input\n      ? { snapshotEquipmentTypes: input.snapshotEquipmentTypes }\n      : {}),\n    resolver: createReferenceResolver(scopes),\n  };\n}\n\nexport function validateStagedDataGraph(\n  graph: StagedDataGraph,\n  options: {\n    scriptEnabled: boolean;\n  },\n): ValidationResult {\n  const issues: ValidationIssue[] = [];\n\n  validateMapEventInputs(graph, issues);\n  if (issues.some((issue) => issue.level === \"error\")) return { issues };\n  validateDeclarationIdentities(\n    graph.declarations,\n    issues,\n    graph.snapshotMaps,\n    graph.snapshotTroops,\n  );\n  validateDeclarationReferences(graph.declarations, graph.resolver, options, issues);\n  for (const declaration of graph.declarations)\n    if (declaration.kind === \"troopEvent\") validateBattlePages(declaration, graph, options, issues);\n  validateCompiledCommandLists(graph, issues, options);\n\n  return { issues };\n}\n\nexport function validateDslOwnedDeclarations(\n  declarations: readonly DslOwnedDeclaration[],\n  input: {\n    scriptEnabled: boolean;\n    snapshotReferences?: SnapshotReferenceInput;\n    snapshotMaps?: readonly SnapshotMapValidationEntry[];\n    snapshotTroops?: readonly SnapshotTroopValidationEntry[];\n  },\n): ValidationResult {\n  const graphInput: {\n    declarations: readonly DslOwnedDeclaration[];\n    snapshotReferences?: SnapshotReferenceInput;\n    snapshotMaps?: readonly SnapshotMapValidationEntry[];\n    snapshotTroops?: readonly SnapshotTroopValidationEntry[];\n  } = { declarations };\n\n  if (input.snapshotReferences !== undefined) {\n    graphInput.snapshotReferences = input.snapshotReferences;\n  }\n  if (input.snapshotMaps !== undefined) {\n    graphInput.snapshotMaps = input.snapshotMaps;\n  }\n  if (input.snapshotTroops !== undefined) graphInput.snapshotTroops = input.snapshotTroops;\n\n  return validateStagedDataGraph(buildStagedDataGraph(graphInput), {\n    scriptEnabled: input.scriptEnabled,\n  });\n}\n\nexport function buildSnapshotReferenceInput(\n  source: SnapshotReferenceSource,\n): SnapshotReferenceInput {\n  return {\n    actors: readObjectReferenceEntries(source.actors ?? []),\n    animations: readObjectReferenceEntries(source.animations ?? []),\n    armors: readObjectReferenceEntries(source.armors ?? []),\n    classes: readObjectReferenceEntries(source.classes ?? []),\n    commonEvents: readObjectReferenceEntries(source.commonEvents ?? []),\n    enemies: readObjectReferenceEntries(source.enemies ?? []),\n    items: readObjectReferenceEntries(source.items ?? []),\n    maps: (source.mapInfos ?? []).map(({ id, name }) => ({ id, name })),\n    skills: readObjectReferenceEntries(source.skills ?? []),\n    states: readObjectReferenceEntries(source.states ?? []),\n    tilesets: readObjectReferenceEntries(source.tilesets ?? []),\n    troops: readObjectReferenceEntries(source.troops ?? []),\n    switches: readSystemNameEntries(source.system ?? {}, \"switches\"),\n    switchCapacity: Array.isArray(source.system?.switches)\n      ? Math.max(0, source.system.switches.length - 1)\n      : 0,\n    variables: readSystemNameEntries(source.system ?? {}, \"variables\"),\n    variableCapacity: Array.isArray(source.system?.variables)\n      ? Math.max(0, source.system.variables.length - 1)\n      : 0,\n    weapons: readObjectReferenceEntries(source.weapons ?? []),\n  };\n}\n\nexport function inspectCommandInputPrimitives(value: unknown): CommandInputPrimitiveInspection {\n  const inspection: CommandInputPrimitiveInspection = {\n    projectDataReferences: [],\n    assetReferences: [],\n    runtimeSelectors: [],\n    scriptInputs: [],\n  };\n  const seen = new Set<object>();\n\n  collectCommandInputPrimitives(value, inspection, seen);\n\n  return inspection;\n}\n","import { renderMovementRoute } from \"../commands/movement/decompile.js\";\nimport { nativeDirections, pageDirections, pagePriorities } from \"../map-event/page.js\";\nimport { literal, mapPageTriggerFromCode, renderPageConditions } from \"./core.js\";\nimport type { SnapshotMapEventPage } from \"./types.js\";\n\nexport function renderMapPageSettings(page: SnapshotMapEventPage): string[] {\n  const fields: string[] = [];\n  const conditions = renderPageConditions(page.conditions);\n  if (conditions !== \"{}\") fields.push(`conditions: ${conditions},`);\n  const image: string[] = [];\n  if (page.image.characterName !== \"\")\n    image.push(\n      `character: imageAsset({ folder: \"characters\", name: ${literal(page.image.characterName)} })`,\n    );\n  if (!Object.is(page.image.characterIndex, 0))\n    image.push(`characterIndex: ${literal(page.image.characterIndex)}`);\n  if (!Object.is(page.image.tileId, 0)) image.push(`tileId: ${literal(page.image.tileId)}`);\n  if (page.image.direction !== 2)\n    image.push(\n      `direction: ${literal(pageDirections[nativeDirections.indexOf(page.image.direction as 2)])}`,\n    );\n  if (!Object.is(page.image.pattern, 0)) image.push(`pattern: ${literal(page.image.pattern)}`);\n  if (image.length) fields.push(`image: { ${image.join(\", \")} },`);\n  const movement: string[] = [];\n  if (page.movement) {\n    if (page.movement.type !== \"fixed\") movement.push(`type: ${literal(page.movement.type)}`);\n    if (page.movement.speed !== 3) movement.push(`speed: ${page.movement.speed}`);\n    if (page.movement.frequency !== 3) movement.push(`frequency: ${page.movement.frequency}`);\n    const route = renderMovementRoute(page.movement.route)!.expression;\n    if (route !== \"{ commands: [] }\") movement.push(`route: ${route}`);\n  }\n  if (movement.length) fields.push(`movement: { ${movement.join(\", \")} },`);\n  if (page.priorityType !== 0)\n    fields.push(`priority: ${literal(pagePriorities[page.priorityType])},`);\n  const options: string[] = [];\n  if (page.walkAnime !== true) options.push(`walkAnimation: ${page.walkAnime}`);\n  if (page.stepAnime !== false) options.push(`stepAnimation: ${page.stepAnime}`);\n  if (page.directionFix !== false) options.push(`directionFix: ${page.directionFix}`);\n  if (page.through !== false) options.push(`through: ${page.through}`);\n  if (options.length) fields.push(`options: { ${options.join(\", \")} },`);\n  if (page.trigger !== 0) fields.push(`trigger: ${literal(mapPageTriggerFromCode(page.trigger))},`);\n  return fields;\n}\n","import { resolve } from \"node:path\";\nimport { parseMapInfos, type MapInfoEntry } from \"../project-data/project.js\";\nimport type { WorkspaceStatePaths } from \"../workspace/state.js\";\nimport type { SnapshotCommonEvent, SnapshotMapEvent, SnapshotMapEventPage } from \"./types.js\";\nimport {\n  collectConditionHelperNames,\n  commonEventTriggerFromCode,\n  createExportNameAllocator,\n  formatMapFileName,\n  indentLines,\n  literal,\n  normalizeCommandList,\n  readCommonEvents,\n  readMapEvents,\n  readRawCommandList,\n  readNamedSystemEntries,\n  readSnapshotArray,\n  readSnapshotFile,\n  readSnapshotObject,\n  renderEmptyModule,\n  renderEventImport,\n} from \"./core.js\";\nimport { renderCommands } from \"./dispatch.js\";\nimport { renderDecompiledCommandList } from \"./dispatch.js\";\nimport { assertNativeSwitchCommand } from \"../commands/variables/validation.js\";\nimport { assertNativeContextReferences } from \"../validation/native-context-references.js\";\nimport { buildSnapshotReferenceInput } from \"../validation/staged-graph.js\";\nimport {\n  buildReferenceScopes,\n  buildReferenceScope,\n  createReferenceResolver,\n} from \"../validation/references.js\";\nimport type { ReferenceResolver } from \"../validation/types.js\";\nimport type { ValidationIssue } from \"../validation/types.js\";\nimport type { RawEventCommand } from \"./types.js\";\nimport {\n  inspectNativeCommandInputs,\n  inspectNativeRouteInputs,\n} from \"../validation/native-command-inputs.js\";\nimport { renderMovementRoute } from \"../commands/movement/decompile.js\";\nimport { validateNativeMovementRouteInputs } from \"../commands/movement/validation.js\";\nimport { inspectNativeCommandReferences } from \"../validation/native-references.js\";\nimport { CommandStructureError } from \"../validation/command-errors.js\";\nimport { assertNativeBattlePages, type NativeBattleEventPage } from \"../validation/battle-pages.js\";\nimport { renderMapPageSettings } from \"./map-page.js\";\n\nexport type DecompileFile = {\n  content: string;\n  path: string;\n};\n\nexport type DecompileProjectDataSnapshotOptions = {\n  scriptEnabled?: boolean;\n  sourceRoot: string;\n  statePaths: WorkspaceStatePaths;\n  workspaceRoot: string;\n  validateCandidate: (files: readonly DecompileFile[]) => Promise<void>;\n  publishCandidate: (files: readonly DecompileFile[]) => Promise<void>;\n};\n\nexport async function decompileProjectDataSnapshot(\n  options: DecompileProjectDataSnapshotOptions,\n): Promise<void> {\n  const issues: ValidationIssue[] = [];\n  const files = await buildDecompiledSourceFiles(options, issues);\n  await options.validateCandidate(files);\n\n  await options.publishCandidate(files);\n  for (const issue of issues) console.error(issue.message);\n}\n\nasync function buildDecompiledSourceFiles(\n  options: DecompileProjectDataSnapshotOptions,\n  issues: ValidationIssue[],\n): Promise<DecompileFile[]> {\n  const mapInfos = parseMapInfos(await readSnapshotFile(options.statePaths, \"MapInfos.json\"));\n  const outputRoot = resolve(options.workspaceRoot, options.sourceRoot, \"decompiled\");\n  const files: DecompileFile[] = [];\n  const system = await readSnapshotObject(options.statePaths, \"System.json\");\n  const referenceSources = await Promise.all(\n    [\n      \"Actors\",\n      \"Animations\",\n      \"Armors\",\n      \"Classes\",\n      \"CommonEvents\",\n      \"Enemies\",\n      \"Items\",\n      \"Skills\",\n      \"States\",\n      \"Tilesets\",\n      \"Troops\",\n      \"Weapons\",\n    ].map((name) => readSnapshotArray(options.statePaths, `${name}.json`)),\n  );\n  const [\n    actors,\n    animations,\n    armors,\n    classes,\n    commonEventsInput,\n    enemies,\n    items,\n    skills,\n    states,\n    tilesets,\n    troops,\n    weapons,\n  ] = referenceSources as [\n    unknown[],\n    unknown[],\n    unknown[],\n    unknown[],\n    unknown[],\n    unknown[],\n    unknown[],\n    unknown[],\n    unknown[],\n    unknown[],\n    unknown[],\n    unknown[],\n  ];\n  const commonEvents = readCommonEvents(commonEventsInput);\n  const scopes = buildReferenceScopes({\n    declarations: [],\n    snapshotReferences: buildSnapshotReferenceInput({\n      system,\n      actors,\n      animations,\n      armors,\n      classes,\n      commonEvents: commonEventsInput,\n      enemies,\n      items,\n      mapInfos,\n      skills,\n      states,\n      tilesets,\n      troops,\n      weapons,\n    }),\n  });\n  // Decompile's entire owned candidate comes from this captured Snapshot. Compile's\n  // resolver continues to take Common Events exclusively from actual declarations.\n  scopes.commonEvent = buildReferenceScope(commonEvents, true);\n  const resolver = createReferenceResolver(scopes);\n  for (const event of commonEvents) {\n    // none's omitted authoring switch reconstructs the fixed saved default 1.\n    if (event.trigger === 0 && event.switchId === 1) continue;\n    try {\n      resolver.resolveReference({ kind: \"switch\", id: event.switchId });\n    } catch (error) {\n      throw new CommandStructureError(\n        \"MV-COMMON-REFERENCE\",\n        error instanceof Error ? error.message : String(error),\n        {\n          nativePath: `CommonEvents[${event.id}].switchId`,\n          expected: \"existing System Switch slot\",\n          actual: String(event.switchId),\n        },\n        `commonEvent:${event.id}`,\n        \"decompile\",\n      );\n    }\n  }\n\n  for (const mapInfo of mapInfos) {\n    const mapFileName = formatMapFileName(mapInfo.id);\n    const mapData = await readSnapshotObject(options.statePaths, mapFileName);\n    const events = readMapEvents(mapData, mapInfo.id);\n    for (const event of events) {\n      for (const [pageIndex, page] of event.pages.entries()) {\n        const inputOptions = {\n          identity: `map:${mapInfo.id}/event:${event.id}`,\n          stage: \"decompile\" as const,\n          scriptEnabled: options.scriptEnabled ?? false,\n          prefix: `pages[${pageIndex}].`,\n        };\n        issues.push(...inspectNativeCommandInputs(page.list ?? [], inputOptions));\n        if (page.movement !== undefined) {\n          const path = `pages[${pageIndex}].moveRoute`;\n          const referenceIssues: ValidationIssue[] = [];\n          validateNativeMovementRouteInputs(\n            page.movement.route,\n            resolver,\n            { scriptEnabled: true, identity: inputOptions.identity, nativePath: path },\n            referenceIssues,\n          );\n          if (referenceIssues.length)\n            throw new Error(\n              `decompile error ${inputOptions.identity}: ${referenceIssues.map((issue) => `${issue.nativePath}: ${issue.message}`).join(\"; \")}`,\n            );\n          issues.push(...inspectNativeRouteInputs(page.movement.route, path, inputOptions));\n        }\n        assertSnapshotReferences(\n          normalizeCommandList(page.list),\n          `map ${mapInfo.id} event ${event.id}.pages[${pageIndex}].list`,\n          resolver,\n        );\n        const errors = inspectNativeCommandReferences(page.list ?? [], resolver, inputOptions);\n        if (errors.length) throw new Error(errors.map((issue) => issue.message).join(\"\\n\"));\n        assertSnapshotRendering(page.list ?? [], inputOptions.identity, inputOptions.prefix);\n      }\n    }\n    files.push({\n      content: renderMapSource(mapInfo, events),\n      path: resolve(outputRoot, \"maps\", `${mapFileName.slice(0, -\".json\".length)}.events.ts`),\n    });\n  }\n\n  for (const event of commonEvents) {\n    issues.push(\n      ...inspectNativeCommandInputs(event.list ?? [], {\n        identity: `commonEvent:${event.id}`,\n        stage: \"decompile\",\n        scriptEnabled: options.scriptEnabled ?? false,\n      }),\n    );\n    assertSnapshotReferences(\n      normalizeCommandList(event.list),\n      `common event ${event.id}.list`,\n      resolver,\n    );\n    const errors = inspectNativeCommandReferences(event.list ?? [], resolver, {\n      identity: `commonEvent:${event.id}`,\n      stage: \"decompile\",\n    });\n    if (errors.length) throw new Error(errors.map((issue) => issue.message).join(\"\\n\"));\n    assertSnapshotRendering(event.list ?? [], `commonEvent:${event.id}`);\n  }\n  files.push({\n    content: renderCommonEventsSource(commonEvents),\n    path: resolve(outputRoot, \"common-events.events.ts\"),\n  });\n\n  const troopEvents: Array<{ id: number; pages: NativeBattleEventPage[] }> = [];\n  for (const [id, entry] of troops.entries()) {\n    if (entry === null) continue;\n    if (\n      !entry ||\n      typeof entry !== \"object\" ||\n      Array.isArray(entry) ||\n      !(\"id\" in entry) ||\n      entry.id !== id ||\n      id <= 0\n    )\n      throw new Error(\n        `decompile Troops.json[${id}]: expected Troop with positive matching identity or null.`,\n      );\n    const troop = entry as Record<string, unknown>;\n    const identity = `troop:${id}`;\n    assertNativeBattlePages(troop.pages, troop.members, resolver, identity, \"decompile\");\n    for (const [pageIndex, page] of troop.pages.entries()) {\n      const prefix = `pages[${pageIndex}].`;\n      const commands = readRawCommandList(page.list, identity, prefix);\n      issues.push(\n        ...inspectNativeCommandInputs(commands, {\n          identity,\n          stage: \"decompile\",\n          scriptEnabled: options.scriptEnabled ?? false,\n          prefix,\n        }),\n      );\n      const errors = inspectNativeCommandReferences(commands, resolver, {\n        identity,\n        stage: \"decompile\",\n        prefix,\n      });\n      if (errors.length) throw new Error(errors.map(({ message }) => message).join(\"\\n\"));\n      assertSnapshotReferences(commands, `${identity}.${prefix}list`, resolver);\n      assertSnapshotRendering(commands, identity, prefix);\n    }\n    troopEvents.push({ id, pages: troop.pages });\n  }\n  files.push({\n    content: renderTroopEventsSource(troopEvents),\n    path: resolve(outputRoot, \"troop-events.events.ts\"),\n  });\n\n  files.push({\n    content: renderSystemSource(system),\n    path: resolve(outputRoot, \"system.dsl.ts\"),\n  });\n\n  return files.sort((left, right) => left.path.localeCompare(right.path));\n}\n\nfunction renderTroopEventsSource(\n  events: readonly { id: number; pages: NativeBattleEventPage[] }[],\n): string {\n  if (!events.length) return renderEmptyModule();\n  const helpers = new Set<string>([\"troopEvent\", \"battlePage\"]);\n  const body = events\n    .map(({ id, pages }) => {\n      const renderedPages = pages.map((page) => {\n        const c = page.conditions;\n        const slots: string[] = [];\n        if (c.turnEnding) slots.push(\"turnEnd: true\");\n        if (c.turnValid || !Object.is(c.turnA, 0) || !Object.is(c.turnB, 0))\n          slots.push(\n            `turn: { enabled: ${c.turnValid}, a: ${literal(c.turnA)}, b: ${literal(c.turnB)} }`,\n          );\n        if (c.enemyValid || !Object.is(c.enemyIndex, 0) || c.enemyHp !== 50)\n          slots.push(\n            `enemy: { enabled: ${c.enemyValid}, index: ${literal(c.enemyIndex)}, hpAtMost: ${literal(c.enemyHp)} }`,\n          );\n        if (c.actorValid || c.actorId !== 1 || c.actorHp !== 50) {\n          helpers.add(\"actorRef\");\n          slots.push(\n            `actor: { enabled: ${c.actorValid}, ref: actorRef({ id: ${literal(c.actorId)} }), hpAtMost: ${literal(c.actorHp)} }`,\n          );\n        }\n        if (c.switchValid || c.switchId !== 1) {\n          helpers.add(\"switchRef\");\n          slots.push(\n            `switch: { enabled: ${c.switchValid}, ref: switchRef({ id: ${literal(c.switchId)} }) }`,\n          );\n        }\n        for (const name of renderDecompiledCommandList(page.list).helperNames) helpers.add(name);\n        return `battlePage({\\n${slots.length ? `  conditions: { ${slots.join(\", \")} },\\n` : \"\"}${page.span === 0 ? \"\" : `  span: ${literal(page.span === 1 ? \"turn\" : \"moment\")},\\n`}  commands: [\\n${indentLines(renderCommands(page.list), 4)}\\n  ],\\n})`;\n      });\n      return `export const troopEvent${id} = troopEvent({\\n  troopId: ${id},\\n  pages: [\\n${indentLines(renderedPages.join(\",\\n\"), 4)}\\n  ],\\n});`;\n    })\n    .join(\"\\n\\n\");\n  return `${renderEventImport([...helpers])}\\n\\n${body}\\n`;\n}\n\nfunction assertSnapshotRendering(\n  commands: readonly RawEventCommand[],\n  identity: string,\n  prefix = \"\",\n): void {\n  try {\n    renderDecompiledCommandList(commands);\n  } catch (error) {\n    if (error instanceof CommandStructureError) {\n      const location = { ...error.location };\n      if (location.nativePath) location.nativePath = prefix + location.nativePath;\n      if (location.relatedLocations)\n        location.relatedLocations = location.relatedLocations.map((related) => ({\n          ...related,\n          ...(related.nativePath ? { nativePath: prefix + related.nativePath } : {}),\n        }));\n      throw new CommandStructureError(error.code, error.detail, location, identity, \"decompile\");\n    }\n    throw error;\n  }\n}\n\nfunction assertSnapshotReferences(\n  commands: readonly RawEventCommand[],\n  identity: string,\n  resolver: ReferenceResolver,\n) {\n  for (const [index, command] of commands.entries()) {\n    try {\n      assertNativeSwitchCommand(command.code, command.parameters, resolver);\n      assertNativeContextReferences(command.code, command.parameters, resolver);\n      if (command.code === 205) {\n        const issues: ValidationIssue[] = [];\n        validateNativeMovementRouteInputs(\n          command.parameters[1],\n          resolver,\n          { scriptEnabled: true, nativePath: `list[${index}].parameters[1]` },\n          issues,\n        );\n        if (issues.length)\n          throw new Error(\n            issues.map((issue) => `${issue.code} ${issue.nativePath}: ${issue.message}`).join(\"; \"),\n          );\n      }\n    } catch (error) {\n      throw new Error(\n        `decompile ${identity}[${index}]: ${error instanceof Error ? error.message : String(error)}`,\n      );\n    }\n  }\n}\n\nfunction renderMapSource(mapInfo: MapInfoEntry, events: readonly SnapshotMapEvent[]): string {\n  if (events.length === 0) {\n    return renderEmptyModule();\n  }\n\n  const names = createExportNameAllocator();\n  const body = events\n    .map((event) => {\n      const exportName = names.create(\"mapEvent\", event.name, event.id);\n      return `export const ${exportName} = mapEvent({\n  mapId: ${mapInfo.id},\n  id: ${event.id},\n  name: ${literal(event.name)},\n${event.note === \"\" ? \"\" : `  note: ${literal(event.note)},\\n`}\\\n  x: ${event.x},\n  y: ${event.y},\n  pages: [\n${indentLines(event.pages.map(renderPage).join(\",\\n\"), 4)}\n  ],\n});`;\n    })\n    .join(\"\\n\\n\");\n\n  return `${renderEventImport([\n    \"mapEvent\",\n    \"page\",\n    ...collectConditionHelperNames(\n      events.flatMap((event) => event.pages.map((page) => page.conditions)),\n    ),\n    ...events.flatMap((event) =>\n      event.pages.flatMap((page) => [\n        ...(page.image.characterName === \"\" ? [] : [\"imageAsset\"]),\n        ...renderDecompiledCommandList(normalizeCommandList(page.list)).helperNames,\n        ...(page.movement ? (renderMovementRoute(page.movement.route)?.helperNames ?? []) : []),\n      ]),\n    ),\n  ])}\\n\\n${body}\\n`;\n}\n\nfunction renderCommonEventsSource(events: readonly SnapshotCommonEvent[]): string {\n  if (events.length === 0) {\n    return renderEmptyModule();\n  }\n\n  const names = createExportNameAllocator();\n  const body = events\n    .map((event) => {\n      const exportName = names.create(\"commonEvent\", event.name, event.id);\n      const trigger = commonEventTriggerFromCode(event.trigger);\n      const switchLine =\n        trigger === \"none\" && event.switchId === 1\n          ? \"\"\n          : `\\n  switch: switchRef({ id: ${event.switchId} }),`;\n\n      return `export const ${exportName} = commonEvent({\n  id: ${event.id},\n  name: ${literal(event.name)},\n  trigger: ${literal(trigger)},${switchLine}\n  commands: [\n${indentLines(renderCommands(normalizeCommandList(event.list)), 4)}\n  ],\n});`;\n    })\n    .join(\"\\n\\n\");\n\n  return `${renderEventImport([\n    \"commonEvent\",\n    ...(events.some((event) => event.trigger !== 0 || event.switchId !== 1) ? [\"switchRef\"] : []),\n    ...events.flatMap(\n      (event) => renderDecompiledCommandList(normalizeCommandList(event.list)).helperNames,\n    ),\n  ])}\\n\\n${body}\\n`;\n}\n\nfunction renderSystemSource(system: Record<string, unknown>): string {\n  const switches = readNamedSystemEntries(system.switches);\n  const variables = readNamedSystemEntries(system.variables);\n  const declarations: string[] = [];\n  const names = createExportNameAllocator();\n\n  for (const entry of switches) {\n    declarations.push(`export const ${names.create(\"switch\", entry.name, entry.id)} = switchDefinition({\n  id: ${entry.id},\n  name: ${literal(entry.name)},\n});`);\n  }\n\n  for (const entry of variables) {\n    declarations.push(`export const ${names.create(\"variable\", entry.name, entry.id)} = variableDefinition({\n  id: ${entry.id},\n  name: ${literal(entry.name)},\n});`);\n  }\n\n  if (declarations.length === 0) {\n    return renderEmptyModule();\n  }\n\n  return `import { switchDefinition, variableDefinition } from \"rpgmaker-event-dsl\";\\n\\n${declarations.join(\n    \"\\n\\n\",\n  )}\\n`;\n}\n\nfunction renderPage(page: SnapshotMapEventPage): string {\n  return `page({\n${renderMapPageSettings(page)\n  .map((field) => `  ${field}\\n`)\n  .join(\"\")}\\\n  commands: [\n${indentLines(renderCommands(normalizeCommandList(page.list)), 4)}\n  ],\n})`;\n}\n","import type {\n  BattleEventPage,\n  CommonEventDefinition,\n  EventPage,\n  MapEventDefinition,\n  ReferenceValue,\n} from \"../domain/types.js\";\nimport { blankBattleEventPage } from \"../domain/battle-page-defaults.js\";\nimport { assertMapEventInput, assertMapPageInput } from \"../map-event/validation.js\";\nimport type { ReferenceResolver } from \"../validation/types.js\";\nimport { commonEventTriggerToCode, compileNodes, type RawEventCommand } from \"./dispatch.js\";\nimport { compilePageMovement } from \"../commands/movement/page.js\";\nimport { assertCommonEventInput } from \"../validation/common-events.js\";\n\nimport { assertBattlePageInput } from \"../validation/battle-pages.js\";\n\nexport function compileBattlePage(page: BattleEventPage, resolver: ReferenceResolver) {\n  assertBattlePageInput(page, resolver);\n  const defaults = blankBattleEventPage();\n  const conditions = page.conditions ?? {};\n  const savedId = (ref: ReferenceValue<\"actor\"> | ReferenceValue<\"switch\">, enabled: boolean) =>\n    !enabled && \"id\" in ref ? ref.id : resolver.resolveReference(ref);\n  return {\n    conditions: {\n      ...defaults.conditions,\n      ...(conditions.turnEnd === undefined ? {} : { turnEnding: conditions.turnEnd }),\n      ...(conditions.turn === undefined\n        ? {}\n        : {\n            turnValid: conditions.turn.enabled,\n            turnA: conditions.turn.a,\n            turnB: conditions.turn.b,\n          }),\n      ...(conditions.enemy === undefined\n        ? {}\n        : {\n            enemyValid: conditions.enemy.enabled,\n            enemyIndex: conditions.enemy.index,\n            enemyHp: conditions.enemy.hpAtMost,\n          }),\n      ...(conditions.actor === undefined\n        ? {}\n        : {\n            actorValid: conditions.actor.enabled,\n            actorId: savedId(conditions.actor.ref, conditions.actor.enabled),\n            actorHp: conditions.actor.hpAtMost,\n          }),\n      ...(conditions.switch === undefined\n        ? {}\n        : {\n            switchValid: conditions.switch.enabled,\n            switchId: savedId(conditions.switch.ref, conditions.switch.enabled),\n          }),\n    },\n    span: page.span === undefined || page.span === \"battle\" ? 0 : page.span === \"turn\" ? 1 : 2,\n    list: compileNodes(page.commands, 0, resolver),\n  };\n}\nimport { compilePageSettings } from \"../map-event/page.js\";\n\nexport type ProjectEventData = {\n  id: number;\n  name: string;\n  x?: number;\n  y?: number;\n  note?: string;\n  pages?: ProjectEventPage[];\n  trigger?: number;\n  switchId?: number;\n  list?: RawEventCommand[];\n};\n\ntype ProjectEventPage = {\n  conditions?: Record<string, unknown>;\n  directionFix?: boolean;\n  image?: Record<string, unknown>;\n  list: RawEventCommand[];\n  moveFrequency?: number;\n  moveRoute?: Record<string, unknown>;\n  moveSpeed?: number;\n  moveType?: number;\n  priorityType?: number;\n  stepAnime?: boolean;\n  through?: boolean;\n  trigger?: number;\n  walkAnime?: boolean;\n};\n\ntype CompiledCommonEvent = {\n  id: number;\n  name: string;\n  trigger: number;\n  switchId: number;\n  list: RawEventCommand[];\n};\n\nexport function compileMapEvent(\n  definition: MapEventDefinition,\n  options: { nextId: number; resolver: ReferenceResolver },\n): ProjectEventData {\n  assertMapEventInput(definition);\n  return {\n    id: options.nextId,\n    name: definition.name,\n    x: definition.x,\n    y: definition.y,\n    note: definition.note ?? \"\",\n    pages: definition.pages.map((page) => compilePage(page, options.resolver)),\n  };\n}\n\nexport function compileCommonEvent(\n  definition: CommonEventDefinition,\n  options: { nextId: number; resolver: ReferenceResolver },\n): CompiledCommonEvent {\n  assertCommonEventInput(definition, true);\n  return {\n    id: options.nextId,\n    name: definition.name,\n    trigger: commonEventTriggerToCode(definition.trigger),\n    switchId: definition.switch ? options.resolver.resolveReference(definition.switch) : 1,\n    list: compileNodes(definition.commands, 0, options.resolver),\n  };\n}\n\nexport function compilePage(page: EventPage, resolver: ReferenceResolver): ProjectEventPage {\n  assertMapPageInput(page, resolver, \"page\");\n  return {\n    ...compilePageSettings(page, resolver),\n    list: compileNodes(page.commands, 0, resolver),\n    ...compilePageMovement(page.movement, resolver),\n  };\n}\n","import type { RawEventCommand } from \"../compiler/types.js\";\nimport type { ReferenceResolver, ValidationIssue } from \"./types.js\";\nimport { assertStrictJson } from \"../project-data/json-values.js\";\nimport { CommandStructureError, inspectCommandListStructure } from \"./command-structure.js\";\nimport { inspectNativeCommandInputs, inspectNativeRouteInputs } from \"./native-command-inputs.js\";\nimport { inspectNativeCommandReferences } from \"./native-references.js\";\nimport {\n  assertNativeMovementRoute,\n  validateNativeMovementRouteInputs,\n} from \"../commands/movement/validation.js\";\nimport type { NativeMovementRoute } from \"../commands/movement/types.js\";\nimport { assertNativeBattlePages } from \"./battle-pages.js\";\n\n/** Validate the actual complete emitted values, before serialization or filesystem writes. */\nexport function assertCompileOutput(\n  files: ReadonlyMap<string, unknown>,\n  resolver: ReferenceResolver,\n  scriptEnabled: boolean,\n): void {\n  const issues: ValidationIssue[] = [];\n  const list = (commands: RawEventCommand[], identity: string, prefix = \"\") => {\n    try {\n      inspectCommandListStructure(commands, { requireTerminator: true });\n    } catch (error) {\n      if (error instanceof CommandStructureError)\n        throw new Error(`Compile output ${identity}: ${error.message}`, { cause: error });\n      throw error;\n    }\n    issues.push(\n      ...inspectNativeCommandInputs(commands, {\n        identity,\n        stage: \"compile\",\n        scriptEnabled,\n        prefix,\n      }),\n    );\n    issues.push(\n      ...inspectNativeCommandReferences(commands, resolver, { identity, stage: \"compile\", prefix }),\n    );\n  };\n  const require = (condition: boolean, path: string, expected: string) => {\n    if (!condition) throw new Error(`Compile output ${path}: expected ${expected}.`);\n  };\n  for (const [file, value] of files) {\n    assertStrictJson(value, `Compile output ${file}`);\n    if (file === \"System.json\") continue;\n    if (file === \"Troops.json\") {\n      require(Array.isArray(value), file, \"Troop array\");\n      for (const [index, troop] of (value as Array<Record<string, unknown> | null>).entries()) {\n        if (troop === null) continue;\n        const identity = `troop:${index}`;\n        require(Boolean(troop) &&\n          troop.id === index &&\n          index > 0 &&\n          Number.isSafeInteger(index), identity, \"positive matching Troop identity\");\n        assertNativeBattlePages(troop.pages, troop.members, resolver, identity);\n        for (const [pageIndex, page] of troop.pages.entries())\n          list(page.list, identity, `pages[${pageIndex}].`);\n      }\n      continue;\n    }\n    const events = (\n      file === \"CommonEvents.json\" ? value : (value as { events: unknown }).events\n    ) as Array<Record<string, unknown> | null>;\n    require(Array.isArray(events), file, \"event array\");\n    for (const [index, event] of events.entries()) {\n      if (event === null) continue;\n      const identity =\n        file === \"CommonEvents.json\"\n          ? `commonEvent:${index}`\n          : `map:${Number(file.slice(3, -5))}/event:${index}`;\n      require(event.id === index &&\n        index > 0 &&\n        Number.isSafeInteger(event.id), identity, \"positive matching Entry Identity\");\n      require(typeof event.name === \"string\", `${identity}.name`, \"string\");\n      if (file === \"CommonEvents.json\") list(event.list as RawEventCommand[], identity);\n      else {\n        require(Number.isInteger(event.x) &&\n          Number(event.x) >= 0 &&\n          Number.isInteger(event.y) &&\n          Number(event.y) >= 0, identity, \"nonnegative integer coordinates\");\n        require(Array.isArray(event.pages) &&\n          event.pages.length > 0, `${identity}.pages`, \"nonempty page array\");\n        for (const [pageIndex, page] of (event.pages as Array<Record<string, unknown>>).entries()) {\n          const prefix = `pages[${pageIndex}].`;\n          list(page.list as RawEventCommand[], identity, prefix);\n          assertNativeMovementRoute(page.moveRoute, `${prefix}moveRoute`);\n          validateNativeMovementRouteInputs(\n            page.moveRoute,\n            resolver,\n            { scriptEnabled: true, identity, nativePath: `${prefix}moveRoute` },\n            issues,\n          );\n          issues.push(\n            ...inspectNativeRouteInputs(\n              page.moveRoute as NativeMovementRoute,\n              `${prefix}moveRoute`,\n              { identity, stage: \"compile\", scriptEnabled },\n            ),\n          );\n        }\n      }\n    }\n  }\n  const errors = issues.filter(({ level }) => level === \"error\");\n  if (errors.length > 0)\n    throw new Error(\n      `Compile output validation failed:\\n${errors.map(({ message }) => message).join(\"\\n\")}`,\n    );\n}\n","import { mkdir, readFile, rename, rm, writeFile } from \"node:fs/promises\";\nimport { dirname, posix, relative, resolve } from \"node:path\";\nimport { randomUUID } from \"node:crypto\";\n\nimport type {\n  CommonEventDefinition,\n  DslOwnedDeclaration,\n  MapEventDefinition,\n  SwitchDefinition,\n  VariableDefinition,\n  TroopEventDefinition,\n} from \"../domain/types.js\";\nimport { compileBattlePage, compileCommonEvent, compileMapEvent } from \"../compiler/events.js\";\nimport { blankBattleEventPage } from \"../domain/battle-page-defaults.js\";\nimport { parseMapInfos } from \"./project.js\";\nimport type { ReferenceResolver } from \"../validation/types.js\";\nimport {\n  hashUtf8Content,\n  readProjectDataSnapshotFile,\n  type SyncManifest,\n  type WorkspaceStatePaths,\n} from \"../workspace/state.js\";\nimport type { WorkspaceConfig } from \"../workspace/config.js\";\nimport { writeStableJson } from \"./writer.js\";\nimport { assertCompileOutput } from \"../validation/compile-output.js\";\nimport {\n  compileContractVersion,\n  typeInputsUnchanged,\n  type TypeInput,\n} from \"../workspace/type-inputs.js\";\n\nexport type CompileBaseline = NonNullable<SyncManifest[\"compileBaseline\"]>;\nexport type FileHashEntry = {\n  hash: string;\n  relativePath: string;\n};\n\nexport type MaterializeCompileOutputOptions = {\n  statePaths: WorkspaceStatePaths;\n  declarations: readonly DslOwnedDeclaration[];\n  resolver: ReferenceResolver;\n  scriptEnabled: boolean;\n};\n\nexport type MaterializedCompileOutput = {\n  generatedFiles: FileHashEntry[];\n};\n\nexport type CompileOutputCandidate = { files: ReadonlyMap<string, string> };\n\nexport type CompileBaselineInput = {\n  projectRootBinding: string;\n  workspaceRoot: string;\n  config: WorkspaceConfig;\n  sourceFiles: readonly string[];\n  sourceFileHashes?: readonly FileHashEntry[];\n  typeInputs?: readonly TypeInput[];\n  snapshotFiles: readonly FileHashEntry[];\n};\n\nexport async function expectedCompileOutputFileNames(\n  statePaths: WorkspaceStatePaths,\n): Promise<string[]> {\n  return [\n    \"CommonEvents.json\",\n    \"System.json\",\n    \"Troops.json\",\n    ...parseMapInfos(await readSnapshotFile(statePaths, \"MapInfos.json\")).map(({ id }) =>\n      formatMapFileName(id),\n    ),\n  ].sort();\n}\n\nexport async function buildCompileOutput(\n  options: MaterializeCompileOutputOptions,\n): Promise<CompileOutputCandidate> {\n  const mapInfos = parseMapInfos(await readSnapshotFile(options.statePaths, \"MapInfos.json\"));\n  const files = new Map<string, unknown>();\n  const troopDefinitions = new Map(\n    options.declarations\n      .filter(\n        (declaration): declaration is TroopEventDefinition => declaration.kind === \"troopEvent\",\n      )\n      .map((declaration) => [declaration.troopId, declaration]),\n  );\n  files.set(\n    \"Troops.json\",\n    (await readSnapshotArray(options.statePaths, \"Troops.json\")).map((entry, index) => {\n      if (entry === null) return null;\n      if (\n        !entry ||\n        typeof entry !== \"object\" ||\n        Array.isArray(entry) ||\n        (entry as { id?: unknown }).id !== index ||\n        index <= 0\n      )\n        throw new Error(\n          `Snapshot Troops.json[${index}]: expected actual Troop with positive matching ID or null.`,\n        );\n      const definition = troopDefinitions.get(index);\n      return {\n        ...entry,\n        pages: definition\n          ? definition.pages.map((page) => compileBattlePage(page, options.resolver))\n          : [blankBattleEventPage()],\n      };\n    }),\n  );\n\n  for (const mapInfo of mapInfos) {\n    const relativePath = formatMapFileName(mapInfo.id);\n    const mapData = await readSnapshotObject(options.statePaths, relativePath);\n    files.set(\n      relativePath,\n      materializeMapCarrier(\n        mapData,\n        options.declarations.filter(\n          (declaration): declaration is MapEventDefinition =>\n            declaration.kind === \"mapEvent\" && declaration.mapId === mapInfo.id,\n        ),\n        options.resolver,\n      ),\n    );\n  }\n\n  files.set(\n    \"CommonEvents.json\",\n    materializeCommonEventsCarrier(\n      await readSnapshotArray(options.statePaths, \"CommonEvents.json\"),\n      options.declarations.filter(\n        (declaration): declaration is CommonEventDefinition => declaration.kind === \"commonEvent\",\n      ),\n      options.resolver,\n    ),\n  );\n\n  files.set(\n    \"System.json\",\n    materializeSystemCarrier(\n      await readSnapshotObject(options.statePaths, \"System.json\"),\n      options.declarations.filter(\n        (declaration): declaration is SwitchDefinition => declaration.kind === \"switchDefinition\",\n      ),\n      options.declarations.filter(\n        (declaration): declaration is VariableDefinition =>\n          declaration.kind === \"variableDefinition\",\n      ),\n    ),\n  );\n\n  assertCompileOutput(files, options.resolver, options.scriptEnabled);\n  return { files: new Map([...files].map(([path, value]) => [path, writeStableJson(value)])) };\n}\n\nexport async function publishCompileOutput(\n  statePaths: WorkspaceStatePaths,\n  candidate: CompileOutputCandidate,\n  assertInputsUnchanged: () => Promise<void>,\n): Promise<MaterializedCompileOutput> {\n  return writeGeneratedProjectData(statePaths, candidate.files, assertInputsUnchanged);\n}\n\nexport async function buildCompileBaseline(input: CompileBaselineInput): Promise<CompileBaseline> {\n  const sourceFiles =\n    input.sourceFileHashes === undefined\n      ? await Promise.all(\n          input.sourceFiles.map(async (filePath) => ({\n            hash: hashUtf8Content(await readFile(filePath, \"utf8\")),\n            relativePath: toPosixPath(relative(input.workspaceRoot, filePath)),\n          })),\n        )\n      : [...input.sourceFileHashes];\n  sourceFiles.sort((left, right) => left.relativePath.localeCompare(right.relativePath));\n\n  const snapshotFiles = [...input.snapshotFiles].sort((left, right) =>\n    left.relativePath.localeCompare(right.relativePath),\n  );\n  const config = {\n    scriptEnabled: input.config.scriptEnabled,\n    sourceExclude: [...input.config.sourceExclude],\n    sourceInclude: [...input.config.sourceInclude],\n    sourceRoot: input.config.sourceRoot,\n  };\n  const baselineWithoutHash = {\n    compileContractVersion,\n    typeInputs: [...(input.typeInputs ?? [])],\n    projectRootBinding: input.projectRootBinding,\n    config,\n    snapshotFiles,\n    sourceFiles,\n  };\n\n  return {\n    ...baselineWithoutHash,\n    hash: hashUtf8Content(writeStableJson(baselineWithoutHash)),\n  };\n}\n\nexport async function isCompileBaselineFresh(input: {\n  projectRootBinding: string;\n  baseline: CompileBaseline;\n  workspaceRoot: string;\n  config: WorkspaceConfig;\n  sourceFiles: readonly string[];\n  snapshotFiles: readonly FileHashEntry[];\n}): Promise<boolean> {\n  if (\n    input.baseline.compileContractVersion !== compileContractVersion ||\n    input.baseline.typeInputs === undefined ||\n    !typeInputsUnchanged(input.baseline.typeInputs)\n  )\n    return false;\n  try {\n    const currentBaseline = await buildCompileBaseline({\n      ...input,\n      typeInputs: input.baseline.typeInputs,\n    });\n    return currentBaseline.hash === input.baseline.hash;\n  } catch {\n    return false;\n  }\n}\n\nfunction materializeMapCarrier(\n  snapshotMapData: Record<string, unknown>,\n  definitions: readonly MapEventDefinition[],\n  resolver: ReferenceResolver,\n): Record<string, unknown> {\n  const snapshotEvents = Array.isArray(snapshotMapData.events) ? snapshotMapData.events : [];\n  const highestDefinitionId = highestId(definitions);\n  const length = Math.max(snapshotEvents.length, highestDefinitionId + 1, 1);\n  const events = createDenseArray<unknown>(length, null);\n\n  for (const definition of definitions) {\n    events[definition.id] = compileMapEvent(definition, {\n      nextId: definition.id,\n      resolver,\n    });\n  }\n\n  return {\n    ...snapshotMapData,\n    events,\n  };\n}\n\nfunction materializeCommonEventsCarrier(\n  snapshotCommonEvents: readonly unknown[],\n  definitions: readonly CommonEventDefinition[],\n  resolver: ReferenceResolver,\n): unknown[] {\n  const length = Math.max(snapshotCommonEvents.length, highestId(definitions) + 1, 1);\n  const output = createDenseArray<unknown>(length, null);\n\n  for (const definition of definitions) {\n    output[definition.id] = compileCommonEvent(definition, {\n      nextId: definition.id,\n      resolver,\n    });\n  }\n\n  return output;\n}\n\nfunction materializeSystemCarrier(\n  snapshotSystem: Record<string, unknown>,\n  switches: readonly SwitchDefinition[],\n  variables: readonly VariableDefinition[],\n): Record<string, unknown> {\n  return {\n    ...snapshotSystem,\n    switches: materializeSystemNames(snapshotSystem.switches, switches),\n    variables: materializeSystemNames(snapshotSystem.variables, variables),\n  };\n}\n\nfunction materializeSystemNames(\n  snapshotValue: unknown,\n  definitions: readonly (SwitchDefinition | VariableDefinition)[],\n): string[] {\n  const snapshotLength = Array.isArray(snapshotValue) ? snapshotValue.length : 0;\n  const length = Math.max(snapshotLength, highestId(definitions) + 1, 1);\n  const output = createDenseArray(length, \"\");\n\n  for (const definition of definitions) {\n    output[definition.id] = definition.name;\n  }\n\n  return output;\n}\n\nasync function writeGeneratedProjectData(\n  statePaths: WorkspaceStatePaths,\n  files: ReadonlyMap<string, string>,\n  assertInputsUnchanged?: () => Promise<void>,\n): Promise<MaterializedCompileOutput> {\n  const tempDirectory = resolve(\n    statePaths.workspaceStateDirectory,\n    `generated-project-data.tmp-${process.pid}-${randomUUID()}`,\n  );\n\n  await rm(tempDirectory, { force: true, recursive: true });\n  await mkdir(tempDirectory, { recursive: true });\n\n  try {\n    const generatedFiles: FileHashEntry[] = [];\n\n    for (const [relativePath, content] of [...files.entries()].sort(([left], [right]) =>\n      left.localeCompare(right),\n    )) {\n      const destinationPath = resolve(tempDirectory, relativePath);\n\n      await mkdir(dirname(destinationPath), { recursive: true });\n      await writeFile(destinationPath, content, \"utf8\");\n      generatedFiles.push({\n        hash: hashUtf8Content(content),\n        relativePath,\n      });\n    }\n\n    await assertInputsUnchanged?.();\n    await replaceDirectory(tempDirectory, statePaths.generatedProjectDataDirectory);\n\n    return { generatedFiles };\n  } catch (error) {\n    await rm(tempDirectory, { force: true, recursive: true });\n    throw error;\n  }\n}\n\nasync function readSnapshotFile(\n  statePaths: WorkspaceStatePaths,\n  relativePath: string,\n): Promise<string> {\n  return readProjectDataSnapshotFile(statePaths, relativePath);\n}\n\nasync function readSnapshotArray(\n  statePaths: WorkspaceStatePaths,\n  relativePath: string,\n): Promise<unknown[]> {\n  const parsed = JSON.parse(await readSnapshotFile(statePaths, relativePath));\n  if (!Array.isArray(parsed)) {\n    throw new Error(`Expected snapshot ${relativePath} to contain a JSON array.`);\n  }\n\n  return parsed;\n}\n\nasync function readSnapshotObject(\n  statePaths: WorkspaceStatePaths,\n  relativePath: string,\n): Promise<Record<string, unknown>> {\n  const parsed = JSON.parse(await readSnapshotFile(statePaths, relativePath));\n  if (!parsed || typeof parsed !== \"object\" || Array.isArray(parsed)) {\n    throw new Error(`Expected snapshot ${relativePath} to contain a JSON object.`);\n  }\n\n  return parsed as Record<string, unknown>;\n}\n\nfunction highestId(entries: readonly { id: number }[]): number {\n  return entries.reduce((highest, entry) => Math.max(highest, entry.id), 0);\n}\n\nfunction createDenseArray<T>(length: number, value: T): T[] {\n  return Array.from({ length }, () => value);\n}\n\nasync function replaceDirectory(sourceDirectory: string, targetDirectory: string): Promise<void> {\n  const backupDirectory = `${targetDirectory}.bak-${process.pid}-${randomUUID()}`;\n\n  await rm(backupDirectory, { force: true, recursive: true });\n\n  try {\n    await rename(targetDirectory, backupDirectory);\n  } catch (error) {\n    if (!isMissingFileError(error)) {\n      throw error;\n    }\n  }\n\n  try {\n    await rename(sourceDirectory, targetDirectory);\n  } catch (error) {\n    await rm(targetDirectory, { force: true, recursive: true });\n    try {\n      await rename(backupDirectory, targetDirectory);\n    } catch (restoreError) {\n      if (!isMissingFileError(restoreError)) {\n        throw restoreError;\n      }\n    }\n    throw error;\n  }\n\n  await rm(backupDirectory, { force: true, recursive: true });\n}\n\nfunction formatMapFileName(mapId: number): string {\n  return `Map${mapId.toString().padStart(3, \"0\")}.json`;\n}\n\nfunction toPosixPath(path: string): string {\n  return path.split(/[/\\\\]/u).join(posix.sep);\n}\n\nfunction isMissingFileError(error: unknown): boolean {\n  return (\n    error instanceof Error &&\n    \"code\" in error &&\n    typeof (error as { code?: unknown }).code === \"string\" &&\n    (error as { code?: string }).code === \"ENOENT\"\n  );\n}\n","import { isDeepStrictEqual } from \"node:util\";\n\nexport function describeMapEventChanges(generated: unknown, snapshot: unknown): string {\n  const changes: string[] = [];\n  const describe = (value: unknown, present: boolean) =>\n    present ? JSON.stringify(value) : \"<absent>\";\n  const visit = (\n    before: unknown,\n    after: unknown,\n    path: string,\n    beforePresent = true,\n    afterPresent = true,\n  ): void => {\n    if (beforePresent === afterPresent && isDeepStrictEqual(before, after)) return;\n    if (beforePresent && afterPresent && Array.isArray(before) && Array.isArray(after)) {\n      if (before.length !== after.length) visit(before.length, after.length, `${path}.length`);\n      for (let index = 0; index < Math.max(before.length, after.length); index++)\n        visit(\n          before[index],\n          after[index],\n          `${path}[${index}]`,\n          Object.hasOwn(before, index),\n          Object.hasOwn(after, index),\n        );\n      return;\n    }\n    if (\n      beforePresent &&\n      afterPresent &&\n      before &&\n      after &&\n      typeof before === \"object\" &&\n      typeof after === \"object\" &&\n      !Array.isArray(before) &&\n      !Array.isArray(after)\n    ) {\n      const left = before as Record<string, unknown>;\n      const right = after as Record<string, unknown>;\n      for (const key of [...new Set([...Object.keys(left), ...Object.keys(right)])].sort())\n        visit(\n          left[key],\n          right[key],\n          path ? `${path}.${key}` : key,\n          Object.hasOwn(left, key),\n          Object.hasOwn(right, key),\n        );\n      return;\n    }\n    const page = /^pages\\[(\\d+)\\]/u.exec(path);\n    changes.push(\n      `\\n  - ${path}${page ? ` (page ${Number(page[1]) + 1})` : \"\"}: ${describe(before, beforePresent)} -> ${describe(after, afterPresent)}`,\n    );\n  };\n  visit(snapshot, generated, \"\");\n  return changes.join(\"\");\n}\n","import { isDeepStrictEqual } from \"node:util\";\nimport { isCanonicalMapFileName } from \"./project.js\";\nimport { blankBattleEventPage } from \"../domain/battle-page-defaults.js\";\nimport { describeMapEventChanges } from \"./map-event-diff.js\";\n\nexport type StructuredDiffChangeKind =\n  | \"generated-only\"\n  | \"snapshot-only\"\n  | \"changed\"\n  | \"unchanged\"\n  | \"non-owned-carried\";\n\nexport type StructuredDiffEntry = {\n  change: StructuredDiffChangeKind;\n  destructive: boolean;\n  detail: string;\n  identity: string;\n  projectDataFile: string;\n};\n\nexport type StructuredDiffDomain = {\n  domain: string;\n  entries: StructuredDiffEntry[];\n};\n\nexport type StructuredDiffReport = {\n  domains: StructuredDiffDomain[];\n  hasDestructiveChanges: boolean;\n};\n\nexport type BuildStructuredDiffReportOptions = {\n  generated: ReadonlyMap<string, unknown>;\n  snapshot: ReadonlyMap<string, unknown>;\n};\n\nexport type RenderStructuredDiffReportOptions = {\n  affectedFiles?: readonly string[];\n  file?: string;\n  short?: boolean;\n};\n\ntype DomainEntryInput = {\n  generated: unknown;\n  identity: string;\n  projectDataFile: string;\n  snapshot: unknown;\n};\n\nexport function buildStructuredDiffReport(\n  options: BuildStructuredDiffReportOptions,\n): StructuredDiffReport {\n  const domains = [\n    buildMapEventDomain(options),\n    buildCommonEventDomain(options),\n    buildTroopEventDomain(options),\n    buildSystemNameDomain(options, {\n      arrayKey: \"switches\",\n      domain: \"Switch\",\n      identityPrefix: \"switchId\",\n    }),\n    buildSystemNameDomain(options, {\n      arrayKey: \"variables\",\n      domain: \"Variable\",\n      identityPrefix: \"variableId\",\n    }),\n    buildCarrierFileDomain(options),\n  ].filter((domain) => domain.entries.length > 0);\n\n  return {\n    domains,\n    hasDestructiveChanges: domains.some((domain) =>\n      domain.entries.some((entry) => entry.destructive),\n    ),\n  };\n}\n\nexport function deriveAffectedProjectDataFiles(input: {\n  generated: ReadonlyMap<string, unknown>;\n  snapshot: ReadonlyMap<string, unknown>;\n}): string[] {\n  return [...input.generated.keys()]\n    .filter(\n      (relativePath) =>\n        !isJsonEqual(input.generated.get(relativePath), input.snapshot.get(relativePath)),\n    )\n    .sort((left, right) => left.localeCompare(right));\n}\n\nexport function renderStructuredDiffReport(\n  report: StructuredDiffReport,\n  options: RenderStructuredDiffReportOptions = {},\n): string {\n  const filteredReport = options.file\n    ? filterReportByProjectDataFile(report, options.file)\n    : report;\n  const lines = [options.short ? \"Structured Diff Summary\" : \"Structured Diff Report\"];\n\n  if (options.file) {\n    lines.push(`Filter: Project Data File ${options.file}`);\n  }\n\n  if (options.short) {\n    pushSummaryLines(lines, filteredReport);\n  } else {\n    pushDetailedLines(lines, filteredReport, options.file);\n  }\n\n  if (options.affectedFiles) {\n    pushAffectedFileLines(lines, options.affectedFiles);\n  }\n\n  if (options.file) {\n    lines.push(\n      \"\",\n      `Destructive Changes In Filter: ${filteredReport.hasDestructiveChanges ? \"yes\" : \"no\"}`,\n      `Destructive Changes Overall: ${report.hasDestructiveChanges ? \"yes\" : \"no\"}`,\n    );\n  } else {\n    lines.push(\"\", `Destructive Changes: ${report.hasDestructiveChanges ? \"yes\" : \"no\"}`);\n  }\n\n  return lines.join(\"\\n\");\n}\n\nfunction filterReportByProjectDataFile(\n  report: StructuredDiffReport,\n  projectDataFile: string,\n): StructuredDiffReport {\n  const domains = report.domains\n    .map((domain) => ({\n      domain: domain.domain,\n      entries: domain.entries.filter((entry) => entry.projectDataFile === projectDataFile),\n    }))\n    .filter((domain) => domain.entries.length > 0);\n\n  return {\n    domains,\n    hasDestructiveChanges: domains.some((domain) =>\n      domain.entries.some((entry) => entry.destructive),\n    ),\n  };\n}\n\nfunction pushDetailedLines(\n  lines: string[],\n  report: StructuredDiffReport,\n  fileFilter: string | undefined,\n): void {\n  let visibleEntryCount = 0;\n\n  for (const domain of report.domains) {\n    const visibleEntries = domain.entries.filter(\n      (entry) => entry.change !== \"unchanged\" && entry.change !== \"non-owned-carried\",\n    );\n\n    if (visibleEntries.length === 0) {\n      continue;\n    }\n\n    visibleEntryCount += visibleEntries.length;\n    lines.push(\"\", domain.domain);\n    for (const entry of visibleEntries) {\n      const destructiveSuffix = entry.destructive ? \" (destructive)\" : \"\";\n      lines.push(`- [${entry.change}] ${entry.identity}${destructiveSuffix}: ${entry.detail}`);\n    }\n  }\n\n  if (visibleEntryCount === 0 && fileFilter) {\n    lines.push(\"\", \"No changes for selected Project Data File.\");\n  }\n}\n\nfunction pushSummaryLines(lines: string[], report: StructuredDiffReport): void {\n  const summaries = report.domains\n    .map((domain) => {\n      const counts = countVisibleChanges(domain.entries);\n      const parts = [\n        formatCount(counts.changed, \"changed\"),\n        formatCount(counts.generatedOnly, \"generated-only\"),\n        formatCount(counts.snapshotOnly, \"snapshot-only\"),\n      ].filter((part): part is string => part !== null);\n\n      return parts.length > 0 ? `${domain.domain}: ${parts.join(\", \")}` : null;\n    })\n    .filter((line): line is string => line !== null);\n\n  if (summaries.length === 0) {\n    lines.push(\"\", \"No changes.\");\n    return;\n  }\n\n  lines.push(\"\", ...summaries);\n}\n\nfunction countVisibleChanges(entries: readonly StructuredDiffEntry[]): {\n  changed: number;\n  generatedOnly: number;\n  snapshotOnly: number;\n} {\n  return entries.reduce(\n    (counts, entry) => {\n      if (entry.change === \"changed\") {\n        counts.changed += 1;\n      } else if (entry.change === \"generated-only\") {\n        counts.generatedOnly += 1;\n      } else if (entry.change === \"snapshot-only\") {\n        counts.snapshotOnly += 1;\n      }\n\n      return counts;\n    },\n    { changed: 0, generatedOnly: 0, snapshotOnly: 0 },\n  );\n}\n\nfunction formatCount(count: number, label: string): string | null {\n  return count > 0 ? `${count} ${label}` : null;\n}\n\nfunction pushAffectedFileLines(lines: string[], affectedFiles: readonly string[]): void {\n  lines.push(\"\", \"Affected Project Data Files:\");\n\n  if (affectedFiles.length === 0) {\n    lines.push(\"- none\");\n    return;\n  }\n\n  for (const affectedFile of affectedFiles) {\n    lines.push(`- ${affectedFile}`);\n  }\n}\n\nfunction buildMapEventDomain(options: BuildStructuredDiffReportOptions): StructuredDiffDomain {\n  const entries: StructuredDiffEntry[] = [];\n\n  for (const relativePath of sortedMapFilePaths(options)) {\n    const mapId = readMapId(\n      relativePath,\n      options.generated.get(relativePath),\n      options.snapshot.get(relativePath),\n    );\n    const generatedEvents = readArrayProperty(options.generated.get(relativePath), \"events\");\n    const snapshotEvents = readArrayProperty(options.snapshot.get(relativePath), \"events\");\n    const length = Math.max(generatedEvents.length, snapshotEvents.length);\n\n    for (let index = 1; index < length; index += 1) {\n      const entry = classifyOwnedEntry({\n        generated: generatedEvents[index],\n        identity: `mapId ${mapId}, eventId ${index}`,\n        projectDataFile: relativePath,\n        snapshot: snapshotEvents[index],\n      });\n      if (entry !== null) {\n        if (entry.change === \"changed\")\n          entry.detail += describeMapEventChanges(generatedEvents[index], snapshotEvents[index]);\n        entries.push(entry);\n      }\n    }\n  }\n\n  return {\n    domain: \"Map Event\",\n    entries,\n  };\n}\n\nfunction buildCommonEventDomain(options: BuildStructuredDiffReportOptions): StructuredDiffDomain {\n  const generated = readArray(options.generated.get(\"CommonEvents.json\"));\n  const snapshot = readArray(options.snapshot.get(\"CommonEvents.json\"));\n  const length = Math.max(generated.length, snapshot.length);\n  const entries: StructuredDiffEntry[] = [];\n\n  for (let index = 1; index < length; index += 1) {\n    const entry = classifyOwnedEntry({\n      generated: generated[index],\n      identity: `commonEventId ${index}`,\n      projectDataFile: \"CommonEvents.json\",\n      snapshot: snapshot[index],\n    });\n    if (entry !== null) {\n      entries.push(entry);\n    }\n  }\n\n  return {\n    domain: \"Common Event\",\n    entries,\n  };\n}\n\nfunction buildTroopEventDomain(options: BuildStructuredDiffReportOptions): StructuredDiffDomain {\n  const generated = readArray(options.generated.get(\"Troops.json\"));\n  const snapshot = readArray(options.snapshot.get(\"Troops.json\"));\n  const entries: StructuredDiffEntry[] = [];\n  for (let id = 1; id < Math.max(generated.length, snapshot.length); id += 1) {\n    if (!generated[id] && !snapshot[id]) continue;\n    const next = readObject(generated[id]).pages;\n    const old = readObject(snapshot[id]).pages;\n    const unchanged = isJsonEqual(next, old);\n    const reset = !unchanged && isJsonEqual(next, [blankBattleEventPage()]);\n    const oldPages = readArray(old),\n      nextPages = readArray(next);\n    const detail: string[] = [];\n    if (oldPages.length !== nextPages.length)\n      detail.push(`page count ${oldPages.length} → ${nextPages.length}`);\n    for (let page = 0; page < Math.max(oldPages.length, nextPages.length); page += 1) {\n      if (!isJsonEqual(oldPages[page], nextPages[page])) {\n        const paths = changedPaths(oldPages[page], nextPages[page], `pages[${page}]`);\n        detail.push(`page ${page + 1}: ${paths.join(\", \")}`);\n      }\n    }\n    entries.push({\n      change: unchanged ? \"unchanged\" : \"changed\",\n      destructive: reset,\n      identity: `troopId ${id}`,\n      projectDataFile: \"Troops.json\",\n      detail: unchanged\n        ? \"Generated Troop Event matches snapshot pages.\"\n        : `${reset ? \"Troop Event Reset\" : \"Troop Event changed\"}: ${detail.join(\"; \")}.`,\n    });\n  }\n  return { domain: \"Troop Event\", entries };\n}\n\nfunction changedPaths(old: unknown, next: unknown, path: string): string[] {\n  if (isJsonEqual(old, next)) return [];\n  if (old === null || next === null || typeof old !== \"object\" || typeof next !== \"object\")\n    return [path];\n  const left = old as Record<string, unknown>,\n    right = next as Record<string, unknown>;\n  return [...new Set([...Object.keys(left), ...Object.keys(right)])].flatMap((key) =>\n    changedPaths(\n      left[key],\n      right[key],\n      Array.isArray(old) && Array.isArray(next) ? `${path}[${key}]` : `${path}.${key}`,\n    ),\n  );\n}\n\nfunction buildSystemNameDomain(\n  options: BuildStructuredDiffReportOptions,\n  input: {\n    arrayKey: \"switches\" | \"variables\";\n    domain: string;\n    identityPrefix: string;\n  },\n): StructuredDiffDomain {\n  const generated = readArrayProperty(options.generated.get(\"System.json\"), input.arrayKey);\n  const snapshot = readArrayProperty(options.snapshot.get(\"System.json\"), input.arrayKey);\n  const length = Math.max(generated.length, snapshot.length);\n  const entries: StructuredDiffEntry[] = [];\n\n  for (let index = 1; index < length; index += 1) {\n    const entry = classifyOwnedEntry({\n      generated: normalizeSystemName(generated[index]),\n      identity: `${input.identityPrefix} ${index}`,\n      projectDataFile: \"System.json\",\n      snapshot: normalizeSystemName(snapshot[index]),\n    });\n    if (entry !== null) {\n      entries.push(entry);\n    }\n  }\n\n  return {\n    domain: input.domain,\n    entries,\n  };\n}\n\nfunction buildCarrierFileDomain(options: BuildStructuredDiffReportOptions): StructuredDiffDomain {\n  const entries: StructuredDiffEntry[] = [];\n\n  for (const relativePath of sortedCarrierFilePaths(options)) {\n    const generated = readCarrierDataWithoutOwnedDomains(\n      relativePath,\n      options.generated.get(relativePath),\n    );\n    const snapshot = readCarrierDataWithoutOwnedDomains(\n      relativePath,\n      options.snapshot.get(relativePath),\n    );\n\n    if (isJsonEqual(generated, snapshot)) {\n      entries.push({\n        change: \"non-owned-carried\",\n        destructive: false,\n        detail: \"Non-owned carrier data matches Project Data Snapshot.\",\n        identity: relativePath,\n        projectDataFile: relativePath,\n      });\n    } else {\n      entries.push({\n        change: \"changed\",\n        destructive: false,\n        detail: \"Non-owned carrier data differs from Project Data Snapshot.\",\n        identity: relativePath,\n        projectDataFile: relativePath,\n      });\n    }\n  }\n\n  return {\n    domain: \"Carrier File\",\n    entries,\n  };\n}\n\nfunction classifyOwnedEntry(input: DomainEntryInput): StructuredDiffEntry | null {\n  const generatedPresent = isOwnedEntryPresent(input.generated);\n  const snapshotPresent = isOwnedEntryPresent(input.snapshot);\n\n  if (generatedPresent && !snapshotPresent) {\n    return {\n      change: \"generated-only\",\n      destructive: false,\n      detail: \"Entry exists only in Generated Project Data.\",\n      identity: input.identity,\n      projectDataFile: input.projectDataFile,\n    };\n  }\n\n  if (!generatedPresent && snapshotPresent) {\n    return {\n      change: \"snapshot-only\",\n      destructive: true,\n      detail: \"Entry exists only in Project Data Snapshot.\",\n      identity: input.identity,\n      projectDataFile: input.projectDataFile,\n    };\n  }\n\n  if (!generatedPresent && !snapshotPresent) {\n    return null;\n  }\n\n  const unchanged = isJsonEqual(input.generated, input.snapshot);\n\n  return {\n    change: unchanged ? \"unchanged\" : \"changed\",\n    destructive: false,\n    detail: unchanged\n      ? \"Generated entry matches snapshot entry.\"\n      : \"Generated entry differs from snapshot entry.\",\n    identity: input.identity,\n    projectDataFile: input.projectDataFile,\n  };\n}\n\nfunction sortedMapFilePaths(options: BuildStructuredDiffReportOptions): string[] {\n  return [...new Set([...options.generated.keys(), ...options.snapshot.keys()])]\n    .filter(isCanonicalMapFileName)\n    .sort((left, right) => left.localeCompare(right));\n}\n\nfunction sortedCarrierFilePaths(options: BuildStructuredDiffReportOptions): string[] {\n  return [...new Set([...options.generated.keys(), ...options.snapshot.keys()])]\n    .filter(\n      (relativePath) =>\n        relativePath === \"System.json\" ||\n        relativePath === \"Troops.json\" ||\n        isCanonicalMapFileName(relativePath),\n    )\n    .sort((left, right) => left.localeCompare(right));\n}\n\nfunction readMapId(relativePath: string, generated: unknown, snapshot: unknown): number {\n  const generatedId = readObject(generated).id;\n  if (typeof generatedId === \"number\" && Number.isInteger(generatedId) && generatedId > 0) {\n    return generatedId;\n  }\n\n  const snapshotId = readObject(snapshot).id;\n  if (typeof snapshotId === \"number\" && Number.isInteger(snapshotId) && snapshotId > 0) {\n    return snapshotId;\n  }\n\n  return isCanonicalMapFileName(relativePath) ? Number(relativePath.slice(3, -5)) : 0;\n}\n\nfunction readCarrierDataWithoutOwnedDomains(relativePath: string, value: unknown): unknown {\n  if (relativePath === \"Troops.json\")\n    return readArray(value).map((entry) => {\n      if (entry === null) return null;\n      const record = { ...readObject(entry) };\n      delete record.pages;\n      return record;\n    });\n  if (relativePath === \"System.json\") {\n    const record = { ...readObject(value) };\n    delete record.switches;\n    delete record.variables;\n    return record;\n  }\n\n  if (isCanonicalMapFileName(relativePath)) {\n    const record = { ...readObject(value) };\n    delete record.events;\n    return record;\n  }\n\n  return value;\n}\n\nfunction readArrayProperty(value: unknown, key: string): unknown[] {\n  return readArray(readObject(value)[key]);\n}\n\nfunction readArray(value: unknown): unknown[] {\n  return Array.isArray(value) ? value : [];\n}\n\nfunction readObject(value: unknown): Record<string, unknown> {\n  if (!value || typeof value !== \"object\" || Array.isArray(value)) {\n    return {};\n  }\n\n  return value as Record<string, unknown>;\n}\n\nfunction normalizeSystemName(value: unknown): unknown {\n  return typeof value === \"string\" ? value : \"\";\n}\n\nfunction isOwnedEntryPresent(value: unknown): boolean {\n  if (value === null || value === undefined) {\n    return false;\n  }\n\n  if (typeof value === \"string\") {\n    return value.length > 0;\n  }\n\n  return true;\n}\n\nfunction isJsonEqual(left: unknown, right: unknown): boolean {\n  return isDeepStrictEqual(left, right);\n}\n","import { constants } from \"node:fs\";\nimport { mkdir, open, realpath } from \"node:fs/promises\";\nimport { resolve } from \"node:path\";\n\nimport { workspaceStateDirectoryName } from \"./state.js\";\n\n// libuv v1.51.0 include/uv/win.h: UV_FS_O_EXLOCK; src/win/fs.c opens\n// with share=0. Node accepts numeric open flags but does not expose this flag\n// in fs.constants. Supported on Windows since libuv 1.17.0; the verification\n// baseline is Node 22.23.0 / libuv 1.51.0.\nconst windowsExclusiveOpen = 0x10000000;\n\nexport async function withWorkspaceOperationLock<T>(\n  workspaceRoot: string,\n  commandName: string,\n  operation: () => Promise<T>,\n): Promise<T> {\n  if (process.platform !== \"win32\") {\n    throw new Error(\"Workspace operations currently require Windows for operation locking.\");\n  }\n\n  // Resolve aliases before taking the lease, without reading mutable Workspace\n  // configuration or data. A missing Workspace is never created by a command.\n  const root = await realpath(workspaceRoot);\n  const stateDirectory = resolve(root, workspaceStateDirectoryName);\n  await mkdir(stateDirectory, { recursive: true });\n  const lockPath = resolve(stateDirectory, \"operation.lock\");\n  const handle = await open(\n    lockPath,\n    constants.O_RDWR | constants.O_CREAT | windowsExclusiveOpen,\n    0o600,\n  ).catch((error: unknown) => {\n    if (error instanceof Error && \"code\" in error && error.code === \"EBUSY\") {\n      throw new Error(\n        `Workspace is busy before ${commandName}: ${root}. Retry after the active operation finishes.`,\n        {\n          cause: error,\n        },\n      );\n    }\n    throw error;\n  });\n\n  try {\n    return await operation();\n  } finally {\n    // Keep the file permanently. The live kernel handle is the lease; its\n    // release (including process death) proves that no prior owner holds it.\n    // Never unlink a stale pathname, which could remove another contender's\n    // replacement lease, and never inspect or clear Interrupted Push state.\n    await handle.close();\n  }\n}\n","import { stat } from \"node:fs/promises\";\n\nimport type { FileHashEntry } from \"../project-data/materialization.js\";\nimport {\n  collectStandardProjectDataSnapshotPlan,\n  readSyncManifest,\n  type SyncManifest,\n  type WorkspaceStatePaths,\n} from \"./state.js\";\nimport { isMissingFileError } from \"./guards.js\";\n\nexport async function assertProjectDataSnapshotExists(\n  statePaths: WorkspaceStatePaths,\n  commandName: string,\n  projectRootBinding: string,\n): Promise<SyncManifest> {\n  const manifest = await readSyncManifest(statePaths.syncManifestPath);\n  if (manifest === null) {\n    throw new Error(\n      `Project Data Snapshot is required before ${commandName}. Run clone or pull first.`,\n    );\n  }\n\n  const snapshotStats = await stat(statePaths.projectDataSnapshotDirectory).catch(\n    (error: unknown) => {\n      if (isMissingFileError(error)) {\n        return null;\n      }\n\n      throw error;\n    },\n  );\n\n  if (snapshotStats === null || !snapshotStats.isDirectory()) {\n    throw new Error(\n      `Project Data Snapshot is required before ${commandName}. Run clone or pull first.`,\n    );\n  }\n\n  assertProjectRootBinding(manifest, projectRootBinding, commandName);\n  const current = await readCurrentSnapshotFileHashes(statePaths, manifest.snapshotFiles).catch(\n    (error: unknown) => {\n      throw new Error(\n        `Unknown or inconsistent Snapshot before ${commandName}. Run pull to capture it again.`,\n        { cause: error },\n      );\n    },\n  );\n  const expected = [...manifest.snapshotFiles].sort((left, right) =>\n    left.relativePath.localeCompare(right.relativePath),\n  );\n  if (JSON.stringify(current) !== JSON.stringify(expected)) {\n    throw new Error(\n      `Unknown or inconsistent Snapshot before ${commandName}. Run pull to capture it again.`,\n    );\n  }\n  return manifest;\n}\n\nexport function assertProjectRootBinding(\n  manifest: SyncManifest,\n  projectRootBinding: string,\n  commandName: string,\n): void {\n  if (\n    manifest.projectRootBinding !== projectRootBinding ||\n    (manifest.compileBaseline !== undefined &&\n      manifest.compileBaseline.projectRootBinding !== projectRootBinding)\n  ) {\n    throw new Error(\n      `Project Root Binding mismatch before ${commandName}. Run pull explicitly to establish the configured target when no Interrupted Push is pending.`,\n    );\n  }\n}\n\nexport async function readCurrentSnapshotFileHashes(\n  statePaths: WorkspaceStatePaths,\n  _snapshotFiles: readonly FileHashEntry[],\n): Promise<FileHashEntry[]> {\n  const files = await collectStandardProjectDataSnapshotPlan(\n    statePaths.projectDataSnapshotDirectory,\n  );\n  return files.map(({ hash, relativePath }) => ({ hash, relativePath }));\n}\n","import { createHash, randomUUID } from \"node:crypto\";\nimport { mkdir, mkdtemp, readFile, readdir, rename, rm, writeFile } from \"node:fs/promises\";\nimport { join, resolve } from \"node:path\";\nimport { isDeepStrictEqual } from \"node:util\";\nimport {\n  expectedCompileOutputFileNames,\n  type FileHashEntry,\n} from \"../project-data/materialization.js\";\nimport { writeStableJson } from \"../project-data/writer.js\";\nimport { deriveAffectedProjectDataFiles } from \"../project-data/structured-diff.js\";\nimport { assertProjectRootBinding, readCurrentSnapshotFileHashes } from \"./checks.js\";\nimport type { LoadedWorkspace } from \"./config.js\";\nimport {\n  collectStandardProjectDataSnapshotPlan,\n  readPendingPushEvidence,\n  readSyncManifest,\n  writeSyncManifest,\n  type PendingPush,\n  type SyncManifest,\n  type WorkspaceStatePaths,\n} from \"./state.js\";\n\nconst hash = (bytes: Uint8Array | string) => createHash(\"sha256\").update(bytes).digest(\"hex\");\nconst same = isDeepStrictEqual;\nfunction ordered(value: unknown): unknown {\n  if (Array.isArray(value)) return value.map(ordered);\n  if (value !== null && typeof value === \"object\")\n    return Object.fromEntries(\n      Object.entries(value)\n        .sort(([a], [b]) => a.localeCompare(b))\n        .map(([key, item]) => [key, ordered(item)]),\n    );\n  return value;\n}\nconst manifestEvidenceHash = (manifest: SyncManifest) => hash(writeStableJson(ordered(manifest)));\nfunction fail(detail: string): never {\n  throw new Error(\n    `Interrupted Push ${detail}. Recovery stopped without changes to the Project Root.`,\n  );\n}\n\n/** Freeze the original compilation and synchronization basis before any Project Root replacement. */\nexport async function createPendingPushState(input: {\n  affectedFiles: readonly string[];\n  generatedFiles: readonly FileHashEntry[];\n  manifest: SyncManifest;\n  statePaths: WorkspaceStatePaths;\n}): Promise<void> {\n  const directory = await mkdtemp(\n    join(input.statePaths.workspaceStateDirectory, \"pending-push.tmp-\"),\n  );\n  try {\n    await mkdir(join(directory, \"backup\"));\n    const affectedFiles: PendingPush[\"affectedFiles\"] = [];\n    for (const relativePath of input.affectedFiles) {\n      const snapshotHash = input.manifest.snapshotFiles.find(\n        (entry) => entry.relativePath === relativePath,\n      )?.hash;\n      const generatedHash = input.generatedFiles.find(\n        (entry) => entry.relativePath === relativePath,\n      )?.hash;\n      if (!snapshotHash || !generatedHash) fail(`cannot prepare ${relativePath}`);\n      const content = await readFile(\n        resolve(input.statePaths.projectDataSnapshotDirectory, relativePath),\n      );\n      if (hash(content) !== snapshotHash) fail(`Snapshot changed while preparing ${relativePath}`);\n      await writeFile(join(directory, \"backup\", relativePath), content, { flag: \"wx\" });\n      affectedFiles.push({\n        relativePath,\n        backupRelativePath: relativePath,\n        backupHash: snapshotHash,\n        snapshotHash,\n        generatedHash,\n      });\n    }\n    await writeFile(\n      join(directory, \"pending-push.json\"),\n      writeStableJson({\n        version: 3,\n        projectRootBinding: input.manifest.projectRootBinding,\n        startedAt: new Date().toISOString(),\n        originalManifest: input.manifest,\n        originalManifestHash: manifestEvidenceHash(input.manifest),\n        affectedFiles,\n      }),\n      { flag: \"wx\" },\n    );\n    await rename(directory, input.statePaths.pendingPushDirectory);\n  } catch (error) {\n    await rm(directory, { recursive: true, force: true });\n    throw error;\n  }\n}\n\nfunction baselineBasis(\n  baseline: NonNullable<SyncManifest[\"compileBaseline\"]>,\n  snapshotFiles = baseline.snapshotFiles,\n) {\n  return {\n    ...(baseline.compileContractVersion === undefined\n      ? {}\n      : { compileContractVersion: baseline.compileContractVersion }),\n    ...(baseline.typeInputs === undefined ? {} : { typeInputs: baseline.typeInputs }),\n    projectRootBinding: baseline.projectRootBinding,\n    config: baseline.config,\n    snapshotFiles,\n    sourceFiles: baseline.sourceFiles,\n  };\n}\nfunction completedManifest(pending: PendingPush): SyncManifest {\n  const original = pending.originalManifest;\n  const changed = new Map(\n    pending.affectedFiles.map((entry) => [entry.relativePath, entry.generatedHash]),\n  );\n  const snapshotFiles = original.snapshotFiles.map((entry) => ({\n    ...entry,\n    hash: changed.get(entry.relativePath) ?? entry.hash,\n  }));\n  const baseline = original.compileBaseline!;\n  const rewritten = baselineBasis(baseline, snapshotFiles);\n  return {\n    ...original,\n    snapshotFiles,\n    compileBaseline: { ...rewritten, hash: hash(writeStableJson(rewritten)) },\n  };\n}\n\n/** Both normal Push and recovery use the same content-proven, deterministic local finalization. */\nexport async function resolvePendingInterruptedPushForPush(input: {\n  workspace: LoadedWorkspace;\n  statePaths: WorkspaceStatePaths;\n}): Promise<void> {\n  try {\n    await resolvePending(input);\n  } catch (error) {\n    if (error instanceof Error && error.message.includes(\"Interrupted Push\")) throw error;\n    throw new Error(\n      `Interrupted Push recovery failed: ${error instanceof Error ? error.message : String(error)}. Preserve the pending evidence and restore its original files before retrying.`,\n      { cause: error },\n    );\n  }\n}\n\nasync function resolvePending(input: {\n  workspace: LoadedWorkspace;\n  statePaths: WorkspaceStatePaths;\n}): Promise<void> {\n  const paths = input.statePaths;\n  const evidence = await readPendingPushEvidence(paths.pendingPushManifestPath);\n  if (evidence === null) return;\n  const { pending, bytes: pendingBytes } = evidence;\n  if (pending.projectRootBinding !== input.workspace.projectRootBinding)\n    fail(\"Project Root Binding mismatch; return to the original configured target before recovery\");\n  const original = pending.originalManifest;\n  assertProjectRootBinding(\n    original,\n    input.workspace.projectRootBinding,\n    \"Interrupted Push recovery\",\n  );\n  const baseline = original.compileBaseline;\n  if (\n    !baseline ||\n    !original.generatedFiles ||\n    manifestEvidenceHash(original) !== pending.originalManifestHash\n  )\n    fail(\"original compilation evidence is inconsistent\");\n  if (\n    hash(writeStableJson(baselineBasis(baseline))) !== baseline.hash ||\n    baseline.projectRootBinding !== original.projectRootBinding ||\n    !same(baseline.snapshotFiles, original.snapshotFiles)\n  )\n    fail(\"original Compile Baseline is inconsistent\");\n  const oldHashes = new Map(\n    original.snapshotFiles.map((entry) => [entry.relativePath, entry.hash]),\n  );\n  const newHashes = new Map(\n    original.generatedFiles.map((entry) => [entry.relativePath, entry.hash]),\n  );\n  const seen = new Set<string>();\n  const backups = new Map<string, Buffer>();\n  for (const entry of pending.affectedFiles) {\n    if (\n      seen.has(entry.relativePath) ||\n      entry.backupRelativePath !== entry.relativePath ||\n      entry.snapshotHash !== oldHashes.get(entry.relativePath) ||\n      entry.generatedHash !== newHashes.get(entry.relativePath) ||\n      entry.backupHash !== entry.snapshotHash\n    )\n      fail(`metadata is inconsistent for ${entry.relativePath}`);\n    seen.add(entry.relativePath);\n    const bytes = await readFile(join(paths.pendingPushBackupDirectory, entry.backupRelativePath));\n    if (hash(bytes) !== entry.snapshotHash)\n      fail(\n        `backup integrity check failed for ${entry.relativePath}; restore the original recovery evidence`,\n      );\n    backups.set(entry.relativePath, bytes);\n  }\n  const next = completedManifest(pending);\n  let current = await readSyncManifest(paths.syncManifestPath);\n  const alreadyCommitted = same(current, next);\n  if (!same(current, original) && !alreadyCommitted)\n    fail(\"Sync Manifest is neither the original nor the completed operation\");\n  const snapshot = await collectStandardProjectDataSnapshotPlan(paths.projectDataSnapshotDirectory);\n  if (\n    snapshot.length !== original.snapshotFiles.length ||\n    snapshot.some((entry) => !oldHashes.has(entry.relativePath))\n  )\n    fail(\"Snapshot file set is inconsistent\");\n  const expectedSnapshot = new Map(snapshot.map((entry) => [entry.relativePath, entry.hash]));\n  const expectedNames = await expectedCompileOutputFileNames(paths);\n  const listed = original.generatedFiles.map((entry) => entry.relativePath).sort();\n  // Before Troop ownership, /1 through /6 emitted the complete Common/System/Map\n  // set. Its v3 frozen evidence is understood without inventing a Troops output\n  // or upgrading the original compilation basis. Every other subset still fails.\n  const priorContract = baseline.compileContractVersion;\n  const understoodPriorSet =\n    (priorContract === undefined || /^mv-1\\.6\\.1\\/[1-6]$/u.test(priorContract)) &&\n    same(\n      listed,\n      expectedNames.filter((name) => name !== \"Troops.json\"),\n    );\n  const actualEntries = await readdir(paths.generatedProjectDataDirectory, { withFileTypes: true });\n  if (\n    (!same(listed, expectedNames) && !understoodPriorSet) ||\n    !same(actualEntries.map((entry) => entry.name).sort(), listed) ||\n    actualEntries.some((entry) => !entry.isFile())\n  )\n    fail(\"generated file set is inconsistent\");\n  const generated = new Map<string, Buffer>();\n  for (const entry of original.generatedFiles) {\n    const bytes = await readFile(resolve(paths.generatedProjectDataDirectory, entry.relativePath));\n    if (hash(bytes) !== entry.hash)\n      fail(\n        `generated data integrity check failed for ${entry.relativePath}; restore the original recovery evidence`,\n      );\n    generated.set(entry.relativePath, bytes);\n  }\n  const originalData = new Map<string, unknown>();\n  const generatedData = new Map<string, unknown>();\n  try {\n    for (const [name, bytes] of generated) {\n      const old =\n        backups.get(name) ?? snapshot.find((entry) => entry.relativePath === name)?.content;\n      if (old === undefined) fail(`original Snapshot is missing ${name}`);\n      originalData.set(name, JSON.parse(new TextDecoder(\"utf-8\", { fatal: true }).decode(old)));\n      generatedData.set(name, JSON.parse(new TextDecoder(\"utf-8\", { fatal: true }).decode(bytes)));\n    }\n  } catch (error) {\n    fail(\n      `data evidence cannot be interpreted: ${error instanceof Error ? error.message : String(error)}`,\n    );\n  }\n  if (\n    !same(\n      [...seen].sort(),\n      deriveAffectedProjectDataFiles({ generated: generatedData, snapshot: originalData }).sort(),\n    )\n  )\n    fail(\"affected file set is inconsistent with the original operation\");\n  const states = await Promise.all(\n    pending.affectedFiles.map(async (entry) => {\n      const bytes = await readFile(\n        resolve(input.workspace.dataDirectory, entry.relativePath),\n      ).catch(() => null);\n      const digest = bytes === null ? null : hash(bytes);\n      return digest === entry.generatedHash\n        ? \"generated\"\n        : digest === entry.snapshotHash\n          ? \"snapshot\"\n          : bytes === null\n            ? \"missing\"\n            : \"unknown\";\n    }),\n  );\n  const allGenerated = states.every((state) => state === \"generated\");\n  const allSnapshot = states.every((state) => state === \"snapshot\");\n  if (!allGenerated && !allSnapshot)\n    throw new Error(\n      [\n        \"Interrupted Push cannot be recovered automatically.\",\n        \"Restore affected Project Root files to either the pending backup state or Generated Project Data, then run push again.\",\n        ...pending.affectedFiles.map((entry, i) => `- ${entry.relativePath}: ${states[i]}`),\n      ].join(\"\\n\"),\n    );\n  for (const entry of snapshot) {\n    const old = oldHashes.get(entry.relativePath);\n    const final = seen.has(entry.relativePath) ? newHashes.get(entry.relativePath) : old;\n    if (\n      alreadyCommitted\n        ? entry.hash !== final\n        : entry.hash !== old &&\n          !(allGenerated && seen.has(entry.relativePath) && entry.hash === final)\n    )\n      fail(`Snapshot evidence is inconsistent for ${entry.relativePath}`);\n  }\n  if (allSnapshot && alreadyCommitted)\n    fail(\"all-Snapshot live contents contradict a completed manifest\");\n\n  async function assertEvidenceUnchanged() {\n    if (\n      !(await readFile(paths.pendingPushManifestPath)).equals(pendingBytes) ||\n      !same(await readSyncManifest(paths.syncManifestPath), current)\n    )\n      fail(\"recovery metadata changed before publication\");\n    const actual = await readCurrentSnapshotFileHashes(paths, original.snapshotFiles);\n    if (\n      actual.length !== expectedSnapshot.size ||\n      actual.some((entry) => entry.hash !== expectedSnapshot.get(entry.relativePath))\n    )\n      fail(\"Snapshot changed before publication\");\n    const entries = await readdir(paths.generatedProjectDataDirectory, { withFileTypes: true });\n    if (\n      !same(entries.map((entry) => entry.name).sort(), listed) ||\n      entries.some((entry) => !entry.isFile())\n    )\n      fail(\"generated file set changed before publication\");\n    for (const entry of original.generatedFiles!)\n      if (\n        hash(await readFile(resolve(paths.generatedProjectDataDirectory, entry.relativePath))) !==\n        entry.hash\n      )\n        fail(`generated data changed before publication for ${entry.relativePath}`);\n    for (const entry of pending!.affectedFiles) {\n      if (\n        hash(await readFile(join(paths.pendingPushBackupDirectory, entry.backupRelativePath))) !==\n        entry.snapshotHash\n      )\n        fail(`backup changed before publication for ${entry.relativePath}`);\n      const expected = allGenerated ? entry.generatedHash : entry.snapshotHash;\n      if (\n        hash(await readFile(resolve(input.workspace.dataDirectory, entry.relativePath))) !==\n        expected\n      )\n        fail(`Project Root changed during recovery for ${entry.relativePath}`);\n    }\n  }\n  await assertEvidenceUnchanged();\n  if (allGenerated && !alreadyCommitted) {\n    for (const entry of pending.affectedFiles) {\n      if (expectedSnapshot.get(entry.relativePath) === entry.generatedHash) continue;\n      const target = resolve(paths.projectDataSnapshotDirectory, entry.relativePath);\n      const temporary = `${target}.push-${randomUUID()}`;\n      try {\n        const bytes = generated.get(entry.relativePath)!;\n        await writeFile(temporary, bytes, { flag: \"wx\" });\n        if (hash(await readFile(temporary)) !== entry.generatedHash)\n          fail(`Snapshot candidate changed for ${entry.relativePath}`);\n        await assertEvidenceUnchanged();\n        await rename(temporary, target);\n        expectedSnapshot.set(entry.relativePath, entry.generatedHash);\n      } finally {\n        await rm(temporary, { force: true });\n      }\n    }\n    await writeSyncManifest(paths.syncManifestPath, next, assertEvidenceUnchanged);\n    current = next;\n  }\n  await assertEvidenceUnchanged();\n  const retired = await mkdtemp(join(paths.workspaceStateDirectory, \"pending-push.retired-\"));\n  await assertEvidenceUnchanged();\n  await rename(paths.pendingPushDirectory, join(retired, \"operation\"));\n  try {\n    await rm(retired, { recursive: true, force: true });\n  } catch (error) {\n    throw new Error(\n      `Interrupted Push pending state retired, but evidence cleanup failed at ${retired}. Synchronization records were preserved.`,\n      { cause: error },\n    );\n  }\n}\n","import { link, mkdir, readFile, readdir, rename, rm, stat, writeFile } from \"node:fs/promises\";\nimport { withWorkspaceOperationLock } from \"./operation-lock.js\";\nimport { dirname, resolve } from \"node:path\";\nimport { createHash, randomUUID } from \"node:crypto\";\n\nimport { discoverDefinitionFiles } from \"./definitions.js\";\nimport {\n  isCompileBaselineFresh,\n  expectedCompileOutputFileNames,\n  type FileHashEntry,\n} from \"../project-data/materialization.js\";\nimport {\n  getWorkspaceStatePaths,\n  readPendingPush,\n  type SyncManifest,\n  type WorkspaceStatePaths,\n} from \"./state.js\";\nimport {\n  buildStructuredDiffReport,\n  deriveAffectedProjectDataFiles,\n} from \"../project-data/structured-diff.js\";\nimport { loadWorkspace, type LoadedWorkspace } from \"./config.js\";\nimport type { PushWorkspaceOptions } from \"./types.js\";\nimport { assertProjectDataSnapshotExists, readCurrentSnapshotFileHashes } from \"./checks.js\";\nimport { isMissingFileError } from \"./guards.js\";\nimport { isCanonicalMapFileName } from \"../project-data/project.js\";\n\nimport { createPendingPushState, resolvePendingInterruptedPushForPush } from \"./push-recovery.js\";\n\nasync function readFileHashOrNull(filePath: string): Promise<string | null> {\n  try {\n    return createHash(\"sha256\")\n      .update(await readFile(filePath))\n      .digest(\"hex\");\n  } catch (error) {\n    if (isMissingFileError(error)) return null;\n    throw error;\n  }\n}\n\nexport async function assertNoPendingInterruptedPushForNonPush(input: {\n  statePaths: WorkspaceStatePaths;\n  commandName: string;\n}): Promise<void> {\n  const pendingPush = await readPendingPush(input.statePaths.pendingPushManifestPath);\n  if (pendingPush === null) {\n    return;\n  }\n\n  throw new Error(\n    `Interrupted Push is pending before ${input.commandName}. Run push to resolve it before running other workspace commands.`,\n  );\n}\n\nexport function assertKnownSafeProjectDataFile(\n  relativePath: string,\n  generatedFiles: readonly FileHashEntry[],\n): void {\n  const knownFiles = new Set(generatedFiles.map((entry) => entry.relativePath));\n  if (!isSafeProjectDataFileName(relativePath) || !knownFiles.has(relativePath)) {\n    throw new Error(`Unknown or unsafe Project Data File for diff --file: ${relativePath}.`);\n  }\n}\n\nexport async function assertGeneratedProjectDataIntegrity(\n  statePaths: WorkspaceStatePaths,\n  manifest: SyncManifest,\n  commandName: string,\n): Promise<void> {\n  if (manifest.generatedFiles === undefined || manifest.compileBaseline === undefined) {\n    throw new Error(`Generated Project Data is required before ${commandName}. Run compile first.`);\n  }\n\n  const generatedStats = await stat(statePaths.generatedProjectDataDirectory).catch(\n    (error: unknown) => {\n      if (isMissingFileError(error)) {\n        return null;\n      }\n\n      throw error;\n    },\n  );\n\n  if (generatedStats === null || !generatedStats.isDirectory()) {\n    throw new Error(`Generated Project Data is required before ${commandName}. Run compile first.`);\n  }\n\n  const expectedNames = await expectedCompileOutputFileNames(statePaths);\n  const listedNames = manifest.generatedFiles.map(({ relativePath }) => relativePath).sort();\n  const actualEntries = await readdir(statePaths.generatedProjectDataDirectory, {\n    withFileTypes: true,\n  });\n  const actualNames = actualEntries.map(({ name }) => name).sort();\n  if (\n    JSON.stringify(expectedNames) !== JSON.stringify(listedNames) ||\n    JSON.stringify(expectedNames) !== JSON.stringify(actualNames) ||\n    actualEntries.some((entry) => !entry.isFile())\n  ) {\n    throw new Error(\n      `Generated Project Data integrity check failed before ${commandName}: incomplete or unexpected owned output file set. Run compile first.`,\n    );\n  }\n\n  const currentGeneratedFiles = await Promise.all(\n    manifest.generatedFiles.map(async ({ relativePath }) => ({\n      hash: createHash(\"sha256\")\n        .update(await readFile(resolve(statePaths.generatedProjectDataDirectory, relativePath)))\n        .digest(\"hex\"),\n      relativePath,\n    })),\n  );\n  currentGeneratedFiles.sort((left, right) => left.relativePath.localeCompare(right.relativePath));\n\n  const expectedGeneratedFiles = [...manifest.generatedFiles].sort((left, right) =>\n    left.relativePath.localeCompare(right.relativePath),\n  );\n\n  if (JSON.stringify(currentGeneratedFiles) !== JSON.stringify(expectedGeneratedFiles)) {\n    throw new Error(\n      `Generated Project Data integrity check failed before ${commandName}. Run compile first.`,\n    );\n  }\n}\n\nexport async function readJsonFiles(\n  directory: string,\n  files: readonly FileHashEntry[],\n): Promise<Map<string, unknown>> {\n  const entries = await Promise.all(\n    files.map(\n      async ({ relativePath }) =>\n        [\n          relativePath,\n          JSON.parse(await readFile(resolve(directory, relativePath), \"utf8\")),\n        ] as const,\n    ),\n  );\n\n  return new Map(entries);\n}\n\nexport async function pushWorkspace(options: PushWorkspaceOptions): Promise<void> {\n  await withWorkspaceOperationLock(\n    options.workspaceRoot,\n    options.allowDestructive ? \"push --allow-destructive\" : \"push\",\n    () => pushWorkspaceUnlocked(options),\n  );\n}\n\nasync function pushWorkspaceUnlocked(options: PushWorkspaceOptions): Promise<void> {\n  const commandName = options.allowDestructive ? \"push --allow-destructive\" : \"push\";\n  const workspace = await loadWorkspace(options.workspaceRoot);\n  const statePaths = getWorkspaceStatePaths(workspace.workspaceRoot);\n\n  await resolvePendingInterruptedPushForPush({ workspace, statePaths });\n\n  const manifest = await assertProjectDataSnapshotExists(\n    statePaths,\n    commandName,\n    workspace.projectRootBinding,\n  );\n\n  await assertGeneratedProjectDataIntegrity(statePaths, manifest, commandName);\n  await assertGeneratedProjectDataFresh({\n    commandName,\n    manifest,\n    statePaths,\n    workspace,\n  });\n\n  const generatedFiles = manifest.generatedFiles ?? [];\n  const generated = await readJsonFiles(statePaths.generatedProjectDataDirectory, generatedFiles);\n  const snapshot = await readJsonFiles(statePaths.projectDataSnapshotDirectory, generatedFiles);\n  const report = buildStructuredDiffReport({ generated, snapshot });\n\n  if (report.hasDestructiveChanges && !options.allowDestructive) {\n    throw new Error(\n      \"Destructive Changes detected before push. Re-run with --allow-destructive after review.\",\n    );\n  }\n\n  const affectedFiles = deriveAffectedProjectDataFiles({ generated, snapshot });\n  await assertNoProjectDrift({\n    expectedFiles: manifest.snapshotFiles,\n    dataDirectory: workspace.dataDirectory,\n  });\n  if (affectedFiles.length === 0) {\n    return;\n  }\n\n  const stagedWrite = await stageProjectRootWrites({\n    affectedFiles,\n    generatedFiles,\n    dataDirectory: workspace.dataDirectory,\n    statePaths,\n  });\n  const writtenFiles: string[] = [];\n  const snapshotHashes = new Map(\n    manifest.snapshotFiles.map((entry) => [entry.relativePath, entry.hash]),\n  );\n\n  try {\n    await createPendingPushState({ affectedFiles, generatedFiles, manifest, statePaths });\n    await assertNoProjectDrift({\n      expectedFiles: manifest.snapshotFiles,\n      dataDirectory: workspace.dataDirectory,\n    });\n    for (const stagedFile of stagedWrite.files) {\n      const expectedHash = snapshotHashes.get(stagedFile.relativePath);\n      if (expectedHash === undefined) {\n        throw new Error(\n          `Project Drift detected before push for ${stagedFile.relativePath}. Run pull first.`,\n        );\n      }\n      await replaceProjectRootFile(stagedFile, expectedHash);\n      writtenFiles.push(stagedFile.relativePath);\n    }\n    const generatedHashes = new Map(\n      generatedFiles.map(({ relativePath, hash }) => [relativePath, hash]),\n    );\n    await assertNoProjectDrift({\n      dataDirectory: workspace.dataDirectory,\n      expectedFiles: manifest.snapshotFiles.map((entry) =>\n        writtenFiles.includes(entry.relativePath)\n          ? { ...entry, hash: generatedHashes.get(entry.relativePath)! }\n          : entry,\n      ),\n    });\n  } catch (error) {\n    if (!(error instanceof RetainedProjectRootObjectError)) {\n      await rm(stagedWrite.directory, { force: true, recursive: true });\n    }\n    const written = writtenFiles.length > 0 ? writtenFiles.join(\", \") : \"none\";\n    throw new Error(\n      `Project Root replacement failed during push after writing: ${written}. ${error instanceof Error ? error.message : String(error)}`,\n      { cause: error },\n    );\n  }\n\n  await rm(stagedWrite.directory, { force: true, recursive: true });\n  await resolvePendingInterruptedPushForPush({ workspace, statePaths });\n}\n\nasync function assertGeneratedProjectDataFresh(input: {\n  commandName: string;\n  manifest: SyncManifest;\n  statePaths: WorkspaceStatePaths;\n  workspace: LoadedWorkspace;\n}): Promise<void> {\n  const files = await discoverDefinitionFiles(input.workspace.workspaceRoot, {\n    sourceRoot: input.workspace.config.sourceRoot,\n    sourceInclude: input.workspace.config.sourceInclude,\n    sourceExclude: input.workspace.config.sourceExclude,\n  });\n  const snapshotFiles = await readCurrentSnapshotFileHashes(\n    input.statePaths,\n    input.manifest.snapshotFiles,\n  );\n\n  if (\n    input.manifest.compileBaseline === undefined ||\n    !(await isCompileBaselineFresh({\n      projectRootBinding: input.workspace.projectRootBinding,\n      baseline: input.manifest.compileBaseline,\n      config: input.workspace.config,\n      snapshotFiles,\n      sourceFiles: files,\n      workspaceRoot: input.workspace.workspaceRoot,\n    }))\n  ) {\n    throw new Error(\n      `Generated Project Data is stale before ${input.commandName}. Run compile first.`,\n    );\n  }\n}\n\nasync function assertNoProjectDrift(input: {\n  expectedFiles: readonly FileHashEntry[];\n  dataDirectory: string;\n}): Promise<void> {\n  for (const { relativePath, hash: expectedHash } of input.expectedFiles) {\n    const currentHash = await readProjectRootFileHash(input.dataDirectory, relativePath);\n    if (currentHash !== expectedHash) {\n      throw new Error(`Project Drift detected before push for ${relativePath}. Run pull first.`);\n    }\n  }\n}\n\nasync function readProjectRootFileHash(\n  dataDirectory: string,\n  relativePath: string,\n): Promise<string> {\n  try {\n    return createHash(\"sha256\")\n      .update(await readFile(resolve(dataDirectory, relativePath)))\n      .digest(\"hex\");\n  } catch (error) {\n    throw new Error(`Project Drift detected before push for ${relativePath}. Run pull first.`, {\n      cause: error,\n    });\n  }\n}\n\nasync function stageProjectRootWrites(input: {\n  affectedFiles: readonly string[];\n  generatedFiles: readonly FileHashEntry[];\n  dataDirectory: string;\n  statePaths: WorkspaceStatePaths;\n}): Promise<{\n  directory: string;\n  files: Array<{\n    relativePath: string;\n    stagedPath: string;\n    targetPath: string;\n    originalPath: string;\n  }>;\n}> {\n  const stagingDirectory = resolve(\n    input.dataDirectory,\n    `push-staging.tmp-${process.pid}-${randomUUID()}`,\n  );\n  const files: Array<{\n    relativePath: string;\n    stagedPath: string;\n    targetPath: string;\n    originalPath: string;\n  }> = [];\n\n  await rm(stagingDirectory, { force: true, recursive: true });\n  await mkdir(stagingDirectory, { recursive: true });\n\n  try {\n    for (const relativePath of input.affectedFiles) {\n      const generatedPath = resolve(input.statePaths.generatedProjectDataDirectory, relativePath);\n      const stagedPath = resolve(stagingDirectory, relativePath);\n\n      await mkdir(dirname(stagedPath), { recursive: true });\n      const content = await readFile(generatedPath);\n      if (\n        createHash(\"sha256\").update(content).digest(\"hex\") !==\n        input.generatedFiles.find((entry) => entry.relativePath === relativePath)?.hash\n      )\n        throw new Error(\n          `Generated Project Data changed while staging ${relativePath}. Run compile first.`,\n        );\n      await writeFile(stagedPath, content);\n      files.push({\n        originalPath: resolve(stagingDirectory, \"original\", relativePath),\n        relativePath,\n        stagedPath,\n        targetPath: resolve(input.dataDirectory, relativePath),\n      });\n    }\n  } catch (error) {\n    await rm(stagingDirectory, { force: true, recursive: true });\n    throw new Error(\"Failed to stage Project Root writes before push.\", { cause: error });\n  }\n\n  return {\n    directory: stagingDirectory,\n    files,\n  };\n}\n\nclass RetainedProjectRootObjectError extends Error {\n  constructor(originalPath: string, error: unknown, restoreError: unknown) {\n    super(\n      `Captured Project Root object retained at ${originalPath}; non-overwriting restoration failed. ${error instanceof Error ? error.message : String(error)} Restoration: ${restoreError instanceof Error ? restoreError.message : String(restoreError)}`,\n      { cause: error },\n    );\n  }\n}\n\nasync function replaceProjectRootFile(\n  stagedFile: {\n    relativePath: string;\n    stagedPath: string;\n    targetPath: string;\n    originalPath: string;\n  },\n  expectedHash: string,\n): Promise<void> {\n  let replacementInstalled = false;\n  let originalCaptured = false;\n  await mkdir(dirname(stagedFile.originalPath), { recursive: true });\n  try {\n    await rename(stagedFile.targetPath, stagedFile.originalPath);\n    originalCaptured = true;\n    const capturedHash = await readFileHashOrNull(stagedFile.originalPath);\n    if (capturedHash !== expectedHash) {\n      throw new Error(\n        `Project Drift detected during push for ${stagedFile.relativePath}. Run pull first.`,\n      );\n    }\n\n    // Both files are on the Project data volume. link refuses an existing target\n    // atomically, including arrivals after the preceding content checks.\n    await link(stagedFile.stagedPath, stagedFile.targetPath);\n    replacementInstalled = true;\n    await rm(stagedFile.stagedPath);\n  } catch (error) {\n    if (originalCaptured && !replacementInstalled) {\n      try {\n        await link(stagedFile.originalPath, stagedFile.targetPath);\n        await rm(stagedFile.originalPath);\n      } catch (restoreError) {\n        // Captured bytes may be an external edit absent from the Snapshot backup.\n        // Retain this object and the staging directory if it cannot be restored.\n        throw new RetainedProjectRootObjectError(stagedFile.originalPath, error, restoreError);\n      }\n    }\n    throw error;\n  }\n\n  await rm(stagedFile.originalPath, { force: true });\n}\n\nfunction isSafeProjectDataFileName(relativePath: string): boolean {\n  return (\n    relativePath === \"CommonEvents.json\" ||\n    relativePath === \"Troops.json\" ||\n    relativePath === \"System.json\" ||\n    isCanonicalMapFileName(relativePath)\n  );\n}\n","import * as ts from \"typescript\";\nimport * as dsl from \"../authoring/index.js\";\n\ntype ObjectValue = { object: true; field: (key: string) => Value };\ntype HelperValue = { helper: string };\nconst missing = Symbol(\"absent own identity field\");\ntype Value =\n  | string\n  | number\n  | boolean\n  | null\n  | undefined\n  | typeof missing\n  | ObjectValue\n  | HelperValue\n  | { opaque: true };\nconst opaque = { opaque: true } as const;\nconst declarationKinds: Record<string, string> = {\n  mapEvent: \"mapEvent\",\n  commonEvent: \"commonEvent\",\n  troopEvent: \"troopEvent\",\n  switchDefinition: \"switchDefinition\",\n  variableDefinition: \"variableDefinition\",\n};\n\n/** Read only declaration identity; unrelated fields and command constructors are never evaluated. */\nexport function definitionIdentities(filePath: string, text: string): string[] {\n  const fail = (detail: string): never => {\n    throw new Error(`MV-DECOMPILE-IDENTITY ${filePath}: ${detail}`);\n  };\n  const diagnostics =\n    ts.transpileModule(text, {\n      fileName: filePath,\n      reportDiagnostics: true,\n      compilerOptions: { target: ts.ScriptTarget.ES2023, module: ts.ModuleKind.ESNext },\n    }).diagnostics ?? [];\n  if (diagnostics.length) fail(ts.flattenDiagnosticMessageText(diagnostics[0]!.messageText, \"\\n\"));\n  const source = ts.createSourceFile(\n    filePath,\n    text,\n    ts.ScriptTarget.ES2023,\n    true,\n    ts.ScriptKind.TS,\n  );\n  const bindings = new Map<string, ts.Expression | Value>();\n  const exported = new Map<string, string>();\n  const helper = (name: string): HelperValue => {\n    if (typeof (dsl as Record<string, unknown>)[name] !== \"function\")\n      fail(`Unknown DSL helper ${name}.`);\n    return { helper: name };\n  };\n  const namespace: ObjectValue = { object: true, field: helper };\n  for (const statement of source.statements) {\n    if (ts.isImportDeclaration(statement)) {\n      if (statement.importClause?.isTypeOnly) continue;\n      if (\n        !ts.isStringLiteral(statement.moduleSpecifier) ||\n        statement.moduleSpecifier.text !== \"rpgmaker-event-dsl\"\n      )\n        fail(\"Unsupported value import source.\");\n      if (statement.importClause?.name) fail(\"Default import is not allowed.\");\n      const named = statement.importClause?.namedBindings;\n      if (named && ts.isNamespaceImport(named)) bindings.set(named.name.text, namespace);\n      else if (named)\n        for (const element of named.elements)\n          if (!element.isTypeOnly)\n            bindings.set(element.name.text, {\n              helper: element.propertyName?.text ?? element.name.text,\n            });\n    } else if (ts.isVariableStatement(statement)) {\n      if (!(statement.declarationList.flags & ts.NodeFlags.Const))\n        fail(\"Only const bindings are supported.\");\n      for (const declaration of statement.declarationList.declarations) {\n        if (!ts.isIdentifier(declaration.name) || !declaration.initializer)\n          fail(\"Expected a named initialized const.\");\n        const name = (declaration.name as ts.Identifier).text;\n        if (bindings.has(name)) fail(`Duplicate binding ${name}.`);\n        bindings.set(name, declaration.initializer!);\n        if (statement.modifiers?.some((item) => item.kind === ts.SyntaxKind.ExportKeyword))\n          exported.set(name, name);\n      }\n    } else if (ts.isExportDeclaration(statement)) {\n      if (\n        statement.moduleSpecifier ||\n        !statement.exportClause ||\n        !ts.isNamedExports(statement.exportClause)\n      )\n        fail(\"Only local named exports are supported.\");\n      for (const element of (statement.exportClause as ts.NamedExports).elements)\n        if (!element.isTypeOnly)\n          exported.set(element.name.text, element.propertyName?.text ?? element.name.text);\n    } else if (\n      ts.isEmptyStatement(statement) ||\n      ts.isInterfaceDeclaration(statement) ||\n      ts.isTypeAliasDeclaration(statement)\n    )\n      continue;\n    else fail(`Unsupported statement ${ts.SyntaxKind[statement.kind]}.`);\n  }\n  const resolving = new Set<string>();\n  const memo = new Map<string, Value>();\n  const fields = new WeakMap<ObjectValue, Set<string>>();\n  const read = (value: Value, key: string): Value => {\n    if (!value || typeof value !== \"object\" || !(\"object\" in value))\n      return fail(`Cannot reliably determine field ${key}.`);\n    const active = fields.get(value) ?? new Set<string>();\n    fields.set(value, active);\n    if (active.has(key)) fail(`Cyclic identity field ${key}.`);\n    active.add(key);\n    try {\n      return value.field(key);\n    } finally {\n      active.delete(key);\n    }\n  };\n  const binding = (name: string): Value => {\n    if (name === \"undefined\") return undefined;\n    if (memo.has(name)) return memo.get(name);\n    if (!bindings.has(name) || resolving.has(name))\n      return fail(`Unresolved or cyclic binding ${name}.`);\n    const value = bindings.get(name);\n    if (value && typeof value === \"object\" && (\"helper\" in value || \"object\" in value))\n      return \"helper\" in value ? helper(value.helper) : value;\n    resolving.add(name);\n    try {\n      const result = expression(value as ts.Expression);\n      memo.set(name, result);\n      return result;\n    } finally {\n      resolving.delete(name);\n    }\n  };\n  const propertyName = (name: ts.PropertyName): string => {\n    if (ts.isComputedPropertyName(name) && ts.isStringLiteral(name.expression))\n      return name.expression.text;\n    if (\n      ts.isIdentifier(name) ||\n      ts.isStringLiteral(name) ||\n      ts.isNumericLiteral(name) ||\n      ts.isNoSubstitutionTemplateLiteral(name)\n    )\n      return name.text;\n    return fail(\"Unresolved computed property name.\");\n  };\n  const expression = (node: ts.Expression): Value => {\n    if (\n      ts.isParenthesizedExpression(node) ||\n      ts.isAsExpression(node) ||\n      ts.isSatisfiesExpression(node) ||\n      ts.isTypeAssertionExpression(node) ||\n      ts.isNonNullExpression(node)\n    )\n      return expression(node.expression);\n    if (ts.isIdentifier(node)) return binding(node.text);\n    if (ts.isStringLiteral(node) || ts.isNoSubstitutionTemplateLiteral(node)) return node.text;\n    if (ts.isNumericLiteral(node)) return Number(node.text);\n    if (node.kind === ts.SyntaxKind.NullKeyword) return null;\n    if (node.kind === ts.SyntaxKind.TrueKeyword) return true;\n    if (node.kind === ts.SyntaxKind.FalseKeyword) return false;\n    if (ts.isPrefixUnaryExpression(node) && node.operator === ts.SyntaxKind.MinusToken) {\n      const value = expression(node.operand);\n      return typeof value === \"number\" ? -value : fail(\"Invalid numeric identity.\");\n    }\n    if (ts.isArrayLiteralExpression(node)) return opaque;\n    if (ts.isObjectLiteralExpression(node))\n      return {\n        object: true,\n        field: (key) => {\n          for (const property of [...node.properties].reverse()) {\n            if (ts.isSpreadAssignment(property)) {\n              const spread = expression(property.expression);\n              const found = read(spread, key);\n              if (found !== missing) return found;\n            } else if (propertyName(property.name!) === key) {\n              if (ts.isPropertyAssignment(property)) return expression(property.initializer);\n              if (ts.isShorthandPropertyAssignment(property)) return binding(property.name.text);\n              return fail(`Unsupported identity property ${key}.`);\n            }\n          }\n          return missing;\n        },\n      };\n    if (ts.isPropertyAccessExpression(node))\n      return read(expression(node.expression), node.name.text);\n    if (ts.isCallExpression(node)) {\n      const callee = expression(node.expression);\n      if (!callee || typeof callee !== \"object\" || !(\"helper\" in callee))\n        return fail(\"Only known DSL helpers can determine identity.\");\n      const kind = declarationKinds[callee.helper];\n      if (!kind) return opaque;\n      if (node.arguments.length !== 1) return fail(\"Declaration requires one input.\");\n      const input = expression(node.arguments[0]!);\n      return {\n        object: true,\n        field: (key) =>\n          key === \"kind\"\n            ? kind\n            : key === \"id\" ||\n                (kind === \"mapEvent\" && key === \"mapId\") ||\n                (kind === \"troopEvent\" && key === \"troopId\")\n              ? read(input, key)\n              : missing,\n      };\n    }\n    return fail(`Cannot reliably determine identity from ${ts.SyntaxKind[node.kind]}.`);\n  };\n  const ids: string[] = [];\n  for (const [name, local] of exported) {\n    const value = binding(local);\n    if (!value || typeof value !== \"object\" || !(\"object\" in value)) continue;\n    const kind = read(value, \"kind\");\n    if (typeof kind !== \"string\" || !Object.values(declarationKinds).includes(kind)) continue;\n    const id = read(value, kind === \"troopEvent\" ? \"troopId\" : \"id\"),\n      mapId = kind === \"mapEvent\" ? read(value, \"mapId\") : undefined;\n    if (\n      !Number.isSafeInteger(id) ||\n      Number(id) <= 0 ||\n      (kind === \"mapEvent\" && (!Number.isSafeInteger(mapId) || Number(mapId) <= 0))\n    )\n      fail(`Unresolved or invalid Entry Identity in export ${name}.`);\n    ids.push(\n      kind === \"mapEvent\" ? `map:${String(mapId)}/event:${String(id)}` : `${kind}:${String(id)}`,\n    );\n  }\n  return ids;\n}\n","import { spawn } from \"node:child_process\";\nimport { createHash } from \"node:crypto\";\nimport {\n  lstat,\n  mkdir,\n  mkdtemp,\n  readFile,\n  readdir,\n  realpath,\n  stat,\n  writeFile,\n} from \"node:fs/promises\";\nimport { dirname, isAbsolute, join, parse, relative, resolve } from \"node:path\";\n\nimport type { DecompileFile } from \"../decompiler/project.js\";\nimport { isMissingFileError } from \"./guards.js\";\nimport { workspaceStateDirectoryName } from \"./state.js\";\nimport { decompileCandidatesDirectoryName } from \"./source-discovery.js\";\n\nexport function decompileDestination(workspaceRoot: string, sourceRoot: string): string {\n  return resolve(workspaceRoot, sourceRoot, \"decompiled\");\n}\n\nexport async function assertDecompileDestinationAbsent(destination: string): Promise<void> {\n  const existing = await lstat(destination).catch((error: unknown) => {\n    if (isMissingFileError(error)) return null;\n    throw error;\n  });\n  if (existing !== null) throw new Error(`Decompile destination already exists: ${destination}`);\n}\n\ntype PathFact = { path: string; physical: string; identity: string };\nexport type DecompilePublicationPaths = {\n  facts: readonly PathFact[];\n  physicalParent: string;\n  physicalProtected: string;\n};\n\nasync function pathFacts(paths: readonly string[]): Promise<PathFact[]> {\n  const facts = new Map<string, PathFact>();\n  for (const path of paths) {\n    let ancestor = resolve(path);\n    while (true) {\n      const physical = await realpath(ancestor);\n      const info = await lstat(ancestor);\n      if (!info.isDirectory() && !info.isSymbolicLink())\n        throw new Error(`Unsupported directory: ${ancestor}`);\n      facts.set(ancestor.toLowerCase(), {\n        path: ancestor,\n        physical,\n        identity: `${info.dev}:${info.ino}:${info.mode}`,\n      });\n      // Pin both the logical reparse entry and every physical ancestor it names.\n      let physicalAncestor = physical;\n      while (true) {\n        const physicalInfo = await lstat(physicalAncestor);\n        facts.set(physicalAncestor.toLowerCase(), {\n          path: physicalAncestor,\n          physical: await realpath(physicalAncestor),\n          identity: `${physicalInfo.dev}:${physicalInfo.ino}:${physicalInfo.mode}`,\n        });\n        const parent = dirname(physicalAncestor);\n        if (parent === physicalAncestor) break;\n        physicalAncestor = parent;\n      }\n      const parent = dirname(ancestor);\n      if (parent === ancestor) break;\n      ancestor = parent;\n    }\n  }\n  return [...facts.values()].sort((a, b) => a.path.localeCompare(b.path));\n}\n\nasync function assertPathFacts(facts: readonly PathFact[]): Promise<void> {\n  for (const fact of facts) {\n    const info = await lstat(fact.path);\n    if (\n      (await realpath(fact.path)) !== fact.physical ||\n      `${info.dev}:${info.ino}:${info.mode}` !== fact.identity\n    )\n      throw new Error(`Decompile publication path changed: ${fact.path}`);\n  }\n}\n\n/** One Windows same-filesystem Directory.Move. Pins survive the final Node validation. */\nasync function moveDirectory(\n  candidate: string,\n  destination: string,\n  facts: readonly PathFact[],\n  validate: () => Promise<void>,\n): Promise<void> {\n  const data = Buffer.from(\n    JSON.stringify({ candidate, destination, paths: facts.map((fact) => fact.path) }),\n    \"utf8\",\n  ).toString(\"base64\");\n  const script = `$ErrorActionPreference = 'Stop'\n$handles = [System.Collections.Generic.List[object]]::new()\ntry {\nAdd-Type -TypeDefinition @'\nusing System;\nusing System.Runtime.InteropServices;\nusing Microsoft.Win32.SafeHandles;\npublic static class MvDecompilePin {\n [DllImport(\"kernel32.dll\", CharSet=CharSet.Unicode, SetLastError=true)]\n public static extern SafeFileHandle CreateFileW(string name, uint access, uint share, IntPtr security, uint creation, uint flags, IntPtr template);\n}\n'@\n$plan = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('${data}')) | ConvertFrom-Json\nforeach ($path in $plan.paths) {\n $handle = [MvDecompilePin]::CreateFileW($path, 1, 3, [IntPtr]::Zero, 3, 0x02200000, [IntPtr]::Zero)\n if ($handle.IsInvalid) { throw ('Cannot pin publication path: ' + $path + ' win32=' + [Runtime.InteropServices.Marshal]::GetLastWin32Error()) }\n $handles.Add($handle)\n}\n[Console]::Out.WriteLine('PINNED')\nif ([Console]::In.ReadLine() -ne 'publish') { throw 'Publication cancelled before move' }\n[System.IO.Directory]::Move($plan.candidate, $plan.destination)\n[Console]::Out.WriteLine('PUBLISHED')\n} catch { [Console]::Error.WriteLine($_.Exception.ToString()); exit 1 }\nfinally { foreach ($handle in $handles) { $handle.Dispose() } }\n`;\n  await new Promise<void>((done, reject) => {\n    const child = spawn(\n      \"powershell.exe\",\n      [\n        \"-NoLogo\",\n        \"-NoProfile\",\n        \"-NonInteractive\",\n        \"-EncodedCommand\",\n        Buffer.from(script, \"utf16le\").toString(\"base64\"),\n      ],\n      { windowsHide: true, stdio: [\"pipe\", \"pipe\", \"pipe\"] },\n    );\n    let output = \"\",\n      errors = \"\",\n      validating = false,\n      failure: unknown;\n    const timer = setTimeout(() => {\n      failure = new Error(\"Decompile directory publication timed out.\");\n      child.kill();\n    }, 30_000);\n    child.stderr.on(\"data\", (chunk) => {\n      errors += String(chunk);\n    });\n    child.stdout.on(\"data\", (chunk) => {\n      output += String(chunk);\n      if (output.includes(\"PINNED\") && !validating) {\n        validating = true;\n        void (async () => {\n          try {\n            await assertPathFacts(facts);\n            await validate();\n            child.stdin.end(\"publish\\n\");\n          } catch (error) {\n            failure = error;\n            child.stdin.end(\"cancel\\n\");\n          }\n        })();\n      }\n    });\n    child.stdin.on(\"error\", (error) => {\n      failure ??= error;\n    });\n    child.once(\"error\", (error) => {\n      clearTimeout(timer);\n      reject(error);\n    });\n    child.once(\"close\", (code) => {\n      clearTimeout(timer);\n      if (failure) reject(failure);\n      else if (code !== 0 || !output.includes(\"PUBLISHED\"))\n        reject(new Error(`Decompile directory publication failed: ${errors}`));\n      else done();\n    });\n  });\n}\n\nexport async function publishDecompileCandidate(options: {\n  destination: string;\n  files: readonly DecompileFile[];\n  assertInputsUnchanged: () => Promise<void>;\n  paths: DecompilePublicationPaths;\n}): Promise<void> {\n  if (process.platform !== \"win32\")\n    throw new Error(\n      \"Complete non-overwriting Decompile publication requires Windows directory move support.\",\n    );\n  const { destination, files } = options;\n  await assertDecompileDestinationAbsent(destination);\n  const { facts, physicalParent, physicalProtected } = options.paths;\n  await assertPathFacts(facts);\n  const candidate = await mkdtemp(join(physicalProtected, \"candidate-\"));\n  const candidateInfo = await lstat(candidate);\n  const expected = new Map<string, string>();\n  for (const file of files) {\n    const name = relative(destination, file.path);\n    if (\n      !name ||\n      isAbsolute(name) ||\n      name === \"..\" ||\n      name.startsWith(`..${process.platform === \"win32\" ? \"\\\\\" : \"/\"}`)\n    )\n      throw new Error(`Invalid Decompile candidate path: ${file.path}`);\n    const target = join(candidate, name);\n    await mkdir(dirname(target), { recursive: true });\n    await writeFile(target, file.content, { encoding: \"utf8\", flag: \"wx\" });\n    expected.set(name, createHash(\"sha256\").update(file.content).digest(\"hex\"));\n  }\n  const validate = async () => {\n    await assertDecompileDestinationAbsent(destination);\n    const currentInfo = await lstat(candidate);\n    if (\n      !currentInfo.isDirectory() ||\n      currentInfo.dev !== candidateInfo.dev ||\n      currentInfo.ino !== candidateInfo.ino\n    )\n      throw new Error(\"Decompile candidate directory changed.\");\n    const names: string[] = [];\n    async function inspect(directory: string) {\n      for (const entry of await readdir(directory, { withFileTypes: true })) {\n        const path = join(directory, entry.name);\n        if (entry.isDirectory()) await inspect(path);\n        else if (entry.isFile()) names.push(relative(candidate, path));\n        else throw new Error(`Unexpected Decompile candidate entry: ${path}`);\n      }\n    }\n    await inspect(candidate);\n    if (JSON.stringify(names.sort()) !== JSON.stringify([...expected.keys()].sort()))\n      throw new Error(\"Decompile candidate membership changed.\");\n    for (const [name, hash] of expected)\n      if (\n        createHash(\"sha256\")\n          .update(await readFile(join(candidate, name)))\n          .digest(\"hex\") !== hash\n      )\n        throw new Error(\"Decompile candidate bytes changed.\");\n    await options.assertInputsUnchanged();\n  };\n  // Remnants are permanently excluded by Discovery. Never delete an uncertain final destination.\n  await moveDirectory(candidate, join(physicalParent, \"decompiled\"), facts, validate);\n}\n\nexport async function captureDecompilePublicationPaths(\n  workspaceRoot: string,\n  destination: string,\n): Promise<DecompilePublicationPaths> {\n  if (process.platform !== \"win32\")\n    throw new Error(\n      \"Complete non-overwriting Decompile publication requires Windows directory move support.\",\n    );\n  const parent = dirname(destination);\n  // The final parent must already be established: preparation never leaves a partial source tree.\n  const parentInfo = await stat(parent).catch((error: unknown) => {\n    if (isMissingFileError(error)) return null;\n    throw error;\n  });\n  if (!parentInfo?.isDirectory())\n    throw new Error(`Decompile sourceRoot must be an existing directory: ${parent}`);\n  const protectedRoot = resolve(\n    workspaceRoot,\n    workspaceStateDirectoryName,\n    decompileCandidatesDirectoryName,\n  );\n  await mkdir(protectedRoot, { recursive: true });\n  if (!(await lstat(protectedRoot)).isDirectory())\n    throw new Error(`Unsupported Decompile isolation directory: ${protectedRoot}`);\n  const physicalParent = await realpath(parent),\n    physicalProtected = await realpath(protectedRoot);\n  if (\n    parse(physicalParent).root.toLowerCase() !== parse(physicalProtected).root.toLowerCase() ||\n    (await stat(parent)).dev !== (await stat(protectedRoot)).dev\n  )\n    throw new Error(\n      \"Decompile requires a same-filesystem isolated candidate and destination; cross-volume publication is unsupported.\",\n    );\n  return { facts: await pathFacts([parent, protectedRoot]), physicalParent, physicalProtected };\n}\n","import { stat } from \"node:fs/promises\";\nimport { relative } from \"node:path\";\n\nimport {\n  discoverDefinitionFiles,\n  loadDefinitionFile,\n  loadVirtualDefinitionFiles,\n  type DefinitionSourceDiscovery,\n} from \"./definitions.js\";\nimport { decompileProjectDataSnapshot } from \"../decompiler/project.js\";\nimport type { DslOwnedDeclaration } from \"../domain/types.js\";\nimport {\n  buildCompileBaseline,\n  isCompileBaselineFresh,\n  buildCompileOutput,\n  publishCompileOutput,\n  type FileHashEntry,\n} from \"../project-data/materialization.js\";\nimport { parseMapInfos } from \"../project-data/project.js\";\nimport {\n  captureStandardProjectDataSnapshot,\n  collectStandardProjectDataSnapshotPlan,\n  getWorkspaceStatePaths,\n  readProjectDataSnapshotFile,\n  readSyncManifest,\n  writeSyncManifest,\n  type WorkspaceStatePaths,\n} from \"./state.js\";\nimport {\n  buildStagedDataGraph,\n  buildSnapshotReferenceInput,\n  validateStagedDataGraph,\n  type SnapshotReferenceSource,\n} from \"../validation/staged-graph.js\";\nimport type { SnapshotMapValidationEntry, SnapshotValidationInput } from \"../validation/types.js\";\nimport { readPositiveInteger } from \"../validation/snapshot.js\";\nimport {\n  buildStructuredDiffReport,\n  deriveAffectedProjectDataFiles,\n  renderStructuredDiffReport,\n} from \"../project-data/structured-diff.js\";\nimport { assertWorkspaceUnchanged, loadWorkspace, type LoadedWorkspace } from \"./config.js\";\nimport { withWorkspaceOperationLock } from \"./operation-lock.js\";\nimport { isMissingFileError } from \"./guards.js\";\nimport {\n  assertKnownSafeProjectDataFile,\n  assertGeneratedProjectDataIntegrity,\n  assertNoPendingInterruptedPushForNonPush,\n  readJsonFiles,\n} from \"./push.js\";\nimport {\n  assertProjectDataSnapshotExists,\n  assertProjectRootBinding,\n  readCurrentSnapshotFileHashes,\n} from \"./checks.js\";\nimport type {\n  CompileWorkspaceOptions,\n  DiffWorkspaceOptions,\n  WorkspaceCommandOptions,\n} from \"./types.js\";\nimport { TypeInputCapture, typeInputsUnchanged } from \"./type-inputs.js\";\nimport { definitionIdentities } from \"./definition-identities.js\";\nimport {\n  assertDecompileDestinationAbsent,\n  captureDecompilePublicationPaths,\n  decompileDestination,\n  publishDecompileCandidate,\n} from \"./decompile-publication.js\";\nimport { assertCandidateDiscoverable } from \"./source-discovery.js\";\n\nexport async function cloneWorkspace(options: WorkspaceCommandOptions): Promise<void> {\n  await withWorkspaceOperationLock(options.workspaceRoot, \"clone\", () =>\n    captureWorkspaceSnapshot(options, \"clone\"),\n  );\n}\n\nexport async function pullWorkspace(options: WorkspaceCommandOptions): Promise<void> {\n  await withWorkspaceOperationLock(options.workspaceRoot, \"pull\", () =>\n    captureWorkspaceSnapshot(options, \"pull\"),\n  );\n}\n\nasync function captureWorkspaceSnapshot(\n  options: WorkspaceCommandOptions,\n  commandName: string,\n): Promise<void> {\n  const workspace = await loadWorkspace(options.workspaceRoot);\n  const statePaths = getWorkspaceStatePaths(workspace.workspaceRoot);\n\n  await assertNoPendingInterruptedPushForNonPush({ statePaths, commandName });\n  if (commandName === \"clone\") {\n    const manifest = await readSyncManifest(statePaths.syncManifestPath);\n    if (manifest !== null)\n      assertProjectRootBinding(manifest, workspace.projectRootBinding, commandName);\n    else {\n      const snapshot = await stat(statePaths.projectDataSnapshotDirectory).catch(\n        (error: unknown) => {\n          if (isMissingFileError(error)) return null;\n          throw error;\n        },\n      );\n      if (snapshot !== null)\n        throw new Error(\n          \"Project Data Snapshot exists without its Sync Manifest. Run pull explicitly to establish a complete Snapshot and target binding.\",\n        );\n    }\n  }\n  await captureStandardProjectDataSnapshot({\n    dataDirectory: workspace.dataDirectory,\n    projectRootBinding: workspace.projectRootBinding,\n    statePaths,\n    assertWorkspaceUnchanged: () => assertWorkspaceUnchanged(workspace, commandName),\n  });\n}\n\nexport async function decompileWorkspace(options: WorkspaceCommandOptions): Promise<void> {\n  await withWorkspaceOperationLock(options.workspaceRoot, \"decompile\", () =>\n    decompileWorkspaceUnlocked(options),\n  );\n}\n\nasync function decompileWorkspaceUnlocked(options: WorkspaceCommandOptions): Promise<void> {\n  const workspace = await loadWorkspace(options.workspaceRoot);\n  const statePaths = getWorkspaceStatePaths(workspace.workspaceRoot);\n  const destination = decompileDestination(workspace.workspaceRoot, workspace.config.sourceRoot);\n\n  await assertNoPendingInterruptedPushForNonPush({ statePaths, commandName: \"decompile\" });\n  const manifest = await assertProjectDataSnapshotExists(\n    statePaths,\n    \"decompile\",\n    workspace.projectRootBinding,\n  );\n  await assertDecompileDestinationAbsent(destination);\n  const publicationPaths = await captureDecompilePublicationPaths(\n    workspace.workspaceRoot,\n    destination,\n  );\n  const files = await discoverDefinitionFiles(workspace.workspaceRoot, workspace.config);\n  const capture = new TypeInputCapture(workspace.workspaceRoot);\n  for (const file of files) capture.fileHash(file);\n  const existingIdentities = new Set(\n    files.flatMap((file) => definitionIdentities(file, capture.readFile(file)!)),\n  );\n  const snapshot = await captureCompileSnapshot(statePaths, manifest.snapshotFiles);\n  await decompileProjectDataSnapshot({\n    scriptEnabled: workspace.config.scriptEnabled,\n    sourceRoot: workspace.config.sourceRoot,\n    statePaths: snapshot.statePaths,\n    workspaceRoot: workspace.workspaceRoot,\n    validateCandidate: async (candidates) => {\n      await assertCandidateDiscoverable(\n        workspace.workspaceRoot,\n        workspace.config,\n        candidates.map((file) => file.path),\n      );\n      const declarations = loadVirtualDefinitionFiles(\n        new Map(candidates.map((file) => [file.path, file.content])),\n        capture,\n      );\n      const snapshotInput = await loadSnapshotValidationInput(snapshot.statePaths);\n      const graph = buildStagedDataGraph({\n        declarations,\n        snapshotReferences: snapshotInput.references,\n        snapshotMaps: snapshotInput.maps,\n        snapshotTroops: snapshotInput.troops,\n        snapshotTilesets: snapshotInput.tilesets,\n        ...(\"equipmentTypes\" in snapshotInput\n          ? { snapshotEquipmentTypes: snapshotInput.equipmentTypes }\n          : {}),\n      });\n      const errors = validateStagedDataGraph(graph, { scriptEnabled: true }).issues.filter(\n        (issue) => issue.level === \"error\",\n      );\n      if (errors.length)\n        throw new Error(\n          `Decompile candidate validation failed:\\n${errors.map((issue) => issue.message).join(\"\\n\")}`,\n        );\n      await buildCompileOutput({\n        declarations,\n        resolver: graph.resolver,\n        statePaths: snapshot.statePaths,\n        scriptEnabled: true,\n      });\n      for (const file of candidates)\n        for (const identity of definitionIdentities(file.path, file.content))\n          if (existingIdentities.has(identity))\n            throw new Error(\n              `MV-DECOMPILE-IDENTITY: candidate conflicts with existing ${identity}.`,\n            );\n    },\n    publishCandidate: (candidates) =>\n      publishDecompileCandidate({\n        destination,\n        files: candidates,\n        paths: publicationPaths,\n        assertInputsUnchanged: async () => {\n          await assertCandidateDiscoverable(\n            workspace.workspaceRoot,\n            workspace.config,\n            candidates.map((file) => file.path),\n          );\n          await assertCompileInputsUnchanged(\n            workspace,\n            files,\n            capture,\n            snapshot.hashes,\n            \"decompile\",\n          );\n        },\n      }),\n  });\n}\n\nexport async function compileWorkspace(options: CompileWorkspaceOptions): Promise<void> {\n  await withWorkspaceOperationLock(\n    options.workspaceRoot,\n    options.check ? \"compile --check\" : \"compile\",\n    () => compileWorkspaceUnlocked(options),\n  );\n}\n\nasync function compileWorkspaceUnlocked(options: CompileWorkspaceOptions): Promise<void> {\n  const workspace = await loadWorkspace(options.workspaceRoot);\n  const statePaths = getWorkspaceStatePaths(workspace.workspaceRoot);\n  const commandName = options.check ? \"compile --check\" : \"compile\";\n\n  await assertNoPendingInterruptedPushForNonPush({ statePaths, commandName });\n  const manifest = await assertProjectDataSnapshotExists(\n    statePaths,\n    commandName,\n    workspace.projectRootBinding,\n  );\n  const definitionInput = await loadDiscoveredDefinitionInput(workspace.workspaceRoot, {\n    sourceRoot: workspace.config.sourceRoot,\n    sourceInclude: workspace.config.sourceInclude,\n    sourceExclude: workspace.config.sourceExclude,\n  });\n\n  const snapshot = await captureCompileSnapshot(statePaths, manifest.snapshotFiles);\n  const snapshotInput = await loadSnapshotValidationInput(snapshot.statePaths);\n  const graph = buildStagedDataGraph({\n    declarations: definitionInput.declarations,\n    snapshotReferences: snapshotInput.references,\n    snapshotMaps: snapshotInput.maps,\n    snapshotTroops: snapshotInput.troops,\n    snapshotTilesets: snapshotInput.tilesets,\n    ...(\"equipmentTypes\" in snapshotInput\n      ? { snapshotEquipmentTypes: snapshotInput.equipmentTypes }\n      : {}),\n  });\n  const validation = validateStagedDataGraph(graph, {\n    scriptEnabled: workspace.config.scriptEnabled,\n  });\n\n  const errors = validation.issues.filter((issue) => issue.level === \"error\");\n  for (const issue of validation.issues.filter((issue) => issue.level === \"warning\"))\n    console.error(issue.message);\n  if (errors.length > 0) {\n    throw new Error(\n      [`${commandName} validation failed:`, ...errors.map((issue) => `- ${issue.message}`)].join(\n        \"\\n\",\n      ),\n    );\n  }\n\n  const candidate = await buildCompileOutput({\n    declarations: definitionInput.declarations,\n    resolver: graph.resolver,\n    statePaths: snapshot.statePaths,\n    scriptEnabled: workspace.config.scriptEnabled,\n  });\n  if (options.check) {\n    await assertCompileInputsUnchanged(\n      workspace,\n      definitionInput.files,\n      definitionInput.capture,\n      snapshot.hashes,\n      commandName,\n    );\n    return;\n  }\n\n  const snapshotFiles = snapshot.hashes;\n  const output = await publishCompileOutput(snapshot.statePaths, candidate, () =>\n    assertCompileInputsUnchanged(\n      workspace,\n      definitionInput.files,\n      definitionInput.capture,\n      snapshot.hashes,\n      commandName,\n    ),\n  );\n  const compileBaseline = await buildCompileBaseline({\n    projectRootBinding: workspace.projectRootBinding,\n    config: workspace.config,\n    snapshotFiles,\n    sourceFiles: definitionInput.files,\n    sourceFileHashes: definitionInput.sourceFileHashes,\n    typeInputs: definitionInput.capture.inputs(),\n    workspaceRoot: workspace.workspaceRoot,\n  });\n\n  await writeSyncManifest(\n    statePaths.syncManifestPath,\n    {\n      ...manifest,\n      compileBaseline,\n      generatedFiles: output.generatedFiles,\n      snapshotFiles,\n    },\n    () =>\n      assertCompileInputsUnchanged(\n        workspace,\n        definitionInput.files,\n        definitionInput.capture,\n        snapshot.hashes,\n        commandName,\n      ),\n  );\n}\n\nexport async function isGeneratedProjectDataFresh(\n  options: WorkspaceCommandOptions,\n): Promise<boolean> {\n  return withWorkspaceOperationLock(options.workspaceRoot, \"isGeneratedProjectDataFresh\", () =>\n    isGeneratedProjectDataFreshUnlocked(options),\n  );\n}\n\nasync function isGeneratedProjectDataFreshUnlocked(\n  options: WorkspaceCommandOptions,\n): Promise<boolean> {\n  const workspace = await loadWorkspace(options.workspaceRoot);\n  const statePaths = getWorkspaceStatePaths(workspace.workspaceRoot);\n\n  await assertNoPendingInterruptedPushForNonPush({\n    statePaths,\n    commandName: \"isGeneratedProjectDataFresh\",\n  });\n  const manifest = await readSyncManifest(statePaths.syncManifestPath);\n\n  if (manifest !== null)\n    assertProjectRootBinding(manifest, workspace.projectRootBinding, \"isGeneratedProjectDataFresh\");\n\n  if (manifest?.compileBaseline === undefined) {\n    return false;\n  }\n\n  const files = await discoverDefinitionFiles(workspace.workspaceRoot, {\n    sourceRoot: workspace.config.sourceRoot,\n    sourceInclude: workspace.config.sourceInclude,\n    sourceExclude: workspace.config.sourceExclude,\n  });\n  const snapshotFiles = await readCurrentSnapshotFileHashes(statePaths, manifest.snapshotFiles);\n\n  return isCompileBaselineFresh({\n    projectRootBinding: workspace.projectRootBinding,\n    baseline: manifest.compileBaseline,\n    config: workspace.config,\n    snapshotFiles,\n    sourceFiles: files,\n    workspaceRoot: workspace.workspaceRoot,\n  });\n}\n\nasync function loadDiscoveredDefinitionInput(\n  workspaceRoot: string,\n  discovery: DefinitionSourceDiscovery,\n): Promise<{\n  declarations: DslOwnedDeclaration[];\n  files: string[];\n  sourceFileHashes: FileHashEntry[];\n  capture: TypeInputCapture;\n}> {\n  const files = await discoverDefinitionFiles(workspaceRoot, discovery);\n  const declarations: DslOwnedDeclaration[] = [];\n  const sourceFileHashes: FileHashEntry[] = [];\n  const capture = new TypeInputCapture(workspaceRoot);\n\n  for (const file of files) {\n    declarations.push(...(await loadDefinitionFile(file, capture)));\n    sourceFileHashes.push({\n      hash: capture.fileHash(file),\n      relativePath: relative(workspaceRoot, file).split(/[/\\\\]/u).join(\"/\"),\n    });\n  }\n\n  sourceFileHashes.sort((left, right) => left.relativePath.localeCompare(right.relativePath));\n  return { declarations, files, sourceFileHashes, capture };\n}\n\nexport async function loadSnapshotValidationInput(\n  statePaths: WorkspaceStatePaths,\n): Promise<SnapshotValidationInput> {\n  const mapInfos = parseMapInfos(await readSnapshotFile(statePaths, \"MapInfos.json\"));\n  const snapshotSource: SnapshotReferenceSource = {\n    actors: await readSnapshotArray(statePaths, \"Actors.json\"),\n    animations: await readSnapshotArray(statePaths, \"Animations.json\"),\n    armors: await readSnapshotArray(statePaths, \"Armors.json\"),\n    classes: await readSnapshotArray(statePaths, \"Classes.json\"),\n    commonEvents: await readSnapshotArray(statePaths, \"CommonEvents.json\"),\n    enemies: await readSnapshotArray(statePaths, \"Enemies.json\"),\n    items: await readSnapshotArray(statePaths, \"Items.json\"),\n    mapInfos,\n    skills: await readSnapshotArray(statePaths, \"Skills.json\"),\n    states: await readSnapshotArray(statePaths, \"States.json\"),\n    tilesets: await readSnapshotArray(statePaths, \"Tilesets.json\"),\n    troops: await readSnapshotArray(statePaths, \"Troops.json\"),\n    system: await readSnapshotObject(statePaths, \"System.json\"),\n    weapons: await readSnapshotArray(statePaths, \"Weapons.json\"),\n  };\n\n  const maps = await Promise.all(\n    mapInfos.map(async ({ id }) => readSnapshotMapValidationEntry(statePaths, id)),\n  );\n\n  return {\n    references: buildSnapshotReferenceInput(snapshotSource),\n    maps,\n    troops: readCarrierContext(snapshotSource.troops ?? [], \"members\"),\n    tilesets: readCarrierContext(snapshotSource.tilesets ?? [], \"tilesetNames\"),\n    ...(snapshotSource.system !== undefined && \"equipTypes\" in snapshotSource.system\n      ? { equipmentTypes: snapshotSource.system.equipTypes }\n      : {}),\n  };\n}\n\nfunction readCarrierContext(\n  entries: readonly unknown[],\n  field: \"members\" | \"tilesetNames\",\n): { id: number; members?: unknown; tilesetNames?: unknown }[] {\n  return entries.flatMap((entry) => {\n    if (entry === null || typeof entry !== \"object\" || Array.isArray(entry)) return [];\n    const record = entry as Record<string, unknown>;\n    const id = readPositiveInteger(record.id);\n    return id === null ? [] : [{ id, ...(field in record ? { [field]: record[field] } : {}) }];\n  });\n}\n\nasync function readSnapshotMapValidationEntry(\n  state