{"version":3,"file":"operations-BfAhz6MG.mjs","names":["isMissingFileError","hash","isMissingFileError","isMissingFileError","dsl","fail","object","integer","isMissingFileError","formatMapFileName","toPosixPath","replaceDirectory","isReferenceValue","isReferenceValue","readSnapshotFile","readSnapshotArray","readSnapshotObject","formatMapFileName","readPositiveInteger","readPositiveInteger","readPositiveInteger","readPositiveInteger","readPositiveInteger","readPositiveInteger","readPositiveInteger","readPositiveInteger","readPositiveInteger","readPositiveInteger","fail","object","integer","isReferenceValue","fail","readSnapshotFile","readSnapshotObject","readSnapshotArray","formatMapFileName","readSnapshotFile","readSnapshotArray","readSnapshotObject","isMissingFileError","isMissingFileError","dsl","isMissingFileError","isMissingFileError"],"sources":["C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/workspace/config.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/workspace/type-inputs.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/workspace/guards.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/workspace/source-discovery.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/workspace/definitions.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/project-data/project.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/map-event/native.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/project-data/writer.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/workspace/state.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/inspection.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/variables/compile.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/compiler/shared/conditions.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/movement/compile.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/movement/page.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/decompiler/core.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/message/decompile.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/flow/decompile.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/movement/decompile.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/screen/decompile.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/audio/decompile.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/map/decompile.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/battle/decompile.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/variables/decompile.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/actor/decompile.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/enemy/decompile.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/system/decompile.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/decompiler/dispatch.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/native-context-references.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/map-event/page.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/map-event/validation.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/shared.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/commands.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/snapshot.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/references.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/identities.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/commands/screen/compile.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/compiler/shared/branches.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/compiler/shared/targets.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/compiler/shared/media.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/compiler/dispatch.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/native-command-inputs.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/native-references.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/compiled-commands.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/domain/battle-page-defaults.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/battle-pages.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/staged-graph.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/decompiler/map-page.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/decompiler/project.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/compiler/events.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/validation/compile-output.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/project-data/materialization.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/project-data/map-event-diff.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/project-data/structured-diff.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/workspace/operation-lock.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/workspace/checks.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/workspace/push-recovery.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/workspace/push.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/workspace/definition-identities.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/workspace/decompile-publication.ts","C:/Users/Shuen/.codex/worktrees/mv-map-numeric-fix/rpgmaker-event-dsl/packages/rpgmaker-event-dsl/src/workspace/operations.ts"],"sourcesContent":["import { mkdir, readFile, readdir, realpath, stat, writeFile } from \"node:fs/promises\";\nimport { createHash } from \"node:crypto\";\nimport { resolve } from \"node:path\";\n\nimport { z } from \"zod\";\n\nexport const defaultSourceRoot = \"src\";\nexport const defaultSourceInclude = [\"**/*.events.ts\", \"**/*.dsl.ts\"] as const;\nexport const defaultSourceExclude = [\"**/*.test.ts\", \"**/*.spec.ts\", \"**/*.d.ts\"] as const;\n\nexport const workspaceConfigSchema = z\n  .object({\n    projectRoot: z.string().min(1),\n    scriptEnabled: z.boolean(),\n    sourceRoot: z.string().min(1),\n    sourceInclude: z.array(z.string().min(1)),\n    sourceExclude: z.array(z.string().min(1)),\n  })\n  .strict();\n\nexport type WorkspaceConfig = z.infer<typeof workspaceConfigSchema>;\n\nexport type LoadedWorkspace = {\n  workspaceRoot: string;\n  projectRoot: string;\n  dataDirectory: string;\n  config: WorkspaceConfig;\n  configHash: string;\n  projectRootBinding: string;\n};\n\nexport type InitWorkspaceOptions = {\n  workspaceRoot: string;\n  projectRoot: string;\n};\n\nexport async function loadWorkspace(workspaceRoot: string): Promise<LoadedWorkspace> {\n  const configPath = resolve(workspaceRoot, \"rpgmaker-event-dsl.config.json\");\n  const configBytes = await readFile(configPath);\n  const rawConfig = new TextDecoder(\"utf-8\", { fatal: true, ignoreBOM: true }).decode(configBytes);\n  const config = workspaceConfigSchema.parse(JSON.parse(rawConfig));\n  const projectRoot = resolve(workspaceRoot, config.projectRoot);\n  const dataDirectory = resolve(projectRoot, \"data\");\n\n  await assertProjectRoot(projectRoot);\n  await assertDirectoryExists(dataDirectory);\n\n  return {\n    workspaceRoot,\n    projectRoot,\n    dataDirectory,\n    config,\n    configHash: createHash(\"sha256\").update(configBytes).digest(\"hex\"),\n    projectRootBinding: await normalizedProjectRoot(projectRoot),\n  };\n}\n\nexport async function initWorkspace(options: InitWorkspaceOptions): Promise<LoadedWorkspace> {\n  const workspaceRoot = resolve(options.workspaceRoot);\n  const configPath = resolve(workspaceRoot, \"rpgmaker-event-dsl.config.json\");\n  const projectRoot = resolve(workspaceRoot, options.projectRoot);\n  const dataDirectory = resolve(projectRoot, \"data\");\n  const config: WorkspaceConfig = {\n    projectRoot: options.projectRoot,\n    scriptEnabled: false,\n    sourceRoot: defaultSourceRoot,\n    sourceInclude: [...defaultSourceInclude],\n    sourceExclude: [...defaultSourceExclude],\n  };\n\n  await assertProjectRoot(projectRoot);\n  await assertDirectoryExists(dataDirectory);\n  await assertConfigDoesNotExist(configPath);\n  await mkdir(workspaceRoot, { recursive: true });\n  await mkdir(resolve(workspaceRoot, config.sourceRoot), { recursive: true });\n  await writeFile(\n    resolve(workspaceRoot, \"rpgmaker-event-dsl.config.json\"),\n    `${JSON.stringify(config, null, 2)}\\n`,\n    \"utf8\",\n  );\n\n  return loadWorkspace(workspaceRoot);\n}\n\nasync function normalizedProjectRoot(projectRoot: string): Promise<string> {\n  const canonical = await realpath(projectRoot);\n  return process.platform === \"win32\" ? canonical.toLowerCase() : canonical;\n}\n\nexport async function assertWorkspaceUnchanged(\n  workspace: LoadedWorkspace,\n  commandName: string,\n): Promise<void> {\n  const current = await loadWorkspace(workspace.workspaceRoot).catch((error: unknown) => {\n    throw new Error(\n      `Workspace configuration or Project Root changed during ${commandName}. Run ${commandName} again.`,\n      { cause: error },\n    );\n  });\n  if (\n    current.configHash !== workspace.configHash ||\n    current.projectRootBinding !== workspace.projectRootBinding\n  ) {\n    throw new Error(\n      `Workspace configuration or Project Root changed during ${commandName}. Run ${commandName} again.`,\n    );\n  }\n}\n\nasync function assertConfigDoesNotExist(configPath: string): Promise<void> {\n  try {\n    await stat(configPath);\n  } catch (error) {\n    if (isMissingFileError(error)) {\n      return;\n    }\n    throw error;\n  }\n\n  throw new Error(\n    `Workspace Config already exists at ${configPath}. Refusing to overwrite it during init.`,\n  );\n}\n\nfunction isMissingFileError(error: unknown): boolean {\n  return (\n    error instanceof Error &&\n    \"code\" in error &&\n    typeof (error as { code?: unknown }).code === \"string\" &&\n    (error as { code?: string }).code === \"ENOENT\"\n  );\n}\n\nasync function assertProjectRoot(projectRoot: string): Promise<void> {\n  const entries = await readdir(projectRoot, { withFileTypes: true });\n  const projectMarkers = entries.filter(\n    (entry) => entry.isFile() && entry.name.endsWith(\".rpgproject\"),\n  );\n\n  if (projectMarkers.length === 0) {\n    throw new Error(`Expected ${projectRoot} to contain a *.rpgproject file.`);\n  }\n}\n\nasync function assertDirectoryExists(directoryPath: string): Promise<void> {\n  const directoryStats = await stat(directoryPath);\n\n  if (!directoryStats.isDirectory()) {\n    throw new Error(`Expected ${directoryPath} to be a directory.`);\n  }\n}\n","import { createHash } from \"node:crypto\";\nimport { readFileSync } from \"node:fs\";\nimport { resolve } from \"node:path\";\n\nimport * as ts from \"typescript\";\nimport { z } from \"zod\";\n\n// Bump when DSL types, validation, generated semantics or Compiler Defaults change.\nexport const compileContractVersion = \"mv-1.6.1/11\";\n\nexport const typeInputSchema = z\n  .object({\n    kind: z.enum([\n      \"readFile\",\n      \"fileExists\",\n      \"directoryExists\",\n      \"getDirectories\",\n      \"realpath\",\n      \"readDirectory\",\n    ]),\n    path: z.string().min(1),\n    value: z.union([z.string(), z.boolean(), z.array(z.string()), z.null()]),\n    directoryOptions: z\n      .object({\n        extensions: z.array(z.string()).nullable(),\n        excludes: z.array(z.string()).nullable(),\n        includes: z.array(z.string()).nullable(),\n        depth: z.number().nullable(),\n      })\n      .strict()\n      .optional(),\n  })\n  .strict()\n  .refine((input) => {\n    if ((input.kind === \"readDirectory\") !== (input.directoryOptions !== undefined)) return false;\n    switch (input.kind) {\n      case \"readFile\":\n        return (\n          input.value === null ||\n          (typeof input.value === \"string\" && /^[a-f0-9]{64}$/u.test(input.value))\n        );\n      case \"fileExists\":\n      case \"directoryExists\":\n        return typeof input.value === \"boolean\";\n      case \"realpath\":\n        return typeof input.value === \"string\" && input.value.length > 0;\n      case \"getDirectories\":\n      case \"readDirectory\":\n        return Array.isArray(input.value);\n    }\n  }, \"Invalid captured TypeScript filesystem observation\");\n\nexport type TypeInput = z.infer<typeof typeInputSchema>;\n\nfunction normalized(path: string): string {\n  const absolute = resolve(path).replaceAll(\"\\\\\", \"/\");\n  return process.platform === \"win32\" ? absolute.toLowerCase() : absolute;\n}\n\nfunction readBytes(path: string): Buffer | undefined {\n  try {\n    return readFileSync(path);\n  } catch (error) {\n    if (\n      error instanceof Error &&\n      \"code\" in error &&\n      [\"ENOENT\", \"ENOTDIR\", \"EISDIR\"].includes(String(error.code))\n    )\n      return undefined;\n    throw error;\n  }\n}\n\nfunction hash(bytes: Buffer): string {\n  return createHash(\"sha256\").update(bytes).digest(\"hex\");\n}\n\nfunction observe(input: TypeInput): TypeInput[\"value\"] {\n  switch (input.kind) {\n    case \"readFile\": {\n      const bytes = readBytes(input.path);\n      return bytes === undefined ? null : hash(bytes);\n    }\n    case \"fileExists\":\n      return ts.sys.fileExists(input.path);\n    case \"directoryExists\":\n      return ts.sys.directoryExists(input.path);\n    case \"getDirectories\":\n      return ts.sys.getDirectories(input.path).sort();\n    case \"realpath\":\n      return ts.sys.realpath?.(input.path) ?? input.path;\n    case \"readDirectory\": {\n      const options = input.directoryOptions!;\n      return ts.sys\n        .readDirectory(\n          input.path,\n          options.extensions ?? undefined,\n          options.excludes ?? undefined,\n          options.includes ?? undefined,\n          options.depth ?? undefined,\n        )\n        .sort();\n    }\n  }\n}\n\nexport function typeInputsUnchanged(inputs: readonly TypeInput[]): boolean {\n  try {\n    return inputs.every((input) => JSON.stringify(observe(input)) === JSON.stringify(input.value));\n  } catch {\n    return false;\n  }\n}\n\n/** One immutable filesystem view for all TypeScript hosts in a compilation. */\nexport class TypeInputCapture {\n  constructor(readonly currentDirectory = process.cwd()) {}\n\n  private readonly observations = new Map<string, TypeInput>();\n  private readonly contents = new Map<string, Buffer | undefined>();\n\n  readFile = (path: string): string | undefined => {\n    const key = normalized(path);\n    if (!this.contents.has(key)) {\n      const bytes = readBytes(key);\n      this.contents.set(key, bytes);\n      this.observations.set(`readFile:${key}`, {\n        kind: \"readFile\",\n        path: key,\n        value: bytes === undefined ? null : hash(bytes),\n      });\n      this.realpath(key);\n    }\n    return this.contents.get(key)?.toString(\"utf8\");\n  };\n\n  private query(\n    kind: TypeInput[\"kind\"],\n    path: string,\n    directoryOptions?: TypeInput[\"directoryOptions\"],\n  ): TypeInput[\"value\"] {\n    const normalizedPath = normalized(path);\n    const key = JSON.stringify([kind, normalizedPath, directoryOptions]);\n    let input = this.observations.get(key);\n    if (input === undefined) {\n      input = {\n        kind,\n        path: normalizedPath,\n        value: null,\n        ...(directoryOptions === undefined ? {} : { directoryOptions }),\n      };\n      input.value = observe(input);\n      this.observations.set(key, input);\n    }\n    return input.value;\n  }\n\n  fileExists = (path: string): boolean => this.query(\"fileExists\", path) as boolean;\n  directoryExists = (path: string): boolean => this.query(\"directoryExists\", path) as boolean;\n  getDirectories = (path: string): string[] => [\n    ...(this.query(\"getDirectories\", path) as string[]),\n  ];\n  realpath = (path: string): string => this.query(\"realpath\", path) as string;\n  readDirectory: typeof ts.sys.readDirectory = (path, extensions, excludes, includes, depth) => [\n    ...(this.query(\"readDirectory\", path, {\n      extensions: extensions === undefined ? null : [...extensions],\n      excludes: excludes === undefined ? null : [...excludes],\n      includes: includes === undefined ? null : [...includes],\n      depth: depth ?? null,\n    }) as string[]),\n  ];\n\n  fileHash(path: string): string {\n    this.readFile(path);\n    const bytes = this.contents.get(normalized(path));\n    if (bytes === undefined) throw new Error(`Definition Source is missing: ${path}`);\n    return hash(bytes);\n  }\n\n  inputs(): TypeInput[] {\n    return [...this.observations.entries()]\n      .sort(([a], [b]) => a.localeCompare(b))\n      .map(([, input]) => input);\n  }\n}\n","export function isMissingFileError(error: unknown): boolean {\n  return (\n    error instanceof Error &&\n    \"code\" in error &&\n    typeof (error as { code?: unknown }).code === \"string\" &&\n    (error as { code?: string }).code === \"ENOENT\"\n  );\n}\n","import { glob, lstat, realpath, stat } from \"node:fs/promises\";\nimport { dirname, isAbsolute, join, matchesGlob, relative, resolve } from \"node:path\";\n\nimport { isMissingFileError } from \"./guards.js\";\n\nexport const decompileCandidatesDirectoryName = \"decompile-candidates\";\nexport type DefinitionSourceDiscovery = {\n  sourceRoot: string;\n  sourceInclude: readonly string[];\n  sourceExclude: readonly string[];\n};\n\nconst key = (path: string) => (process.platform === \"win32\" ? path.toLowerCase() : path);\nfunction within(root: string, path: string): boolean {\n  const name = relative(key(root), key(path));\n  return (\n    name === \"\" ||\n    (!isAbsolute(name) && name !== \"..\" && !name.startsWith(\"..\\\\\") && !name.startsWith(\"../\"))\n  );\n}\n\n/** Project an absent descendant through its nearest real ancestor. */\nexport async function projectedRealpath(path: string): Promise<string> {\n  let ancestor = resolve(path);\n  while (true) {\n    try {\n      return resolve(await realpath(ancestor), relative(ancestor, path));\n    } catch (error) {\n      if (!isMissingFileError(error) || dirname(ancestor) === ancestor) throw error;\n      ancestor = dirname(ancestor);\n    }\n  }\n}\n\nexport function matchesSourceRules(name: string, discovery: DefinitionSourceDiscovery): boolean {\n  const includes = discovery.sourceInclude.length ? discovery.sourceInclude : [\"**/*\"];\n  if (!includes.some((pattern) => matchesGlob(name, pattern))) return false;\n  let path = name;\n  while (path !== \".\" && path !== dirname(path)) {\n    if (discovery.sourceExclude.some((pattern) => matchesGlob(path, pattern))) return false;\n    path = dirname(path);\n  }\n  return true;\n}\n\nasync function protectedRoot(workspaceRoot: string): Promise<string> {\n  const path = resolve(workspaceRoot, \".rpgmaker-event-dsl\", decompileCandidatesDirectoryName);\n  const info = await lstat(path).catch((error: unknown) => {\n    if (isMissingFileError(error)) return null;\n    throw error;\n  });\n  if (info && !info.isDirectory())\n    throw new Error(`Unsupported Decompile isolation directory: ${path}`);\n  return projectedRealpath(path);\n}\n\nexport async function assertCandidateDiscoverable(\n  workspaceRoot: string,\n  discovery: DefinitionSourceDiscovery,\n  files: readonly string[],\n): Promise<void> {\n  const root = resolve(workspaceRoot, discovery.sourceRoot),\n    protectedPath = await protectedRoot(workspaceRoot);\n  for (const file of files) {\n    const name = relative(root, file);\n    if (\n      !within(root, file) ||\n      !matchesSourceRules(name, discovery) ||\n      within(protectedPath, await projectedRealpath(file))\n    )\n      throw new Error(`Decompile candidate is excluded from Definition Source Discovery: ${file}`);\n  }\n}\n\nexport async function discoverDefinitionFiles(\n  workspaceRoot: string,\n  discovery: DefinitionSourceDiscovery,\n): Promise<string[]> {\n  const root = resolve(workspaceRoot, discovery.sourceRoot),\n    protectedPath = await protectedRoot(workspaceRoot);\n  const files = new Map<string, string>();\n  for (const pattern of discovery.sourceInclude.length ? discovery.sourceInclude : [\"**/*\"]) {\n    for await (const name of glob(pattern, { cwd: root, exclude: discovery.sourceExclude })) {\n      if (!matchesSourceRules(name, discovery)) continue;\n      const path = join(root, name);\n      const info = await stat(path).catch((error: unknown) => {\n        if (isMissingFileError(error)) return null;\n        throw error;\n      });\n      if (!info?.isFile()) continue;\n      const physical = await realpath(path);\n      if (within(protectedPath, physical)) continue;\n      const old = files.get(key(physical));\n      if (old === undefined || path < old) files.set(key(physical), path);\n    }\n  }\n  return [...files.values()].sort();\n}\n","import { basename, dirname, matchesGlob, relative, resolve } from \"node:path\";\n\nimport * as ts from \"typescript\";\n\nimport * as dsl from \"../authoring/index.js\";\nimport type { DslOwnedDeclaration } from \"../domain/declarations.js\";\nimport { collectDslOwnedDeclarations } from \"../validation/declarations.js\";\nimport { TypeInputCapture } from \"./type-inputs.js\";\n\nexport { discoverDefinitionFiles, type DefinitionSourceDiscovery } from \"./source-discovery.js\";\n\ntype EvaluationScope = {\n  bindings: Map<string, unknown>;\n};\n\nexport async function loadDefinitionFile(\n  filePath: string,\n  capture = new TypeInputCapture(),\n): Promise<DslOwnedDeclaration[]> {\n  const sourceText = capture.readFile(filePath);\n  if (sourceText === undefined) throw new Error(`Definition Source is missing: ${filePath}`);\n  const sourceFile = ts.createSourceFile(\n    filePath,\n    sourceText,\n    ts.ScriptTarget.ES2023,\n    true,\n    ts.ScriptKind.TS,\n  );\n\n  const diagnostics = collectDiagnostics(filePath, sourceFile, capture);\n  if (diagnostics.length > 0) {\n    throw new Error(formatDiagnostics(filePath, diagnostics));\n  }\n\n  try {\n    const moduleExports = evaluateModule(sourceFile);\n    return collectDslOwnedDeclarations(moduleExports);\n  } catch (error) {\n    if (error instanceof Error) {\n      throw new Error(formatSourceError(filePath, error.message));\n    }\n\n    throw error;\n  }\n}\n\n/** Immutable candidate bytes at final filenames; all other reads remain captured real inputs. */\nexport function loadVirtualDefinitionFiles(\n  files: ReadonlyMap<string, string>,\n  capture: TypeInputCapture,\n): DslOwnedDeclaration[] {\n  const options: ts.CompilerOptions = {\n    allowSyntheticDefaultImports: true,\n    esModuleInterop: true,\n    module: ts.ModuleKind.NodeNext,\n    moduleResolution: ts.ModuleResolutionKind.NodeNext,\n    noEmit: true,\n    strict: true,\n    target: ts.ScriptTarget.ES2023,\n    verbatimModuleSyntax: true,\n  };\n  const content = new Map<string, string>();\n  const paths = new Map<string, string>();\n  const directories = new Set<string>();\n  for (const [path, text] of files) {\n    let ancestor = dirname(path);\n    const missing: string[] = [];\n    while (!capture.directoryExists(ancestor)) {\n      missing.push(ancestor);\n      const parent = dirname(ancestor);\n      if (parent === ancestor)\n        throw new Error(`Cannot locate candidate filesystem ancestor: ${path}`);\n      ancestor = parent;\n    }\n    const physical = resolve(capture.realpath(ancestor), relative(ancestor, path));\n    for (const candidate of [path, physical]) {\n      content.set(normalizePath(candidate), text);\n      paths.set(normalizePath(candidate), physical);\n    }\n    for (const directory of missing) {\n      const physicalDirectory = resolve(capture.realpath(ancestor), relative(ancestor, directory));\n      directories.add(normalizePath(directory));\n      directories.add(normalizePath(physicalDirectory));\n      paths.set(normalizePath(directory), physicalDirectory);\n      paths.set(normalizePath(physicalDirectory), physicalDirectory);\n    }\n  }\n  const read = (path: string) => content.get(normalizePath(path)) ?? capture.readFile(path);\n  const host = ts.createCompilerHost(options, true);\n  host.getCurrentDirectory = () => capture.currentDirectory;\n  host.readFile = read;\n  host.fileExists = (path) => content.has(normalizePath(path)) || capture.fileExists(path);\n  host.directoryExists = (path) =>\n    directories.has(normalizePath(path)) || capture.directoryExists(path);\n  host.realpath = (path) => paths.get(normalizePath(path)) ?? capture.realpath(path);\n  host.getDirectories = (path) =>\n    [\n      ...new Set([\n        ...capture.getDirectories(path),\n        ...[...directories]\n          .filter((directory) => normalizePath(dirname(directory)) === normalizePath(path))\n          .map((directory) => basename(directory)),\n      ]),\n    ].sort();\n  host.readDirectory = (path, extensions, excludes, includes, depth) =>\n    [\n      ...new Set([\n        ...capture.readDirectory(path, extensions, excludes, includes, depth),\n        ...[...files.keys()].filter((file) => {\n          const name = relative(path, file).replaceAll(\"\\\\\", \"/\");\n          return (\n            name !== \"..\" &&\n            !name.startsWith(\"../\") &&\n            (depth === undefined || name.split(\"/\").length - 1 <= depth) &&\n            (!extensions || extensions.some((extension) => name.endsWith(extension))) &&\n            (!includes || includes.some((pattern) => matchesGlob(name, pattern))) &&\n            !excludes?.some((pattern) => matchesGlob(name, pattern))\n          );\n        }),\n      ]),\n    ].sort();\n  host.getSourceFile = (path, version) => {\n    const text = read(path);\n    return text === undefined ? undefined : ts.createSourceFile(path, text, version, true);\n  };\n  const program = ts.createProgram([...files.keys()], options, host);\n  const declarations: DslOwnedDeclaration[] = [];\n  for (const path of files.keys()) {\n    const source = program.getSourceFile(path);\n    if (!source) throw new Error(`Candidate source is missing at final location: ${path}`);\n    const diagnostics = [\n      ...program.getSyntacticDiagnostics(source),\n      ...program.getSemanticDiagnostics(source),\n    ];\n    if (diagnostics.length) throw new Error(formatDiagnostics(path, diagnostics));\n    try {\n      declarations.push(...collectDslOwnedDeclarations(evaluateModule(source)));\n    } catch (error) {\n      throw new Error(\n        formatSourceError(path, error instanceof Error ? error.message : String(error)),\n      );\n    }\n  }\n  return declarations;\n}\n\nfunction collectDiagnostics(\n  filePath: string,\n  sourceFile: ts.SourceFile,\n  capture: TypeInputCapture,\n): readonly ts.Diagnostic[] {\n  const compilerOptions: ts.CompilerOptions = {\n    allowSyntheticDefaultImports: true,\n    esModuleInterop: true,\n    module: ts.ModuleKind.NodeNext,\n    moduleResolution: ts.ModuleResolutionKind.NodeNext,\n    noEmit: true,\n    strict: true,\n    target: ts.ScriptTarget.ES2023,\n    verbatimModuleSyntax: true,\n  };\n\n  const host = ts.createCompilerHost(compilerOptions, true);\n  host.getCurrentDirectory = () => capture.currentDirectory;\n  host.readFile = capture.readFile;\n  host.fileExists = capture.fileExists;\n  host.directoryExists = capture.directoryExists;\n  host.getDirectories = capture.getDirectories;\n  host.realpath = capture.realpath;\n  host.readDirectory = capture.readDirectory;\n\n  host.getSourceFile = (requestedFileName, languageVersion) => {\n    if (normalizePath(requestedFileName) === normalizePath(filePath)) {\n      return sourceFile;\n    }\n\n    const text = capture.readFile(requestedFileName);\n    return text === undefined\n      ? undefined\n      : ts.createSourceFile(requestedFileName, text, languageVersion, true);\n  };\n\n  const program = ts.createProgram([filePath], compilerOptions, host);\n  return [\n    ...program.getSyntacticDiagnostics(sourceFile),\n    ...program.getSemanticDiagnostics(sourceFile),\n  ];\n}\n\nfunction evaluateModule(sourceFile: ts.SourceFile): Record<string, unknown> {\n  const scope: EvaluationScope = {\n    bindings: new Map<string, unknown>(),\n  };\n  const exports: Record<string, unknown> = Object.create(null) as Record<string, unknown>;\n\n  for (const statement of sourceFile.statements) {\n    if (ts.isEmptyStatement(statement)) {\n      continue;\n    }\n\n    if (ts.isImportDeclaration(statement)) {\n      registerImport(statement, scope);\n      continue;\n    }\n\n    if (ts.isExportAssignment(statement)) {\n      throw new Error(\"Default export is not allowed for Event Definitions.\");\n    }\n\n    if (ts.isExportDeclaration(statement)) {\n      if (statement.moduleSpecifier !== undefined) {\n        throw new Error(\"Re-exporting from other modules is not allowed for Event Definitions.\");\n      }\n\n      if (statement.exportClause === undefined || !ts.isNamedExports(statement.exportClause)) {\n        throw new Error(\"Only named exports are allowed for Event Definitions.\");\n      }\n\n      for (const specifier of statement.exportClause.elements) {\n        const exportedName = specifier.name.text;\n        const localName = specifier.propertyName?.text ?? exportedName;\n\n        if (!scope.bindings.has(localName)) {\n          throw new Error(`Exported binding \"${localName}\" was not declared in the file.`);\n        }\n\n        exports[exportedName] = scope.bindings.get(localName);\n      }\n\n      continue;\n    }\n\n    if (ts.isVariableStatement(statement)) {\n      if ((statement.declarationList.flags & ts.NodeFlags.Const) === 0) {\n        throw new Error(\"Only const bindings are allowed for Event Definitions.\");\n      }\n\n      for (const declaration of statement.declarationList.declarations) {\n        if (!ts.isIdentifier(declaration.name)) {\n          throw new Error(\"Only simple named bindings are supported for Event Definitions.\");\n        }\n\n        if (declaration.initializer === undefined) {\n          throw new Error(\n            `Event Definition binding \"${declaration.name.text}\" must have an initializer.`,\n          );\n        }\n\n        const value = evaluateExpression(declaration.initializer, scope);\n        scope.bindings.set(declaration.name.text, value);\n\n        if (\n          statement.modifiers?.some((modifier) => modifier.kind === ts.SyntaxKind.ExportKeyword)\n        ) {\n          exports[declaration.name.text] = value;\n        }\n      }\n      continue;\n    }\n\n    if (isIgnorableStatement(statement)) {\n      continue;\n    }\n\n    throw new Error(`Unsupported Event Definition statement: ${ts.SyntaxKind[statement.kind]}`);\n  }\n\n  return exports;\n}\n\nfunction registerImport(statement: ts.ImportDeclaration, scope: EvaluationScope): void {\n  if (statement.importClause?.isTypeOnly === true) {\n    return;\n  }\n\n  const moduleSpecifier = getModuleSpecifier(statement);\n  if (moduleSpecifier !== \"rpgmaker-event-dsl\") {\n    throw new Error(`Unsupported import source: ${moduleSpecifier}`);\n  }\n\n  if (statement.importClause === undefined) {\n    return;\n  }\n\n  if (statement.importClause.name !== undefined) {\n    throw new Error(\"Default imports are not allowed for Event Definitions.\");\n  }\n\n  if (statement.importClause.namedBindings === undefined) {\n    return;\n  }\n\n  if (ts.isNamespaceImport(statement.importClause.namedBindings)) {\n    scope.bindings.set(statement.importClause.namedBindings.name.text, createDslNamespace());\n    return;\n  }\n\n  for (const element of statement.importClause.namedBindings.elements) {\n    if (element.isTypeOnly) {\n      continue;\n    }\n\n    const importedName = element.propertyName?.text ?? element.name.text;\n    const helper = getDslHelper(importedName);\n\n    if (helper === undefined) {\n      throw new Error(`Unsupported imported helper: ${importedName}`);\n    }\n\n    scope.bindings.set(element.name.text, helper);\n  }\n}\n\nfunction evaluateExpression(node: ts.Expression, scope: EvaluationScope): unknown {\n  if (ts.isParenthesizedExpression(node)) {\n    return evaluateExpression(node.expression, scope);\n  }\n\n  if (\n    ts.isAsExpression(node) ||\n    ts.isTypeAssertionExpression(node) ||\n    ts.isSatisfiesExpression(node)\n  ) {\n    return evaluateExpression(node.expression, scope);\n  }\n\n  if (ts.isNonNullExpression(node)) {\n    return evaluateExpression(node.expression, scope);\n  }\n\n  if (ts.isIdentifier(node)) {\n    if (node.text === \"undefined\") {\n      return undefined;\n    }\n\n    const value = scope.bindings.get(node.text);\n    if (value === undefined && !scope.bindings.has(node.text)) {\n      throw new Error(`Unknown identifier in Event Definition source: ${node.text}`);\n    }\n\n    return value;\n  }\n\n  if (ts.isStringLiteral(node) || ts.isNoSubstitutionTemplateLiteral(node)) {\n    return node.text;\n  }\n\n  if (ts.isNumericLiteral(node)) {\n    return Number(node.text);\n  }\n\n  if (node.kind === ts.SyntaxKind.TrueKeyword) {\n    return true;\n  }\n\n  if (node.kind === ts.SyntaxKind.FalseKeyword) {\n    return false;\n  }\n\n  if (node.kind === ts.SyntaxKind.NullKeyword) {\n    return null;\n  }\n\n  if (ts.isPrefixUnaryExpression(node) && node.operator === ts.SyntaxKind.MinusToken) {\n    const operand = evaluateExpression(node.operand, scope);\n    if (typeof operand !== \"number\") {\n      throw new Error(\"Unary minus can only be applied to numbers in Event Definitions.\");\n    }\n\n    return -operand;\n  }\n\n  if (ts.isArrayLiteralExpression(node)) {\n    const output: unknown[] = [];\n\n    for (const element of node.elements) {\n      if (ts.isSpreadElement(element)) {\n        const spreadValue = evaluateExpression(element.expression, scope);\n        if (!Array.isArray(spreadValue)) {\n          throw new Error(\"Array spreads must resolve to arrays.\");\n        }\n\n        output.push(...spreadValue);\n        continue;\n      }\n\n      output.push(evaluateExpression(element, scope));\n    }\n\n    return output;\n  }\n\n  if (ts.isObjectLiteralExpression(node)) {\n    const output: Record<string, unknown> = {};\n    const set = (key: string, value: unknown) =>\n      Object.defineProperty(output, key, {\n        value,\n        enumerable: true,\n        configurable: true,\n        writable: true,\n      });\n\n    for (const property of node.properties) {\n      if (ts.isSpreadAssignment(property)) {\n        const spreadValue = evaluateExpression(property.expression, scope);\n        if (spreadValue === null || typeof spreadValue !== \"object\" || Array.isArray(spreadValue)) {\n          throw new Error(\"Object spreads must resolve to plain objects.\");\n        }\n\n        for (const [key, value] of Object.entries(spreadValue)) set(key, value);\n        continue;\n      }\n\n      if (ts.isShorthandPropertyAssignment(property)) {\n        set(property.name.text, evaluateExpression(property.name, scope));\n        continue;\n      }\n\n      if (!ts.isPropertyAssignment(property)) {\n        throw new Error(\"Only object properties and spreads are allowed in Event Definitions.\");\n      }\n\n      set(evaluatePropertyName(property.name), evaluateExpression(property.initializer, scope));\n    }\n\n    return output;\n  }\n\n  if (ts.isCallExpression(node)) {\n    const callee = evaluateCallee(node.expression, scope);\n    if (typeof callee !== \"function\") {\n      throw new Error(\"Only DSL helper calls are allowed in Event Definitions.\");\n    }\n\n    const args = node.arguments.map((argument) => evaluateExpression(argument, scope));\n    return callee(...args);\n  }\n\n  if (ts.isPropertyAccessExpression(node)) {\n    const target = evaluateExpression(node.expression, scope);\n    if (target === null || (typeof target !== \"object\" && typeof target !== \"function\")) {\n      throw new Error(\"Property access must target an object or namespace import.\");\n    }\n\n    const record = target as Record<string, unknown>;\n    const value = record[node.name.text];\n    if (value === undefined && !(node.name.text in record)) {\n      throw new Error(`Unknown property access in Event Definition source: ${node.name.text}`);\n    }\n\n    return value;\n  }\n\n  throw new Error(`Unsupported Event Definition expression: ${ts.SyntaxKind[node.kind]}`);\n}\n\nfunction evaluateCallee(node: ts.LeftHandSideExpression, scope: EvaluationScope): unknown {\n  if (ts.isIdentifier(node)) {\n    const value = scope.bindings.get(node.text);\n    if (value === undefined && !scope.bindings.has(node.text)) {\n      throw new Error(`Unknown DSL helper: ${node.text}`);\n    }\n\n    return value;\n  }\n\n  if (ts.isPropertyAccessExpression(node)) {\n    const target = evaluateExpression(node.expression, scope);\n    if (target === null || (typeof target !== \"object\" && typeof target !== \"function\")) {\n      throw new Error(\"Property access must target an object or namespace import.\");\n    }\n\n    const record = target as Record<string, unknown>;\n    const value = record[node.name.text];\n    if (value === undefined && !(node.name.text in record)) {\n      throw new Error(`Unknown DSL helper: ${node.name.text}`);\n    }\n\n    return value;\n  }\n\n  throw new Error(\"Only identifier or property-access helper calls are allowed.\");\n}\n\nfunction evaluatePropertyName(name: ts.PropertyName): string {\n  if (ts.isComputedPropertyName(name) && ts.isStringLiteral(name.expression))\n    return name.expression.text;\n  if (\n    ts.isIdentifier(name) ||\n    ts.isStringLiteral(name) ||\n    ts.isNoSubstitutionTemplateLiteral(name)\n  ) {\n    return name.text;\n  }\n\n  if (ts.isNumericLiteral(name)) {\n    return name.text;\n  }\n\n  throw new Error(\"Only simple property names are allowed in Event Definitions.\");\n}\n\nfunction getModuleSpecifier(statement: ts.ImportDeclaration): string {\n  const moduleSpecifier = statement.moduleSpecifier;\n  if (\n    !ts.isStringLiteral(moduleSpecifier) &&\n    !ts.isNoSubstitutionTemplateLiteral(moduleSpecifier)\n  ) {\n    throw new Error(\"Import sources must be string literals.\");\n  }\n\n  return moduleSpecifier.text;\n}\n\nfunction createDslNamespace(): Record<string, unknown> {\n  return Object.fromEntries(\n    Object.entries(dsl).filter(([, helper]) => typeof helper === \"function\"),\n  );\n}\n\nfunction getDslHelper(name: string): unknown {\n  const candidate = (dsl as Record<string, unknown>)[name];\n  return typeof candidate === \"function\" ? candidate : undefined;\n}\n\nfunction isIgnorableStatement(statement: ts.Statement): boolean {\n  return ts.isTypeAliasDeclaration(statement) || ts.isInterfaceDeclaration(statement);\n}\n\nfunction formatDiagnostics(filePath: string, diagnostics: readonly ts.Diagnostic[]): string {\n  const header = `TypeScript diagnostics failed for ${filePath}:`;\n  const lines = diagnostics.map((diagnostic) => {\n    const message = ts.flattenDiagnosticMessageText(diagnostic.messageText, \"\\n\");\n    if (diagnostic.file === undefined || diagnostic.start === undefined) {\n      return `- ${message}`;\n    }\n\n    const position = diagnostic.file.getLineAndCharacterOfPosition(diagnostic.start);\n    return `- ${diagnostic.file.fileName}:${position.line + 1}:${position.character + 1} ${message}`;\n  });\n\n  return [header, ...lines].join(\"\\n\");\n}\n\nfunction formatSourceError(filePath: string, message: string): string {\n  return [`TypeScript diagnostics failed for ${filePath}:`, `- ${message}`].join(\"\\n\");\n}\n\nfunction normalizePath(input: string): string {\n  const path = input.replaceAll(\"\\\\\", \"/\");\n  return process.platform === \"win32\" ? path.toLowerCase() : path;\n}\n","import { readFile } from \"node:fs/promises\";\nimport { join } from \"node:path\";\n\nexport function isCanonicalMapFileName(name: string): boolean {\n  if (!/^Map\\d{3,}\\.json$/u.test(name)) return false;\n  const id = Number(name.slice(3, -5));\n  return Number.isSafeInteger(id) && id > 0 && `Map${String(id).padStart(3, \"0\")}.json` === name;\n}\n\nexport type MapInfoEntry = {\n  id: number;\n  name: string;\n  parentId?: unknown;\n};\n\nexport type ProjectIndex = {\n  actorsByName: Map<string, number>;\n  armorsByName: Map<string, number>;\n  commonEventsByName: Map<string, number>;\n  itemsByName: Map<string, number>;\n  mapsByName: Map<string, number>;\n  troopsByName: Map<string, number>;\n  switchesByName: Map<string, number>;\n  variablesByName: Map<string, number>;\n  weaponsByName: Map<string, number>;\n};\n\nexport type LoadedProject = {\n  projectRoot: string;\n  dataDirectory: string;\n  mapInfos: MapInfoEntry[];\n  commonEvents: readonly unknown[];\n  index: ProjectIndex;\n};\n\nexport async function loadProject(projectRoot: string): Promise<LoadedProject> {\n  const dataDirectory = join(projectRoot, \"data\");\n  const [\n    mapInfosRaw,\n    commonEventsRaw,\n    actorsRaw,\n    itemsRaw,\n    weaponsRaw,\n    armorsRaw,\n    troopsRaw,\n    systemRaw,\n  ] = await Promise.all([\n    readFile(join(dataDirectory, \"MapInfos.json\"), \"utf8\"),\n    readFile(join(dataDirectory, \"CommonEvents.json\"), \"utf8\"),\n    readFile(join(dataDirectory, \"Actors.json\"), \"utf8\"),\n    readFile(join(dataDirectory, \"Items.json\"), \"utf8\"),\n    readFile(join(dataDirectory, \"Weapons.json\"), \"utf8\"),\n    readFile(join(dataDirectory, \"Armors.json\"), \"utf8\"),\n    readFile(join(dataDirectory, \"Troops.json\"), \"utf8\"),\n    readFile(join(dataDirectory, \"System.json\"), \"utf8\"),\n  ]);\n\n  const mapInfos = parseMapInfos(mapInfosRaw);\n  const commonEvents = parseCommonEvents(commonEventsRaw);\n  const actors = parseArray<Record<string, unknown>>(actorsRaw);\n  const items = parseArray<Record<string, unknown>>(itemsRaw);\n  const weapons = parseArray<Record<string, unknown>>(weaponsRaw);\n  const armors = parseArray<Record<string, unknown>>(armorsRaw);\n  const troops = parseArray<Record<string, unknown>>(troopsRaw);\n  const system = parseObject<Record<string, unknown>>(systemRaw);\n\n  return {\n    projectRoot,\n    dataDirectory,\n    mapInfos,\n    commonEvents,\n    index: buildProjectIndex({\n      actors,\n      armors,\n      commonEvents,\n      items,\n      mapInfos,\n      troops,\n      system,\n      weapons,\n    }),\n  };\n}\n\nexport function buildProjectIndex(input: {\n  actors: readonly Record<string, unknown>[];\n  armors: readonly Record<string, unknown>[];\n  commonEvents: readonly { id: number; name: string }[];\n  items: readonly Record<string, unknown>[];\n  mapInfos: readonly MapInfoEntry[];\n  troops?: readonly Record<string, unknown>[];\n  system: Record<string, unknown>;\n  weapons: readonly Record<string, unknown>[];\n}): ProjectIndex {\n  return {\n    actorsByName: buildNamedIndex(input.actors),\n    armorsByName: buildNamedIndex(input.armors),\n    commonEventsByName: buildNamedIndex(input.commonEvents),\n    itemsByName: buildNamedIndex(input.items),\n    mapsByName: buildMapIndex(input.mapInfos),\n    troopsByName: buildNamedIndex(input.troops ?? []),\n    switchesByName: buildNamedIndexFromEntries(readSwitchEntries(input.system)),\n    variablesByName: buildNamedIndexFromEntries(readVariableEntries(input.system)),\n    weaponsByName: buildNamedIndex(input.weapons),\n  };\n}\n\nexport function parseMapInfos(raw: string): MapInfoEntry[] {\n  let values: unknown;\n  try {\n    values = JSON.parse(raw);\n  } catch (error) {\n    throw new Error(\"Cannot safely determine Snapshot collection: invalid MapInfos.json JSON.\", {\n      cause: error,\n    });\n  }\n  if (!Array.isArray(values))\n    throw new Error(\"Cannot safely determine Snapshot collection: MapInfos.json must be an array.\");\n  const ids = new Set<number>();\n  return (values as unknown[]).flatMap((entry) => {\n    if (entry === null) return [];\n    if (\n      typeof entry !== \"object\" ||\n      !(\"id\" in entry) ||\n      typeof entry.id !== \"number\" ||\n      !Number.isSafeInteger(entry.id) ||\n      entry.id <= 0 ||\n      ids.has(entry.id)\n    ) {\n      throw new Error(\n        \"Cannot safely determine Snapshot collection: MapInfos.json contains an invalid or duplicate map ID.\",\n      );\n    }\n    ids.add(entry.id);\n    return [\n      {\n        id: entry.id,\n        name: \"name\" in entry && typeof entry.name === \"string\" ? entry.name : \"\",\n        ...(\"parentId\" in entry ? { parentId: entry.parentId } : {}),\n      },\n    ];\n  });\n}\n\nexport function parseCommonEvents(raw: string): { id: number; name: string }[] {\n  const values = parseArray<Record<string, unknown>>(raw);\n\n  return values.flatMap((entry) => {\n    if (!entry) {\n      return [];\n    }\n\n    const id = readPositiveInt(entry.id);\n    const name = readString(entry.name);\n\n    if (id === null || name === null) {\n      return [];\n    }\n\n    return [{ id, name }];\n  });\n}\n\nfunction buildMapIndex(mapInfos: readonly MapInfoEntry[]): Map<string, number> {\n  const index = new Map<string, number>();\n\n  for (const entry of mapInfos) {\n    if (!index.has(entry.name)) {\n      index.set(entry.name, entry.id);\n    }\n  }\n\n  return index;\n}\n\nfunction buildNamedIndex(\n  entries: readonly (Record<string, unknown> | null | undefined)[],\n): Map<string, number> {\n  const index = new Map<string, number>();\n\n  for (const entry of entries) {\n    if (!entry || typeof entry !== \"object\") {\n      continue;\n    }\n    const id = readPositiveInt(entry.id);\n    const name = readString(entry.name);\n\n    if (id !== null && name !== null && !index.has(name)) {\n      index.set(name, id);\n    }\n  }\n\n  return index;\n}\n\nfunction buildNamedIndexFromEntries(\n  entries: readonly { id: number; name: string }[],\n): Map<string, number> {\n  const index = new Map<string, number>();\n\n  for (const entry of entries) {\n    if (!index.has(entry.name)) {\n      index.set(entry.name, entry.id);\n    }\n  }\n\n  return index;\n}\n\nfunction readSwitchEntries(system: Record<string, unknown>): { id: number; name: string }[] {\n  return readDatabaseEntries(system, \"switches\");\n}\n\nfunction readVariableEntries(system: Record<string, unknown>): { id: number; name: string }[] {\n  return readDatabaseEntries(system, \"variables\");\n}\n\nfunction readDatabaseEntries(\n  system: Record<string, unknown>,\n  key: string,\n): { id: number; name: string }[] {\n  const entries = system[key];\n  if (!Array.isArray(entries)) {\n    return [];\n  }\n\n  return entries.flatMap((entry, index) => {\n    if (typeof entry === \"string\") {\n      return entry.length > 0 ? [{ id: index, name: entry }] : [];\n    }\n\n    if (!entry || typeof entry !== \"object\") {\n      return [];\n    }\n\n    const record = entry as Record<string, unknown>;\n    const name = readString(record.name);\n    return name === null ? [] : [{ id: index, name }];\n  });\n}\n\nfunction parseArray<T>(raw: string): T[] {\n  const parsed = JSON.parse(raw);\n  if (!Array.isArray(parsed)) {\n    throw new Error(\"Expected a JSON array.\");\n  }\n\n  return parsed as T[];\n}\n\nfunction parseObject<T>(raw: string): T {\n  const parsed = JSON.parse(raw);\n  if (!parsed || typeof parsed !== \"object\" || Array.isArray(parsed)) {\n    throw new Error(\"Expected a JSON object.\");\n  }\n\n  return parsed as T;\n}\n\nfunction readString(value: unknown): string | null {\n  return typeof value === \"string\" && value.length > 0 ? value : null;\n}\n\nfunction readPositiveInt(value: unknown): number | null {\n  return typeof value === \"number\" && Number.isInteger(value) && value > 0 ? value : null;\n}\n","import { CommandStructureError } from \"../validation/command-errors.js\";\n\nfunction fail(path: string, expected: string, actual: unknown, code = \"MV-MAP-PAGE-SHAPE\"): never {\n  throw new CommandStructureError(code, \"Invalid native Map Event saved shape.\", {\n    nativePath: path,\n    expected,\n    actual: Object.is(actual, -0) ? \"-0\" : String(actual),\n  });\n}\n\nfunction object(\n  value: unknown,\n  path: string,\n  fields: readonly string[],\n  code?: string,\n): Record<string, unknown> {\n  if (\n    !value ||\n    typeof value !== \"object\" ||\n    Array.isArray(value) ||\n    ![Object.prototype, null].includes(Object.getPrototypeOf(value))\n  )\n    fail(path, \"complete saved object\", value, code);\n  const record = value as Record<string, unknown>;\n  for (const key of Reflect.ownKeys(record)) {\n    const descriptor = Object.getOwnPropertyDescriptor(record, key)!;\n    if (\n      typeof key !== \"string\" ||\n      !fields.includes(key) ||\n      !(\"value\" in descriptor) ||\n      !descriptor.enumerable\n    )\n      fail(`${path}${path ? \".\" : \"\"}${String(key)}`, \"supported saved field\", key, code);\n  }\n  for (const key of fields)\n    if (!Object.hasOwn(record, key))\n      fail(`${path}${path ? \".\" : \"\"}${key}`, \"required saved field\", \"<missing>\", code);\n  return record;\n}\n\nfunction integer(\n  value: unknown,\n  path: string,\n  min: number,\n  max: number,\n  code?: string,\n  allowNegativeZero = false,\n): void {\n  if (\n    !Number.isSafeInteger(value) ||\n    (!allowNegativeZero && Object.is(value, -0)) ||\n    (value as number) < min ||\n    (value as number) > max\n  )\n    fail(path, `integer ${min}..${max}`, value, code);\n}\n\nexport function assertNativeMapEvent(\n  value: unknown,\n  index: number,\n): asserts value is Record<string, unknown> {\n  const code = \"MV-MAP-EVENT-SHAPE\";\n  const event = object(value, \"\", [\"id\", \"name\", \"note\", \"x\", \"y\", \"pages\"], code);\n  integer(event.id, \"id\", 1, Number.MAX_SAFE_INTEGER, code);\n  if (event.id !== index) fail(\"id\", `event array position ${index}`, event.id, code);\n  for (const field of [\"name\", \"note\"] as const)\n    if (typeof event[field] !== \"string\") fail(field, \"string\", event[field], code);\n  for (const field of [\"x\", \"y\"] as const)\n    integer(event[field], field, 0, Number.MAX_SAFE_INTEGER, code);\n}\n\nexport function assertNativeMapPage(\n  value: unknown,\n  path: string,\n): asserts value is Record<string, unknown> {\n  const page = object(value, path, [\n    \"conditions\",\n    \"image\",\n    \"moveType\",\n    \"moveSpeed\",\n    \"moveFrequency\",\n    \"moveRoute\",\n    \"priorityType\",\n    \"walkAnime\",\n    \"stepAnime\",\n    \"directionFix\",\n    \"through\",\n    \"trigger\",\n    \"list\",\n  ]);\n  const conditions = object(page.conditions, `${path}.conditions`, [\n    \"actorId\",\n    \"actorValid\",\n    \"itemId\",\n    \"itemValid\",\n    \"selfSwitchCh\",\n    \"selfSwitchValid\",\n    \"switch1Id\",\n    \"switch1Valid\",\n    \"switch2Id\",\n    \"switch2Valid\",\n    \"variableId\",\n    \"variableValid\",\n    \"variableValue\",\n  ]);\n  for (const field of [\"actor\", \"item\", \"switch1\", \"switch2\", \"variable\"])\n    integer(\n      conditions[`${field}Id`],\n      `${path}.conditions.${field}Id`,\n      conditions[`${field}Valid`] === true ? 1 : 0,\n      Number.MAX_SAFE_INTEGER,\n      undefined,\n      conditions[`${field}Valid`] === false,\n    );\n  integer(\n    conditions.variableValue,\n    `${path}.conditions.variableValue`,\n    -99999999,\n    99999999,\n    undefined,\n    true,\n  );\n  for (const field of [\"actor\", \"item\", \"selfSwitch\", \"switch1\", \"switch2\", \"variable\"])\n    if (typeof conditions[`${field}Valid`] !== \"boolean\")\n      fail(`${path}.conditions.${field}Valid`, \"boolean\", conditions[`${field}Valid`]);\n  if (![\"A\", \"B\", \"C\", \"D\"].includes(conditions.selfSwitchCh as string))\n    fail(`${path}.conditions.selfSwitchCh`, \"A/B/C/D\", conditions.selfSwitchCh);\n  const image = object(page.image, `${path}.image`, [\n    \"characterName\",\n    \"characterIndex\",\n    \"tileId\",\n    \"direction\",\n    \"pattern\",\n  ]);\n  if (typeof image.characterName !== \"string\")\n    fail(`${path}.image.characterName`, \"string\", image.characterName);\n  integer(image.characterIndex, `${path}.image.characterIndex`, 0, 7, undefined, true);\n  integer(image.tileId, `${path}.image.tileId`, 0, 1023, undefined, true);\n  integer(image.pattern, `${path}.image.pattern`, 0, 2, undefined, true);\n  if (![2, 4, 6, 8].includes(image.direction as number))\n    fail(`${path}.image.direction`, \"2/4/6/8\", image.direction);\n  for (const field of [\"walkAnime\", \"stepAnime\", \"directionFix\", \"through\"])\n    if (typeof page[field] !== \"boolean\") fail(`${path}.${field}`, \"boolean\", page[field]);\n  integer(page.priorityType, `${path}.priorityType`, 0, 2);\n  integer(page.trigger, `${path}.trigger`, 0, 4);\n}\n\nexport function assertNativeMapPages(value: unknown): asserts value is unknown[] {\n  if (!Array.isArray(value) || value.length === 0)\n    fail(\"pages\", \"nonempty dense page array\", value);\n  for (let index = 0; index < value.length; index++)\n    if (!Object.hasOwn(value, index)) fail(`pages[${index}]`, \"saved page\", \"<missing>\");\n}\n\nexport function assertNativeMapEvents(value: unknown): asserts value is unknown[] {\n  if (!Array.isArray(value) || value.length === 0)\n    fail(\n      \"events\",\n      \"nonempty dense event array with required null slot zero\",\n      value,\n      \"MV-MAP-EVENT-SHAPE\",\n    );\n  for (let index = 0; index < value.length; index++) {\n    if (!Object.hasOwn(value, index) || (index === 0 && value[index] !== null))\n      fail(\n        `events[${index}]`,\n        \"event or null hole (slot zero must be null)\",\n        value[index],\n        \"MV-MAP-EVENT-SHAPE\",\n      );\n  }\n}\n","import { assertStrictJson } from \"./json-values.js\";\n\nexport function writeStableJson(value: unknown): string {\n  assertStrictJson(value);\n  return `${stringify(value)}\\n`;\n}\n\nfunction stringify(value: unknown, indent = 0): string {\n  if (value === null) {\n    return \"null\";\n  }\n  if (typeof value === \"number\" || typeof value === \"boolean\") {\n    return Object.is(value, -0) ? \"-0\" : JSON.stringify(value);\n  }\n  if (typeof value === \"string\") {\n    return JSON.stringify(value);\n  }\n  if (Array.isArray(value)) {\n    if (value.length === 0) {\n      return \"[]\";\n    }\n    const nextIndent = indent + 2;\n    const entries = value.map(\n      (entry) => `${\" \".repeat(nextIndent)}${stringify(entry, nextIndent)}`,\n    );\n    return `[\\n${entries.join(\",\\n\")}\\n${\" \".repeat(indent)}]`;\n  }\n  if (typeof value === \"object\") {\n    const entries = Object.entries(value as Record<string, unknown>);\n    if (entries.length === 0) {\n      return \"{}\";\n    }\n    const nextIndent = indent + 2;\n    const lines = entries.map(([key, entry]) => {\n      return `${\" \".repeat(nextIndent)}${JSON.stringify(key)}:${stringify(entry, nextIndent)}`;\n    });\n    return `{\\n${lines.join(\",\\n\")}\\n${\" \".repeat(indent)}}`;\n  }\n\n  return \"null\";\n}\n","import { mkdir, readFile, rename, rm, stat, writeFile } from \"node:fs/promises\";\nimport { createHash, randomUUID } from \"node:crypto\";\nimport { dirname, posix, resolve } from \"node:path\";\n\nimport { z } from \"zod\";\n\nimport { isCanonicalMapFileName, parseMapInfos } from \"../project-data/project.js\";\nimport { writeStableJson } from \"../project-data/writer.js\";\nimport { typeInputSchema } from \"./type-inputs.js\";\n\nexport const workspaceStateDirectoryName = \".rpgmaker-event-dsl\";\nexport const projectDataSnapshotDirectoryName = \"project-data-snapshot\";\nexport const generatedProjectDataDirectoryName = \"generated-project-data\";\nexport const syncManifestFileName = \"sync-manifest.json\";\nexport const pendingPushDirectoryName = \"pending-push\";\nexport const pendingPushBackupDirectoryName = \"backup\";\nexport const pendingPushManifestFileName = \"pending-push.json\";\n\nexport const standardDatabaseFileNames = [\n  \"Actors.json\",\n  \"Animations.json\",\n  \"Armors.json\",\n  \"Classes.json\",\n  \"CommonEvents.json\",\n  \"Enemies.json\",\n  \"Items.json\",\n  \"MapInfos.json\",\n  \"Skills.json\",\n  \"States.json\",\n  \"System.json\",\n  \"Tilesets.json\",\n  \"Troops.json\",\n  \"Weapons.json\",\n] as const;\n\nconst hashSchema = z.string().regex(/^[a-f0-9]{64}$/u);\nconst projectDataFileNameSchema = z\n  .string()\n  .refine(\n    (name) =>\n      (standardDatabaseFileNames as readonly string[]).includes(name) ||\n      isCanonicalMapFileName(name),\n  );\nconst projectDataHashSchema = z\n  .object({ hash: hashSchema, relativePath: projectDataFileNameSchema })\n  .strict();\nconst projectDataHashesSchema = z\n  .array(projectDataHashSchema)\n  .refine((files) => new Set(files.map(({ relativePath }) => relativePath)).size === files.length);\n\nexport const syncManifestSchema = z\n  .object({\n    version: z.literal(1),\n    projectRootBinding: z.string().min(1),\n    compileBaseline: z\n      .object({\n        projectRootBinding: z.string().min(1),\n        compileContractVersion: z.string().min(1).optional(),\n        typeInputs: z.array(typeInputSchema).optional(),\n        hash: hashSchema,\n        config: z\n          .object({\n            scriptEnabled: z.boolean(),\n            sourceExclude: z.array(z.string().min(1)),\n            sourceInclude: z.array(z.string().min(1)),\n            sourceRoot: z.string().min(1),\n          })\n          .strict(),\n        snapshotFiles: projectDataHashesSchema,\n        sourceFiles: z.array(\n          z\n            .object({\n              hash: hashSchema,\n              relativePath: z.string().min(1),\n            })\n            .strict(),\n        ),\n      })\n      .strict()\n      .optional(),\n    generatedFiles: projectDataHashesSchema.optional(),\n    snapshotFiles: projectDataHashesSchema.refine((files) =>\n      standardDatabaseFileNames.every((name) =>\n        files.some(({ relativePath }) => relativePath === name),\n      ),\n    ),\n  })\n  .strict();\n\nexport const pendingPushSchema = z\n  .object({\n    originalManifest: syncManifestSchema,\n    originalManifestHash: hashSchema,\n    projectRootBinding: z.string().min(1),\n    affectedFiles: z\n      .array(\n        z\n          .object({\n            backupHash: hashSchema,\n            backupRelativePath: projectDataFileNameSchema,\n            generatedHash: hashSchema,\n            relativePath: projectDataFileNameSchema,\n            snapshotHash: hashSchema,\n          })\n          .strict(),\n      )\n      .min(1),\n    startedAt: z.string().min(1),\n    version: z.literal(3),\n  })\n  .strict();\n\nexport type WorkspaceStatePaths = {\n  snapshotContents?: ReadonlyMap<string, Buffer>;\n  workspaceStateDirectory: string;\n  projectDataSnapshotDirectory: string;\n  generatedProjectDataDirectory: string;\n  pendingPushDirectory: string;\n  pendingPushBackupDirectory: string;\n  pendingPushManifestPath: string;\n  syncManifestPath: string;\n};\n\nexport async function readProjectDataSnapshotFile(\n  statePaths: WorkspaceStatePaths,\n  relativePath: string,\n): Promise<string> {\n  if (statePaths.snapshotContents !== undefined) {\n    const content = statePaths.snapshotContents.get(relativePath);\n    if (content === undefined)\n      throw new Error(`Captured Snapshot file is missing: ${relativePath}`);\n    return content.toString(\"utf8\");\n  }\n  return readFile(resolve(statePaths.projectDataSnapshotDirectory, relativePath), \"utf8\");\n}\n\nexport type SyncManifest = z.infer<typeof syncManifestSchema>;\nexport type PendingPush = z.infer<typeof pendingPushSchema>;\n\nexport type SnapshotFilePlan = {\n  relativePath: string;\n  sourcePath: string;\n  content: Buffer;\n  hash: string;\n};\n\nexport function getWorkspaceStatePaths(workspaceRoot: string): WorkspaceStatePaths {\n  const workspaceStateDirectory = resolve(workspaceRoot, workspaceStateDirectoryName);\n\n  return {\n    workspaceStateDirectory,\n    projectDataSnapshotDirectory: resolve(\n      workspaceStateDirectory,\n      projectDataSnapshotDirectoryName,\n    ),\n    generatedProjectDataDirectory: resolve(\n      workspaceStateDirectory,\n      generatedProjectDataDirectoryName,\n    ),\n    pendingPushDirectory: resolve(workspaceStateDirectory, pendingPushDirectoryName),\n    pendingPushBackupDirectory: resolve(\n      workspaceStateDirectory,\n      pendingPushDirectoryName,\n      pendingPushBackupDirectoryName,\n    ),\n    pendingPushManifestPath: resolve(\n      workspaceStateDirectory,\n      pendingPushDirectoryName,\n      pendingPushManifestFileName,\n    ),\n    syncManifestPath: resolve(workspaceStateDirectory, syncManifestFileName),\n  };\n}\n\nexport async function readSyncManifest(manifestPath: string): Promise<SyncManifest | null> {\n  try {\n    const rawManifest = new TextDecoder(\"utf-8\", { fatal: true, ignoreBOM: true }).decode(\n      await readFile(manifestPath),\n    );\n    return syncManifestSchema.parse(JSON.parse(rawManifest));\n  } catch (error) {\n    if (isMissingFileError(error)) {\n      return null;\n    }\n\n    throw new Error(\n      `Unknown or corrupt Sync Manifest at ${manifestPath}. Run pull to establish a new Snapshot when no Interrupted Push is pending.`,\n      { cause: error },\n    );\n  }\n}\n\nexport async function readPendingPush(manifestPath: string): Promise<PendingPush | null> {\n  return (await readPendingPushEvidence(manifestPath))?.pending ?? null;\n}\n\nexport async function readPendingPushEvidence(\n  manifestPath: string,\n): Promise<{ pending: PendingPush; bytes: Buffer } | null> {\n  try {\n    const bytes = await readFile(manifestPath);\n    const rawManifest = new TextDecoder(\"utf-8\", { fatal: true, ignoreBOM: true }).decode(bytes);\n    return { pending: pendingPushSchema.parse(JSON.parse(rawManifest)), bytes };\n  } catch (error) {\n    if (isMissingFileError(error)) {\n      const directory = await stat(dirname(manifestPath)).catch((directoryError: unknown) => {\n        if (isMissingFileError(directoryError)) return null;\n        throw directoryError;\n      });\n      if (directory === null) return null;\n      throw new Error(\n        `Interrupted Push state is incomplete: missing ${manifestPath}. Recovery stopped without changes.`,\n        { cause: error },\n      );\n    }\n    throw new Error(\n      `Unknown or corrupt Interrupted Push state at ${manifestPath}. Recovery stopped without changes.`,\n      { cause: error },\n    );\n  }\n}\n\nexport async function writeSyncManifest(\n  manifestPath: string,\n  manifest: SyncManifest,\n  assertInputsUnchanged?: () => Promise<void>,\n): Promise<void> {\n  await mkdir(dirname(manifestPath), { recursive: true });\n\n  const tempManifestPath = `${manifestPath}.tmp-${process.pid}-${randomUUID()}`;\n  try {\n    await writeFile(tempManifestPath, writeStableJson(manifest), \"utf8\");\n    await assertInputsUnchanged?.();\n    await rename(tempManifestPath, manifestPath);\n  } finally {\n    await rm(tempManifestPath, { force: true });\n  }\n}\n\nexport async function captureStandardProjectDataSnapshot(options: {\n  dataDirectory: string;\n  projectRootBinding: string;\n  statePaths: WorkspaceStatePaths;\n  assertWorkspaceUnchanged: () => Promise<void>;\n}): Promise<SyncManifest> {\n  const snapshotPlan = await collectStandardProjectDataSnapshotPlan(options.dataDirectory);\n  const manifest: SyncManifest = {\n    version: 1,\n    projectRootBinding: options.projectRootBinding,\n    snapshotFiles: snapshotPlan\n      .map(({ hash, relativePath }) => ({ hash, relativePath }))\n      .sort((left, right) => left.relativePath.localeCompare(right.relativePath)),\n  };\n  await writeSnapshotState(\n    options.statePaths,\n    snapshotPlan,\n    manifest,\n    options.assertWorkspaceUnchanged,\n  );\n  return manifest;\n}\n\nexport async function collectStandardProjectDataSnapshotPlan(\n  dataDirectory: string,\n): Promise<SnapshotFilePlan[]> {\n  const mapInfosPath = resolve(dataDirectory, \"MapInfos.json\");\n  const mapInfosRaw = await readFile(mapInfosPath);\n  const mapFileNames = parseMapInfos(decodeProjectData(mapInfosRaw, \"MapInfos.json\")).map(\n    ({ id }) => formatMapFileName(id),\n  );\n\n  const fileNames = [...standardDatabaseFileNames, ...mapFileNames];\n\n  const snapshotPlan: SnapshotFilePlan[] = [];\n\n  for (const fileName of fileNames) {\n    const sourcePath = resolve(dataDirectory, fileName);\n    await assertReadableFile(sourcePath);\n\n    const rawContent = fileName === \"MapInfos.json\" ? mapInfosRaw : await readFile(sourcePath);\n    assertProjectDataCarrier(decodeProjectData(rawContent, fileName), fileName);\n    snapshotPlan.push({\n      content: rawContent,\n      hash: hashContent(rawContent),\n      relativePath: toPosixPath(fileName),\n      sourcePath,\n    });\n  }\n\n  snapshotPlan.sort((left, right) => left.relativePath.localeCompare(right.relativePath));\n  return snapshotPlan;\n}\n\nfunction assertProjectDataCarrier(content: string, fileName: string): void {\n  try {\n    const value: unknown = JSON.parse(content);\n    const object = typeof value === \"object\" && value !== null && !Array.isArray(value);\n    if (\n      fileName === \"System.json\"\n        ? object\n        : fileName.startsWith(\"Map\") && fileName !== \"MapInfos.json\"\n          ? object && \"events\" in value && Array.isArray(value.events)\n          : Array.isArray(value)\n    )\n      return;\n    throw new Error(\"Unexpected carrier shape\");\n  } catch (error) {\n    throw new Error(\n      `Cannot safely locate Project data carrier in ${fileName}. Snapshot capture stopped without publication.`,\n      { cause: error },\n    );\n  }\n}\n\nasync function writeSnapshotState(\n  statePaths: WorkspaceStatePaths,\n  snapshotPlan: readonly SnapshotFilePlan[],\n  manifest: SyncManifest,\n  assertWorkspaceUnchanged: () => Promise<void>,\n): Promise<void> {\n  const tempSnapshotDirectory = resolve(\n    statePaths.workspaceStateDirectory,\n    `${projectDataSnapshotDirectoryName}.tmp-${process.pid}-${randomUUID()}`,\n  );\n\n  await mkdir(dirname(statePaths.projectDataSnapshotDirectory), { recursive: true });\n  await rm(tempSnapshotDirectory, { force: true, recursive: true });\n  await mkdir(tempSnapshotDirectory, { recursive: true });\n\n  try {\n    for (const filePlan of snapshotPlan) {\n      const destinationPath = resolve(tempSnapshotDirectory, filePlan.relativePath);\n      await mkdir(dirname(destinationPath), { recursive: true });\n      await writeFile(destinationPath, filePlan.content);\n    }\n\n    for (const filePlan of snapshotPlan) {\n      const current = await readFile(filePlan.sourcePath).catch((error: unknown) => {\n        throw new Error(\n          `Project data changed during Snapshot capture: ${filePlan.relativePath}. Run clone or pull again.`,\n          { cause: error },\n        );\n      });\n      if (!current.equals(filePlan.content)) {\n        throw new Error(\n          `Project data changed during Snapshot capture: ${filePlan.relativePath}. Run clone or pull again.`,\n        );\n      }\n    }\n    await assertWorkspaceUnchanged();\n    await replaceDirectory(tempSnapshotDirectory, statePaths.projectDataSnapshotDirectory, () =>\n      writeSyncManifest(statePaths.syncManifestPath, manifest),\n    );\n  } catch (error) {\n    await rm(tempSnapshotDirectory, { force: true, recursive: true });\n    throw error;\n  }\n}\n\nasync function replaceDirectory(\n  sourceDirectory: string,\n  targetDirectory: string,\n  publishManifest: () => Promise<void>,\n): Promise<void> {\n  const targetExists = await exists(targetDirectory);\n  const backupDirectory = targetExists\n    ? `${targetDirectory}.bak-${process.pid}-${randomUUID()}`\n    : null;\n\n  if (backupDirectory !== null) {\n    await rm(backupDirectory, { force: true, recursive: true });\n    await rename(targetDirectory, backupDirectory);\n  }\n\n  try {\n    await rename(sourceDirectory, targetDirectory);\n    await publishManifest();\n  } catch (error) {\n    await rm(targetDirectory, { force: true, recursive: true });\n    if (backupDirectory !== null) {\n      await rename(backupDirectory, targetDirectory);\n    }\n\n    throw error;\n  }\n\n  if (backupDirectory !== null) {\n    await rm(backupDirectory, { force: true, recursive: true });\n  }\n}\n\nasync function assertReadableFile(filePath: string): Promise<void> {\n  const fileStats = await stat(filePath);\n\n  if (!fileStats.isFile()) {\n    throw new Error(`Expected ${filePath} to be a file.`);\n  }\n}\n\nfunction decodeProjectData(content: Buffer, relativePath: string): string {\n  try {\n    return new TextDecoder(\"utf-8\", { fatal: true, ignoreBOM: true }).decode(content);\n  } catch (error) {\n    throw new Error(\n      `Invalid UTF-8 Project data: ${relativePath}. Snapshot capture stopped without publication.`,\n      { cause: error },\n    );\n  }\n}\n\nfunction hashContent(content: string | Buffer): string {\n  return createHash(\"sha256\").update(content).digest(\"hex\");\n}\n\nexport function hashUtf8Content(content: string): string {\n  return hashContent(content);\n}\n\nfunction formatMapFileName(mapId: number): string {\n  return `Map${mapId.toString().padStart(3, \"0\")}.json`;\n}\n\nfunction toPosixPath(path: string): string {\n  return path.split(/[/\\\\]/u).join(posix.sep);\n}\n\nasync function exists(path: string): Promise<boolean> {\n  try {\n    await stat(path);\n    return true;\n  } catch (error) {\n    if (isMissingFileError(error)) {\n      return false;\n    }\n\n    throw error;\n  }\n}\n\nfunction isMissingFileError(error: unknown): boolean {\n  return (\n    error instanceof Error &&\n    \"code\" in error &&\n    typeof (error as { code?: unknown }).code === \"string\" &&\n    (error as { code?: string }).code === \"ENOENT\"\n  );\n}\n","import type { ReferenceKind, ReferenceValue } from \"../domain/types.js\";\nimport {\n  isAssetReference,\n  isProjectDataReference,\n  isRuntimeSelector,\n  isScriptInput,\n} from \"../domain/references.js\";\nimport type { CommandInputPrimitiveInspection } from \"./types.js\";\n\nexport function collectCommandInputPrimitives(\n  value: unknown,\n  inspection: CommandInputPrimitiveInspection,\n  seen: Set<object>,\n): void {\n  if (!value || typeof value !== \"object\") {\n    return;\n  }\n  if (seen.has(value)) {\n    return;\n  }\n\n  seen.add(value);\n\n  if (isProjectDataReference(value)) {\n    inspection.projectDataReferences.push(value);\n    return;\n  }\n  if (isAssetReference(value)) {\n    inspection.assetReferences.push(value);\n    return;\n  }\n  if (isRuntimeSelector(value)) {\n    inspection.runtimeSelectors.push(value);\n    return;\n  }\n  if (isScriptInput(value)) {\n    inspection.scriptInputs.push(value);\n    return;\n  }\n\n  if (Array.isArray(value)) {\n    for (const item of value) {\n      collectCommandInputPrimitives(item, inspection, seen);\n    }\n    return;\n  }\n\n  for (const nestedValue of Object.values(value)) {\n    collectCommandInputPrimitives(nestedValue, inspection, seen);\n  }\n}\n\nexport function isReferenceValue(value: unknown): value is ReferenceValue<ReferenceKind> {\n  return isProjectDataReference(value);\n}\n","import type {\n  CommandOperand,\n  ControlVariablesDslCommand,\n  OperateValueOperand,\n  ReferenceKind,\n  ReferenceRange,\n  ReferenceValue,\n} from \"../../domain/types.js\";\nimport type { ReferenceResolver } from \"../../validation/types.js\";\n\nexport function resolveControlValue(value: boolean): number {\n  return value ? 0 : 1;\n}\n\nexport function isReferenceValue(value: unknown): value is ReferenceValue<\"variable\"> {\n  return (\n    !!value &&\n    typeof value === \"object\" &&\n    \"kind\" in value &&\n    (value as { kind?: unknown }).kind === \"variable\"\n  );\n}\n\nexport function compileControlVariablesParameters(\n  node: ControlVariablesDslCommand,\n  resolver: ReferenceResolver,\n): unknown[] {\n  const [startVariableId, endVariableId] = compileReferenceTargetRange(node.variable, resolver);\n  const operation =\n    node.operation === \"set\"\n      ? 0\n      : node.operation === \"add\"\n        ? 1\n        : node.operation === \"sub\"\n          ? 2\n          : node.operation === \"mul\"\n            ? 3\n            : node.operation === \"div\"\n              ? 4\n              : 5;\n\n  if (typeof node.value === \"number\") {\n    return [startVariableId, endVariableId, operation, 0, node.value];\n  }\n\n  if (\"kind\" in node.value && node.value.kind === \"random\") {\n    return [startVariableId, endVariableId, operation, 2, node.value.from, node.value.to];\n  }\n\n  if (\"kind\" in node.value && node.value.kind === \"script\") {\n    return [startVariableId, endVariableId, operation, 4, node.value.script.code];\n  }\n\n  if (\"kind\" in node.value && node.value.kind === \"gameData\") {\n    return [\n      startVariableId,\n      endVariableId,\n      operation,\n      3,\n      ...compileControlVariablesGameDataOperand(node.value, resolver),\n    ];\n  }\n\n  return [startVariableId, endVariableId, operation, 1, resolver.resolveReference(node.value)];\n}\n\nexport function compileReferenceTargetRange<TKind extends ReferenceKind>(\n  target: ReferenceValue<TKind> | ReferenceRange<TKind>,\n  resolver: ReferenceResolver,\n): [number, number] {\n  if (\"from\" in target) {\n    return [resolver.resolveReference(target.from), resolver.resolveReference(target.to)];\n  }\n\n  const id = resolver.resolveReference(target);\n  return [id, id];\n}\n\nexport function compileOperateValueParameters(\n  operation: \"gain\" | \"lose\",\n  operand: OperateValueOperand,\n  resolver: ReferenceResolver,\n): [number, number, number] {\n  return [\n    operation === \"gain\" ? 0 : 1,\n    isReferenceValue(operand) ? 1 : 0,\n    isReferenceValue(operand) ? resolver.resolveReference(operand) : operand,\n  ];\n}\n\nexport function compileControlVariablesGameDataOperand(\n  operand: Extract<CommandOperand, { kind: \"gameData\" }>,\n  resolver: ReferenceResolver,\n): [number, number, number] {\n  switch (operand.source) {\n    case \"item\":\n      return [0, resolver.resolveReference(operand.item), 0];\n    case \"weapon\":\n      return [1, resolver.resolveReference(operand.weapon), 0];\n    case \"armor\":\n      return [2, resolver.resolveReference(operand.armor), 0];\n    case \"actor\":\n      return [3, resolver.resolveReference(operand.actor), actorGameDataValueToCode(operand.value)];\n    case \"enemy\":\n      return [4, operand.enemyIndex, enemyGameDataValueToCode(operand.value)];\n    case \"character\":\n      return [5, operand.characterId, characterGameDataValueToCode(operand.value)];\n    case \"party\":\n      return [6, operand.memberIndex, 0];\n    case \"other\":\n      return [7, otherGameDataValueToCode(operand.value), 0];\n  }\n}\n\nexport function actorGameDataValueToCode(\n  value: Extract<CommandOperand, { kind: \"gameData\"; source: \"actor\" }>[\"value\"],\n): number {\n  switch (value) {\n    case \"level\":\n      return 0;\n    case \"exp\":\n      return 1;\n    case \"hp\":\n      return 2;\n    case \"mp\":\n      return 3;\n    case \"mhp\":\n      return 4;\n    case \"mmp\":\n      return 5;\n    case \"atk\":\n      return 6;\n    case \"def\":\n      return 7;\n    case \"mat\":\n      return 8;\n    case \"mdf\":\n      return 9;\n    case \"agi\":\n      return 10;\n    case \"luk\":\n      return 11;\n  }\n}\n\nexport function enemyGameDataValueToCode(\n  value: Extract<CommandOperand, { kind: \"gameData\"; source: \"enemy\" }>[\"value\"],\n): number {\n  switch (value) {\n    case \"hp\":\n      return 0;\n    case \"mp\":\n      return 1;\n    case \"mhp\":\n      return 2;\n    case \"mmp\":\n      return 3;\n    case \"atk\":\n      return 4;\n    case \"def\":\n      return 5;\n    case \"mat\":\n      return 6;\n    case \"mdf\":\n      return 7;\n    case \"agi\":\n      return 8;\n    case \"luk\":\n      return 9;\n  }\n}\n\nexport function characterGameDataValueToCode(\n  value: Extract<CommandOperand, { kind: \"gameData\"; source: \"character\" }>[\"value\"],\n): number {\n  switch (value) {\n    case \"mapX\":\n      return 0;\n    case \"mapY\":\n      return 1;\n    case \"direction\":\n      return 2;\n    case \"screenX\":\n      return 3;\n    case \"screenY\":\n      return 4;\n  }\n}\n\nexport function otherGameDataValueToCode(\n  value: Extract<CommandOperand, { kind: \"gameData\"; source: \"other\" }>[\"value\"],\n): number {\n  switch (value) {\n    case \"mapId\":\n      return 0;\n    case \"partyMembers\":\n      return 1;\n    case \"gold\":\n      return 2;\n    case \"steps\":\n      return 3;\n    case \"playTime\":\n      return 4;\n    case \"timer\":\n      return 5;\n    case \"saveCount\":\n      return 6;\n    case \"battleCount\":\n      return 7;\n    case \"winCount\":\n      return 8;\n    case \"escapeCount\":\n      return 9;\n  }\n}\n","import type {\n  ConditionalBranchCondition,\n  ConditionalVariableOperator,\n  VehicleTarget,\n} from \"../../domain/types.js\";\nimport type { ReferenceResolver } from \"../../validation/types.js\";\nimport { isReferenceValue } from \"../../validation/inspection.js\";\nimport { resolveControlValue } from \"../../commands/variables/compile.js\";\n\nexport function compileConditionalBranchParameters(\n  condition: ConditionalBranchCondition,\n  resolver: ReferenceResolver,\n): unknown[] {\n  switch (condition.kind) {\n    case \"switch\":\n      return [0, resolver.resolveReference(condition.switch), resolveControlValue(condition.value)];\n    case \"variable\":\n      return [\n        1,\n        resolver.resolveReference(condition.variable),\n        isReferenceValue(condition.value) ? 1 : 0,\n        isReferenceValue(condition.value)\n          ? resolver.resolveReference(condition.value)\n          : condition.value,\n        conditionalVariableOperatorToCode(condition.operator),\n      ];\n    case \"selfSwitch\":\n      return [2, condition.selfSwitch, resolveControlValue(condition.value)];\n    case \"timer\":\n      return [3, condition.seconds, condition.operator === \"ge\" ? 0 : 1];\n    case \"actor\":\n      return condition.check.kind === \"inParty\"\n        ? [4, resolver.resolveReference(condition.actor), 0]\n        : [\n            4,\n            resolver.resolveReference(condition.actor),\n            actorConditionCheckToCode(condition.check),\n            actorConditionCheckValue(condition.check, resolver),\n          ];\n    case \"enemy\":\n      return condition.check.kind === \"appeared\"\n        ? [5, condition.enemyIndex, 0]\n        : [5, condition.enemyIndex, 1, resolver.resolveReference(condition.check.state)];\n    case \"character\":\n      return [6, condition.characterId, condition.direction];\n    case \"gold\":\n      return [7, condition.amount, goldConditionOperatorToCode(condition.operator)];\n    case \"item\":\n      return [8, resolver.resolveReference(condition.item)];\n    case \"weapon\":\n      return [9, resolver.resolveReference(condition.weapon), condition.includeEquipment ?? false];\n    case \"armor\":\n      return [10, resolver.resolveReference(condition.armor), condition.includeEquipment ?? false];\n    case \"button\":\n      return [11, condition.button];\n    case \"script\":\n      return [12, condition.script.code];\n    case \"vehicle\":\n      return [13, vehicleToCode(condition.vehicle)];\n  }\n}\n\nexport function conditionalVariableOperatorToCode(operator: ConditionalVariableOperator): number {\n  switch (operator) {\n    case \"eq\":\n      return 0;\n    case \"ge\":\n      return 1;\n    case \"le\":\n      return 2;\n    case \"gt\":\n      return 3;\n    case \"lt\":\n      return 4;\n    case \"ne\":\n      return 5;\n  }\n}\n\nexport function actorConditionCheckToCode(\n  check: Extract<ConditionalBranchCondition, { kind: \"actor\" }>[\"check\"],\n): number {\n  switch (check.kind) {\n    case \"inParty\":\n      return 0;\n    case \"name\":\n      return 1;\n    case \"class\":\n      return 2;\n    case \"skill\":\n      return 3;\n    case \"weapon\":\n      return 4;\n    case \"armor\":\n      return 5;\n    case \"state\":\n      return 6;\n  }\n}\n\nexport function actorConditionCheckValue(\n  check: Extract<ConditionalBranchCondition, { kind: \"actor\" }>[\"check\"],\n  resolver: ReferenceResolver,\n): unknown {\n  switch (check.kind) {\n    case \"inParty\":\n      return 0;\n    case \"name\":\n      return check.name;\n    case \"class\":\n      return resolver.resolveReference(check.class);\n    case \"skill\":\n      return resolver.resolveReference(check.skill);\n    case \"weapon\":\n      return resolver.resolveReference(check.weapon);\n    case \"armor\":\n      return resolver.resolveReference(check.armor);\n    case \"state\":\n      return resolver.resolveReference(check.state);\n  }\n}\n\nexport function goldConditionOperatorToCode(\n  operator: Extract<ConditionalBranchCondition, { kind: \"gold\" }>[\"operator\"],\n): number {\n  switch (operator) {\n    case \"ge\":\n      return 0;\n    case \"le\":\n      return 1;\n    case \"lt\":\n      return 2;\n  }\n}\n\nexport function vehicleToCode(\n  vehicle: Extract<ConditionalBranchCondition, { kind: \"vehicle\" }>[\"vehicle\"] | VehicleTarget,\n): number {\n  switch (vehicle) {\n    case \"boat\":\n      return 0;\n    case \"ship\":\n      return 1;\n    case \"airship\":\n      return 2;\n  }\n}\n","import type {\n  CharacterRuntimeSelector,\n  DslCommand,\n  MoveRouteCommand,\n  MovementRoute,\n  VehicleTarget,\n} from \"../../domain/types.js\";\nimport type { ReferenceResolver } from \"../../validation/types.js\";\nimport { vehicleToCode } from \"../../compiler/shared/conditions.js\";\nimport { assertMovementRoute, assertNativeMovementRecord } from \"./validation.js\";\nimport type { NativeMovementRecord } from \"./types.js\";\nexport type { NativeMovementRecord } from \"./types.js\";\n\nexport function characterSelectorToCode(selector: CharacterRuntimeSelector): number {\n  switch (selector.target) {\n    case \"player\":\n      return -1;\n    case \"currentEvent\":\n      return 0;\n    case \"event\":\n      return selector.id;\n  }\n}\n\nexport function compileSetVehicleLocationParameters(\n  vehicle: VehicleTarget,\n  destination: Extract<DslCommand, { kind: \"setVehicleLocation\" }>[\"destination\"],\n  resolver: ReferenceResolver,\n): unknown[] {\n  const vehicleCode = vehicleToCode(vehicle);\n  if (destination.kind === \"direct\") {\n    return [\n      vehicleCode,\n      0,\n      resolver.resolveReference(destination.map),\n      destination.x,\n      destination.y,\n    ];\n  }\n\n  return [\n    vehicleCode,\n    1,\n    resolver.resolveReference(destination.map),\n    resolver.resolveReference(destination.x),\n    resolver.resolveReference(destination.y),\n  ];\n}\n\nexport function compileSetEventLocationParameters(\n  node: Extract<DslCommand, { kind: \"setEventLocation\" }>,\n  resolver: ReferenceResolver,\n): unknown[] {\n  const characterId = characterSelectorToCode(node.character);\n\n  switch (node.destination.kind) {\n    case \"direct\":\n      return [characterId, 0, node.destination.x, node.destination.y, node.direction ?? 0];\n    case \"variables\":\n      return [\n        characterId,\n        1,\n        resolver.resolveReference(node.destination.x),\n        resolver.resolveReference(node.destination.y),\n        node.direction ?? 0,\n      ];\n    case \"exchange\":\n      return [\n        characterId,\n        2,\n        characterSelectorToCode(node.destination.character),\n        0,\n        node.direction ?? 0,\n      ];\n  }\n}\n\nexport function compileMovementRoute(\n  route: MovementRoute,\n  resolver: ReferenceResolver,\n  path = \"route\",\n) {\n  assertMovementRoute(route, path);\n  return {\n    list: compileMoveRouteCommands(route, resolver, path),\n    repeat: route.repeat ?? true,\n    skippable: route.skippable ?? false,\n    wait: route.wait ?? false,\n  };\n}\n\nexport function compileMoveRouteCommands(\n  route: MovementRoute,\n  resolver: ReferenceResolver,\n  path = \"route\",\n): NativeMovementRecord[] {\n  return [\n    ...route.commands.map((command, index) =>\n      compileMoveRouteCommand(command, resolver, `${path}.commands[${index}]`),\n    ),\n    route.terminator?.parameters === \"absent\" ? { code: 0 } : { code: 0, parameters: [] },\n  ];\n}\n\nexport function compileMoveRouteCommand(\n  command: MoveRouteCommand,\n  resolver: ReferenceResolver,\n  path = \"route.commands\",\n): NativeMovementRecord {\n  const record: NativeMovementRecord = compileMoveRouteInstruction(command, resolver);\n  if (record.parameters?.length === 0) delete record.parameters;\n  if (command.savedShape?.indent === \"null\") record.indent = null;\n  if (command.savedShape?.indent === \"zero\") record.indent = 0;\n  assertNativeMovementRecord(record, { dslPath: path });\n  return record;\n}\n\nfunction compileMoveRouteInstruction(\n  command: MoveRouteCommand,\n  resolver: ReferenceResolver,\n): { code: number; parameters: unknown[] } {\n  switch (command.kind) {\n    case \"moveDown\":\n      return { code: 1, parameters: [] };\n    case \"moveLeft\":\n      return { code: 2, parameters: [] };\n    case \"moveRight\":\n      return { code: 3, parameters: [] };\n    case \"moveUp\":\n      return { code: 4, parameters: [] };\n    case \"moveLowerLeft\":\n      return { code: 5, parameters: [] };\n    case \"moveLowerRight\":\n      return { code: 6, parameters: [] };\n    case \"moveUpperLeft\":\n      return { code: 7, parameters: [] };\n    case \"moveUpperRight\":\n      return { code: 8, parameters: [] };\n    case \"moveRandom\":\n      return { code: 9, parameters: [] };\n    case \"moveTowardPlayer\":\n      return { code: 10, parameters: [] };\n    case \"moveAwayFromPlayer\":\n      return { code: 11, parameters: [] };\n    case \"moveForward\":\n      return { code: 12, parameters: [] };\n    case \"moveBackward\":\n      return { code: 13, parameters: [] };\n    case \"jump\":\n      return { code: 14, parameters: [command.x, command.y] };\n    case \"wait\":\n      return { code: 15, parameters: [command.frames] };\n    case \"turnDown\":\n      return { code: 16, parameters: [] };\n    case \"turnLeft\":\n      return { code: 17, parameters: [] };\n    case \"turnRight\":\n      return { code: 18, parameters: [] };\n    case \"turnUp\":\n      return { code: 19, parameters: [] };\n    case \"turn90Right\":\n      return { code: 20, parameters: [] };\n    case \"turn90Left\":\n      return { code: 21, parameters: [] };\n    case \"turn180\":\n      return { code: 22, parameters: [] };\n    case \"turn90RightOrLeft\":\n      return { code: 23, parameters: [] };\n    case \"turnRandom\":\n      return { code: 24, parameters: [] };\n    case \"turnTowardPlayer\":\n      return { code: 25, parameters: [] };\n    case \"turnAwayFromPlayer\":\n      return { code: 26, parameters: [] };\n    case \"switchOn\":\n      return { code: 27, parameters: [resolver.resolveReference(command.switch)] };\n    case \"switchOff\":\n      return { code: 28, parameters: [resolver.resolveReference(command.switch)] };\n    case \"changeSpeed\":\n      return { code: 29, parameters: [command.speed] };\n    case \"changeFrequency\":\n      return { code: 30, parameters: [command.frequency] };\n    case \"walkAnimation\":\n      return { code: command.enabled ? 31 : 32, parameters: [] };\n    case \"stepAnimation\":\n      return { code: command.enabled ? 33 : 34, parameters: [] };\n    case \"directionFix\":\n      return { code: command.enabled ? 35 : 36, parameters: [] };\n    case \"through\":\n      return { code: command.enabled ? 37 : 38, parameters: [] };\n    case \"transparent\":\n      return { code: command.enabled ? 39 : 40, parameters: [] };\n    case \"changeImage\":\n      return { code: 41, parameters: [command.character?.name ?? \"\", command.characterIndex] };\n    case \"changeOpacity\":\n      return { code: 42, parameters: [command.opacity] };\n    case \"changeBlendMode\":\n      return {\n        code: 43,\n        parameters: [[\"normal\", \"additive\", \"multiply\", \"screen\"].indexOf(command.blendMode)],\n      };\n    case \"playSe\":\n      return {\n        code: 44,\n        parameters: [\n          {\n            name: command.audio.asset?.name ?? \"\",\n            volume: command.audio.volume,\n            pitch: command.audio.pitch,\n            pan: command.audio.pan,\n          },\n        ],\n      };\n    case \"script\":\n      return { code: 45, parameters: [command.script.code] };\n  }\n}\n","import type { AutonomousMovement } from \"../../domain/types.js\";\nimport type { ReferenceResolver } from \"../../validation/types.js\";\nimport { CommandStructureError } from \"../../validation/command-errors.js\";\nimport { compileMovementRoute } from \"./compile.js\";\nimport { assertNativeMovementRoute } from \"./validation.js\";\nimport type { NativeMovementRoute } from \"./types.js\";\n\nexport const movementTypes = [\"fixed\", \"random\", \"approach\", \"custom\"] as const;\n\nexport function compilePageMovement(\n  value: AutonomousMovement | undefined,\n  resolver: ReferenceResolver,\n  path = \"movement\",\n) {\n  if (value !== undefined) {\n    const fail = (field: string, expected: string, actual: unknown): never => {\n      throw new CommandStructureError(\n        \"MV-PAGE-MOVEMENT\",\n        \"Invalid Autonomous Movement configuration.\",\n        { dslPath: `${path}${field}`, expected, actual: String(actual) },\n      );\n    };\n    if (\n      !value ||\n      typeof value !== \"object\" ||\n      Array.isArray(value) ||\n      ![Object.prototype, null].includes(Object.getPrototypeOf(value))\n    )\n      fail(\"\", \"movement object\", value);\n    if (\n      Reflect.ownKeys(value).some((key) => {\n        const descriptor = Object.getOwnPropertyDescriptor(value, key)!;\n        return (\n          typeof key !== \"string\" ||\n          ![\"type\", \"speed\", \"frequency\", \"route\"].includes(key) ||\n          !(\"value\" in descriptor) ||\n          !descriptor.enumerable\n        );\n      })\n    )\n      fail(\"\", \"type/speed/frequency/route only\", \"extra field\");\n    if (value.type !== undefined && !movementTypes.includes(value.type))\n      fail(\".type\", movementTypes.join(\"/\"), value.type);\n    for (const [field, maximum] of [\n      [\"speed\", 6],\n      [\"frequency\", 5],\n    ] as const) {\n      const number = value[field];\n      if (number !== undefined && (!Number.isInteger(number) || number < 1 || number > maximum))\n        fail(`.${field}`, `integer 1..${maximum}`, number);\n    }\n  }\n  return {\n    moveType: movementTypes.indexOf(value?.type ?? \"fixed\"),\n    moveSpeed: value?.speed ?? 3,\n    moveFrequency: value?.frequency ?? 3,\n    moveRoute: compileMovementRoute(\n      value?.route === undefined ? { commands: [] } : value.route,\n      resolver,\n      `${path}.route`,\n    ),\n  };\n}\n\nexport type NativePageMovement = {\n  type: (typeof movementTypes)[number];\n  speed: number;\n  frequency: number;\n  route: NativeMovementRoute;\n};\n\nexport function readNativePageMovement(\n  page: Record<string, unknown>,\n  path: string,\n): NativePageMovement | undefined {\n  if (\n    ![\"moveType\", \"moveSpeed\", \"moveFrequency\", \"moveRoute\"].some((key) => Object.hasOwn(page, key))\n  )\n    return undefined;\n  assertNativeMovementRoute(page.moveRoute, `${path}.moveRoute`);\n  for (const [field, minimum, maximum] of [\n    [\"moveType\", 0, 3],\n    [\"moveSpeed\", 1, 6],\n    [\"moveFrequency\", 1, 5],\n  ] as const) {\n    const value = page[field];\n    if (\n      !Number.isInteger(value) ||\n      (value as number) < minimum ||\n      (value as number) > maximum ||\n      Object.is(value, -0)\n    )\n      throw new CommandStructureError(\n        \"MV-PAGE-MOVEMENT\",\n        \"Invalid native Autonomous Movement configuration.\",\n        {\n          nativePath: `${path}.${field}`,\n          expected: `integer ${minimum}..${maximum}`,\n          actual: Object.hasOwn(page, field)\n            ? Object.is(value, -0)\n              ? \"-0\"\n              : String(value)\n            : \"<missing>\",\n        },\n      );\n  }\n  return {\n    type: movementTypes[page.moveType as number]!,\n    speed: page.moveSpeed as number,\n    frequency: page.moveFrequency as number,\n    route: page.moveRoute,\n  };\n}\n","import {\n  assertNativeMapEvent,\n  assertNativeMapEvents,\n  assertNativeMapPage,\n  assertNativeMapPages,\n} from \"../map-event/native.js\";\nimport { readProjectDataSnapshotFile, type WorkspaceStatePaths } from \"../workspace/state.js\";\nimport type { RawEventCommand } from \"../compiler/types.js\";\nimport type { SnapshotCommonEvent, SnapshotMapEvent, SnapshotMapEventPage } from \"./types.js\";\nimport { readNativePageMovement } from \"../commands/movement/page.js\";\nimport { describeValue, renderJsonValue } from \"../project-data/json-values.js\";\nimport {\n  CommandStructureError,\n  inspectCommandListStructure,\n} from \"../validation/command-structure.js\";\n\nexport function renderPageConditions(conditions: Record<string, unknown> | undefined): string {\n  if (conditions === undefined) {\n    return \"{}\";\n  }\n\n  const fields: string[] = [];\n\n  for (const [slot, helper] of [\n    [\"switch1\", \"switch\"],\n    [\"switch2\", \"switch\"],\n    [\"variable\", \"variable\"],\n    [\"item\", \"item\"],\n    [\"actor\", \"actor\"],\n  ] as const) {\n    if (\n      conditions[`${slot}Valid`] === false &&\n      conditions[`${slot}Id`] === 1 &&\n      (slot !== \"variable\" || Object.is(conditions.variableValue, 0))\n    )\n      continue;\n    fields.push(\n      `${slot}: { enabled: ${conditions[`${slot}Valid`]}, ref: ${helper}Ref({ id: ${literal(conditions[`${slot}Id`])} })${slot === \"variable\" ? `, atLeast: ${literal(conditions.variableValue)}` : \"\"} }`,\n    );\n  }\n  if (conditions.selfSwitchValid !== false || conditions.selfSwitchCh !== \"A\")\n    fields.push(\n      `selfSwitch: { enabled: ${conditions.selfSwitchValid}, value: ${literal(conditions.selfSwitchCh)} }`,\n    );\n\n  if (fields.length === 0) {\n    return \"{}\";\n  }\n\n  return `{\\n${indentLines(fields.map((field) => `${field},`).join(\"\\n\"), 4)}\\n  }`;\n}\n\nexport function renderEventImport(helpers: readonly string[]): string {\n  const uniqueHelpers = [...new Set(helpers)].sort((left, right) => left.localeCompare(right));\n\n  return `import { ${uniqueHelpers.join(\", \")} } from \"rpgmaker-event-dsl\";`;\n}\n\nexport function collectConditionHelperNames(\n  conditions: readonly (Record<string, unknown> | undefined)[],\n): string[] {\n  const helpers = new Set<string>();\n\n  for (const condition of conditions) {\n    if (\n      condition &&\n      (condition.switch1Valid !== false ||\n        condition.switch1Id !== 1 ||\n        condition.switch2Valid !== false ||\n        condition.switch2Id !== 1)\n    ) {\n      helpers.add(\"switchRef\");\n    }\n    if (\n      condition &&\n      (condition.variableValid !== false ||\n        condition.variableId !== 1 ||\n        !Object.is(condition.variableValue, 0))\n    ) {\n      helpers.add(\"variableRef\");\n    }\n    if (condition && (condition.itemValid !== false || condition.itemId !== 1)) {\n      helpers.add(\"itemRef\");\n    }\n    if (condition && (condition.actorValid !== false || condition.actorId !== 1)) {\n      helpers.add(\"actorRef\");\n    }\n  }\n\n  return [...helpers];\n}\n\nexport function readMapEvents(\n  mapData: Record<string, unknown>,\n  mapId?: number,\n): SnapshotMapEvent[] {\n  try {\n    assertNativeMapEvents(mapData.events);\n  } catch (error) {\n    if (error instanceof CommandStructureError)\n      throw new CommandStructureError(\n        error.code,\n        error.detail,\n        error.location,\n        `map:${mapId ?? \"?\"}`,\n        \"decompile\",\n      );\n    throw error;\n  }\n  return mapData.events.flatMap((entry, index) => {\n    if (entry === null) return [];\n    const identity = `map:${mapId ?? \"?\"}/event:${index}`;\n    try {\n      assertNativeMapEvent(entry, index);\n      return [\n        {\n          id: entry.id as number,\n          name: entry.name as string,\n          note: entry.note as string,\n          x: entry.x as number,\n          y: entry.y as number,\n          pages: readMapEventPages(entry.pages, identity),\n        },\n      ];\n    } catch (error) {\n      if (error instanceof CommandStructureError)\n        throw new CommandStructureError(\n          error.code,\n          error.detail,\n          error.location,\n          identity,\n          \"decompile\",\n        );\n      throw error;\n    }\n  });\n}\n\nexport function readMapEventPages(value: unknown, identity?: string): SnapshotMapEventPage[] {\n  try {\n    assertNativeMapPages(value);\n    return value.map((record, pageIndex) => {\n      const path = `pages[${pageIndex}]`;\n      assertNativeMapPage(record, path);\n      const movement = readNativePageMovement(record, path)!;\n      return {\n        movement,\n        conditions: record.conditions as Record<string, unknown>,\n        image: record.image as SnapshotMapEventPage[\"image\"],\n        directionFix: record.directionFix as boolean,\n        stepAnime: record.stepAnime as boolean,\n        through: record.through as boolean,\n        walkAnime: record.walkAnime as boolean,\n        priorityType: record.priorityType as number,\n        trigger: record.trigger as number,\n        list: readRawCommandList(record.list, identity, `${path}.`),\n      };\n    });\n  } catch (error) {\n    if (error instanceof CommandStructureError)\n      throw new CommandStructureError(\n        error.code,\n        error.detail,\n        error.location,\n        identity,\n        \"decompile\",\n      );\n    throw error;\n  }\n}\n\nexport function readCommonEvents(value: readonly unknown[]): SnapshotCommonEvent[] {\n  if (value.length === 0 || value[0] !== null)\n    throw new CommandStructureError(\n      \"MV-COMMON-EVENT\",\n      \"Common Event data requires a reserved null first slot.\",\n      {\n        nativePath: \"CommonEvents[0]\",\n        expected: \"present null reserved slot\",\n        actual: describeValue(value[0]),\n      },\n      \"commonEvents\",\n      \"decompile\",\n    );\n  return value.flatMap((entry, index) => {\n    if (entry === null) return [];\n    const fail = (field: string, expected: string, actual: unknown): never => {\n      throw new CommandStructureError(\n        \"MV-COMMON-EVENT\",\n        \"Invalid owned Common Event saved state.\",\n        {\n          nativePath: `CommonEvents[${index}]${field ? `.${field}` : \"\"}`,\n          expected,\n          actual: describeValue(actual),\n        },\n        `commonEvent:${index}`,\n        \"decompile\",\n      );\n    };\n    if (typeof entry !== \"object\" || Array.isArray(entry))\n      fail(\"\", \"Common Event object or null hole\", entry);\n    const record = entry as Record<string, unknown>;\n    for (const field of Object.keys(record))\n      if (![\"id\", \"name\", \"trigger\", \"switchId\", \"list\"].includes(field))\n        fail(field, \"only id, name, trigger, switchId and list\", record[field]);\n    if (index === 0 || record.id !== index)\n      fail(\"id\", \"positive ID matching the array position\", record.id);\n    if (typeof record.name !== \"string\") fail(\"name\", \"present string\", record.name);\n    if (\n      Object.is(record.trigger, -0) ||\n      (record.trigger !== 0 && record.trigger !== 1 && record.trigger !== 2)\n    )\n      fail(\"trigger\", \"0, 1 or 2\", record.trigger);\n    if (!Number.isSafeInteger(record.switchId) || (record.switchId as number) <= 0)\n      fail(\"switchId\", \"positive safe integer\", record.switchId);\n    return [\n      {\n        id: index,\n        list: readRawCommandList(record.list, `commonEvent:${index}`),\n        name: record.name as string,\n        trigger: record.trigger as 0 | 1 | 2,\n        switchId: record.switchId as number,\n      },\n    ];\n  });\n}\n\nexport function readRawCommandList(\n  value: unknown,\n  identity?: string,\n  nativePrefix = \"\",\n): RawEventCommand[] {\n  try {\n    inspectCommandListStructure(value as RawEventCommand[], { requireTerminator: true });\n  } catch (error) {\n    if (error instanceof CommandStructureError)\n      throw new CommandStructureError(\n        error.code,\n        error.detail,\n        {\n          ...error.location,\n          ...(error.location.nativePath\n            ? { nativePath: nativePrefix + error.location.nativePath }\n            : {}),\n          ...(error.location.relatedLocations\n            ? {\n                relatedLocations: error.location.relatedLocations.map((related) => ({\n                  ...related,\n                  ...(related.nativePath ? { nativePath: nativePrefix + related.nativePath } : {}),\n                })),\n              }\n            : {}),\n        },\n        identity,\n        \"decompile\",\n      );\n    throw error;\n  }\n  return (value as RawEventCommand[]).map((entry: RawEventCommand) => ({\n    ...entry,\n    parameters: [...entry.parameters],\n  }));\n}\n\nexport function normalizeCommandList(\n  commands: readonly RawEventCommand[] | undefined,\n): RawEventCommand[] {\n  return commands === undefined ? [] : [...commands];\n}\n\nexport function readNamedSystemEntries(value: unknown): Array<{ id: number; name: string }> {\n  if (!Array.isArray(value)) {\n    return [];\n  }\n\n  return value.flatMap((entry, index) => {\n    if (typeof entry !== \"string\" || entry.length === 0 || index === 0) {\n      return [];\n    }\n\n    return [{ id: index, name: entry }];\n  });\n}\n\nexport async function readSnapshotFile(\n  statePaths: WorkspaceStatePaths,\n  relativePath: string,\n): Promise<string> {\n  return readProjectDataSnapshotFile(statePaths, relativePath);\n}\n\nexport async function readSnapshotArray(\n  statePaths: WorkspaceStatePaths,\n  relativePath: string,\n): Promise<unknown[]> {\n  const parsed = JSON.parse(await readSnapshotFile(statePaths, relativePath));\n  if (!Array.isArray(parsed)) {\n    throw new Error(`Expected snapshot ${relativePath} to contain a JSON array.`);\n  }\n\n  return parsed;\n}\n\nexport async function readSnapshotObject(\n  statePaths: WorkspaceStatePaths,\n  relativePath: string,\n): Promise<Record<string, unknown>> {\n  const parsed = JSON.parse(await readSnapshotFile(statePaths, relativePath));\n  if (!parsed || typeof parsed !== \"object\" || Array.isArray(parsed)) {\n    throw new Error(`Expected snapshot ${relativePath} to contain a JSON object.`);\n  }\n\n  return parsed as Record<string, unknown>;\n}\n\nexport function renderEmptyModule(): string {\n  return \"export {};\\n\";\n}\n\nexport function commonEventTriggerFromCode(value: unknown): \"none\" | \"autorun\" | \"parallel\" {\n  if (value === 1) {\n    return \"autorun\";\n  }\n  if (value === 2) {\n    return \"parallel\";\n  }\n\n  return \"none\";\n}\n\nexport function mapPageTriggerFromCode(\n  value: unknown,\n): \"action\" | \"playerTouch\" | \"eventTouch\" | \"autorun\" | \"parallel\" {\n  if (value === 1) {\n    return \"playerTouch\";\n  }\n  if (value === 2) {\n    return \"eventTouch\";\n  }\n  if (value === 3) {\n    return \"autorun\";\n  }\n  if (value === 4) {\n    return \"parallel\";\n  }\n\n  return \"action\";\n}\n\nexport function createExportNameAllocator(): {\n  create(prefix: string, displayName: string, id: number): string;\n} {\n  const usedNames = new Set<string>();\n\n  return {\n    create(prefix, displayName, id) {\n      const nameParts = displayName\n        .normalize(\"NFKD\")\n        .replaceAll(/[^a-zA-Z0-9]+/gu, \" \")\n        .trim()\n        .split(/\\s+/u)\n        .filter(Boolean);\n      const base =\n        nameParts.length === 0 ? prefix : `${prefix}${nameParts.map(toPascalCasePart).join(\"\")}`;\n      const candidate = `${base}${id.toString().padStart(3, \"0\")}`;\n      let output = candidate;\n      let suffix = 2;\n\n      while (usedNames.has(output)) {\n        output = `${candidate}_${suffix}`;\n        suffix += 1;\n      }\n\n      usedNames.add(output);\n      return output;\n    },\n  };\n}\n\nexport function toPascalCasePart(value: string): string {\n  return `${value.charAt(0).toUpperCase()}${value.slice(1)}`;\n}\n\nexport function formatMapFileName(mapId: number): string {\n  return `Map${mapId.toString().padStart(3, \"0\")}.json`;\n}\n\nexport function indentLines(value: string, spaces: number): string {\n  if (value.length === 0) {\n    return \"\";\n  }\n\n  const prefix = \" \".repeat(spaces);\n  return value\n    .split(\"\\n\")\n    .map((line) => (line.length === 0 ? line : `${prefix}${line}`))\n    .join(\"\\n\");\n}\n\nexport function literal(value: unknown): string {\n  return renderJsonValue(value, { typeScript: true });\n}\n\nexport function readStringParameter(value: unknown): string {\n  return typeof value === \"string\" ? value : \"\";\n}\n\nexport function isStringArray(value: unknown): value is string[] {\n  return Array.isArray(value) && value.every((entry) => typeof entry === \"string\");\n}\n\nexport function isMessageBackground(value: unknown): value is 0 | 1 | 2 {\n  return value === 0 || value === 1 || value === 2;\n}\n\nexport function isMessagePositionType(value: unknown): value is 0 | 1 | 2 {\n  return value === 0 || value === 1 || value === 2;\n}\n\nexport function isItemType(value: unknown): value is 1 | 2 | 3 | 4 {\n  return value === 1 || value === 2 || value === 3 || value === 4;\n}\n\nexport function isDirection(value: unknown): value is 2 | 4 | 6 | 8 {\n  return value === 2 || value === 4 || value === 6 || value === 8;\n}\n\nexport function isEventLocationDirection(value: unknown): value is 0 | 2 | 4 | 6 | 8 {\n  return value === 0 || isDirection(value);\n}\n\nexport function isFadeType(value: unknown): value is 0 | 1 | 2 {\n  return value === 0 || value === 1 || value === 2;\n}\n\nexport function isBlendMode(value: unknown): value is 0 | 1 | 2 | 3 {\n  return value === 0 || value === 1 || value === 2 || value === 3;\n}\n\nexport function isNumberTuple(value: unknown, length: number): value is number[] {\n  return (\n    Array.isArray(value) &&\n    value.length === length &&\n    value.every((entry) => typeof entry === \"number\")\n  );\n}\n\nexport function isSelfSwitch(value: unknown): value is \"A\" | \"B\" | \"C\" | \"D\" {\n  return value === \"A\" || value === \"B\" || value === \"C\" || value === \"D\";\n}\n\nexport function readControlValue(value: unknown): boolean | null {\n  if (value === 0) {\n    return true;\n  }\n  if (value === 1) {\n    return false;\n  }\n\n  return null;\n}\n\nexport function readPositiveInteger(value: unknown): number | null {\n  return typeof value === \"number\" && Number.isInteger(value) && value > 0 ? value : null;\n}\n\nexport function isMissingFileError(error: unknown): boolean {\n  return (\n    error instanceof Error &&\n    \"code\" in error &&\n    typeof (error as { code?: unknown }).code === \"string\" &&\n    (error as { code?: string }).code === \"ENOENT\"\n  );\n}\n","import type {\n  RawEventCommand,\n  RenderCommandList,\n  RenderedCommand,\n  RenderSimpleCommand,\n} from \"../../decompiler/types.js\";\nimport {\n  isMessageBackground,\n  isMessagePositionType,\n  isStringArray,\n  literal,\n  readStringParameter,\n} from \"../../decompiler/core.js\";\n\nexport function renderShowTextCommand(\n  commands: readonly RawEventCommand[],\n  index: number,\n  renderSimpleCommand: RenderSimpleCommand,\n): RenderedCommand {\n  const command = commands[index];\n  if (command === undefined) {\n    throw new Error(\"Cannot render missing Show Text command.\");\n  }\n\n  const lines: string[] = [];\n  let nextIndex = index;\n  const faceName = command.parameters[0];\n  const faceIndex = command.parameters[1];\n  const background = command.parameters[2];\n  const positionType = command.parameters[3];\n\n  if (\n    typeof faceName !== \"string\" ||\n    typeof faceIndex !== \"number\" ||\n    !isMessageBackground(background) ||\n    !isMessagePositionType(positionType)\n  ) {\n    return renderSimpleCommand(command, index);\n  }\n\n  // MV stores Show Text bodies as 401 continuation commands owned by the parent command.\n  while (\n    commands[nextIndex + 1]?.code === 401 &&\n    commands[nextIndex + 1]?.indent === command.indent\n  ) {\n    const next = commands[nextIndex + 1];\n    const line = next?.parameters[0];\n    lines.push(typeof line === \"string\" ? line : \"\");\n    nextIndex += 1;\n  }\n\n  const fields = [`lines: ${literal(lines.length > 0 ? lines : [\"\"])}`];\n  const helperNames = [\"showText\"];\n\n  if (faceName.length > 0) {\n    fields.push(\n      `face: { image: imageAsset({ folder: \"faces\", name: ${literal(faceName)} }), index: ${faceIndex} }`,\n    );\n    helperNames.push(\"imageAsset\");\n  }\n  if (background !== 0) {\n    fields.push(`background: ${background}`);\n  }\n  if (positionType !== 2) {\n    fields.push(`positionType: ${positionType}`);\n  }\n\n  return {\n    expression: `showText({ ${fields.join(\", \")} })`,\n    helperNames,\n    nextIndex,\n  };\n}\n\nexport function renderShowChoicesCommand(\n  commands: readonly RawEventCommand[],\n  index: number,\n  renderCommandList: RenderCommandList,\n  renderSimpleCommand: RenderSimpleCommand,\n): RenderedCommand {\n  const command = commands[index];\n  if (command === undefined) {\n    throw new Error(\"Cannot render missing Show Choices command.\");\n  }\n\n  const choices = command.parameters[0];\n  const cancelType = command.parameters[1];\n  const defaultType = command.parameters[2];\n  const positionType = command.parameters[3];\n  const background = command.parameters[4];\n\n  if (\n    !isStringArray(choices) ||\n    choices.length === 0 ||\n    typeof cancelType !== \"number\" ||\n    typeof defaultType !== \"number\" ||\n    !isMessagePositionType(positionType) ||\n    !isMessageBackground(background)\n  ) {\n    return renderSimpleCommand(command, index);\n  }\n\n  const helperNames = new Set<string>([\"showChoices\"]);\n  const branches = Array.from({ length: choices.length }, () => [] as RawEventCommand[]);\n  let cancelBranch: RawEventCommand[] | null = null;\n  let nextIndex = index;\n\n  while (commands[nextIndex + 1]?.indent === command.indent) {\n    const branchCommand = commands[nextIndex + 1];\n    if (branchCommand === undefined || (branchCommand.code !== 402 && branchCommand.code !== 403)) {\n      break;\n    }\n\n    const branchEndIndex = findMessageBranchEnd(commands, nextIndex + 2, command.indent);\n    const body = commands.slice(nextIndex + 2, branchEndIndex);\n\n    if (branchCommand.code === 402) {\n      const choiceIndex = branchCommand.parameters[0];\n      if (\n        typeof choiceIndex !== \"number\" ||\n        !Number.isInteger(choiceIndex) ||\n        choiceIndex < 0 ||\n        choiceIndex >= choices.length\n      ) {\n        break;\n      }\n      branches[choiceIndex] = body;\n    } else {\n      cancelBranch = body;\n    }\n\n    nextIndex = branchEndIndex - 1;\n  }\n\n  if (commands[nextIndex + 1]?.code === 404 && commands[nextIndex + 1]?.indent === command.indent) {\n    nextIndex += 1;\n  }\n\n  const branchExpressions = branches.map((branch) => {\n    const rendered = renderCommandList(branch);\n    for (const helperName of rendered.helperNames) {\n      helperNames.add(helperName);\n    }\n    return `[${renderInlineCommandListSource(rendered.source)}]`;\n  });\n  if (cancelBranch !== null && cancelType !== -2) return renderSimpleCommand(command, index);\n\n  const fields = [`choices: ${literal(choices)}`, `branches: [${branchExpressions.join(\", \")}]`];\n\n  if (cancelBranch === null && cancelType !== -1) {\n    fields.push(`cancelType: ${cancelType}`);\n  }\n  if (defaultType !== 0) {\n    fields.push(`defaultType: ${defaultType}`);\n  }\n  if (positionType !== 2) {\n    fields.push(`positionType: ${positionType}`);\n  }\n  if (background !== 0) {\n    fields.push(`background: ${background}`);\n  }\n  if (cancelBranch !== null) {\n    const renderedCancelBranch = renderCommandList(cancelBranch);\n    for (const helperName of renderedCancelBranch.helperNames) {\n      helperNames.add(helperName);\n    }\n    fields.push(\n      `cancelType: -2, cancelBranch: [${renderInlineCommandListSource(renderedCancelBranch.source)}]`,\n    );\n  }\n\n  return {\n    expression: `showChoices({ ${fields.join(\", \")} })`,\n    helperNames: [...helperNames],\n    nextIndex,\n  };\n}\n\nexport function renderShowScrollingTextCommand(\n  commands: readonly RawEventCommand[],\n  index: number,\n  renderSimpleCommand: RenderSimpleCommand,\n): RenderedCommand {\n  const command = commands[index];\n  if (command === undefined) {\n    throw new Error(\"Cannot render missing Show Scrolling Text command.\");\n  }\n\n  const speed = command.parameters[0];\n  const noFastForward = command.parameters[1];\n  if (typeof speed !== \"number\" || typeof noFastForward !== \"boolean\") {\n    return renderSimpleCommand(command, index);\n  }\n\n  const lines: string[] = [];\n  let nextIndex = index;\n\n  while (\n    commands[nextIndex + 1]?.code === 405 &&\n    commands[nextIndex + 1]?.indent === command.indent\n  ) {\n    const next = commands[nextIndex + 1];\n    const line = next?.parameters[0];\n    if (typeof line !== \"string\") {\n      break;\n    }\n    lines.push(line);\n    nextIndex += 1;\n  }\n\n  const fields = [`lines: ${literal(lines.length > 0 ? lines : [\"\"])}`];\n  if (speed !== 2) {\n    fields.push(`speed: ${speed}`);\n  }\n  if (noFastForward) {\n    fields.push(\"noFastForward: true\");\n  }\n\n  return {\n    expression: `showScrollingText({ ${fields.join(\", \")} })`,\n    helperNames: [\"showScrollingText\"],\n    nextIndex,\n  };\n}\n\nexport function renderCommentCommand(\n  commands: readonly RawEventCommand[],\n  index: number,\n): RenderedCommand {\n  const command = commands[index];\n  if (command === undefined) {\n    throw new Error(\"Cannot render missing Comment command.\");\n  }\n\n  const lines = [readStringParameter(command.parameters[0])];\n  let nextIndex = index;\n\n  while (\n    commands[nextIndex + 1]?.code === 408 &&\n    commands[nextIndex + 1]?.indent === command.indent\n  ) {\n    const next = commands[nextIndex + 1];\n    lines.push(readStringParameter(next?.parameters[0]));\n    nextIndex += 1;\n  }\n\n  return {\n    expression: `comment(${literal(lines)})`,\n    helperNames: [\"comment\"],\n    nextIndex,\n  };\n}\n\nexport function renderScriptCommand(\n  commands: readonly RawEventCommand[],\n  index: number,\n  renderSimpleCommand: RenderSimpleCommand,\n): RenderedCommand {\n  const command = commands[index];\n  if (command === undefined) {\n    throw new Error(\"Cannot render missing Script command.\");\n  }\n\n  if (typeof command.parameters[0] !== \"string\") {\n    return renderSimpleCommand(command, index);\n  }\n\n  const lines = [command.parameters[0]];\n  let nextIndex = index;\n  while (\n    commands[nextIndex + 1]?.code === 655 &&\n    commands[nextIndex + 1]?.indent === command.indent\n  ) {\n    const line = commands[nextIndex + 1]?.parameters[0];\n    if (typeof line !== \"string\") {\n      break;\n    }\n    lines.push(line);\n    nextIndex += 1;\n  }\n\n  return {\n    expression: `script({ code: ${literal(lines.join(\"\\n\"))} })`,\n    helperNames: [\"script\"],\n    nextIndex,\n  };\n}\n\nexport function findMessageBranchEnd(\n  commands: readonly RawEventCommand[],\n  startIndex: number,\n  parentIndent: number,\n): number {\n  let index = startIndex;\n\n  while (index < commands.length) {\n    const command = commands[index];\n    if (command === undefined || command.indent <= parentIndent) {\n      break;\n    }\n    index += 1;\n  }\n\n  return index;\n}\n\nexport function renderInlineCommandListSource(source: string): string {\n  if (source.length === 0) {\n    return \"\";\n  }\n\n  return source.replaceAll(\"\\n\", \" \");\n}\n","import type {\n  RawEventCommand,\n  RenderCommandList,\n  RenderedCommand,\n  RenderSimpleCommand,\n} from \"../../decompiler/types.js\";\nimport {\n  isDirection,\n  isSelfSwitch,\n  literal,\n  readControlValue,\n  readPositiveInteger,\n} from \"../../decompiler/core.js\";\nimport { renderInlineCommandListSource } from \"../message/decompile.js\";\n\nexport function renderConditionalCommand(\n  commands: readonly RawEventCommand[],\n  index: number,\n  renderCommandList: RenderCommandList,\n  renderSimpleCommand: RenderSimpleCommand,\n): RenderedCommand {\n  const command = commands[index];\n  if (command === undefined) {\n    throw new Error(\"Cannot render missing Conditional Branch command.\");\n  }\n\n  const condition = renderConditionalBranchCondition(command.parameters);\n  if (condition === null) {\n    return renderSimpleCommand(command, index);\n  }\n\n  const helperNames = new Set<string>([\"conditional\", ...condition.helperNames]);\n  const thenEndIndex = findConditionalBranchBodyEnd(commands, index + 1, command.indent);\n  const thenCommands = commands.slice(index + 1, thenEndIndex);\n  const renderedThen = renderCommandList(thenCommands);\n\n  for (const helperName of renderedThen.helperNames) {\n    helperNames.add(helperName);\n  }\n\n  const fields = [\n    `condition: ${condition.expression}`,\n    `then: [${renderInlineCommandListSource(renderedThen.source)}]`,\n  ];\n  let nextIndex = thenEndIndex - 1;\n\n  if (commands[thenEndIndex]?.code === 411 && commands[thenEndIndex]?.indent === command.indent) {\n    const elseEndIndex = findConditionalBranchBodyEnd(commands, thenEndIndex + 1, command.indent);\n    const renderedElse = renderCommandList(commands.slice(thenEndIndex + 1, elseEndIndex));\n\n    for (const helperName of renderedElse.helperNames) {\n      helperNames.add(helperName);\n    }\n\n    fields.push(`else: [${renderInlineCommandListSource(renderedElse.source)}]`);\n    nextIndex = elseEndIndex - 1;\n  }\n\n  if (commands[nextIndex + 1]?.code === 412 && commands[nextIndex + 1]?.indent === command.indent) {\n    nextIndex += 1;\n  }\n\n  return {\n    expression: `conditional({ ${fields.join(\", \")} })`,\n    helperNames: [...helperNames],\n    nextIndex,\n  };\n}\n\nexport function renderLoopCommand(\n  commands: readonly RawEventCommand[],\n  index: number,\n  renderCommandList: RenderCommandList,\n): RenderedCommand {\n  const command = commands[index];\n  if (command === undefined) {\n    throw new Error(\"Cannot render missing Loop command.\");\n  }\n\n  const bodyEndIndex = findLoopBodyEnd(commands, index + 1, command.indent);\n  const bodyCommands = commands.slice(index + 1, bodyEndIndex);\n  const last = bodyCommands.at(-1);\n  const hasEndMarker = last?.code === 0 && last.indent === command.indent + 1;\n  const body = renderCommandList(hasEndMarker ? bodyCommands.slice(0, -1) : bodyCommands);\n  const markerField = hasEndMarker ? \"\" : ', endMarker: \"absent\"';\n\n  return {\n    expression: `loop({ body: { commands: [${renderInlineCommandListSource(body.source)}]${markerField} } })`,\n    helperNames: [\"loop\", ...body.helperNames],\n    nextIndex: bodyEndIndex,\n  };\n}\n\nexport function renderConditionalBranchCondition(\n  parameters: readonly unknown[],\n): { expression: string; helperNames: readonly string[] } | null {\n  switch (parameters[0]) {\n    case 0:\n      return renderSwitchCondition(parameters);\n    case 1:\n      return renderVariableCondition(parameters);\n    case 2:\n      return renderSelfSwitchCondition(parameters);\n    case 3:\n      return renderTimerCondition(parameters);\n    case 4:\n      return renderActorCondition(parameters);\n    case 5:\n      return renderEnemyCondition(parameters);\n    case 6:\n      return renderCharacterCondition(parameters);\n    case 7:\n      return renderGoldCondition(parameters);\n    case 8:\n      return renderItemCondition(parameters);\n    case 9:\n      return renderWeaponCondition(parameters);\n    case 10:\n      return renderArmorCondition(parameters);\n    case 11:\n      return renderButtonCondition(parameters);\n    case 12:\n      return typeof parameters[1] === \"string\"\n        ? {\n            expression: `{\n  kind: \"script\",\n  script: scriptInput({ code: ${literal(parameters[1])} }),\n}`,\n            helperNames: [\"scriptInput\"],\n          }\n        : null;\n    case 13:\n      return renderVehicleCondition(parameters);\n    default:\n      return null;\n  }\n}\n\nexport function renderSwitchCondition(\n  parameters: readonly unknown[],\n): { expression: string; helperNames: readonly string[] } | null {\n  const switchId = readPositiveInteger(parameters[1]);\n  const value = readControlValue(parameters[2]);\n\n  return switchId === null || value === null\n    ? null\n    : {\n        expression: `{ kind: \"switch\", switch: switchRef({ id: ${switchId} }), value: ${value} }`,\n        helperNames: [\"switchRef\"],\n      };\n}\n\nexport function renderVariableCondition(\n  parameters: readonly unknown[],\n): { expression: string; helperNames: readonly string[] } | null {\n  const variableId = readPositiveInteger(parameters[1]);\n  const operandKind = parameters[2];\n  const operator = conditionalVariableOperatorFromCode(parameters[4]);\n\n  if (variableId === null || operator === null) {\n    return null;\n  }\n\n  if (operandKind === 0 && typeof parameters[3] === \"number\") {\n    return {\n      expression: `{ kind: \"variable\", variable: variableRef({ id: ${variableId} }), operator: ${literal(operator)}, value: ${parameters[3]} }`,\n      helperNames: [\"variableRef\"],\n    };\n  }\n\n  if (operandKind === 1) {\n    const sourceVariableId = readPositiveInteger(parameters[3]);\n    return sourceVariableId === null\n      ? null\n      : {\n          expression: `{ kind: \"variable\", variable: variableRef({ id: ${variableId} }), operator: ${literal(operator)}, value: variableRef({ id: ${sourceVariableId} }) }`,\n          helperNames: [\"variableRef\"],\n        };\n  }\n\n  return null;\n}\n\nexport function renderSelfSwitchCondition(\n  parameters: readonly unknown[],\n): { expression: string; helperNames: readonly string[] } | null {\n  const selfSwitch = parameters[1];\n  const value = readControlValue(parameters[2]);\n\n  return isSelfSwitch(selfSwitch) && value !== null\n    ? {\n        expression: `{ kind: \"selfSwitch\", selfSwitch: ${literal(selfSwitch)}, value: ${value} }`,\n        helperNames: [],\n      }\n    : null;\n}\n\nexport function renderTimerCondition(\n  parameters: readonly unknown[],\n): { expression: string; helperNames: readonly string[] } | null {\n  const seconds = parameters[1];\n  const operator = parameters[2] === 0 ? \"ge\" : parameters[2] === 1 ? \"le\" : null;\n\n  return typeof seconds === \"number\" && operator !== null\n    ? {\n        expression: `{ kind: \"timer\", seconds: ${seconds}, operator: ${literal(operator)} }`,\n        helperNames: [],\n      }\n    : null;\n}\n\nexport function renderActorCondition(\n  parameters: readonly unknown[],\n): { expression: string; helperNames: readonly string[] } | null {\n  const actorId = readPositiveInteger(parameters[1]);\n  if (actorId === null) {\n    return null;\n  }\n\n  const check = renderActorConditionCheck(parameters[2], parameters[3]);\n  if (check === null) {\n    return null;\n  }\n\n  return {\n    expression: `{ kind: \"actor\", actor: actorRef({ id: ${actorId} }), check: ${check.expression} }`,\n    helperNames: [\"actorRef\", ...check.helperNames],\n  };\n}\n\nexport function renderActorConditionCheck(\n  checkKind: unknown,\n  value: unknown,\n): { expression: string; helperNames: readonly string[] } | null {\n  switch (checkKind) {\n    case 0:\n      return { expression: `{ kind: \"inParty\" }`, helperNames: [] };\n    case 1:\n      return typeof value === \"string\"\n        ? { expression: `{ kind: \"name\", name: ${literal(value)} }`, helperNames: [] }\n        : null;\n    case 2:\n      return renderReferencedActorCheck(\"class\", \"classRef\", value);\n    case 3:\n      return renderReferencedActorCheck(\"skill\", \"skillRef\", value);\n    case 4:\n      return renderReferencedActorCheck(\"weapon\", \"weaponRef\", value);\n    case 5:\n      return renderReferencedActorCheck(\"armor\", \"armorRef\", value);\n    case 6:\n      return renderReferencedActorCheck(\"state\", \"stateRef\", value);\n    default:\n      return null;\n  }\n}\n\nexport function renderReferencedActorCheck(\n  kind: \"armor\" | \"class\" | \"skill\" | \"state\" | \"weapon\",\n  helperName: \"armo