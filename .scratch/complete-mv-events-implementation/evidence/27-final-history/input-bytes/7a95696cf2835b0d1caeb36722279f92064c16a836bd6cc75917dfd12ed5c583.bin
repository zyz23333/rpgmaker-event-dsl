		changeBattleBack: ["battleback1", "battleback2"],
		changeParallax: [
			"image",
			"loopX",
			"loopY",
			"sx",
			"sy"
		]
	};
	if (!Object.hasOwn(fields, kind)) return;
	assertDslObject(input, [...withKind ? ["kind"] : [], ...fields[kind]], path);
	if (kind === "changeParallax") {
		assertImageSlot(input.image, "parallaxes", `${path}.image`, 284);
		for (const field of [
			"loopX",
			"loopY",
			"sx",
			"sy"
		]) {
			const value = input[field];
			const boolean = field === "loopX" || field === "loopY";
			if (boolean ? typeof value !== "boolean" : !Number.isSafeInteger(value) || value < -32 || value > 32) throw new CommandStructureError("MV-E284-INPUT", "Invalid independently saved parallax configuration.", {
				dslPath: `${path}.${field}`,
				expected: boolean ? "boolean" : "integer -32..32",
				actual: describeValue(value)
			});
		}
		return;
	}
	if (kind === "changeBattleBack") {
		assertImageSlot(input.battleback1, "battlebacks1", `${path}.battleback1`, 283);
		assertImageSlot(input.battleback2, "battlebacks2", `${path}.battleback2`, 283);
		return;
	}
	if (kind === "changeMapNameDisplay") {
		if (typeof input.enabled !== "boolean") throw new CommandStructureError("MV-E281-INPUT", "Map name display requires an explicit boolean.", {
			dslPath: `${path}.enabled`,
			expected: "boolean",
			actual: describeValue(input.enabled)
		});
		return;
	}
	const expected = "tileset reference with one positive integer ID or nonempty name; no None";
	const fail = () => {
		throw new CommandStructureError("MV-E282-INPUT", "Invalid tileset reference.", {
			dslPath: `${path}.tileset`,
			expected,
			actual: describeValue(input.tileset)
		});
	};
	if (input.tileset === null || typeof input.tileset !== "object") fail();
	const reference = input.tileset;
	assertDslObject(reference, [
		"kind",
		"id",
		"name"
	], `${path}.tileset`);
	if (reference.kind !== "tileset" || Object.hasOwn(reference, "id") === Object.hasOwn(reference, "name")) fail();
	if (Object.hasOwn(reference, "id") ? !Number.isSafeInteger(reference.id) || reference.id <= 0 : typeof reference.name !== "string" || reference.name.length === 0) fail();
	if (resolver) try {
		resolver.resolveReference(reference);
	} catch (error) {
		throw new CommandStructureError("MV-E282-REFERENCE", error instanceof Error ? error.message : String(error), {
			dslPath: `${path}.tileset`,
