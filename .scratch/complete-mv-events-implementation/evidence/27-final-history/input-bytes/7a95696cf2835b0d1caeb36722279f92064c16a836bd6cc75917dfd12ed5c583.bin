	}
}
function assertImageSlot(value, folder, path, code) {
	if (value === null) return;
	const fail = () => {
		throw new CommandStructureError(`MV-E${code}-INPUT`, "Expected an explicit image Asset Reference or None.", {
			dslPath: path,
